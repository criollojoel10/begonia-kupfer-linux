# Overlay del device para begonia (Xiaomi Redmi Note 8 Pro, MT6785).
#
# Base: deviceinfo de pmaports (gitlab.postmarketos.org, commit 6c223d3) tal cual,
# mas las variables que Kupfer necesita y pmaports no usa.
#
# Sobre el recovery dtbo: el bootloader de begonia arranca con header_version 2
# y sin un recovery dtbo vacio no localiza el dtbo de recovery. pmaports lo
# resuelve en su APKBUILD generando el dtbo con `mkdtboimg create`, que viene
# del subpackage de Alpine `android-tools-mkdtboimg`. En Arch no existe
# mkdtboimg ni en los repos ni en la AUR, y el prebuilt de Kupfer
# `mkbootimg-git-r254...` solo trae mkbootimg/unpack_bootimg. Por eso se
# versiona aqui el binario ya construido (136 bytes) en lugar de depender de una
# herramienta que no hay.
#
#   $ mkdtboimg create empty.dtbo empty.dtb      # vacio.dtb = /dts-v1/; / {};
#   # magic 0xd7b7ab1e = variante MediaTek (AOSP usa 0xd7b7caf1), por eso se
#   # reutilizan los bytes exactos de pmaports en vez de reinventar el formato.
#
# Si se quiere regenerar, basta con ese par de comandos sobre un empty.dtb
# trivial; el resultado debe dar 136 bytes y este mismo sha256.
_mode=cross
pkgname=device-mt6785-xiaomi-begonia
pkgver=0.1
pkgrel=2
_arches=specific
arch=(aarch64)
license=(MIT)
depends=(
    boot-android-common
    firmware-mt6785-xiaomi-begonia
    linux-mt6785
)
_commit=6c223d3
source=(
    https://gitlab.postmarketos.org/postmarketOS/pmaports/-/raw/${_commit}/device/testing/device-xiaomi-begonia/deviceinfo
    https://gitlab.postmarketos.org/postmarketOS/pmaports/-/raw/${_commit}/device/testing/device-xiaomi-begonia/modules-initfs
    xiaomi-begonia.conf
    machine-info
    empty.dtbo
    mediatek-wifi.sh
    mediatek-wifi.service
)
# Ojo: los hash de abajo son de los ficheros de source=(). Al tocar uno de
# ellos hay que rehacer el correspondiente, o el build muere aqui con
# "One or more files did not pass the validity check".
sha256sums=(
    e951e23dda716ab7ef25f41eac6f7368d0d69ab423442ca9aba0c833556af41e
    7c42356f4d8963a925bf996d6dc44544146247c2cf8c30049f1740e931105913
    eb2b3acb43b4f9d48ec3affb16b923c588e5583fde2bebf85303966bf0c90159
    7b7f69c23f35c956b628ef6eedc6fd59f0688b8c310ed0429a24a89bfac43ae7
    f72e1df52c33bde1676863a21b3e7f8c3cb9a21b8ed7addefe2ac0eb8cce0635
    SKIP
    SKIP
)

package() {
    cp "$srcdir"/deviceinfo "$srcdir"/deviceinfo_
    cat >>"$srcdir"/deviceinfo_ <<EOF

# --- anadido por el port a Kupfer (overlay/device/device-mt6785-xiaomi-begonia) ---
# header_version 2 hace que update-bootimg.sh use la ruta --kernel/--dtb/--dtb_offset
# en vez de concatenar Image.gz y el dtb.
deviceinfo_header_version="2"
deviceinfo_dtb="mediatek/mt6785-xiaomi-begonia"
# deviceinfo_flash_offset_dtb (0x0bc08000) ya viene de pmaports mas arriba.
# El bootloader MTK aborta el arranque sin esto en la linea de comandos.
deviceinfo_kernel_cmdline="bootopt=64S3,32N2,64N2"
# update-bootimg.sh lo pasa a mkbootimg --recovery_dtbo. El fichero lo instala
# este mismo paquete en /boot/empty.dtbo.
deviceinfo_recovery_dtbo="/boot/empty.dtbo"
# begonia guarda datos en UFS, no en particiones de eMMC.
deviceinfo_partitions_data="/dev/disk/by-partlabel/userdata"
deviceinfo_partitions_microsd="/dev/mmcblk0"
EOF
    # modules-initfs viene por source=() y con su sha256, no por curl dentro de
    # package(): con `curl -sSL` y sin -f, un 404 guardaria el HTML de error en el
    # fichero y la linea de abajo lo inyectaria tal cual en
    # deviceinfo_modules_initfs, con lo que mkinitcpio pediria modulos que no
    # existen. Asi el error sale aqui, en la descarga, y no en el arranque.
    grep -q 'novatek-nvt-ts-spi' "$srcdir"/modules-initfs \
        || { echo "modules-initfs de pmaports no contiene el stack de panel/tactil" >&2; return 1; }
    # paste -sd' ' une las lineas con un unico espacio y sin dejar ninguno al
    # final. Con `tr '\n' ' '` quedaria un espacio colgante que update-bootimg.sh
    # convierte en una coma final en `earlymodules=` de la linea de comandos.
    cat >>"$srcdir"/deviceinfo_ <<EOF

# Panel y tactil: sin esto en el initramfs no hay imagen en absoluto.
deviceinfo_modules_initfs="$(paste -sd' ' "$srcdir"/modules-initfs)"
EOF
    install -Dm644 "$srcdir"/deviceinfo_ "$pkgdir"/etc/kupfer/deviceinfo

    # Sin este fichero, el --recovery_dtbo de arriba apuntaria a la nada.
    install -Dm644 "$srcdir"/empty.dtbo "$pkgdir"/boot/empty.dtbo

    install -Dm644 "$srcdir"/xiaomi-begonia.conf "$pkgdir"/etc/kupfer/mkinitcpio.conf.d/xiaomi-begonia.conf

    install -Dm644 "$srcdir"/machine-info "$pkgdir"/etc/machine-info

    # Encendido del wifi interno de MediaTek (wmt_drv + wlan_gen4m + btif).
    # El symlink de multi-user.target.wants se crea a mano, no con un
    # post_install, porque en una construccion de imagen no corre systemctl y
    # hay que dejar la unidad habilitada de antemano.
    install -Dm755 "$srcdir"/mediatek-wifi.sh \
        "$pkgdir"/usr/libexec/mediatek-wifi.sh
    install -Dm644 "$srcdir"/mediatek-wifi.service \
        "$pkgdir"/usr/lib/systemd/system/mediatek-wifi.service
    ln -s /usr/lib/systemd/system/mediatek-wifi.service \
        "$pkgdir"/etc/systemd/system/multi-user.target.wants/mediatek-wifi.service
}
