[Unit]
Description=MediaTek internal WiFi (begonia, MT6785: wmt_drv + wlan_gen4m)
# Los modulos los carga el propio script con modprobe, asi que basta con ir
# detras de systemd-modules-load. Se deja en multi-user.target para no atar el
# arranque a la red.
After=systemd-modules-load.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
# La ruta tiene que ser EXACTAMENTE la que instala el PKGBUILD
# (/usr/libexec/mediatek-wifi.sh). Con /usr/lib/device-mt6785-xiaomi-begonia/
# el servicio arrancaba con status=203/EXEC "No such file or directory": el
# fichero nunca estuvo ahi, el wifi interno no se encendia nunca, y nada de
# esto lo delata en el build (el paquete se construye bien de todos modos).
ExecStart=/usr/libexec/mediatek-wifi.sh
TimeoutStartSec=120
# Si falla, reintenta: al arrancar el nodo puede no existir todavia porque el
# UFS acaba de despertar y el firmware se pide del disco.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
