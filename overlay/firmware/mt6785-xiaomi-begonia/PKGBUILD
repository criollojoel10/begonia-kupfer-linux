# Firmware de conectividad y panel del Xiaomi Redmi Note 8 Pro (MT6785).
#
# El repositorio es el mismo que usa pmaports (mt6785-mainline/firmware) y ya
# trae los blobs de conectividad del stack WMT/gen4m, que son los que pide el
# driver por request_firmware():
#
#   WMT_SOC.cfg                    configuracion del WMT (fallback: WMT.cfg)
#   soc1_0_patch_mcu_2a_1_hdr.bin  parche del firmware del MCU
#   soc1_0_ram_mcu_2a_1_hdr.bin    firmware del MCU
#   soc1_0_ram_wifi_2a_1_hdr.bin   firmware de la RAM de wifi
#   soc1_0_ram_bt_2a_1_hdr.bin     firmware de la RAM de BT
#   WIFI_RAM_CODE_soc1_0_2a_1.bin  firmware principal del WLAN (connac)
#   wifi.cfg                       parametros del driver, opcional (ver abajo)
#
# wifi.cfg y txpowerctrl.cfg son opcionales de verdad, no por un fallback: los
# dos se cargan DESPUES de haber puesto la tabla de fabrica que ya viene
# compilada en el driver, y el fichero solo la sobreescribe si viene relleno.
# wlanGetConfig() (gl_init.c, CFG_SUPPORT_CFG_FILE=1) hace antes
# wlanCfgInit(prAdapter, NULL, 0, 0), y txPwrCtrlLoadConfig() mete antes la
# lista con txPwrCtrlGlobalVariableToList(). Si el cfg no esta, el firmware
# arranca igual y solo se pierde la configuracion de fabrica. Como este paquete
# instala el directorio entero del repo, van los que haya.
#
# El nombre del firmware del WLAN lo construye connacConstructFirmwarePrio() con
# "%s_%u%s_%u.bin" = <prefijo>_<CFG_WIFI_IP_SET=2><kalGetFwFlavor()><eco>.bin, y
# kalGetFwFlavor() en os/linux/plat/mt6785/plat_priv.c devuelve 'a'. Por eso el
# 2a del nombre. Si el kernel askhara otro nombre, se prueban en este orden:
# ..._2a_1.bin, ..._2a_1, WIFI_RAM_CODE_soc1_0, WIFI_RAM_CODE_soc1_0.bin.
#
# El EEPROM (EEPROM_MT<chip_id>.bin) NO hace falta: si el driver no lo encuentra
# cae al modo eFuse, que es lo normal en un movil (la calibracion esta en el
# eFuse del SoC, no en un fichero).
#
# Importante: los ficheros van a /usr/lib/firmware/, NO a /usr/<vendor>/. El
# cargador de firmware del kernel solo busca en /usr/lib/firmware (y sus
# subdirectorios), asi que antes de este cambio el firmware estaba en
# /usr/mediatek/ y era invisible para el driver.
#
# Y los blobs de conectividad van en la RAIZ de /usr/lib/firmware/, NO en un
# subdirectorio, porque el fwport los pide con nombres pelados:
#
#   wmt_conf.h:34        "WMT_SOC.cfg"
#   wmt_dev.c:406,459,508 "soc1_0_patch_mcu_2a_1_hdr.bin"
#   wmt_ctrl.c:654-656   "soc1_0_ram_{bt,wifi,mcu}_2a_1_hdr.bin"
#   config.h:149         "WIFI_RAM_CODE" -> connacConstructFirmwarePrio()
#                        genera "WIFI_RAM_CODE_soc1_0_2a_1.bin"
#   gl_init.c:3322,3372  "wifi.cfg"
#
# El kernel resuelve un request_firmware() sin "/" en la raiz de cada ruta de
# firmware_class, y en los subdirectorios solo si el nombre lleva la carpeta.
# Comprobado en un begonia con pmOS: con los blobs en
# /usr/lib/firmware/mediatek/, modprobe wmt_drv moria con
#   (NULL device *): Direct firmware load for WMT_SOC.cfg failed with error -2
# y wlan0 no aparecia nunca. Copiados a la raiz, escanea, se asocia y hay
# internet.
#
# El firmware del panel SI lleva carpeta en el nombre, porque el DTB lo pide
# como "novatek/nt36672a_begonia_csot.bin", asi que ese va en novatek/.
#
# --- variante de panel ---
#
# _panel dice que panel lleva ESTA unidad, y no es un detalle. El DTB de la
# rama 6.16 (la unica que hay para begonia) solo conoce la variante CSOT:
#
#   panel@...:     compatible = "xiaomi,begonia-csot-nt36672a", "novatek,nt36672a"
#   touchscreen@0: firmware-name = "novatek/nt36672a_begonia_csot.bin"
#
# El driver del tactil (novatek-nvt-ts-spi) hace request_firmware() con ese
# nombre EXACTO, asi que en una unidad Tianma hay que servir el binario Tianma
# bajo el nombre CSOT o el touch sale con los ejes invertidos. Confirmado en
# hardware sobre este mismo movil con pmOS.
#
#   md5sum nt36672a_begonia_tianma.bin.zst = 7d67c2e9167f1a630576c177c1b831f7 (53321 B)
#   md5sum nt36672a_begonia_csot.bin.zst  = 52f5e96f84fbdd6cbed2e98790a202df (53731 B)
#
# Asi el touch va bien sin tocar el movil. Para una unidad CSOT: _panel=csot.
_panel=tianma
_mode=cross
pkgname=firmware-mt6785-xiaomi-begonia
pkgver=0.1
# 4: los blobs de conectividad pasan de firmware/mediatek/ a la raiz de
#    firmware/, que es donde request_firmware() los busca.
pkgrel=5
_arches=specific
arch=(aarch64)
license=(custom:Proprietary)
options=(
    !strip
    !emptydirs
)
depends=(linux-firmware)
_commit=33aa9fe1db0079945fa272e42f04db732489319d
source=(
    "git+https://gitlab.postmarketos.org/mt6785-mainline/firmware.git#commit=$_commit"
)
sha256sums=(SKIP)

package() {
    mkdir -p "$pkgdir/usr/lib/firmware"
    # Los blobs de wifi+BT van a la RAIZ: el driver los pide sin carpeta
    # (ver la nota de cabecera).
    cp -a "$srcdir"/firmware/mediatek/. "$pkgdir/usr/lib/firmware/"
    # El firmware del panel y del tactil si lleva carpeta en el nombre, asi
    # que ese se queda en su subdirectorio.
    cp -a "$srcdir"/firmware/novatek "$pkgdir/usr/lib/firmware/"
    # El repo no trae LICENSE (solo los dos directorios), asi que esto es
    # opcional: si algun dia lo anaden, se copia sin romper nada.
    if [ -f "$srcdir"/firmware/LICENSE ]; then
        install -Dm644 "$srcdir"/firmware/LICENSE \
            "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    fi

    # El tactil de una unidad Tianma se queda sin blob si esto no esta: el DTB
    # pide el nombre CSOT y ese nombre tiene que contener el binario Tianma
    # (ver la nota de _panel arriba). Se hace aqui, y no en el paquete del
    # device, para que haya un unico escritor de ese path.
    if [ "$_panel" = tianma ]; then
        cp -f "$pkgdir"/usr/lib/firmware/novatek/nt36672a_begonia_tianma.bin.zst \
              "$pkgdir"/usr/lib/firmware/novatek/nt36672a_begonia_csot.bin.zst
        echo "panel Tianma: el nombre CSOT apunta al binario Tianma"
    fi
}
