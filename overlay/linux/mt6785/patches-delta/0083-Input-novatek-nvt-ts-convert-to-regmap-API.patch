-	tristate "Novatek NT11205 touchscreen support"
+
+config TOUCHSCREEN_NOVATEK_NVT_TS_CORE
+	tristate
+
+config TOUCHSCREEN_NOVATEK_NVT_TS_I2C
+	tristate "Novatek I2C touchscreen support"
 	depends on I2C
+	select REGMAP_I2C
+	select TOUCHSCREEN_NOVATEK_NVT_TS_CORE
