From 5fd196cb81ea5660e35fe47462300a82bae8fa1d Mon Sep 17 00:00:00 2001
From: Dinolek <git@dinolek.me>
Date: Tue, 8 Jul 2025 18:48:01 +0200
Subject: [PATCH 070/115] arm64: dts: mediatek: mt6785: Add GPU support

The MediaTek MT6785 includes a Mali-G76 GPU supported in Panfrost. Add
the GPU node to the device tree to enable 3D acceleration.

Signed-off-by: Dinolek <git@dinolek.me>
---
 arch/arm64/boot/dts/mediatek/mt6785.dtsi | 240 +++++++++++++++++++++++
 1 file changed, 240 insertions(+)

diff --git a/arch/arm64/boot/dts/mediatek/mt6785.dtsi b/arch/arm64/boot/dts/mediatek/mt6785.dtsi
index 10bb8490d..0e4f3a845 100644
--- a/arch/arm64/boot/dts/mediatek/mt6785.dtsi
+++ b/arch/arm64/boot/dts/mediatek/mt6785.dtsi
@@ -224,6 +224,226 @@ l3_0: l3-cache {
 		};
 	};
 
+	gpu_opp_table: opp-table-0 {
+		compatible = "operating-points-v2";
+		opp-shared;
