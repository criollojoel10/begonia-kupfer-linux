+
 	clk13m: fixed-factor-clock-13m {
 		compatible = "fixed-factor-clock";
 		#clock-cells = <0>;
@@ -894,6 +1114,26 @@ ufsphy: ufs-phy@11fa0000 {
 			status = "disabled";
 		};
 
+		gpu: gpu@13040000 {
+			compatible = "mediatek,mt6785-mali", "arm,mali-bifrost";
+			reg = <0 0x13040000 0 0x4000>;
+
+			clocks = <&mfgcfg CLK_MFG_BG3D>;
+			interrupts = <GIC_SPI 311 IRQ_TYPE_LEVEL_LOW>,
+				     <GIC_SPI 310 IRQ_TYPE_LEVEL_LOW>,
+				     <GIC_SPI 309 IRQ_TYPE_LEVEL_LOW>,
+				     <GIC_SPI 312 IRQ_TYPE_LEVEL_LOW>;
+			interrupt-names = "job", "mmu", "gpu", "event";
+			operating-points-v2 = <&gpu_opp_table>;
+			power-domains = <&spm MT6785_POWER_DOMAIN_MFG_CORE0>,
+					<&spm MT6785_POWER_DOMAIN_MFG_CORE1>,
+					<&spm MT6785_POWER_DOMAIN_MFG_CORE2>,
+					<&spm MT6785_POWER_DOMAIN_MFG_CORE3>;
+			power-domain-names = "core0", "core1", "core2", "core3";
+			#cooling-cells = <2>;
+			status = "disabled";
+		};
+
 		mfgcfg: clock-controller@13fbf000 {
 			compatible = "mediatek,mt6785-mfgcfg", "syscon";
 			reg = <0 0x13fbf000 0 0x1000>;
