From bf39daeb46bcabef775f80be6ecf6220ebafb0c1 Mon Sep 17 00:00:00 2001
From: Dinolek <git@dinolek.me>
Date: Sun, 6 Jul 2025 23:25:21 +0200
Subject: [PATCH 017/115] arm64: dts: mediatek: mt6785: Add watchdog support

Add watchdog node as default enabled to avoid timeouts.

Signed-off-by: Dinolek <git@dinolek.me>
---
 arch/arm64/boot/dts/mediatek/mt6785.dtsi | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/arch/arm64/boot/dts/mediatek/mt6785.dtsi b/arch/arm64/boot/dts/mediatek/mt6785.dtsi
index fe0e88d6c..a234a5efa 100644
--- a/arch/arm64/boot/dts/mediatek/mt6785.dtsi
+++ b/arch/arm64/boot/dts/mediatek/mt6785.dtsi
@@ -340,6 +340,13 @@ pio: pinctrl@10005000 {
 			#interrupt-cells = <2>;
 		};
 
+		watchdog: watchdog@10007000 {
+			compatible = "mediatek,mt6785-wdt";
+			reg = <0 0x10007000 0 0x1000>;
+			interrupts = <GIC_SPI 72 IRQ_TYPE_LEVEL_LOW>;
+			#reset-cells = <1>;
+		};
+
 		apmixedsys: clock-controller@1000c000 {
 			compatible = "mediatek,mt6785-apmixedsys", "syscon";
 			reg = <0 0x1000c000 0 0x1000>;
-- 
2.56.0

