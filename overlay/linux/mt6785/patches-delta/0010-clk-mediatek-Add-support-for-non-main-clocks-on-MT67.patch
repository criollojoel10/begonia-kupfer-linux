diff --git a/drivers/clk/mediatek/clk-mt6785-apu.c b/drivers/clk/mediatek/clk-mt6785-apu.c
new file mode 100644
index 000000000..71505667b
--- /dev/null
+++ b/drivers/clk/mediatek/clk-mt6785-apu.c
@@ -0,0 +1,92 @@
+// SPDX-License-Identifier: GPL-2.0
