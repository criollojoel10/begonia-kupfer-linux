From b29840ed4605800cb94d0212c27505f6c70d3c05 Mon Sep 17 00:00:00 2001
From: Dinolek <git@dinolek.me>
Date: Mon, 7 Jul 2025 00:25:50 +0200
Subject: [PATCH 023/115] arm64: dts: mediatek: mt6785: Add mmsys support

Add node for mmsys.

Signed-off-by: Dinolek <git@dinolek.me>
---
 arch/arm64/boot/dts/mediatek/mt6785.dtsi | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/arch/arm64/boot/dts/mediatek/mt6785.dtsi b/arch/arm64/boot/dts/mediatek/mt6785.dtsi
index a234a5efa..5acf76030 100644
--- a/arch/arm64/boot/dts/mediatek/mt6785.dtsi
+++ b/arch/arm64/boot/dts/mediatek/mt6785.dtsi
@@ -396,6 +396,13 @@ mfgcfg: clock-controller@13fbf000 {
 			#clock-cells = <1>;
 		};
 
+		mmsys: syscon@14000000 {
+			compatible = "mediatek,mt6785-mmsys", "syscon";
+			reg = <0 0x14000000 0 0x1000>;
+			#clock-cells = <1>;
+			#reset-cells = <1>;
+		};
+
 		imgsys: clock-controller@15020000 {
 			compatible = "mediatek,mt6785-imgsys", "syscon";
 			reg = <0 0x15020000 0 0x1000>;
-- 
2.56.0

