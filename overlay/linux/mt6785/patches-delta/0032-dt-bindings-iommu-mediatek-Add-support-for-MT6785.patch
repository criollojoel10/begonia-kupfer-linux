 .../bindings/iommu/mediatek,iommu.yaml        |   2 +
 .../memory/mediatek,mt6785-memory-port.h      | 128 ++++++++++++++++++
 2 files changed, 130 insertions(+)
 create mode 100644 include/dt-bindings/memory/mediatek,mt6785-memory-port.h

