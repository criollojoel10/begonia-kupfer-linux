+void wlanClearPendingInterrupt(IN struct ADAPTER *prAdapter)
+{
+	uint32_t i;
+
+	i = 0;
+	while (i < CFG_IST_LOOP_COUNT
+	       && nicProcessIST(prAdapter) != WLAN_STATUS_NOT_INDICATING) {
+		i++;
+	};
+}
