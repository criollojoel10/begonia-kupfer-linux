+	DBGLOG(SW4, INFO,
+	       "(OBSS) ProtectMode HT[%u] ERP[%u], OperationMode GF[%u] RIFS[%u]\n",
+	       prBssInfo->eObssHtProtectMode, prBssInfo->fgObssErpProtectMode,
