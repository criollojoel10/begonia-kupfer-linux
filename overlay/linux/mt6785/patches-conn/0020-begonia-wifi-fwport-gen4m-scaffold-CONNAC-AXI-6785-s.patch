+#if CFG_SUPPORT_MTK_SYNERGY
+/*----------------------------------------------------------------------------*/
+/*!
+ * \brief This function is used to generate MTK Vendor Specific OUI
+ *
+ * \param[in]
+ *
+ * \return none
+ */
+/*----------------------------------------------------------------------------*/
+void rlmGenerateMTKOuiIE(struct ADAPTER *prAdapter,
+			 struct MSDU_INFO *prMsduInfo)
+{
