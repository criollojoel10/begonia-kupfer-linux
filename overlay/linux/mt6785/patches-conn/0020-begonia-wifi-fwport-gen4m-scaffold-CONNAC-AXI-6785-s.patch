+		       "p2pFsmUninit: wlanProcessCommandQueue, num of element:%d\n",
+		       prAdapter->prGlueInfo->rCmdQueue.u4NumElem);
+		wlanProcessCommandQueue(prAdapter,
+			&prAdapter->prGlueInfo->rCmdQueue);
+
+		wlanReleasePowerControl(prAdapter);
