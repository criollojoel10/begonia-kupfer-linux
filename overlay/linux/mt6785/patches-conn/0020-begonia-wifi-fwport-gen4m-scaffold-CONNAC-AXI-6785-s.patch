+/*----------------------------------------------------------------------------*/
+uint32_t glRegisterBus(probe_card pfProbe, remove_card pfRemove)
+{
+	int ret = 0;
+
+	ASSERT(pfProbe);
+	ASSERT(pfRemove);
+
+	pfWlanProbe = pfProbe;
+	pfWlanRemove = pfRemove;
+
+	mtk_axi_driver.probe = mtk_axi_probe;
