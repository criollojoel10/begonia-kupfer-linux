+/*!
+ * @brief This procedure is used to retrieve a TX sequence number atomically
+ *
+ * @param    prAdapter   Pointer of ADAPTER_T
+ *
+ * @retval - UINT_8
+ */
+/*----------------------------------------------------------------------------*/
+uint8_t nicIncreaseTxSeqNum(IN struct ADAPTER *prAdapter)
+{
+	uint8_t ucRetval;
+
+	KAL_SPIN_LOCK_DECLARATION();
+
+	ASSERT(prAdapter);
