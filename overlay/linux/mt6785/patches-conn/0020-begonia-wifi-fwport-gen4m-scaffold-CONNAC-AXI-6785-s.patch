+
+	for (ucStaRecIndex = 0; ucStaRecIndex < CFG_STA_REC_NUM;
+		++ucStaRecIndex) {
+		if (QUEUE_IS_NOT_EMPTY(
+			&prAdapter->rStaPsQueue[ucStaRecIndex])) {
+			nicTxDirectClearStaPsQ(prAdapter,
+				ucStaRecIndex);
