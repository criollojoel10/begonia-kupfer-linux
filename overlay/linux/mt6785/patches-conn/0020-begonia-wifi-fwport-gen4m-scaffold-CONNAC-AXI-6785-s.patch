+uint32_t wlanoidUpdateFtIes(struct ADAPTER *prAdapter, void *pvSetBuffer,
+			    uint32_t u4SetBufferLen, uint32_t *pu4SetInfoLen)
+{
+	struct FT_IES *prFtIes = NULL;
