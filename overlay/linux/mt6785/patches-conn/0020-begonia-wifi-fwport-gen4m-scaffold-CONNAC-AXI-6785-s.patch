+/*!
+ * @brief This function is used to calculate P2P IE length for Beacon frame.
+ *
+ * @param[in] eNetTypeIndex      Specify which network
+ * @param[in] prStaRec           Pointer to the STA_RECORD_T
+ *
+ * @return The length of P2P IE added
