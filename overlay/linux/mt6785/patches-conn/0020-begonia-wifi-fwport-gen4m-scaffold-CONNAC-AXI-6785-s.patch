+
+	prP2pBssInfo = GET_BSS_INFO_BY_INDEX(prAdapter, ucBssIdx);
+
+	if (prP2pBssInfo->eNetworkType != NETWORK_TYPE_P2P)
+		return 0;
+
+	return kalP2PCalWSC_IELen(prAdapter->prGlueInfo,
