+#if DBG
+#define kalMemFree(pvAddr, eMemType, u4Size)  \
+{   \
+	if (pvAddr) {   \
+		allocatedMemSize -= u4Size; \
+		DBGLOG(INIT, INFO, "0x%p(%ld) freed (%s:%s)\n", \
+			pvAddr, (uint32_t)u4Size, __FILE__, __func__);  \
+	}   \
+	kvfree(pvAddr); \
+}
+#else
+#define kalMemFree(pvAddr, eMemType, u4Size)  \
