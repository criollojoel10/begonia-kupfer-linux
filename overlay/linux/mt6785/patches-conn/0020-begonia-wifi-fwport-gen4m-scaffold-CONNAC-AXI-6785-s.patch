+	LOG_SCAN_ABORT_REQ_D2F,
+	LOG_SCAN_ABORT_DONE_D2K,
+
+	/* Driver only */
+	LOG_SCAN_D2D,
+
+	/* Last one */
+	LOG_SCAN_MAX
+};
