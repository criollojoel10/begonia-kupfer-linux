+	TDLS_FRM_ACTION_PEER_PSM_RSP,
+	TDLS_FRM_ACTION_PTI_RSP,
+	TDLS_FRM_ACTION_DISCOVERY_REQ,
+	TDLS_FRM_ACTION_DISCOVERY_RSP = 0x0e,
+	TDLS_FRM_ACTION_EVENT_TEAR_DOWN_TO_SUPPLICANT = 0x30
