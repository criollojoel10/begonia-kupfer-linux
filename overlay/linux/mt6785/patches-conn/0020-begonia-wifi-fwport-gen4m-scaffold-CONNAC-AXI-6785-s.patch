+const struct BOW_CMD arBowCmdTable[] = {
+	{BOW_CMD_ID_GET_MAC_STATUS, bowCmdGetMacStatus},
+	{BOW_CMD_ID_SETUP_CONNECTION, bowCmdSetupConnection},
+	{BOW_CMD_ID_DESTROY_CONNECTION, bowCmdDestroyConnection},
