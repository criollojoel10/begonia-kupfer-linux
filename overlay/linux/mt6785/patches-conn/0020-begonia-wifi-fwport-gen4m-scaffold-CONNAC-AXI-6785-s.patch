+	rStatus = wlanSetInformation(prGlueInfo->prAdapter, wlanoidSetFrequency,
+				     &prNewConfig->u4DSConfig,
+				     sizeof(uint32_t), &u4SetInfoLen);
+#endif
+
+	if (rStatus != WLAN_STATUS_SUCCESS)
+		return rStatus;
+
+	return rStatus;
+
