+		FALSE, /* fgNeedResp */
+		FALSE, /* fgIsOid */
+		NULL,  /* pfCmdDoneHandler */
+		NULL,  /* pfCmdTimeoutHandler */
+		sizeof(struct CMD_SET_DOMAIN_INFO), /* u4SetQueryInfoLen */
+		(uint8_t *) prCmd, /* pucInfoBuffer */
+		NULL,  /* pvSetQueryBuffer */
+		0      /* u4SetQueryBufferLen */
+	    );
