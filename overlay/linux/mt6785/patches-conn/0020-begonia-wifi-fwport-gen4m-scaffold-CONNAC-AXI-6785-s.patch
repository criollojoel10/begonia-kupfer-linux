+*    \brief  Declaration of functions and finite state machine for BOW Module.
+*
+*    Declaration of functions and finite state machine for BOW Module.
+*/
+
+
+#ifndef _BOW_FSM_H
+#define _BOW_FSM_H
+
+/*******************************************************************************
+*                         C O M P I L E R   F L A G S
