+/*----------------------------------------------------------------------------*/
+/*!
+ * \brief
+ *
+ * \param[in]
+ *
+ * \return none
+ */
+/*----------------------------------------------------------------------------*/
+struct STA_RECORD *cnmGetStaRecByIndex(struct ADAPTER *prAdapter,
+	uint8_t ucIndex)
+{
+	struct STA_RECORD *prStaRec;
+
+	ASSERT(prAdapter);
+
+	if (ucIndex < CFG_STA_REC_NUM)
+		prStaRec = &prAdapter->arStaRec[ucIndex];
+	else
+		prStaRec = NULL;
+
+	if (prStaRec && prStaRec->fgIsInUse == FALSE)
+		prStaRec = NULL;
+
+	return prStaRec;
+}
