+void nicRxProcessEventPacket(IN struct ADAPTER *prAdapter,
+			     IN OUT struct SW_RFB *prSwRfb)
+{
+	struct mt66xx_chip_info *prChipInfo;
+	struct CMD_INFO *prCmdInfo;
