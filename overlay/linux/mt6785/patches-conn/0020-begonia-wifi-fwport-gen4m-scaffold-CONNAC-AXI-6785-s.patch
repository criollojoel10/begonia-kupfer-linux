+/* size_t assocresp_ies_len; */
+/* size_t probe_resp_len; */
+/* }; */
+
+/* ////////////////////////// */
+
+	} while (FALSE);
+
+	return i4Rslt;
+}				/* mtk_p2p_cfg80211_change_beacon */
