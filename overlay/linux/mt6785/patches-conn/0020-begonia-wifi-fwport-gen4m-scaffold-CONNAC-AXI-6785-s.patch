+ *                            P U B L I C   D A T A
+ *******************************************************************************
+ */
+
+/*******************************************************************************
+ *                           P R I V A T E   D A T A
+ *******************************************************************************
+ */
+
+/*******************************************************************************
+ *                                 M A C R O S
+ *******************************************************************************
+ */
+#define RSN_IE(fp)              ((struct RSN_INFO_ELEM *) fp)
+#define WPA_IE(fp)              ((struct WPA_INFO_ELEM *) fp)
+
+#define ELEM_MAX_LEN_ASSOC_RSP_WSC_IE          (32 - ELEM_HDR_LEN)
+#define ELEM_MAX_LEN_TIMEOUT_IE          (5)
+
