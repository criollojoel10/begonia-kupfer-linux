+
+			u4Value = ntohl(u4Value);
+			memcpy(HqaCmdFrame->Data + 2 + (u4Index * 4), &u4Value,
+			       4);
+		}
+	}
+
+	ResponseToQA(HqaCmdFrame, prIwReqData, 2 + (u4Length * 4),
+		     i4Status);
+
+	return i4Status;
+}
