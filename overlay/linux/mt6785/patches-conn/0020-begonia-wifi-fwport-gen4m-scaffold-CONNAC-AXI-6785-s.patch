+	rx_st_comm->sinr =
+		ntohl(g_HqaRxStat.SINR);
+	if (band_idx == HQA_M_BAND_0) {
+		rx_st_comm->driver_rx_count =
+		ntohl(g_HqaRxStat.DriverRxCount);
+	} else {
+		rx_st_comm->driver_rx_count =
+		ntohl(g_HqaRxStat.DriverRxCount1);
+	}
