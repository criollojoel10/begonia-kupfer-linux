+
+	ASSERT(prAdapter);
+
+	prBowFsmInfo = &(prAdapter->rWifiVar.rBowFsmInfo);
+
+	if (g_u4LinkCount == 1) {
+		DBGLOG(BOW, EVENT, "BoW Starting.\n");
