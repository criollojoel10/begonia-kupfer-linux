+	union {
+		struct TDLS_CMD_CORE_TEST_NULL_RCV rCmdNullRcv;
+		uint8_t Reserved[TDLS_CMD_CORE_RESERVED_SIZE];
+	} Content;
+};
+
+enum TDLS_EVENT_HOST_ID {
