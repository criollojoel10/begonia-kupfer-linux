+		__cp[0] = (uint8_t)((_value) >> 24); \
+		__cp[1] = (uint8_t)((_value) >> 16); \
+		__cp[2] = (uint8_t)((_value) >> 8); \
+		__cp[3] = (uint8_t)(_value); \
