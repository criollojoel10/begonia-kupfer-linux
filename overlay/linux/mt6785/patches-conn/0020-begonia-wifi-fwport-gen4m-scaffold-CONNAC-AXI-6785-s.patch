+			  (uint32_t) u2OverallBufferLength,
+			  (uint8_t *) pucOutputBuf,
+			  (uint32_t) prAdapter->u4CoalescingBufCachedSize);
+
+	return WLAN_STATUS_SUCCESS;
+}
