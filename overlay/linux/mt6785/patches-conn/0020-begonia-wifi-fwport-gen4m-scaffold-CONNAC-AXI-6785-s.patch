+ */
+/*----------------------------------------------------------------------------*/
+void kalUpdateRxCSUMOffloadParam(IN void *pvPacket,
+				 IN enum ENUM_CSUM_RESULT aeCSUM[])
+{
+	struct sk_buff *skb = (struct sk_buff *)pvPacket;
