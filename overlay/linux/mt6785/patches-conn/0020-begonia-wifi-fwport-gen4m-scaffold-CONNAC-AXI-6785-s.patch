+		i4TotalLen - i4BytesWritten,
+		"Dump WTBL info of WLAN_IDX	    = %d\n",
+		u4Index);
+	/* DW0~DW1 */
+	i4BytesWritten += kalSnprintf(pcCommand + i4BytesWritten,
+		i4TotalLen - i4BytesWritten, "\tADDR="MACSTR"\n",
