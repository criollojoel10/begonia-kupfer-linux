+	*pu2Rx1Num = (uint16_t)(pu4Buf[3] >> 16); \
+	kalMemCopy(au2Rx0Len, &pu4Buf[4], 8); \
+	kalMemCopy(au2Rx1Len, &pu4Buf[12], 8); \
+}
