+	       u4Type, ucAddr[0], ucAddr[1], ucAddr[2], ucAddr[3],
+	       ucAddr[4], ucAddr[5]);
+
+#if 1
+	rRfATInfo.u4FuncIndex = u4Type;
+	memcpy(&rRfATInfo.u4FuncData, ucAddr, 4);
+
+	i4Status = kalIoctl(prGlueInfo,	/* prGlueInfo */
+			    wlanoidRftestSetAutoTest,	/* pfnOidHandler */
