+	uint8_t ucBssIndex = 0;
+
+	do {
+		prMgmtTxMsg = (struct MSG_MGMT_TX_REQUEST *)prMsgHdr;
+
+		ucBssIndex = prMgmtTxMsg->ucBssIdx;
+
+		prAisFsmInfo = aisGetAisFsmInfo(prAdapter, ucBssIndex);
