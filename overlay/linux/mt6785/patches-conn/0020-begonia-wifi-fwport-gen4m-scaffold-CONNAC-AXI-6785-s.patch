+/*----------------------------------------------------------------------------*/
+void wlanoidClearTimeoutCheck(IN struct ADAPTER *prAdapter)
+{
+	ASSERT(prAdapter);
+
+	cnmTimerStopTimer(prAdapter, &(prAdapter->rOidTimeoutTimer));
+}
