+				    UMAC_PG_PLE_GROUP_6);
+
+
+	pUmacStat2Get->u2PleTotalPageNum =
+		halUmacPbufCtrlTotalPageNum(prAdapter,
+					    UMAC_PLE_CFG_POOL_INDEX);
+
+	pUmacStat2Get->u2PseTotalPageNum =
