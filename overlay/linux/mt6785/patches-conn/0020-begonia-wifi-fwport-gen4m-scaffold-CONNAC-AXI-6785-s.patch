+static uint8_t *apucTxResultStr[TX_RESULT_NUM] = {
+	(uint8_t *) DISP_STRING("SUCCESS"),		/* success */
+	(uint8_t *) DISP_STRING("LIFE_TO"),		/* life timeout */
