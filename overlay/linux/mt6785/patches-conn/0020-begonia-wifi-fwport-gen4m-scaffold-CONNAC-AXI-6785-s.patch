+
+		if (prAisFsmInfo == NULL)
+			break;
+
+		u2PktLen =
+		    (uint16_t) OFFSET_OF(struct _ACTION_VENDOR_SPEC_FRAME_T,
+					 aucElemInfo[0]) +
+		    prNchoInfo->rParamActionFrame.i4len + MAC_TX_RESERVED_FIELD;
