+#define CONNAC2X_TX_DESC_TXD_UTXB_AMSDU_MASK             BIT(23)
+#define CONNAC2X_TX_DESC_TXD_UTXB_AMSDU_OFFSET           23
+
+#define CONNAC2X_TX_DESC_OWN_MAC_MASK                    BITS(24, 29)
+#define CONNAC2X_TX_DESC_OWN_MAC_OFFSET                  24
