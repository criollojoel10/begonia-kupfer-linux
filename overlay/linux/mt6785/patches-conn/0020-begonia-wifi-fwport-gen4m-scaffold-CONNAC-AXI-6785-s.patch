+void dumpSTA(struct ADAPTER *prAdapter, struct STA_RECORD *prStaRec)
+{
+	uint8_t ucWTEntry;
+	uint32_t i;
+	struct BSS_INFO *prBssInfo;
+
+	DEBUGFUNC("dumpSTA");
+
+	ASSERT(prStaRec);
+	ucWTEntry = prStaRec->ucWlanIndex;
+
+	prBssInfo = GET_BSS_INFO_BY_INDEX(prAdapter, prStaRec->ucBssIndex);
+	ASSERT(prBssInfo);
