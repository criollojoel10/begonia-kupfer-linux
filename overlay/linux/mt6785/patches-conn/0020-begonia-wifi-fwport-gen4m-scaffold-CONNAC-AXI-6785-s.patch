+#define DBDC_FSM_MSG_WRONG_EVT(_eEvent) \
+	log_dbg(CNM, WARN, \
+		"[DBDC] Should not reveice evt %u during state %u\n", \
+		_eEvent, \
+		g_rDbdcInfo.eDbdcFsmCurrState)
