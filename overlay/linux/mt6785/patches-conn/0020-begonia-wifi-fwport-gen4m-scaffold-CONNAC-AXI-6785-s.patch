+				   FALSE,	/* fgRead */
+				   FALSE,	/* fgWaitResp */
+				   TRUE,	/* fgCmd */
+				   &u4BufLen);	/* pu4QryInfoLen */
+	}
+
+	DBGLOG(RFTEST, INFO, "QA_AGENT HQA_CapWiFiSpectrum Wait!!!!!!!!!!!!\n");
+	return 1;
+}
