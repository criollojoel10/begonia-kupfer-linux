+		}
+	} else {
+		if (((rCmdKey.aucPeerAddr[0] & rCmdKey.aucPeerAddr[1] &
+			rCmdKey.aucPeerAddr[2] & rCmdKey.aucPeerAddr[3] &
+			rCmdKey.aucPeerAddr[4] &
+			rCmdKey.aucPeerAddr[5]) == 0xFF) ||
