+	/* 4 <2> Update information of OID */
+	if (prCmdInfo->fgIsOid) {
+		prGlueInfo = prAdapter->prGlueInfo;
+		prCmdAccessReg = (struct CMD_ACCESS_REG *) (pucEventBuf);
