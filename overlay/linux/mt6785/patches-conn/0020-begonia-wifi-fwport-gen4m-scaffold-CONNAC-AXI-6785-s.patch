+
+	GLUE_SPIN_LOCK_DECLARATION();
+
+	ASSERT(data);
+
+	u4CopySize =
+		(count < (sizeof(acBuf) - 1)) ? count : (sizeof(acBuf) - 1);
+	copy_from_user(acBuf, buffer, u4CopySize);
+	acBuf[u4CopySize] = '\0';
+
+	rv = kstrtoint(acBuf, 0, &u4ClearCounter);
