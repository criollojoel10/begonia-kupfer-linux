+{\
+	kalMemCopy(pucTA, &(_prHwRxVector)->aucTA[0], 6); \
+}
+
+#define HAL_RX_VECTOR_GET_SEQ_NO(_prHwRxVector) \
+	((_prHwRxVector)->ucRxVtSeqNo & RX_STATUS_RXV_SEQ_NO_MASK)
