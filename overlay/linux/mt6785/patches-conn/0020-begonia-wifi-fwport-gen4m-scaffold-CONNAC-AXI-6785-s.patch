+				 pucStartAddr[1], pucStartAddr[2],
+				 pucStartAddr[3], pucStartAddr[4],
+				 pucStartAddr[5], pucStartAddr[6],
+				 pucStartAddr[7], pucStartAddr[8]);
+				break;
+			case 10:
+				LOG_FUNC
+				(case10,
