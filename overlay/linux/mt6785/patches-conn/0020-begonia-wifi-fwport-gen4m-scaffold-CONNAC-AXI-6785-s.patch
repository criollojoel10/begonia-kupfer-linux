+				 struct HQA_CMD_FRAME *HqaCmdFrame)
+{
+	uint32_t u4Index, u4WfSel, u4Offset, u4Length, u4Value;
+	int32_t i4Status = 0;
+	uint32_t u4BufLen = 0;
+	struct GLUE_INFO *prGlueInfo = NULL;
