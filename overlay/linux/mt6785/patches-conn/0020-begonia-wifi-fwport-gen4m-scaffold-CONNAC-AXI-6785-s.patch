+/*----------------------------------------------------------------------------*/
+static int nvram_read(char *filename, char *buf,
+		      ssize_t len, int offset)
+{
+#if CFG_SUPPORT_NVRAM
+	struct file *fd;
+	int retLen = -1;
+#if KERNEL_VERSION(4, 4, 0) <= LINUX_VERSION_CODE
+	loff_t pos;
+	char __user *p;
+#endif
+
+	mm_segment_t old_fs = get_fs();
+
+	set_fs(KERNEL_DS);
+
+	fd = filp_open(filename, O_RDONLY, 0644);
+
+	if (IS_ERR(fd)) {
+		DBGLOG(INIT, INFO, "[nvram_read] : failed to open!!\n");
+		set_fs(old_fs);
+		return -1;
+	}
+
+	do {
+		if (fd->f_op == NULL) {
+			DBGLOG(INIT, INFO, "[nvram_read] : f_op is NULL!!\n");
+			break;
+		}
+
+		if (fd->f_pos != offset) {
+			if (fd->f_op->llseek) {
+				if (fd->f_op->llseek(fd, offset, 0) != offset) {
+					DBGLOG(INIT, INFO,
+					       "[nvram_read] : failed to seek!!\n");
+					break;
+				}
+			} else {
+				fd->f_pos = offset;
+			}
+		}
+
+#if KERNEL_VERSION(4, 4, 0) <= LINUX_VERSION_CODE
+		p = (__force char __user *)buf;
+		pos = (loff_t)offset;
+
+		retLen = __vfs_read(fd, p, len, &pos);
+#else
+		retLen = fd->f_op->read(fd, buf, len, &fd->f_pos);
+#endif
+		if (retLen < 0)
+			DBGLOG(INIT, ERROR,
+			       "[nvram_read] : read failed!! Error code: %d\n",
+			       retLen);
+	} while (FALSE);
+
+	filp_close(fd, NULL);
+
+	set_fs(old_fs);
+
+	return retLen;
+
+#else /* !CFG_SUPPORT_NVRAM */
+
+	return -EIO;
+
+#endif
+}
