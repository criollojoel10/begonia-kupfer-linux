+		"ucHwBssIdNum: %d, ucWtblEntryNum: %d, ucWmmSetNum: %d.\n",
+			prMacCap->ucHwBssIdNum,
+			prMacCap->ucWtblEntryNum,
+			prMacCap->ucWmmSet);
