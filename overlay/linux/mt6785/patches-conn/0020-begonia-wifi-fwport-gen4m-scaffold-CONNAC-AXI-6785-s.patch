+void asicPdmaHifReset(IN struct ADAPTER *prAdapter,
+		      IN u_int8_t bRelease)
+{
+	uint32_t u4Value;
+
+	HAL_MCR_RD(prAdapter, PDMA_HIF_RESET, &u4Value);
