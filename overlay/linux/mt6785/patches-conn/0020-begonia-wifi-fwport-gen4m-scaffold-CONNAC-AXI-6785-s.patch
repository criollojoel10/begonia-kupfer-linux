+	DBGLOG(SW4, INFO,
+	       "ProtectMode HT[%u] ERP[%u], OperationMode GF[%u] RIFS[%u]\n",
+	       prBssInfo->eHtProtectMode, prBssInfo->fgErpProtectMode,
