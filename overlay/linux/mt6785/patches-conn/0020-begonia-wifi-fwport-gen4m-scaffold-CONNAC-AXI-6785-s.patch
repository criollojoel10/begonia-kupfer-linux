+#define CONNAC2X_TX_DESC_HEADER_PADDING_LENGTH_OFFSET    18
+#define CONNAC2X_TX_DESC_HEADER_PADDING_MODE             BIT(19)
+
+#define CONNAC2X_TX_DESC_TID_MASK                        BITS(20, 22)
