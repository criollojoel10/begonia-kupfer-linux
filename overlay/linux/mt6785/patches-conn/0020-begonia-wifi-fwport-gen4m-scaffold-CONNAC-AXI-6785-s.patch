+	for (i = 0; i < WAKE_MAX_CMD_EVENT_NUM; i++) {
+		if ((gprWakeInfoStatics->arEvent[i].ucFlagIsUesd == TRUE)
+		&&
+		(gprWakeInfoStatics->arEvent[i].ucEventId == ucEventId)) {
+			/*old item ++*/
+			gprWakeInfoStatics->arEvent[i].u2Cnt++;
+			gprWakeInfoStatics->u4TotalEvent++;
+			break;
+		}
+	}
