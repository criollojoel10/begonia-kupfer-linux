+/*----------------------------------------------------------------------------*/
+static int
+wext_set_mlme(IN struct net_device *prNetDev,
+	      IN struct iw_request_info *prIwrInfo,
+	      IN struct iw_point *prData, IN char *pcExtra)
+{
+	struct iw_mlme *prMlme = NULL;
+
+	struct GLUE_INFO *prGlueInfo = NULL;
