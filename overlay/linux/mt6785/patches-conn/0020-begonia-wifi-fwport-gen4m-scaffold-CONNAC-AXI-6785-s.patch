+void
+p2pFunClearAllTxReq(IN struct ADAPTER *prAdapter,
+		IN struct P2P_MGMT_TX_REQ_INFO *prP2pMgmtTxInfo)
+{
+	struct P2P_OFF_CHNL_TX_REQ_INFO *prOffChnlTxPkt =
