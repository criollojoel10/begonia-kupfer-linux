+	LR_TDLS_FME_FIELD_FILL(TDLS_FME_MAC_ADDR_LEN);
+	*(uint16_t *) pPkt = htons(TDLS_FRM_PROT_TYPE);
+	LR_TDLS_FME_FIELD_FILL(2);
