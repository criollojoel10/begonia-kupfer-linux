+struct BSS_INFO *aisGetConnectedBssInfo(
+	IN struct ADAPTER *prAdapter) {
+
+	struct BSS_INFO *prBssInfo;
+	uint8_t i;
+
+	if (!prAdapter)
+		return NULL;
+
+	for (i = 0; i < prAdapter->ucHwBssIdNum; i++) {
+		prBssInfo = prAdapter->aprBssInfo[i];
