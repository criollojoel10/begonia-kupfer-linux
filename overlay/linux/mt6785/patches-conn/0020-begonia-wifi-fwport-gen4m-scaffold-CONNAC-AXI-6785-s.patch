+	/* 4. Update packet length */
+	prMsduInfo->len = u4PktLen;
+
+	/* 5. send the data frame */
+	wlanHardStartXmit(prMsduInfo, prMsduInfo->dev);
+
+	return TDLS_STATUS_PENDING;
+}
