+		&g_rDbdcInfo.rDbdcGuardTimer);
+
+	for (ucWmmIndex = 0; ucWmmIndex < prAdapter->ucWmmSetNum;
+		ucWmmIndex++) {
+		prWmmQuotaCtrl = &(g_arWmmQuotaControl[ucWmmIndex]);
+		cnmTimerStopTimer(prAdapter, &(prWmmQuotaCtrl->rTimer));
+	}
+}	/* end of cnmUninit()*/
