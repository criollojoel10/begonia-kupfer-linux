+};
+
+struct PATCH_SEC_MAP {
+	uint32_t section_type;
+	uint32_t section_offset;
+	uint32_t section_size;
+	union {
+		uint32_t section_spec[13];
+		struct {
+			uint32_t dl_addr;
+			uint32_t dl_size;
+			uint32_t sec_key_idx;
+			uint32_t align_len;
+			uint32_t reserved[9];
+		} bin_info_spec;
+	};
+};
+
+struct patch_dl_buf {
