+				    UMAC_PG_HIF0_GROUP_0);
+
+	pUmacStat2Get->u2PseSrvPgHif1Group1 =
+		halUmacWrapSrcPgCnt(prAdapter, UMAC_PSE_CFG_POOL_INDEX,
+				    UMAC_PG_HIF1_GROUP_1);
+
+	pUmacStat2Get->u2PseSrvPgCpuGroup2 =
+		halUmacWrapSrcPgCnt(prAdapter, UMAC_PSE_CFG_POOL_INDEX,
+				    UMAC_PG_CPU_GROUP_2);
+
+	pUmacStat2Get->u2PseSrvPgLmac0Group3 =
