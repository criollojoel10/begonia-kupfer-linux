+/*! \file   cmm_asic_connac2x.c
+*    \brief  Internal driver stack will export the required procedures here for
+* GLUE Layer.
+*
+*    This file contains all routines which are exported from MediaTek 802.11
+* Wireless
+*    LAN driver stack to GLUE Layer.
+*/
