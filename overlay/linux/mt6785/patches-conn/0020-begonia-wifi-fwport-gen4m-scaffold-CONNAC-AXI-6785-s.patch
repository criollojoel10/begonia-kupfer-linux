+/*----------------------------------------------------------------------------*/
+/*!
+ *
+ * \brief This routine is called to start the 802.11w sa query.
+ *
+ *
+ * \note
+ *      Called by: AIS module, Handle Rx mgmt request
+ */
+/*----------------------------------------------------------------------------*/
+void rsnStartSaQuery(IN struct ADAPTER *prAdapter,
+	IN uint8_t ucBssIdx)
