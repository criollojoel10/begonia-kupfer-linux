+#define WF_WFDMA_HOST_DMA1_WPDMA_RX_RING3_BKRS_CTRL2_pld_ring_empty_ADDR       \
+	WF_WFDMA_HOST_DMA1_WPDMA_RX_RING3_BKRS_CTRL2_ADDR
