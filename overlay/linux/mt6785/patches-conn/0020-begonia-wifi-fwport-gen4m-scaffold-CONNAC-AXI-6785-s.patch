+void fillTxDescAppendByCR4(IN struct ADAPTER *prAdapter,
+	IN struct MSDU_INFO *prMsduInfo, IN uint16_t u4MsduId,
+	IN phys_addr_t rDmaAddr, IN uint32_t u4Idx,
+	IN u_int8_t fgIsLast,
