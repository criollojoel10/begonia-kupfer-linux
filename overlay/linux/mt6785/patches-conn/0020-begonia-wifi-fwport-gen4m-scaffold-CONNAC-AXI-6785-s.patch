+void nicEventRddSendPulse(IN struct ADAPTER *prAdapter,
+			  IN struct WIFI_EVENT *prEvent)
+{
+	DBGLOG(RLM, INFO, "%s: EVENT_ID_RDD_SEND_PULSE\n",
+	       __func__);
+
+	nicEventRddPulseDump(prAdapter, prEvent->aucBuffer);
+}
