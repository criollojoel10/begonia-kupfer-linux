+	rCmdSer.ucDbdcIdx = ucDbdcIdx;
+
+	rStatus = wlanSendSetQueryExtCmd(prAdapter,
+					 CMD_ID_LAYER_0_EXT_MAGIC_NUM,
+					 EXT_CMD_ID_SER,
+					 TRUE,
+					 FALSE,
+					 TRUE,
+					 NULL,
+					 nicOidCmdTimeoutCommon,
+					 sizeof(struct EXT_CMD_SER_T),
+					 (uint8_t *)&rCmdSer, NULL, 0);
+	return rStatus;
+}
