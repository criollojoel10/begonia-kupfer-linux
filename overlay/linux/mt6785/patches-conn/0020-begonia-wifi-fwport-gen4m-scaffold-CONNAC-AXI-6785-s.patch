+/*----------------------------------------------------------------------------*/
+/*!
+ * \brief
+ *
+ * @param prAdapter      Pointer to the Adapter structure.
+ *
+ * @retval
+ */
+/*----------------------------------------------------------------------------*/
+u_int8_t nicTxIsMgmtResourceEnough(IN struct ADAPTER
+				   *prAdapter)
+{
+	if (nicTxGetFreeCmdCount(prAdapter) >
+	    (CFG_TX_MAX_CMD_PKT_NUM / 2))
+		return TRUE;
+	else
+		return FALSE;
+}
