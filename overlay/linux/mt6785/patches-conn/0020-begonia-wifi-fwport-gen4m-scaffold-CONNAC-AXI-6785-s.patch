+	if (prMsduInfo == NULL)
+		return TDLS_STATUS_RESOURCES;
+
+	prMsduInfo->dev = wlanGetNetDev(prGlueInfo,
+		prStaRec->ucBssIndex);
+	if (prMsduInfo->dev == NULL) {
+		kalPacketFree(prGlueInfo, prMsduInfo);
+		return TDLS_STATUS_FAIL;
+	}
+
+	/* make up frame content */
+	/* 1. 802.3 header */
