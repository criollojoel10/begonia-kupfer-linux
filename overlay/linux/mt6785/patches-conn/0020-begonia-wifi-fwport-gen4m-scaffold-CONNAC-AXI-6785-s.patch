+void wmmRunEventTSOperate(IN struct ADAPTER *prAdapter,
+			  IN struct MSG_HDR *prMsgHdr)
+{
+	struct MSG_TS_OPERATE *prMsgTsOperate =
+		(struct MSG_TS_OPERATE *)prMsgHdr;
