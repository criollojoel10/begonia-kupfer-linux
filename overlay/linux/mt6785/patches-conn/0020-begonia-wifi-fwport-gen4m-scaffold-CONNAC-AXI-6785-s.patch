+		    rCmdKey.aucPeerAddr[2] | rCmdKey.aucPeerAddr[3] |
+		    rCmdKey.aucPeerAddr[4] | rCmdKey.aucPeerAddr[5]) == 0x00)) {
+			rCmdKey.ucWlanIndex = 255;	/* GC WEP ? */
+			ASSERT(FALSE);
+		} else {
+			if (prStaRec) {	/* GC Rx RSN Group key */
+				rCmdKey.ucWlanIndex =
