+	if (i >= WAKE_MAX_CMD_EVENT_NUM) {
+		/*add new item*/
+		for (j = 0; j < WAKE_MAX_CMD_EVENT_NUM; j++) {
+			if (gprWakeInfoStatics->arEvent[j].ucFlagIsUesd
+				!= TRUE) {
+				gprWakeInfoStatics->ucEventCnt++;
