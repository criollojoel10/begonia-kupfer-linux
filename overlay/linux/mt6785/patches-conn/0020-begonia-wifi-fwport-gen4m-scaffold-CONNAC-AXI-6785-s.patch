+uint32_t wlanCfgGetTotalCfgNum(
+	IN struct ADAPTER *prAdapter, uint32_t flag)
+{
+	uint32_t i = 0;
+	struct WLAN_CFG_ENTRY *prWlanCfgEntry;
+	uint32_t count = 0;
