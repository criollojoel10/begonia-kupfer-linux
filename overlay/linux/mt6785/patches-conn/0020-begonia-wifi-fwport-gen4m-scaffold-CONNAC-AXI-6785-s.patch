+#define TXD_LEN_AL              BIT(15)     /* A-MSDU last */
+#define TXD_LEN_ML              BIT(14)     /* MSDU last */
+#define TXD_LEN_ML_V2           BIT(15)     /* MSDU last */
+#define TXD_LEN_MASK_V2         BITS(0, 11)
