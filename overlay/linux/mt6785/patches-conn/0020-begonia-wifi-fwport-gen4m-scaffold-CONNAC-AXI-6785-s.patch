+		kalMemFree(prHwMibInfo, VIR_MEM_TYPE,
+			   sizeof(struct PARAM_HW_MIB_INFO));
+		return -1;
+	}
+
+	if (prHwMibInfo->u4Index < 2) {
+		i4BytesWritten = kalSnprintf(pcCommand, i4TotalLen, "%s",
