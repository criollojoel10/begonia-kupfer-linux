+	if (GLUE_CHK_PR2(prNetDev, prRts) == FALSE)
+		return -EINVAL;
+	prGlueInfo = *((struct GLUE_INFO **) netdev_priv(prNetDev));
+
+	rStatus = kalIoctl(prGlueInfo, wlanoidQueryRtsThreshold, &u4RtsThresh,
