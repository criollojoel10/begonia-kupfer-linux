+					 OFFSET_OF(struct IE_SSID,
+						aucSSID) + prSsid->ucLength -
+						WLAN_MAC_MGMT_HEADER_LEN,
+					 (uint8_t *) ((unsigned long) (prBeacon)
+						+ WLAN_MAC_MGMT_HEADER_LEN));
+		}
+	}
+#endif
+
+	if (fgGenErrMsg == TRUE)
+		cnmMemFree(prAdapter, prBeacon);
+#endif
+	return WLAN_STATUS_SUCCESS;
+}
