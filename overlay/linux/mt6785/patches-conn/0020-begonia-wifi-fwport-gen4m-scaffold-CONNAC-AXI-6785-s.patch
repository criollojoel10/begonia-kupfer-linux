+	if (prStaRec) {
+
+		/* Todo:: */
+		if (prMsduInfo->fgIs802_1x)
+			return TRUE;
+
+		if (prStaRec->fgPortBlock == TRUE) {
+			DBGLOG(INIT, TRACE,
+			       "Drop Tx packet due Port Control!\n");
