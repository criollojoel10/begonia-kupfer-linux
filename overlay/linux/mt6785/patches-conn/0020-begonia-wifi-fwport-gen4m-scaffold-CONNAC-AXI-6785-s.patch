+	i4BytesWritten += kalSnprintf(pcCommand + i4BytesWritten,
+				      i4TotalLen - i4BytesWritten,
+				      "ACL Policy = %d, Total ACLs = %d\n",
+				      prBssInfo->rACL.ePolicy,
+				      prBssInfo->rACL.u4Num);
