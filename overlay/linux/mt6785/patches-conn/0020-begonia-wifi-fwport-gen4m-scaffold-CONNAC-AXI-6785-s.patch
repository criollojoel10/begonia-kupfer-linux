+void swCrDebugQueryTimeout(IN struct ADAPTER *prAdapter,
+			   IN struct CMD_INFO *prCmdInfo)
+{
+	ASSERT(prAdapter);
+
+	swCrDebugCheck(prAdapter, NULL);
+}
