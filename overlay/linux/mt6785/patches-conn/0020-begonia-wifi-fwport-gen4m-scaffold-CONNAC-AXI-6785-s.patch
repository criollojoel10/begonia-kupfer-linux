+/*----------------------------------------------------------------------------*/
+/*!
+ * \brief To update the checksum offload status to the packet to be indicated to
+ *        OS.
+ *
+ * \param[in] pvPacket Pointer to the packet descriptor.
+ * \param[in] pucFlag  Points to the offload related parameter.
