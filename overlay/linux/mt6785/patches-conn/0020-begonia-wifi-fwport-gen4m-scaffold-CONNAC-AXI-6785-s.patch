+
+	uint8_t aucStoredKey[64];
+
+	u_int8_t fgAllowOnly1x;
+};
+#endif
+
+#define MAX_NUM_CONCURRENT_FRAGMENTED_MSDUS	3
+
+#define UPDATE_BSS_RSSI_INTERVAL_SEC		3	/* Seconds */
+
