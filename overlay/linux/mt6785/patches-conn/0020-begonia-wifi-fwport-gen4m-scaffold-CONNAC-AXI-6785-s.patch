+/*! \file   rsn.h
+ *  \brief  The wpa/rsn related define, macro and structure are described here.
+ */
+
+#ifndef _RSN_H
+#define _RSN_H
+
+/*******************************************************************************
+ *                         C O M P I L E R   F L A G S
