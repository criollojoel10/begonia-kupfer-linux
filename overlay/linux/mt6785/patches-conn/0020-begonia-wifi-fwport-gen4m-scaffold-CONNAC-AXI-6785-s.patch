+	if (RLM_NET_IS_11N(prBssInfo) &&
+	    (ucPhyTypeSet & PHY_TYPE_SET_802_11N) &&
+		(!prBssInfo->fgIsWepCipherGroup))
+		rlmFillHtCapIE(prAdapter, prBssInfo, prMsduInfo);
