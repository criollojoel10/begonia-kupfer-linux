+
+		i4Status = kalIoctl(prGlueInfo, wlanoidQueryMcrRead,
+				    &rMcrInfo, sizeof(rMcrInfo),
+				    TRUE, TRUE, TRUE, &u4BufLen);
+
+		if (i4Status == 0) {
+			u4Value = rMcrInfo.u4McrData;
+
