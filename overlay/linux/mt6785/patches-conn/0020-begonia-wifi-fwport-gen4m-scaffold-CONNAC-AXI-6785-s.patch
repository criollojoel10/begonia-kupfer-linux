+	u4Ext_id = ntohl(u4Ext_id);
+	memcpy(HqaCmdFrame->Data + 2, (uint8_t *) &u4Ext_id,
+	       sizeof(u4Ext_id));
+	ResponseToQA(HqaCmdFrame, prIwReqData, 6, i4Ret);
+
+	return i4Ret;
+}
