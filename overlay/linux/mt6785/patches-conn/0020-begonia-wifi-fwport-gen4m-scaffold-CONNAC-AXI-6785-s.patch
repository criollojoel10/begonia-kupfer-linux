+			    && (prAdapter->rWifiVar.rConnSettings.eEncStatus ==
+				ENUM_ENCRYPTION1_ENABLED)) {
+				DBGLOG(INIT, TRACE,
+				       "Drop Tx packet due the key is removed!!!\n");
+				return FALSE;
+			}
+		}
+	}
+
+	return TRUE;
+}
