+void p2pFuncGenerateP2p_IEForBeacon(IN struct ADAPTER *prAdapter,
+		IN struct MSDU_INFO *prMsduInfo)
+{
+	struct P2P_SPECIFIC_BSS_INFO *prP2pSpeBssInfo =
+		(struct P2P_SPECIFIC_BSS_INFO *) NULL;
+	uint8_t *pucIEBuf = (uint8_t *) NULL;
