+	 * Required Alignment 2 bytes
+	 */
+	uint16_t u2VhtKnown;
+	uint8_t ucVhtFlags;
+	uint8_t ucVhtBandwidth;
+	uint8_t aucVhtMcsNss[4];
+	uint8_t ucVhtCoding;
+	uint8_t ucVhtGroupId;
