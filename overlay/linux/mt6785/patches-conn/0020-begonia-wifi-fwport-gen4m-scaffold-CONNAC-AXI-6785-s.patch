+ */
+/*----------------------------------------------------------------------------*/
+u_int8_t kalCancelTimer(IN struct GLUE_INFO *prGlueInfo)
+{
+	ASSERT(prGlueInfo);
+
+	clear_bit(GLUE_FLAG_TIMEOUT_BIT, &prGlueInfo->ulFlag);
+
+	if (del_timer_sync(&(prGlueInfo->tickfn)) >= 0)
+		return TRUE;
+	else
+		return FALSE;
+}
