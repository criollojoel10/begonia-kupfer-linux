+	uint8_t aucPlatform[4];
+	uint32_t u4SwHwVersion;
+	uint32_t u4PatchVersion;
+	uint16_t u2CRC;		/* CRC calculated for image only */
+	uint8_t ucPatchImage[0];
+};
+
+struct PATCH_FORMAT_V2_T {
