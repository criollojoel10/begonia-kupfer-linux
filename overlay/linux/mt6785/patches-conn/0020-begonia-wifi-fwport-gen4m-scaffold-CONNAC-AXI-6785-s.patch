+				prTcRel[i * 4 + 1].u4Tc4RelCnt,
+				prTcRel[i * 4 + 1].u4AvailableTc4,
+				prTcRel[i * 4 + 1].u4RelCID);
+			LOG_FUNC(
+				"%d: Time %llu, Tc4Cnt %d, Free %d, CID %08x; %d: Time %llu, Tc4Cnt %d, Free %d, CID %08x\n",
+				i * 4 + 2, prTcRel[i * 4 + 2].u8RelaseTime,
