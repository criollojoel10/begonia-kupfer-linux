+/*----------------------------------------------------------------------------*/
+u_int8_t qmAdjustTcQuotas(IN struct ADAPTER *prAdapter,
+	OUT struct TX_TCQ_ADJUST *prTcqAdjust,
+	IN struct TX_TCQ_STATUS *prTcqStatus)
+{
