+
+	rlmDomainTxPwrLimitPerRateSetValues(ucVersion,
+		prTxPwrLimitPerRateCmd[KAL_BAND_2GHZ], pTxPwrLimitData);
+	rlmDomainTxPwrLimitPerRateSetValues(ucVersion,
