+	struct STA_RECORD *prStaRec;
+
+	DEBUGFUNC("joinFsmRunEventJoinTimeOut");
+
+	ASSERT(prAdapter);
+	prJoinInfo = &prAdapter->rJoinInfo;
+
+	DBGLOG(JOIN, EVENT, "JOIN EVENT: JOIN TIMEOUT\n");
