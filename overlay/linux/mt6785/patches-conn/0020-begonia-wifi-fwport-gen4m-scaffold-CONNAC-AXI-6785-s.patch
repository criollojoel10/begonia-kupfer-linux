+p2pFuncAssocRespUpdate(IN struct ADAPTER *prAdapter,
+		    IN struct BSS_INFO *prP2pBssInfo,
+		    IN uint8_t *AssocRespIE, IN uint32_t u4AssocRespLen)
+{
+	uint8_t ucOuiType = 0;
