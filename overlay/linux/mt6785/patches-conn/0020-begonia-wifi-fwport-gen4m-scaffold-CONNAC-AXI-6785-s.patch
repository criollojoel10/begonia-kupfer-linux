+int mtk_cfg80211_NLA_PUT(struct sk_buff *skb, int attrtype,
+			 int attrlen, const void *data)
+{
+	if (unlikely(nla_put(skb, attrtype, attrlen, data) < 0))
+		return 0;
+	return 1;
+}
