+/*----------------------------------------------------------------------------*/
+uint32_t aaaFsmSendEventJoinComplete(uint32_t rJoinStatus,
+		struct STA_RECORD *prStaRec, struct SW_RFB *prSwRfb)
+{
+	P_MSG_SAA_JOIN_COMP_T prJoinCompMsg;
