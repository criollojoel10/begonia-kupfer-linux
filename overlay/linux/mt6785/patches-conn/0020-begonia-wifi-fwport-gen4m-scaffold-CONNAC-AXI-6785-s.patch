+	struct sk_buff *prMsduInfo;
+	uint8_t *pPkt;
+	uint32_t u4PktLen, u4IeLen;
+
+	/* allocate/init packet */
+	prGlueInfo = (struct GLUE_INFO *) prAdapter->prGlueInfo;
+	prBssInfo = GET_BSS_INFO_BY_INDEX(prAdapter,
+		prStaRec->ucBssIndex);
