+
+/*! \file   gl_typedef.h
+ *    \brief  Definition of basic data type(os dependent).
+ *
+ *    In this file we define the basic data type.
+ */
+
+
+#ifndef _GL_TYPEDEF_H
+#define _GL_TYPEDEF_H
+
