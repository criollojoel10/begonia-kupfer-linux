+	ASSERT(prBssInfo);
+
+	rlmBssReset(prAdapter, prBssInfo);
+
+	prBssInfo->fg40mBwAllowed = FALSE;
+	prBssInfo->fgAssoc40mBwAllowed = FALSE;
