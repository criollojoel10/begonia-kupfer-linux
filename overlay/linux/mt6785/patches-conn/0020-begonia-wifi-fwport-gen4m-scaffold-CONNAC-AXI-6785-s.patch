+	if (kalIsConfigurationExist(prAdapter->prGlueInfo) == TRUE)
+		wlanLoadManufactureData(prAdapter, prRegInfo);
+	else
+		DBGLOG(INIT, WARN, "%s: load manufacture data fail\n",
+			       __func__);
