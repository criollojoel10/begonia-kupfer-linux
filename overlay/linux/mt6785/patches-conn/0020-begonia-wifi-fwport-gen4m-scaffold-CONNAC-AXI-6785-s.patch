+			prScanCancel =
+			    (struct MSG_SCN_SCAN_CANCEL *) cnmMemAlloc(prAdapter, RAM_TYPE_MSG, sizeof(struct MSG_SCN_SCAN_CANCEL));
+			if (!prScanCancel) {
+				/* Buffer not enough, can not cancel scan request. */
+				DBGLOG(BOW, TRACE, "Buffer not enough, can not cancel scan.\n");
