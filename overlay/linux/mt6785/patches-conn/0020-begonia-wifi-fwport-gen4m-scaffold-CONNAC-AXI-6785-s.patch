+					MAC2STR(prParams->
+					hs20_set_bssid_pool.
+					arBssidPool[i]));
+			}
+			rstatus = kalIoctlByBssIdx(prGlueInfo,
+			   (PFN_OID_HANDLER_FUNC) wlanoidSetHS20BssidPool,
