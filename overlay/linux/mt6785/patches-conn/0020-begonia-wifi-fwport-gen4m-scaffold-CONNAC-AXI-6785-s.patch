+static void halStartSerTimer(IN struct ADAPTER *prAdapter)
+{
+	struct GLUE_INFO *prGlueInfo;
+	struct GL_HIF_INFO *prHifInfo;
+
+	prGlueInfo = prAdapter->prGlueInfo;
