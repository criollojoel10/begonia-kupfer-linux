+
+	if (prGlueInfo->fgIsInSuspendMode == FALSE) {
+		DBGLOG(INIT, INFO, "%s: Not in suspend mode, SKIP!\n",
+		       __func__);
+		return;
+	}
+
+	prGlueInfo->fgIsInSuspendMode = FALSE;
+
