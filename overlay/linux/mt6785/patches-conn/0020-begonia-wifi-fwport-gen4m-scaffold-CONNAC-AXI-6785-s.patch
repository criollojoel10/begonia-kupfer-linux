+void heRlmReqGenerateHeHtcACtrlOM(
+	IN struct HE_A_CTRL_OM_T *prHeActrlOM,
+	OUT uint32_t *pHtc)
+{
+	uint32_t u4HTC = 0;
+
+	if (!pHtc || !prHeActrlOM) {
+		DBGLOG(RLM, WARN,
+		 "heRlmReqGenerateHeHtcACtrlOM:: Please check function parameters.\n");
