+			    FALSE,	/* fgRead */
+			    FALSE,	/* fgWaitResp */
+			    TRUE,	/* fgCmd */
+			    &u4BufLen);	/* pu4QryInfoLen */
+	if (i4Status != WLAN_STATUS_SUCCESS)
+		return -EFAULT;
+#endif
+	rRfATInfo.u4FuncIndex = u4Type | BIT(18);
+	memset(&rRfATInfo.u4FuncData, 0,
