 	return -EFAULT;
 }
 
-static const struct file_operations auto_perf_ops = {
-	.owner = THIS_MODULE,
-	.read = procAutoPerfCfgRead,
-	.write = procAutoPerfCfgWrite,
+static const KAL_FOPS auto_perf_ops = {
