+	.KAL_FOP_READ = procAutoPerfCfgRead,
+	.KAL_FOP_WRITE = procAutoPerfCfgWrite,
 };
 
 #if (CFG_SUPPORT_PRE_ON_PHY_ACTION == 1)
@@ -1260,10 +1285,10 @@ static ssize_t procCalResultWrite(struct file *file, const char __user *buffer,
 	return count;
 }
 
-static const struct file_operations cal_result_ops = {
-	.owner = THIS_MODULE,
-	.read = procCalResultRead,
-	.write = procCalResultWrite,
+static const KAL_FOPS cal_result_ops = {
+	.KAL_FOP_OWNER = KAL_FOP_OWNER_VAL,
+	.KAL_FOP_READ = procCalResultRead,
+	.KAL_FOP_WRITE = procCalResultWrite,
 };
 #endif /*(CFG_SUPPORT_PRE_ON_PHY_ACTION == 1)*/
 
@@ -1804,10 +1829,10 @@ static ssize_t cfgWrite(struct file *filp, const char __user *buf,
 	return count;
 }
 
-static const struct file_operations fwcfg_ops = {
-	.owner = THIS_MODULE,
-	.read = cfgRead,
-	.write = cfgWrite,
+static const KAL_FOPS fwcfg_ops = {
+	.KAL_FOP_OWNER = KAL_FOP_OWNER_VAL,
+	.KAL_FOP_READ = cfgRead,
+	.KAL_FOP_WRITE = cfgWrite,
 };
 
 int32_t cfgRemoveProcEntry(void)
