+/*
+ * Headless srh_patch.
+ *
+ * On stock Android the WMT_CTRL ul_cmd "srh_patch" is serviced by the userspace
+ * stp_uart_launcher daemon: it locates the SOC multi-patch (the connac MCU
+ * patch), then publishes the patch count and per-patch download descriptor into
+ * the kernel via WMT_IOCTL_SET_PATCH_NUM / WMT_IOCTL_SET_PATCH_INFO.
+ *
+ * pmOS has no such daemon, so the ul_cmd never completes and mtk_wcn_soc_sw_init
+ * aborts at "patch info perpare fail". Replay the launcher step in-kernel, using
+ * the very same pPatchInfo / pAtchNum statics + free path the ioctls use:
+ * request_firmware the MCU patch (the core re-reads it through WMT_CTRL_GET_PATCH),
+ * then set patchNum=1 and a single WMT_PATCH_INFO whose conn target address is
+ * CONNAC_PATCH_START_ADDR (0x0001C000 per begonia gen4m connac.h/connac2x2.h; the
+ * patch header u4PatchVer 0x0001c0xx corroborates this load address).
+ */
+INT32 wmt_dev_srh_patch_headless(VOID)
+{
+	static const char *patch_name = "soc1_0_patch_mcu_2a_1_hdr.bin";
+	const UINT32 connac_patch_addr = 0x0001C000;
+	osal_firmware *fw = NULL;
+
+	/* verify the patch file is present; the core re-reads it via GET_PATCH */
+	if (wmt_dev_patch_get((PUINT8)patch_name, &fw) != 0 || fw == NULL) {
+		WMT_ERR_FUNC("srh_patch(headless): get %s fail\n", patch_name);
+		return -1;
+	}
+	wmt_dev_patch_put(&fw);
+
+	if (pPatchInfo == NULL)
+		pPatchInfo = kcalloc(1, sizeof(WMT_PATCH_INFO), GFP_ATOMIC);
+	if (!pPatchInfo) {
+		WMT_ERR_FUNC("srh_patch(headless): allocate memory fail\n");
+		return -1;
+	}
+
+	pAtchNum = 1;
+	pPatchInfo[0].dowloadSeq = 1;
+	pPatchInfo[0].addRess[0] = connac_patch_addr & 0xFF;
+	pPatchInfo[0].addRess[1] = (connac_patch_addr >> 8) & 0xFF;
+	pPatchInfo[0].addRess[2] = (connac_patch_addr >> 16) & 0xFF;
+	pPatchInfo[0].addRess[3] = (connac_patch_addr >> 24) & 0xFF;
+	osal_strncpy(pPatchInfo[0].patchName, (PUINT8)patch_name,
+		     osal_sizeof(pPatchInfo[0].patchName) - 1);
+
+	wmt_lib_set_patch_num(pAtchNum);
+	wmt_lib_set_patch_info(pPatchInfo);
+	WMT_INFO_FUNC("srh_patch(headless): %s seq=1 addr=0x%x num=%u\n",
+		      patch_name, connac_patch_addr, pAtchNum);
+	return 0;
+}
