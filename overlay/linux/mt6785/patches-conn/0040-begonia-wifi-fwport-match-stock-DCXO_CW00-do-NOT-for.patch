From a26924de2defca896704602ced8afdc941f161c5 Mon Sep 17 00:00:00 2001
From: Michal Andrzejczak <mit.mis@gmail.com>
Date: Thu, 18 Jun 2026 10:28:02 +0200
Subject: [PATCH 40/51] begonia-wifi (fwport): match stock DCXO_CW00 - do NOT
 force XO_WCN SW mode

Stock dmesg shows DCXO_CW00=0x4e1d at boot and stays (EXTBUF2 MODE[4:3]=3 HW-mode,
EN_M[5]=0, preloader-set). The earlier reimpl-style force (MODE=0/EN_M=1 -> 0x4e25)
DIVERGED from stock and mis-configured the conn clock buffer. Leave DCXO untouched
to match stock; read+log only. Found via stock-vs-mainline register comparison.

Signed-off-by: Michal Andrzejczak <mit.mis@gmail.com>
---
 .../common/common_main/platform/mt6785.c      | 36 ++++++-------------
 1 file changed, 11 insertions(+), 25 deletions(-)

diff --git a/drivers/misc/mediatek/connectivity/common/common_main/platform/mt6785.c b/drivers/misc/mediatek/connectivity/common/common_main/platform/mt6785.c
index 7f5c0cd22..d11f2e6c9 100644
--- a/drivers/misc/mediatek/connectivity/common/common_main/platform/mt6785.c
+++ b/drivers/misc/mediatek/connectivity/common/common_main/platform/mt6785.c
@@ -461,40 +461,26 @@ static INT32 consys_co_clock_type(VOID)
 	return 0;
 }
 
-/* Faithful port of the MTK clkbuf driver's clk_buf_ctrl(CLK_BUF_CONN, FORCE_ON):
- * the conn subsystem's 26MHz crystal clock is the mt6359 PMIC EXTBUF2 buffer
- * ("XO_WCN"). The vendor opens it on DCXO_CW00 (clear EXTBUF2_MODE -> force/SW
- * mode, set EXTBUF2_EN_M -> enable). Mainline has no mt6359 clk-buf driver, so we
- * do the register op directly via the PMIC regmap (g_regmap, from
- * mtk_wcn_get_regmap). Without this 26MHz reference the conn cannot run its
- * BTIF/RF. Register op corroborated by the reimpl mtk_conninfra_enable_xo_wcn. */
+/* consys clock buffer (conn 26MHz XO_WCN = mt6359 PMIC EXTBUF2, DCXO_CW00).
+ * IMPORTANT (verified vs stock dmesg): on the WORKING stock kernel DCXO_CW00 reads
+ * 0x4e1d at boot and stays there - i.e. EXTBUF2 is left in HW-controlled mode
+ * (MODE[4:3]=3, EN_M[5]=0), set by the preloader; the vendor clk_buf_ctrl does NOT
+ * force it into SW/manual mode. The earlier reimpl-style "force MODE=0, EN_M=1"
+ * produced 0x4e25 - a DIVERGENCE from stock that mis-configures the conn's clock
+ * buffer. So match stock: DO NOT modify DCXO_CW00; the preloader already leaves
+ * XO_WCN HW-on (begonia is non-co-clock). Read+log only, for diff against stock. */
 #define MT6359_DCXO_CW00		0x788
-#define XO_EXTBUF2_MODE_MASK		(0x3u << 3)	/* bits [4:3] */
-#define XO_EXTBUF2_EN_M_MASK		(0x1u << 5)	/* bit 5 */
 extern struct regmap *g_regmap;			/* mt6359 PMIC regmap (consys_hw.c) */
 
 static INT32 consys_clock_buffer_ctrl(MTK_WCN_BOOL enable)
 {
 	unsigned int v = 0;
 
-	if (!g_regmap) {
-		WMT_PLAT_PR_ERR("clock_buffer_ctrl: no PMIC regmap, cannot %s XO_WCN\n",
-				enable ? "open" : "close");
-		return -1;
-	}
-
-	if (enable) {
-		/* clear EXTBUF2_MODE (force/SW mode), then set EXTBUF2_EN_M (enable) */
-		regmap_update_bits(g_regmap, MT6359_DCXO_CW00, XO_EXTBUF2_MODE_MASK, 0);
-		regmap_update_bits(g_regmap, MT6359_DCXO_CW00,
-				   XO_EXTBUF2_EN_M_MASK, XO_EXTBUF2_EN_M_MASK);
+	if (g_regmap) {
 		regmap_read(g_regmap, MT6359_DCXO_CW00, &v);
-		WMT_PLAT_PR_INFO("clock_buffer_ctrl: open XO_WCN, DCXO_CW00=0x%08x\n", v);
-	} else {
-		regmap_update_bits(g_regmap, MT6359_DCXO_CW00, XO_EXTBUF2_EN_M_MASK, 0);
-		WMT_PLAT_PR_INFO("clock_buffer_ctrl: close XO_WCN\n");
+		WMT_PLAT_PR_INFO("clock_buffer_ctrl(%s): DCXO_CW00=0x%08x (left as preloader/stock; expect 0x4e1d)\n",
+				 enable ? "on" : "off", v);
 	}
-
 	return 0;
 }
 
