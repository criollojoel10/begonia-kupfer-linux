+static INT32 mt6628_gps_sync_ctrl(WMT_IC_PIN_STATE state, UINT32 flag)
+{
+	INT32 ret = -1;
+	UINT32 uVal = 0;
+
+	if (state == WMT_IC_PIN_MUX)
+		uVal = 0x1 << 28;
+	else
+		uVal = 0x5 << 28;
+	ret = wmt_core_reg_rw_raw(1, 0x80050078, &uVal, 0x7 << 28);
+	if (ret != 0)
+		WMT_ERR_FUNC("gps_sync pin ctrl failed, ret(%d)\n", ret);
+	/* anyway, we return 0 */
+	return 0;
+}
