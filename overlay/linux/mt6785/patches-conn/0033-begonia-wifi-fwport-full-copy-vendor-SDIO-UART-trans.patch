+	stp_sdio_txperf_fifo_left = 0;
+	stp_sdio_txperf_to_send = 0;
+	stp_sdio_txperf_fifo_lmt_cnt = 0;
+
+	stp_sdio_txperf_txed_pkt_num = 0;
+	stp_sdio_txperf_pkt_num_lmt_cnt = 0;
+#endif
+
+#if STP_SDIO_TXDBG
+	stp_sdio_txdbg_cnt = 0;
+#endif
+
+	return 0;
+}
