+	    && (gp_mt6630_info->bPsmSupport != MTK_WCN_BOOL_FALSE)) {
+		wmt_lib_ps_disable();
+	}
+#endif
+
+	gp_mt6630_info = NULL;
+
+	return 0;
+}
