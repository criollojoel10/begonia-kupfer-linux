+	 .cChipVersion = WMT_IC_VER_E4,
+	 .cPatchNameExt = WMT_IC_PATCH_E2_EXT,
+	 .bWorkWithoutPatch = MTK_WCN_BOOL_FALSE,
+	 .bPsmSupport = MTK_WCN_BOOL_TRUE,
+	 }
+};
