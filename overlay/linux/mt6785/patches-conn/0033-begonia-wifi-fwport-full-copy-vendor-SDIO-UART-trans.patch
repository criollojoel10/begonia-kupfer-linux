+				0);
+#endif
+		/* 20111020: change to poll CHLPCR instead of read-cleared CHISR */
+		ret = stp_sdio_rw_retry(HIF_TYPE_READL, STP_SDIO_RETRY_LIMIT, clt_ctx, CHLPCR, &chlpcr, 0);
+		if (ret) {
+			/* 4 <1.1> get CHISR Rx error handling */
