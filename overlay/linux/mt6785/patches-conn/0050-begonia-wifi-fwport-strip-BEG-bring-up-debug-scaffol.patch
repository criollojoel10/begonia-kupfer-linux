diff --git a/drivers/misc/mediatek/connectivity/common/common_main/platform/begsnap.h b/drivers/misc/mediatek/connectivity/common/common_main/platform/begsnap.h
deleted file mode 100644
index 4a3b918dc..000000000
--- a/drivers/misc/mediatek/connectivity/common/common_main/platform/begsnap.h
+++ /dev/null
@@ -1,64 +0,0 @@
-/* BEGSNAP — self-contained conn RX-DMA / WFSYS / mailbox snapshot helper.
- * Portable (no conn_reg dependency): ioremaps the conn windows itself, so it
- * can be called from any module TU (mt6785.c platform layer AND wmt_core.c).
- * Uses raw readl (NOT hijacked) — include this WITHOUT begtrace.h's readl/writel
- * redefinition. Each line is tagged with `where` so before/after-TX snapshots
- * are distinguishable in dmesg.
- *
- * Decisive registers (all conn_infra-domain, valid while WFSYS is still dark):
- *   0x18002108  DMA-engine clock        0x18002150  bootstrap RX-DMA clock
- *   0x18002510  0x1101 command mailbox   0x180a1014  ch0 ring-ctrl ("started")
- *   0x180a1038  ch0 RX-DMA count         0x180ae000  WFSYS_ON (req/ACK)
- *   0x18000000  WF_MAC (0x42424242 = unpowered bus-poison)
- */
-#ifndef _BEGSNAP_H_
-#define _BEGSNAP_H_
-#include <linux/printk.h>
-#include <linux/io.h>
-
-static inline void begtrace_rx_snapshot(const char *where)
-{
-	void __iomem *mcu  = ioremap_nocache(0x18002000, 0x800);
-	void __iomem *dma  = ioremap_nocache(0x180a1000, 0x300);
-	void __iomem *btif = ioremap_nocache(0x180a2000, 0x100);
-	void __iomem *wfsys = ioremap_nocache(0x180ae000, 0x20);
-	void __iomem *wfmac = ioremap_nocache(0x18000000, 0x10);
-
-	pr_err("[BEGSNAP:%s] === snapshot ===\n", where);
-	if (mcu) {
-		pr_err("[BEGSNAP:%s] MCU_CFG: 108_DMAclk=%08x 150_bootclk=%08x 16c=%08x 510_mbox=%08x 514=%08x 424=%08x 440=%08x 600_COM=%08x\n",
-			where, readl(mcu+0x108), readl(mcu+0x150), readl(mcu+0x16c), readl(mcu+0x510),
-			readl(mcu+0x514), readl(mcu+0x424), readl(mcu+0x440), readl(mcu+0x600));
-		iounmap(mcu);
-	}
-	if (dma) {
-		/* Sweep ALL 8 DMA channels: base 0x180a1000 + ch*0x100.
-		 * The conn binds BTIF-RX to an unverified channel (prior traces:
-		 * fn0x3968->ch2, fn0x5dd8->ch5); watching only ch0 reads an idle channel.
-		 * Per ch: 0x00 glob/ctl, 0x14 ringctl(start), 0x18 base, 0x38 count. */
-		int ch;
-		for (ch = 0; ch < 8; ch++) {
-			u32 off = ch * 0x100;
-			pr_err("[BEGSNAP:%s] DMA ch%d (180a1%03x): 00=%08x 14_ringctl=%08x 18_base=%08x 1c=%08x 20=%08x 38_cnt=%08x\n",
-				where, ch, off, readl(dma+off+0x00), readl(dma+off+0x14), readl(dma+off+0x18),
-				readl(dma+off+0x1c), readl(dma+off+0x20), readl(dma+off+0x38));
-		}
-		iounmap(dma);
-	}
-	if (btif) {
-		pr_err("[BEGSNAP:%s] BTIF0: ctl04=%08x ier08=%08x fifo0c=%08x lsr14=%08x dmaen4c=%08x\n",
-			where, readl(btif+0x04), readl(btif+0x08), readl(btif+0x0c), readl(btif+0x14), readl(btif+0x4c));
-		iounmap(btif);
-	}
-	if (wfsys) {
-		pr_err("[BEGSNAP:%s] WFSYS: ae000=%08x ae00c=%08x ae010=%08x\n",
-			where, readl(wfsys+0x00), readl(wfsys+0x0c), readl(wfsys+0x10));
-		iounmap(wfsys);
-	}
-	if (wfmac) {
-		pr_err("[BEGSNAP:%s] WF_MAC 18000000=%08x\n", where, readl(wfmac+0x00));
-		iounmap(wfmac);
-	}
-	pr_err("[BEGSNAP:%s] === END ===\n", where);
-}
-#endif
diff --git a/drivers/misc/mediatek/connectivity/common/common_main/platform/begtrace.h b/drivers/misc/mediatek/connectivity/common/common_main/platform/begtrace.h
deleted file mode 100644
index 1a2d47a73..000000000
--- a/drivers/misc/mediatek/connectivity/common/common_main/platform/begtrace.h
+++ /dev/null
@@ -1,35 +0,0 @@
-/* BEGTRACE shared instrumentation — #include AFTER the targets own includes */
-#ifndef _BEGTRACE_H_
-#define _BEGTRACE_H_
-#include <linux/printk.h>
-#include <linux/delay.h>
-#include <linux/io.h>
-#define ORACLE_TAG "[BEGTRACE_ORACLE]"
-static inline u32  _bt_readl(const volatile void __iomem *a){ return readl(a); }
-static inline void _bt_writel(u32 v, volatile void __iomem *a){ writel(v, a); }
-static inline void _bt_udelay(unsigned long u){ udelay(u); }
-static inline void _bt_mdelay(unsigned long m){ mdelay(m); }
-static inline void _bt_msleep(unsigned int m){ msleep(m); }
-#undef readl
-#define readl(a) ({ const volatile void __iomem *_a=(a); u32 _v=_bt_readl(_a); \
-	pr_err("%s R [0x%lx]=0x%08x\n", ORACLE_TAG, (unsigned long)_a, _v); _v; })
-#undef writel
-#define writel(v,a) do { volatile void __iomem *_a=(volatile void __iomem*)(a); u32 _v=(u32)(v); \
-	pr_err("%s W [0x%lx]<-0x%08x\n", ORACLE_TAG, (unsigned long)_a, _v); _bt_writel(_v,_a); } while(0)
-#undef udelay
-#define udelay(u) do { pr_err("%s udelay(%lu)\n", ORACLE_TAG, (unsigned long)(u)); _bt_udelay(u); } while(0)
-#undef mdelay
-#define mdelay(m) do { pr_err("%s mdelay(%lu)\n", ORACLE_TAG, (unsigned long)(m)); _bt_mdelay(m); } while(0)
-#undef msleep
-#define msleep(m) do { pr_err("%s msleep(%u)\n", ORACLE_TAG, (unsigned int)(m)); _bt_msleep(m); } while(0)
-#ifdef CONSYS_REG_WRITE
-#undef CONSYS_REG_WRITE
-#define CONSYS_REG_WRITE(a,d) do { pr_err("%s CW [0x%lx]<-0x%08x\n", ORACLE_TAG, (unsigned long)(a), (u32)(d)); \
-	_bt_writel((u32)(d),(volatile void __iomem*)(a)); } while(0)
-#endif
-#ifdef CONSYS_REG_READ
-#undef CONSYS_REG_READ
-#define CONSYS_REG_READ(a) ({ unsigned long _ca=(unsigned long)(a); u32 _cv=_bt_readl((volatile void __iomem*)_ca); \
-	pr_err("%s CR [0x%lx]=0x%08x\n", ORACLE_TAG, _ca, _cv); _cv; })
-#endif
-#endif
