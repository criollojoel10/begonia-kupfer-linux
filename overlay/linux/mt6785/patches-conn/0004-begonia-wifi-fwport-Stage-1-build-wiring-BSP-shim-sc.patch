+static unsigned char __iomem *wmt_step_get_emi_base_address(void)
+{
+	if (g_step_env.emi_base_addr == NULL) {
+		if (gConEmiPhyBase)
+			g_step_env.emi_base_addr = ioremap_nocache(gConEmiPhyBase, gConEmiSize);
+	}
+
+	return g_step_env.emi_base_addr;
+}
