+INT32 stp_dbg_log_ctrl(UINT32 on)
+{
+	if (on != 0) {
+		gStpDbgLogOut = 1;
+		pr_warn("STP-DBG: enable pkt log dump out.\n");
+	} else {
+		gStpDbgLogOut = 0;
+		pr_warn("STP-DBG: disable pkt log dump out.\n");
+	}
+
+	return 0;
+}
