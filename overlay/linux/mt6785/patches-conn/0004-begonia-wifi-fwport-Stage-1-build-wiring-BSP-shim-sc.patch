+static INT32 mtk_wcn_sys_rx_has_pending_data(VOID)
+{
+	if (g_stp_if_type == STP_BTIF_IF_TX)
+		return stp_btif_rx_has_pending_data != NULL ? (*stp_btif_rx_has_pending_data) () : -1;
+	return -1;
+}
