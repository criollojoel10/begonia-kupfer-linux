+int hal_tx_dma_irq_handler(struct _MTK_DMA_INFO_STR_ *p_dma_info);
+
+/*****************************************************************************
+ * FUNCTION
+ *  hal_dma_send_data
+ * DESCRIPTION
+ *  send data through btif in DMA mode
+ * PARAMETERS
+ *  p_dma_info   [IN]        pointer to BTIF dma channel's information
