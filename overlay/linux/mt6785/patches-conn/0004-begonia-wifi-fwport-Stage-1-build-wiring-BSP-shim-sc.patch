+INT32 wmt_core_opid_handler(P_WMT_OP pWmtOp)
+{
+	UINT32 opId;
+	INT32 ret;
+
+	opId = pWmtOp->opId;
+
+	if (wmt_core_opfunc[opId]) {
+		ret = (*(wmt_core_opfunc[opId])) (pWmtOp);	/*wmtCoreOpidHandlerPack[].opHandler */
+		return ret;
+	}
+	WMT_ERR_FUNC("WMT-CORE: null handler (%d)\n", pWmtOp->opId);
+	return -2;
+}
