+int hal_dma_get_ava_room(struct _MTK_DMA_INFO_STR_ *p_dma_info);
+
+/*****************************************************************************
+ * FUNCTION
+ *  hal_dma_is_tx_allow
+ * DESCRIPTION
+ *  is tx operation allowed by DMA
