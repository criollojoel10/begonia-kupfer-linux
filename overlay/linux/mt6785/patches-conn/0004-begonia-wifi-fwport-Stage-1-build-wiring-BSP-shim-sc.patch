+	defined(CONFIG_MACH_MT6873) || \
+	defined(CONFIG_MACH_ELBRUS) || \
+	defined(CONFIG_MACH_MT6893)
+#define CONNADP_HAS_CLOCK_BUF_CTRL
+#define KERNEL_CLK_BUF_CHIP_NOT_SUPPORT -7788
