+INT32 mtk_wcn_sys_if_rx(PUINT8 data, INT32 size)
+{
+	if (stp_if_rx == 0x0)
+		return -1;
+	(*stp_if_rx)(data, size);
+	return 0;
+}
+
+static INT32 mtk_wcn_sys_if_tx(const PUINT8 data, const UINT32 size, PUINT32 written_size)
+{
+	if (data) print_hex_dump(KERN_ERR, "[BEGTRACE_TX] ", DUMP_PREFIX_NONE, 16, 1, data, (size <= 48 ? size : 48), false);
+	pr_err("[BEGTRACE_TX] sys_if_tx if=%d size=%u\n", g_stp_if_type, size);
+	{
+		static void __iomem *cb, *cd, *cm;
+		static int frm;
+		if (frm < 40) {
+			if (!cb) cb = ioremap(0x180a2000u, 0x1000);
+			if (!cd) cd = ioremap(0x180a1000u, 0x1000);
+			if (!cm) cm = ioremap(0x18002000u, 0x1000);
+			if (cb && cd && cm)
+				pr_err("[BEGTRACE_CONN] f%d sz=%u: BTIF0 e4=%08x DR_lsr=%08x dmaen=%08x | ring1038=%08x | COM600=%08x mbox510=%08x\n",
+					frm, size, readl(cb+0xe4), readl(cb+0x14), readl(cb+0x4c), readl(cd+0x38), readl(cm+0x600), readl(cm+0x510));
+			if (frm < 6) {
+				static void __iomem *hif;
+				u32 isr=0, recv=0, disp=0, task=0, emi=0, pcmax=0, i, pc;
+				if (!hif) hif = ioremap(0x18007000u, 0x1000);
+				if (hif) {
+					for (i = 0; i < 4000; i++) {
+						pc = readl(hif + 0x104);
+						if (pc > pcmax) pcmax = pc;
+						if ((pc & 0xf0000000u) == 0xf0000000u) emi++;
+						if (pc >= 0xf0002600u && pc <= 0xf0002800u) isr++;
+						if ((pc >= 0xf0008a00u && pc <= 0xf0008c00u) || (pc >= 0x0000e130u && pc <= 0x0000e160u)) recv++;
+						if (pc >= 0x00006a00u && pc <= 0x00006d00u) disp++;
+						if (pc >= 0x000021b0u && pc <= 0x00002290u) task++;
+					}
+					pr_err("[BEGTRACE_PC] f%d: ISR=%u RECV=%u STPdisp=%u task=%u EMI=%u maxPC=%08x\n", frm, isr, recv, disp, task, emi, pcmax);
+				}
+			}
+			frm++;
+		}
+	}
+	if (g_stp_if_type == STP_UART_IF_TX)
+		return stp_uart_if_tx != NULL ? (*stp_uart_if_tx)(data, size, written_size) : -1;
+	else if (g_stp_if_type == STP_SDIO_IF_TX)
+		return stp_sdio_if_tx != NULL ? (*stp_sdio_if_tx)(data, size, written_size) : -1;
+	else if (g_stp_if_type == STP_BTIF_IF_TX)
+		return stp_btif_if_tx != NULL ? (*stp_btif_if_tx) (data, size, written_size) : -1;
+	/*if (g_stp_if_type >= STP_MAX_IF_TX) *//* George: remove ALWAYS TRUE condition */
+	return -1;
+}
