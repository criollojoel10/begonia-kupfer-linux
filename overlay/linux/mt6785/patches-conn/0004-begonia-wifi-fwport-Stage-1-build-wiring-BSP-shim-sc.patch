+	p_cond_reg_act = kzalloc(sizeof(struct step_condition_register_action), GFP_KERNEL);
+	if (p_cond_reg_act == NULL) {
+		WMT_ERR_FUNC("STEP failed: kzalloc condition register fail\n");
