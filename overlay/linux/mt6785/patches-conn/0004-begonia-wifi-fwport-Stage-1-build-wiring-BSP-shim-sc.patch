+		osal_memcpy(pAbuf, pPatchinfo->addRess, osal_sizeof(pPatchinfo->addRess));
+		WMT_DBG_FUNC("get 4 address bytes is 0x%2x,0x%2x,0x%2x,0x%2x", pAbuf[0], pAbuf[1],
+			     pAbuf[2], pAbuf[3]);
+	} else
+		WMT_ERR_FUNC("NULL patchinfo pointer\n");
+
+	return 0;
