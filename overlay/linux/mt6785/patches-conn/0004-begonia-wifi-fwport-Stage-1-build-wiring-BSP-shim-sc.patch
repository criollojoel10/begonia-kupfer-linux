+			WMT_WARN_FUNC("mtk_wcn_wmt_func_off(WMTDRV_TYPE_LPBK) return %d\n", ret);
+		wmt_dev_apo_ctrl(1);
+	} else {
+		/* Just set always power on flag to 0 */
+		wmt_dev_apo_ctrl(0);
+	}
+
+	return 0;
+}
