+static VOID wmt_dbg_fwinfor_print_buff(UINT32 len)
+{
+	UINT32 i = 0;
+	UINT32 idx = 0;
+
+	for (i = 0; i < len; i++) {
+		buf_emi[idx] = gEmiBuf[i];
+		if (gEmiBuf[i] == '\n') {
+			WMT_INFO_FUNC("%s", buf_emi);
+			osal_memset(buf_emi, 0, BUF_LEN_MAX);
+			idx = 0;
+		} else {
+			idx++;
+			if (idx == BUF_LEN_MAX-1) {
+				buf_emi[idx] = '\0';
+				WMT_INFO_FUNC("%s", buf_emi);
+				osal_memset(buf_emi, 0, BUF_LEN_MAX);
+				idx = 0;
+			}
+		}
+	}
+	if ((idx != 0) && (idx < BUF_LEN_MAX)) {
+		buf_emi[idx] = '\0';
+		WMT_INFO_FUNC("%s", buf_emi);
+		osal_memset(buf_emi, 0, BUF_LEN_MAX);
+		idx = 0;
+	}
+}
