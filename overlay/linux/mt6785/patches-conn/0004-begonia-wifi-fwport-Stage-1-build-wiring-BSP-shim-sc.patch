+#include <linux/platform_device.h>
+
+#ifdef DFT_TAG
+#undef DFT_TAG
+#endif
+#define DFT_TAG         "[WMT-DETECT]"
+
+#include "wmt_detect.h"
+#include "wmt_gpio.h"
