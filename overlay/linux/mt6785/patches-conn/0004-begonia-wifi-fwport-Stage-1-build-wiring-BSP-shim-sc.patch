+INT32 _osal_fifo_data_in(OSAL_FIFO *pFifo, const PVOID buf, UINT32 len)
+{
+	struct kfifo *fifo = NULL;
+	INT32 ret = 0;
+
+	if (!pFifo || !pFifo->pFifoBody) {
