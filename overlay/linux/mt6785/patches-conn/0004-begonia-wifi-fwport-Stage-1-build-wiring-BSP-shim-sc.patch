+{
+	if (!p_ops)
+		return MTK_WCN_BOOL_FALSE;
+	if ((p_ops->sw_init == NULL)
+	    || (p_ops->sw_deinit == NULL)
+	    || (p_ops->ic_ver_check == NULL)
+	    || (p_ops->ic_pin_ctrl == NULL)) {
