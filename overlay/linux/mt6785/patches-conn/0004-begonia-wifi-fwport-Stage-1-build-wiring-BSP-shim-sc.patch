+
+		i_ret = kfifo_alloc(p_btif_info->p_tx_fifo,
+				    BTIF_HAL_TX_FIFO_SIZE, GFP_ATOMIC);
+		if (i_ret != 0) {
+			BTIF_ERR_FUNC("kfifo_alloc failed, errno(%d)\n", i_ret);
