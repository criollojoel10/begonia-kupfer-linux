+#include "stp_dbg_combo.h"
+
+static _osal_inline_ INT32 stp_dbg_combo_put_dump_to_aee(VOID);
+static _osal_inline_ INT32 stp_dbg_combo_put_dump_to_nl(VOID);
+
+static PUINT8 combo_task_str[STP_DBG_TASK_ID_MAX] = {
+	"Task_WMT",
+	"Task_BT",
+	"Task_Wifi",
+	"Task_Tst",
