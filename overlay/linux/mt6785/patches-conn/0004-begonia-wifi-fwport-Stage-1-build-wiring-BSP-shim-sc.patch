+static char *wmt_step_save_params_msg(int num, char *params[], char *buf, int buf_size)
+{
+	int i, len, temp;
+
+	for (i = 0, len = 0; i < num; i++) {
+		if (params[i] == NULL)
+			break;
+
+		temp = osal_strlen(params[i]) + 1;
+
+		if ((len + temp) >= (buf_size - 1))
+			break;
+
+		len += temp;
+		osal_strncat(buf, params[i], temp);
+		osal_strncat(buf, " ", 1);
+	}
+	osal_strncat(buf, "\0", 1);
+
+	return buf;
+}
