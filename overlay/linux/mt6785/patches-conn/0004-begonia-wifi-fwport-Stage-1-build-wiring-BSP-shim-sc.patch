+		if (dmp->p_head != NULL) {
+			osal_free(dmp->p_head);
+			dmp->p_head = NULL;
+		}
+		osal_sleepable_lock_deinit(&dmp->dmp_lock);
+		osal_timer_stop(&dmp->dmp_timer);
+		osal_timer_stop(&dmp->dmp_emi_timer);
+		osal_free(dmp);
+		dmp = NULL;
+	}
+
+	return 0;
+}
