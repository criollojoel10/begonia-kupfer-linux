+P_OSAL_OP wmt_lib_get_free_op(VOID)
+{
+	P_OSAL_OP pOp = NULL;
+	P_DEV_WMT pDevWmt = &gDevWmt;
+
+	osal_assert(pDevWmt);
+	pOp = wmt_lib_get_op(&pDevWmt->rFreeOpQ);
+	if (pOp) {
+		osal_memset(pOp, 0, osal_sizeof(OSAL_OP));
+	}
+	return pOp;
+}
