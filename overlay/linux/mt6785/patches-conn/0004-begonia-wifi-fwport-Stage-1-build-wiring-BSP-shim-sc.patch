+	pRomVer = (PUINT8) (pWmtCtrlData->au4CtrlData[1]);
+	pPatch = (P_WMT_PATCH)(pWmtCtrlData->au4CtrlData[2]);
+	if (!pRomVer) {
+		WMT_ERR_FUNC("pRomVer null pointer\n");
+		return -1;
+	}
+
+	if (!pPatch) {
