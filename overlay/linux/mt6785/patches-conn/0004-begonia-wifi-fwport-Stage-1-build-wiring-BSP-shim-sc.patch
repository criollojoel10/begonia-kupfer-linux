@@ -2116,6 +2116,28 @@ static int mtk_conninfra_pda_patch_dwn(struct mtk_conninfra *c)
 		}
 	}
 
+	/* r118 CLEAN pre-TX idle read of all 8 conn DMA channels — the decisive
+	 * delivery-vs-processing disambiguation.  Read ch7 0x38 (count, WPT-RPT)
+	 * HERE (conn at idle, BEFORE any WMT/PDA frame is sent) vs the post-TX
+	 * value.  Stock idle ch7 0x38=0.  If mainline reads 0 here too but 0x258
+	 * after TX -> bytes ARRIVED in ch7's ring (delivery works) and the conn
+	 * never drained them (PROCESSING gate).  If already non-zero here -> the
+	 * post-TX value is stale and delivery re-opens. */
+	{
+		void __iomem *dm = ioremap(0x180A1000u, 0x1000);
+		int ch;
+
+		if (dm) {
+			for (ch = 0; ch < 8; ch++)
+				dev_info(c->dev,
+					 "PRETX-CH%d @idle(pre-WMT): 0x14=%08x 0x18=%08x 0x38=%08x\n",
+					 ch, readl(dm + ch * 0x100 + 0x14),
+					 readl(dm + ch * 0x100 + 0x18),
+					 readl(dm + ch * 0x100 + 0x38));
+			iounmap(dm);
+		}
+	}
+
