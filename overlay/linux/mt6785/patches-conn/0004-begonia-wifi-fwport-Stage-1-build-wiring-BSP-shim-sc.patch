+#
+
+config MTK_WMT_DRV
+	tristate "MediaTek WMT/connsys core driver (wmt_drv, vendor forward-port)"
+	default MTK_WMT_FWPORT
+	help
+	  Vendor MediaTek WMT/STP/connsys bring-up driver (wmt_drv)
