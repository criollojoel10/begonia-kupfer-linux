+UINT16 osal_crc16(const PUINT8 buffer, const UINT32 length)
+{
+	UINT16 crc = 0;
+	UINT32 i = 0;
+	PUINT8 temp = buffer;
+
+	/* FIXME: Add STP checksum feature */
+	crc = 0;
+	for (i = 0; i < length; i++, temp++)
+		crc = (crc >> 8) ^ crc16_table[(crc ^ (*temp)) & 0xff];
+	return crc;
+}
