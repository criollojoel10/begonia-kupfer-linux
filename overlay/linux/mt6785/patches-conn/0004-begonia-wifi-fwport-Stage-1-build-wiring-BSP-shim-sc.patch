+	} while (0);
+
+	if (fgFail == MTK_WCN_BOOL_FALSE)
+		WMT_INFO_FUNC("wmt-core:%s: ok!\n", set_mcu_clk_str[kind]);
+	else
+		WMT_INFO_FUNC("wmt-core:%s: fail!\n", set_mcu_clk_str[kind]);
