+INT32 osal_wait_for_event_timeout(P_OSAL_EVENT pEvent, INT32(*condition) (PVOID), PVOID cond_pa)
+{
+	if (pEvent)
+		return wait_event_interruptible_timeout(pEvent->waitQueue,
+							condition(cond_pa),
+							msecs_to_jiffies(pEvent->timeoutValue));
+	return -1;
+}
