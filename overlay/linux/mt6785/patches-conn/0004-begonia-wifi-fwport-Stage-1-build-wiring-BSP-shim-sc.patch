+		return -2;
+	}
+	WMT_DBG_FUNC("chipid(0x%x),rom(%s),patch date(%s),patch plat(%s)\n", chipID, pRomVer,
+		     pPatch->ucDateTime, pPatch->ucPLat);
+	return stp_dbg_set_version_info(chipID, pRomVer, &(pPatch->ucDateTime[0]),
+					&(pPatch->ucPLat[0]));
