+int _btif_irq_ctrl(struct _MTK_BTIF_IRQ_STR_ *p_irq, bool en)
+{
+	unsigned int eint_num = p_irq->irq_id;
+
+	if (en)
+		enable_irq(eint_num);
+	else
+		disable_irq_nosync(eint_num);
+
+	return 0;
+}
