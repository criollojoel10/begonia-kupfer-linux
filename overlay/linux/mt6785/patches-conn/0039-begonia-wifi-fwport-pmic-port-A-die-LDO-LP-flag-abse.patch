+/* ---- mt6359 A-die LDO hardware-low-power (SRCLKEN0) faithful port ----------
+ * The vendor consys_hw_vcn18_ctrl / consys_hw_vcn28_ctrl drive the conn A-die
+ * LDOs (VCN18 1.8V, VCN33_2 2.8V) through two MTK-BSP calls that are no-ops in
+ * mainline (no mt6359 pmic_lp_api):
+ *
+ *   KERNEL_pmic_ldo_vcnXX_lp(user, op_mode, op_en, op_cfg)
+ *       -> pmic_ldo_vcnXX_lp() -> pmic_set_ldo_op_mode()+pmic_lp_type_set()
+ *   KERNEL_pmic_set_register_value(PMIC_RG_LDO_VCNXX_LP, 0)
+ *       -> clears CON0[1] (the SW low-power request bit)
+ *
+ * We port these to real mt6359 PMIC regmap ops via g_regmap, faithful to the
+ * vendor pmic_lp_type_set() semantics and corroborated by the proven reimpl
+ * mtk_conninfra_ldo_sw_op_en() / mtk_conninfra_ldo_hw_mode()
+ * (drivers/soc/mediatek/mtk-conninfra-mt6785.c). 3-source bar met:
+ *   (1) vendor intent: the KERNEL_pmic_ldo_*_lp() / KERNEL_pmic_set_register_value
+ *       call sites in mt6785.c.
+ *   (2) reimpl proven op: mtk_conninfra-mt6785.c (reaches conn idle 0x1d1e).
+ *   (3) mainline/vendor field def: include/linux/mfd/mt6359/registers.h +
+ *       mt6785 upmu_hw.h (begonia-r-oss): CON0/OP_EN/OP_CFG addresses, LP bit[1],
+ *       OP_MODE[12:10], and pmic_lp_api selector model (SRCLKEN0=bit0,SW=bit15).
+ *
+ * mt6359 register offsets (PMIC_REG_BASE==0, so offset==ADDR):
+ *   VCN18:    CON0 0x1c2a  OP_EN 0x1c2e  OP_CFG 0x1c34
+ *   VCN33_2:  CON0 0x1c08  OP_EN 0x1c0c  OP_CFG 0x1c12
+ */
+#define MT6359_LDO_VCN18_CON0		0x1c2a
+#define MT6359_LDO_VCN18_OP_EN		0x1c2e
+#define MT6359_LDO_VCN18_OP_CFG		0x1c34
+#define MT6359_LDO_VCN33_2_CON0		0x1c08
+#define MT6359_LDO_VCN33_2_OP_EN	0x1c0c
+#define MT6359_LDO_VCN33_2_OP_CFG	0x1c12
+#define MT6359_LDO_LP_BIT		(0x1u << 1)	/* CON0[1]  SW low-power request */
+#define MT6359_LDO_OP_MODE_MASK		(0x7u << 10)	/* CON0[12:10] operator-mode select */
+#define MT6359_LDO_OP_MODE_SRCLKEN0	(0x0u << 10)	/* op_mode==SRCLKEN0(0) */
+#define MT6359_LDO_HW0_OP_BIT		(0x1u << 0)	/* OP_EN/OP_CFG[0] SRCLKEN0 operator */
+#define MT6359_LDO_SW_OP_EN_BIT		(0x1u << 15)	/* OP_EN[15] SW operator enable */
+
+/* Faithful port of the vendor pmic_ldo_vcnXX_lp(user, op_mode, op_en, op_cfg).
+ * Mirrors pmic_lp_type_set(): for user==SW the op_en goes to OP_EN bit15 (the SW
+ * operator) and op_cfg is ignored; for user==SRCLKEN0 it selects OP_MODE and
+ * drives OP_EN/OP_CFG bit0 (the SRCLKEN0 operator). con0/op_en/op_cfg are the
+ * mt6359 register offsets for the target LDO. */
+static void wmt_pmic_ldo_lp(unsigned int con0, unsigned int op_en_reg,
+			    unsigned int op_cfg_reg, int user, int op_mode,
+			    unsigned char op_en, unsigned char op_cfg)
+{
+	if (!g_regmap)
+		return;
+
+	if (user == SW) {
+		/* SW operator: OP_EN[15]; op_cfg unused (matches pmic_lp_type_set) */
+		regmap_update_bits(g_regmap, op_en_reg, MT6359_LDO_SW_OP_EN_BIT,
+				   op_en ? MT6359_LDO_SW_OP_EN_BIT : 0);
+	} else {
+		/* SRCLKEN0 operator: select OP_MODE, then drive OP_EN/OP_CFG bit0 */
+		regmap_update_bits(g_regmap, con0, MT6359_LDO_OP_MODE_MASK,
+				   (op_mode == SRCLKEN0) ? MT6359_LDO_OP_MODE_SRCLKEN0
+							 : ((op_mode << 10) &
+							    MT6359_LDO_OP_MODE_MASK));
+		regmap_update_bits(g_regmap, op_en_reg, MT6359_LDO_HW0_OP_BIT,
+				   op_en ? MT6359_LDO_HW0_OP_BIT : 0);
+		regmap_update_bits(g_regmap, op_cfg_reg, MT6359_LDO_HW0_OP_BIT,
+				   op_cfg ? MT6359_LDO_HW0_OP_BIT : 0);
+	}
+}
+
+/* Faithful port of KERNEL_pmic_set_register_value(PMIC_RG_LDO_VCNXX_LP, val):
+ * the *_LP flag is CON0 bit[1] (the SW low-power request). val==0 takes the rail
+ * out of low-power so the A-die gets full current. */
+static void wmt_pmic_set_ldo_lp(unsigned int con0, unsigned int val)
+{
+	if (!g_regmap)
+		return;
+	regmap_update_bits(g_regmap, con0, MT6359_LDO_LP_BIT,
+			   val ? MT6359_LDO_LP_BIT : 0);
+}
