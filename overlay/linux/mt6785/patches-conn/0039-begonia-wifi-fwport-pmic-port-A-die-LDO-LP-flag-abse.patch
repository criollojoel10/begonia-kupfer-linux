 		/*Set VCN18 as low-power mode(1), HW0_OP_EN as 1, HW0_OP_CFG as HW_LP(1)*/
-		KERNEL_pmic_ldo_vcn18_lp(SRCLKEN0, 1, 1, HW_LP);
+		wmt_pmic_ldo_lp(MT6359_LDO_VCN18_CON0, MT6359_LDO_VCN18_OP_EN,
