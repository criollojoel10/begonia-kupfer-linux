 			result = regulator_enable(reg_VCN33_2);
 		}
 		/*Set VCN33_2 SW_LP as 0*/
-		KERNEL_pmic_set_register_value(PMIC_RG_LDO_VCN33_2_LP, 0);
+		wmt_pmic_set_ldo_lp(MT6359_LDO_VCN33_2_CON0, 0);
 		/*Set VCN33_2 as low-power mode(1), HW0_OP_EN as 1, HW0_OP_CFG as HW_OFF(0)*/
-		KERNEL_pmic_ldo_vcn33_2_lp(SRCLKEN0, 1, 1, HW_OFF);
+		wmt_pmic_ldo_lp(MT6359_LDO_VCN33_2_CON0, MT6359_LDO_VCN33_2_OP_EN,
+				MT6359_LDO_VCN33_2_OP_CFG, SRCLKEN0, 1, 1, HW_OFF);
 		WMT_PLAT_PR_DBG("turn on vcn33_2 for fm/gps usage in co-clock mode\n");
 	} else {
 		/*in co-clock mode,need to turn off vcn33_2 when fm off */
 		/*Set VCN33_2 as low-power mode(1), HW0_OP_EN as 0, HW0_OP_CFG as HW_OFF(0)*/
-		KERNEL_pmic_ldo_vcn33_2_lp(SRCLKEN0, 1, 0, HW_OFF);
+		wmt_pmic_ldo_lp(MT6359_LDO_VCN33_2_CON0, MT6359_LDO_VCN33_2_OP_EN,
+				MT6359_LDO_VCN33_2_OP_CFG, SRCLKEN0, 1, 0, HW_OFF);
 		if (reg_VCN33_2)
 			regulator_disable(reg_VCN33_2);
 		WMT_PLAT_PR_DBG("turn off vcn33_2 for fm/gps usage in co-clock mode\n");
@@ -1091,23 +1175,31 @@ static INT32 consys_hw_wifi_vcn33_ctrl(UINT32 enable)
 	return 0;
 }
 
+/* FLAGGED: NOT PORTED - no mainline EMI-MPU API exists in 6.16.
+ *
+ * The vendor sets an EMI MPU access-protection domain (region 27) over the conn
+ * EMI share-memory carveout [gConEmiPhyBase .. +gConEmiSize) via
+ * emi_mpu_set_protection(&emi_region_info_t). That depends on the MTK BSP EMI-MPU
+ * driver (mtk_emimpu_* / emi_mpu_set_protection), which is GATED on CONFIG_MTK_EMI.
+ * Mainline 6.16 has NO MediaTek EMI driver at all (drivers/memory/mediatek/ ships
+ * only mtk-smi.o; there is no mtk-emi.c and no mtk_emimpu_* symbol in-tree), and
+ * CONFIG_MTK_EMI is undefined, so the ifdef body never compiled. The compat
+ * mt_emi_api.h is an empty stub (the emi_region_info_t type / SET_ACCESS_PERMISSION
+ * macro do not exist), confirming there is nothing to call.
+ *
+ * This is an ACCESS-PROTECTION table (which masters may read/write the region),
+ * NOT the mechanism by which the conn-MCU FETCHES its firmware. Firmware fetch is
+ * via the conn's 0xF0000000 EMI window remapped to the carveout phys base
+ * (consys_emi_set_remapping_reg() below + the EMI-remap registers), and the proven
+ * reimpl mtk-conninfra-mt6785.c reaches conn idle 0x1d1e by exactly that path with
+ * NO EMI-MPU call. So the missing MPU does not block firmware fetch; it only means
+ * the carveout is not access-locked against other masters (a security hardening,
+ * not a functional bring-up gate). Left explicitly unported and FLAGGED rather
+ * than silently no-op'd. If a future EMI-MPU mainline API lands, wire it here. */
 static INT32 consys_emi_mpu_set_region_protection(VOID)
 {
-#ifdef CONFIG_MTK_EMI
-	struct emi_region_info_t region_info;
-
-	/*set MPU for EMI share Memory */
-	WMT_PLAT_PR_DBG("setting MPU for EMI share memory\n");
-
-	region_info.start = gConEmiPhyBase;
-	region_info.end = gConEmiPhyBase + gConEmiSize - 1;
-	region_info.region = 27;
-	SET_ACCESS_PERMISSION(region_info.apc, LOCK,
-			FORBIDDEN, FORBIDDEN, FORBIDDEN, FORBIDDEN, FORBIDDEN, FORBIDDEN, FORBIDDEN,
-			FORBIDDEN, FORBIDDEN, FORBIDDEN, FORBIDDEN, FORBIDDEN, FORBIDDEN,
-			NO_PROTECTION, FORBIDDEN, NO_PROTECTION);
-	emi_mpu_set_protection(&region_info);
-#endif
+	WMT_PLAT_PR_INFO("EMI MPU region protection: no mainline EMI-MPU API in 6.16 (CONFIG_MTK_EMI unset, no mtk-emi.c) - SKIPPED. conn fw fetch uses EMI remap, not MPU; not a bring-up gate. carveout [0x%llx +0x%llx)\n",
+			 (unsigned long long)gConEmiPhyBase, (unsigned long long)gConEmiSize);
 	return 0;
 }
 
