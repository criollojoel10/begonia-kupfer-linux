@@ -1043,10 +1122,12 @@ static VOID consys_vcn28_hw_mode_ctrl(UINT32 enable)
 #if CONSYS_PMIC_CTRL_ENABLE
 	if (enable)
 		/*Set VCN33_2_SW_OP_EN as 1*/
-		KERNEL_pmic_ldo_vcn33_2_lp(SW, 1, 1, SW_OFF);
+		wmt_pmic_ldo_lp(MT6359_LDO_VCN33_2_CON0, MT6359_LDO_VCN33_2_OP_EN,
+				MT6359_LDO_VCN33_2_OP_CFG, SW, 1, 1, SW_OFF);
 	else
 		/*Set VCN33_2 as low-power mode(1), HW0_OP_EN as 0, HW0_OP_CFG as HW_OFF(0)*/
-		KERNEL_pmic_ldo_vcn33_2_lp(SRCLKEN0, 1, 0, HW_OFF);
+		wmt_pmic_ldo_lp(MT6359_LDO_VCN33_2_CON0, MT6359_LDO_VCN33_2_OP_EN,
+				MT6359_LDO_VCN33_2_OP_CFG, SRCLKEN0, 1, 0, HW_OFF);
 #endif
 }
 
@@ -1058,21 +1139,24 @@ static INT32 consys_hw_vcn28_ctrl(UINT32 enable)
 	if (enable) {
 		/*in co-clock mode,need to turn on vcn33_2 when fm on */
 		/*Set VCN33_2_SW_OP_EN as 1*/
-		KERNEL_pmic_ldo_vcn33_2_lp(SW, 1, 1, SW_OFF);
+		wmt_pmic_ldo_lp(MT6359_LDO_VCN33_2_CON0, MT6359_LDO_VCN33_2_OP_EN,
+				MT6359_LDO_VCN33_2_OP_CFG, SW, 1, 1, SW_OFF);
