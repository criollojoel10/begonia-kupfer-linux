 		/*Set VCN18_SW_EN as 1 and set votage as 1V8*/
 		if (reg_VCN18) {
 			regulator_set_voltage(reg_VCN18, 1800000, 1800000);
@@ -1009,9 +1087,10 @@ static INT32 consys_hw_vcn18_ctrl(MTK_WCN_BOOL enable)
