 	return 0;
 
 error:
@@ -1735,6 +1743,8 @@ static VOID WMT_exit(VOID)
 	fb_unregister_client(&wmt_fb_notifier);
 #endif /* CONFIG_EARLYSUSPEND */
 
+	wmt_wifi_trigger_exit();
