From d17cf98d4e34e6b0ac037bfec186710358ea8881 Mon Sep 17 00:00:00 2001
From: Michal Andrzejczak <mit.mis@gmail.com>
Date: Thu, 18 Jun 2026 02:27:14 +0200
Subject: [PATCH 30/51] begonia-wifi (fwport): add /dev/wmtWifi WiFi on/off
 trigger node

The stock /dev/wmtWifi node (the userspace WiFi-on trigger the working oracle
uses, `echo 1 > /dev/wmtWifi`) is created by the vendor wlan adaptor
wmt_chrdev_wifi.c, which is absent from every available source tree and so is
not part of this forward-port. Without it the loaded stack has no way to kick
bring-up. Reconstruct it minimally: a misc chrdev "wmtWifi" whose write handler
calls the verified WMT export mtk_wcn_wmt_func_on/off(WMTDRV_TYPE_WIFI) - the
exact entry the stock node drives (powers connsys, arms WFSYS, invokes the
gen4m-registered wlan probe -> wlan0). Compiled into wmt_drv (same module as the
export, no symbol-version concern); registered from wmt_dev init, torn down in exit.
RUNTIME-UNPROVEN: compile/link verified; func_on semantics confirmed from
wmt_exp.c source; end-to-end bring-up must be validated on hardware.

Signed-off-by: Michal Andrzejczak <mit.mis@gmail.com>
---
 .../mediatek/connectivity/common/Makefile     |  2 +
 .../common/common_main/linux/wmt_dev.c        | 10 +++
 .../common_main/linux/wmt_wifi_trigger.c      | 81 +++++++++++++++++++
 3 files changed, 93 insertions(+)
 create mode 100644 drivers/misc/mediatek/connectivity/common/common_main/linux/wmt_wifi_trigger.c

diff --git a/drivers/misc/mediatek/connectivity/common/Makefile b/drivers/misc/mediatek/connectivity/common/Makefile
index 9332baa9c..a9df86ccb 100644
--- a/drivers/misc/mediatek/connectivity/common/Makefile
+++ b/drivers/misc/mediatek/connectivity/common/Makefile
@@ -77,6 +77,8 @@ wmt_drv-objs += common_main/linux/wmt_alarm.o
 wmt_drv-objs += common_main/linux/fw_log_wmt.o
 wmt_drv-objs += common_main/linux/wmt_step.o
 wmt_drv-objs += common_main/linux/stp_btif.o
+# begonia fwport: /dev/wmtWifi WiFi on/off trigger (reconstructs the stock node)
+wmt_drv-objs += common_main/linux/wmt_wifi_trigger.o
 
 # debug_utility
 wmt_drv-objs += debug_utility/ring.o
diff --git a/drivers/misc/mediatek/connectivity/common/common_main/linux/wmt_dev.c b/drivers/misc/mediatek/connectivity/common/common_main/linux/wmt_dev.c
index 275cda6d1..3b20b271a 100644
--- a/drivers/misc/mediatek/connectivity/common/common_main/linux/wmt_dev.c
+++ b/drivers/misc/mediatek/connectivity/common/common_main/linux/wmt_dev.c
@@ -68,6 +68,10 @@
 #include "wmt_detect.h"
 #include "hif_sdio.h"
 #include "wmt_step.h"
+
+/* begonia fwport: /dev/wmtWifi WiFi on/off trigger node (wmt_wifi_trigger.c). */
+int wmt_wifi_trigger_init(void);
+void wmt_wifi_trigger_exit(void);
 #include "wmt_proc_dbg.h"
 #include "wmt_alarm.h"
 
@@ -1689,6 +1693,10 @@ static INT32 WMT_init(VOID)
 	mtk_wcn_stp_sdio_drv_init();
 #endif
 
+	/* begonia fwport: create /dev/wmtWifi (the stock WiFi on/off trigger the
+	 * un-ported wlan adaptor would otherwise provide). Non-fatal on failure. */
+	wmt_wifi_trigger_init();
