diff --git a/drivers/misc/mediatek/connectivity/common/mtk-bsp-compat.c b/drivers/misc/mediatek/connectivity/common/mtk-bsp-compat.c
new file mode 100644
index 000000000..b19e5a302
--- /dev/null
+++ b/drivers/misc/mediatek/connectivity/common/mtk-bsp-compat.c
@@ -0,0 +1,50 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * mtk-bsp-compat.c - no-op bodies for the connectivity_build_in_adapter
+ * export wrappers that wmt_drv references via the unconditional KERNEL_*
+ * macros. The real bodies live in the separate connadp module (which pulls a
+ * large BSP surface incl. private scheduler headers); for the Stage-1 build
+ * port wmt_drv is standalone, so these are no-op shims.
+ *
+ * RULE: no register address / value / bitfield. PMIC/GPIO calls are no-op at
+ * the API level - no hardware is touched at build or (these) call sites.
+ */
+#include <linux/module.h>
+#include <linux/types.h>
+#include <linux/sched.h>
+
+void connectivity_export_pmic_set_register_value(int flagname, unsigned int val)
+{
+	(void)flagname; (void)val;
+}
+
+unsigned short connectivity_export_pmic_get_register_value(int flagname)
+{
+	(void)flagname;
+	return 0;
+}
+
+void connectivity_export_mt6306_set_gpio_out(unsigned long pin, unsigned long output)
+{
+	(void)pin; (void)output;
+}
+
+void connectivity_export_mt6306_set_gpio_dir(unsigned long pin, unsigned long dir)
+{
+	(void)pin; (void)dir;
+}
+
+void connectivity_export_show_stack(struct task_struct *tsk, unsigned long *sp)
+{
+	(void)tsk; (void)sp;
+}
+
+void connectivity_export_dump_thread_state(const char *name)
+{
+	(void)name;
+}
+
+void connectivity_export_dump_gpio_info(int start, int end)
+{
+	(void)start; (void)end;
+}
diff --git a/drivers/misc/mediatek/connectivity/compat/include/mtk-bsp-compat.h b/drivers/misc/mediatek/connectivity/compat/include/mtk-bsp-compat.h
index 95fbe634a..e055a1b7d 100644
--- a/drivers/misc/mediatek/connectivity/compat/include/mtk-bsp-compat.h
+++ b/drivers/misc/mediatek/connectivity/compat/include/mtk-bsp-compat.h
@@ -5,18 +5,56 @@
  *
  * Backs the external MTK-BSP symbols the 4.14 vendor stack references that
  * have no mainline equivalent, as no-op stubs or mainline-framework shims.
- * Grown from compile errors (undeclared identifier / implicit declaration),
- * not predicted.
+ * Grown from compile errors, not predicted.
  *
  * RULE: no register address / value / bitfield is altered here. Type /
- * signature / symbol shims only. PMIC/EMI/clkbuf calls are stubbed at the
- * API level for the build; runtime wiring is later-stage work.
+ * signature / symbol shims only. PMIC/EMI/clkbuf calls are stubbed at the API
+ * level for the build; runtime A-die wiring is the reimpl/DT path and is out
+ * of scope for this build-port. A no-op here touches no hardware.
+ *
+ * Split of responsibility for the connectivity_build_in_adapter KERNEL_*
+ * macros (the connadp module is NOT linked into wmt_drv here):
+ *  - UNCONDITIONAL macros in connectivity_build_in_adapter.h (pmic_set_register
+ *    _value, mt6306 gpio, show_stack, dump_thread_state, gpio_dump_regs_range)
+ *    map to connectivity_export_*(); we provide no-op bodies in
+ *    mtk-bsp-compat.c. Do NOT redefine those KERNEL_* macros here.
+ *  - GATED-OFF macros (clk_buf*, pmic_ldo_vcn*_lp - gated on CONFIG_MACH_* /
+ *    CONFIG_MTK_PMIC_CHIP_* which are unset in mainline) are not defined by the
+ *    adapter header, so we define them directly as no-op inlines here.
  */
 #ifndef _MTK_BSP_COMPAT_H
 #define _MTK_BSP_COMPAT_H
 
 #ifdef __KERNEL__
 #include <linux/types.h>
+#include <linux/io.h>
+
+/* --- 4.14 -> 6.16 API churn --------------------------------------------- */
+/* ioremap_nocache() was removed in 5.6; ioremap() is now always non-cached. */
+#ifndef ioremap_nocache
+#define ioremap_nocache(addr, size) ioremap((addr), (size))
+#endif
+
+/* --- adapter KERNEL_* macros the adapter header leaves UNDEFINED ---------- *
+ * (clk_buf / pmic_ldo blocks are gated on CONFIG_MACH_* / CONFIG_MTK_PMIC_CHIP_*
+ * which are unset on mainline). No-op at the API level - no hardware touched.  */
+static inline void __wmt_compat_clk_buf_ctrl(int id, bool onoff) { (void)id; (void)onoff; }
+static inline void __wmt_compat_clk_buf_show_status_info(void) { }
+static inline int  __wmt_compat_pmic_ldo_lp(int a, int b, int c, int d) { (void)a; (void)b; (void)c; (void)d; return 0; }
+
+#ifndef KERNEL_clk_buf_ctrl
+#define KERNEL_clk_buf_ctrl(id, onoff)           __wmt_compat_clk_buf_ctrl((id), (onoff))
 #endif
+#ifndef KERNEL_clk_buf_show_status_info
+#define KERNEL_clk_buf_show_status_info()        __wmt_compat_clk_buf_show_status_info()
+#endif
+#ifndef KERNEL_pmic_ldo_vcn18_lp
+#define KERNEL_pmic_ldo_vcn18_lp(a, b, c, d)     __wmt_compat_pmic_ldo_lp((a), (b), (c), (d))
+#endif
+#ifndef KERNEL_pmic_ldo_vcn33_2_lp
+#define KERNEL_pmic_ldo_vcn33_2_lp(a, b, c, d)   __wmt_compat_pmic_ldo_lp((a), (b), (c), (d))
+#endif
+
+#endif /* __KERNEL__ */
 
 #endif /* _MTK_BSP_COMPAT_H */
