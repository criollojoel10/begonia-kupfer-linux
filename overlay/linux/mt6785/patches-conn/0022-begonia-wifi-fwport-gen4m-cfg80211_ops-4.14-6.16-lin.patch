 .../connectivity/compat/include/stdarg.h      | 11 +++
 .../wlan/gen4m/os/linux/gl_cfg80211.c         | 95 +++++++++++++++++--
 .../wlan/gen4m/os/linux/gl_init.c             | 11 +++
 .../wlan/gen4m/os/linux/include/gl_cfg80211.h | 61 ++++++++++--
 4 files changed, 164 insertions(+), 14 deletions(-)
 create mode 100644 drivers/misc/mediatek/connectivity/compat/include/stdarg.h

