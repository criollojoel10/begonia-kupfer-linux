diff --git a/drivers/misc/Makefile b/drivers/misc/Makefile
index fed47c767..a7a828d38 100644
--- a/drivers/misc/Makefile
+++ b/drivers/misc/Makefile
@@ -74,3 +74,4 @@ obj-$(CONFIG_MCHP_LAN966X_PCI)	+= lan966x-pci.o
 obj-y				+= keba/
 obj-y				+= amd-sbi/
 obj-$(CONFIG_MISC_RP1)		+= rp1/
+obj-$(CONFIG_MTK_BTIF) += mtk-btif.o
diff --git a/drivers/misc/mtk-btif.c b/drivers/misc/mtk-btif.c
new file mode 100755
index 000000000..169e0bc1e
--- /dev/null
+++ b/drivers/misc/mtk-btif.c
@@ -0,0 +1,914 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek BTIF (Bluetooth Interface) bus driver — mt6785 (begonia).
+ *
+ * BTIF is a UART-like FIFO interface between the AP and the consys MCU.
+ * It carries WMT (Wireless MultiTransport) traffic for BT/FM/GPS control
+ * and is also used by the consys boot/init path. This driver owns the
+ * BTIF register block + AP DMA channels assigned to BTIF traffic.
+ *
+ * Port traceability — vendor source:
+ *   drivers/misc/mediatek/btif/common/btif_plat.c   (HAL + DT parse)
+ *   drivers/misc/mediatek/btif/common/mtk_btif.c    (platform_driver shell)
+ *   drivers/misc/mediatek/btif/common/btif_dma_plat.c (DMA path, not yet ported)
+ *
+ * DT binding (compatible "mediatek,btif" matches vendor begonia DTS so udev's
+ * existing modalias autoload works):
+ *
+ *   btif@1100c000 {
+ *       compatible = "mediatek,btif";
+ *       reg = <0 0x1100c000 0 0x1000>,    -- btif base
+ *             <0 0x11000b80 0 0x80>,      -- tx dma base
+ *             <0 0x11000c00 0 0x80>;      -- rx dma base
+ *       interrupts = <GIC_SPI 138 IRQ_TYPE_LEVEL_LOW>,  -- btif irq (sync ID, btif_irq_b)
+ *                    <GIC_SPI 155 IRQ_TYPE_LEVEL_LOW>,  -- tx dma irq
+ *                    <GIC_SPI 154 IRQ_TYPE_LEVEL_LOW>;  -- rx dma irq
+ *       clocks = <&infracfg CLK_INFRA_BTIF>,
+ *                <&infracfg CLK_INFRA_AP_DMA>;
+ *       clock-names = "btifc", "apdmac";
+ *   };
+ *
+ * This port covers the probe layer (DT parse, ioremap, clock_get, irq_request)
+ * plus a PIO transport: mtk_btif_send() (TX), mtk_btif_recv() (blocking RX),
+ * and mtk_btif_raise_wak() (AP->consys wake). That is enough for the conninfra
+ * driver to drive the WMT control channel. The DMA TX/RX paths are left as a
+ * TODO for subsequent ports.
+ */
+#include <linux/bits.h>
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/dma-mapping.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/kfifo.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_platform.h>
+#include <linux/platform_device.h>
+#include <linux/spinlock.h>
+#include <linux/wait.h>
+
+#include <linux/soc/mediatek/mtk-btif.h>
+
+#define DRV_NAME "mtk-btif"
+
+/* Diagnostic: run a PIO loopback self-test at the end of probe. Confirms our
+ * TX -> (internal loopback) -> RX -> IRQ -> kfifo -> recv path works, isolating
+ * "our RX plumbing is broken" from "the conn MCU isn't receiving our frames". */
+static bool selftest;
+module_param(selftest, bool, 0644);
+MODULE_PARM_DESC(selftest, "run a BTIF PIO loopback self-test at probe");
+
+/* r113 tx_pio — send via raw PIO THR writes instead of the APDMA vFIFO.  LIVE-HW
+ * PROVEN (2026-06-09): the APDMA TX path drains its ring (WPT==RPT) but delivers
+ * NOTHING to the conn MCU (conn BTIF0 RBR/RX-count stays 0), while a direct THR
+ * write DOES reach the conn (its RX byte-count ticks per byte).  So the "legacy THR
+ * path is dead" assumption was wrong — PIO is the working transport.  Slower (poll
+ * THRE per byte) but fine for the WMT/PDA handshake. */
+static bool tx_pio;
+module_param(tx_pio, bool, 0644);
+MODULE_PARM_DESC(tx_pio, "TX via PIO THR writes (works) instead of APDMA (delivers nothing to the conn)");
+
+/* RX kfifo size — vendor uses 256-byte chunks before calling rx_cb; we keep
+ * the same lower-bound (1 KiB power-of-2 = 1024 bytes) for headroom when
+ * no consumer is hooked up yet. */
+#define MTK_BTIF_RX_KFIFO_SIZE	1024
+
+/* TX kfifo size — vendor BTIF_HAL_TX_FIFO_SIZE = 1024*4. Senders enqueue
+ * bytes here; the IRQ handler drains into the HW THR FIFO when TX_EMPTY
+ * fires. */
+#define MTK_BTIF_TX_KFIFO_SIZE	(4 * 1024)
+
+/* --- Register layout (vendor btif_priv.h) --------------------------------- */
+#define BTIF_REG_RBR			0x00	/* RX buffer (read) */
+#define BTIF_REG_THR			0x00	/* TX holding (write) */
+#define BTIF_REG_IER			0x04	/* interrupt enable */
+#define BTIF_REG_IIR			0x08	/* interrupt ID (read) */
+#define BTIF_REG_FIFOCTRL		0x08	/* FIFO control (write) */
+#define BTIF_REG_FAKELCR		0x0C	/* line control mode */
+#define BTIF_REG_LSR			0x14	/* line status */
+#define BTIF_REG_SLEEP_EN		0x48
+#define BTIF_REG_DMA_EN			0x4C
+#define BTIF_REG_RTOCNT			0x54	/* RX timeout count */
+#define BTIF_REG_TRI_LVL		0x60	/* RX/TX FIFO thresholds + loopback */
+#define BTIF_REG_WAK			0x64
+#define BTIF_REG_WAT_TIME		0x68
+#define BTIF_REG_HANDSHAKE		0x6C
+
+/* IER bits */
+#define BTIF_IER_RXFEN			BIT(0)	/* RX buffer contains data */
+#define BTIF_IER_TXEEN			BIT(1)	/* TX holding register empty */
+
+/* IIR bits (read) */
+#define BTIF_IIR_NINT			BIT(0)	/* 1 = no interrupt pending */
+#define BTIF_IIR_TX_EMPTY		BIT(1)
+#define BTIF_IIR_RX			BIT(2)
+
+/* LSR bits */
+#define BTIF_LSR_DR			BIT(0)	/* RX data ready */
+#define BTIF_LSR_THRE			BIT(5)	/* TX holding empty */
+#define BTIF_LSR_TEMT			BIT(6)	/* TX shift register empty */
+
+/* FIFOCTRL bits (write at 0x08) */
+#define BTIF_FIFOCTRL_CLR_RX		BIT(1)
+#define BTIF_FIFOCTRL_CLR_TX		BIT(2)
+
+/* FAKELCR values */
+#define BTIF_FAKELCR_NORMAL_MODE	0x0
+
+/* SLEEP_EN bits */
+#define BTIF_SLEEP_EN_BIT		BIT(0)
+
+/* DMA_EN bits */
+#define BTIF_DMA_EN_RX			BIT(0)
+#define BTIF_DMA_EN_TX			BIT(1)
+#define BTIF_DMA_EN_AUTORST		BIT(2)
+
+/* TRI_LVL */
+#define BTIF_TRI_LVL_TX_MASK		(0xf << 0)
+#define BTIF_TRI_LVL_RX_MASK		(0x7 << 4)
+#define BTIF_TRI_LVL_TX(x)		((x) & 0xf)
+#define BTIF_TRI_LVL_RX(x)		(((x) & 0x7) << 4)
+#define BTIF_TRI_LOOP_EN		BIT(7)
+
+/* WAK — AP-to-consys wake-up signal (vendor BTIF_WAK_BIT) */
+#define BTIF_WAK_BIT			BIT(0)
+
+/* HANDSHAKE */
+#define BTIF_HANDSHAKE_EN		BIT(0)
+
+/* FIFO sizes / default thresholds (vendor btif_priv.h:117-121) */
+#define BTIF_TX_FIFO_SIZE		16
+#define BTIF_RX_FIFO_SIZE		8
+#define BTIF_TX_FIFO_THRE		(BTIF_TX_FIFO_SIZE / 2)
+#define BTIF_RX_FIFO_THRE		0x1
+
+/* --- MediaTek APDMA "virtual FIFO" (VFF) — the conn-MCU transport ----------
+ * Begonia BTIF talks to the conn MCU ONLY over APDMA vFIFO rings (verified
+ * against stock vmlinux hal_btif_dma_hw_init / hal_dma_send_data /
+ * hal_rx_dma_irq_handler): TX is ring-enqueue + VFF_WPT kick, RX is delivered
+ * by the rx-dma IRQ draining the ring. The legacy PIO THR/RBR path is never
+ * serviced by the MCU. Register offsets are from each engine base
+ * (tx_dma @ 0x11000b80, rx_dma @ 0x11000c00). */
+#define VFF_INT_FLAG		0x00	/* W1C completion flags */
+#define VFF_INT_EN		0x04	/* TX: BIT(0); RX: BIT(0)|BIT(1) */
+#define VFF_EN			0x08	/* BIT(0) run; reads 1 while active */
+#define VFF_RST			0x0C	/* BIT(0) warm reset */
+#define VFF_STOP		0x10	/* BIT(0) stop */
+#define VFF_FLUSH		0x14	/* BIT(0) flush */
+#define VFF_ADDR		0x1C	/* ring phys base (low 32) */
+#define VFF_ADDR_H		0x54	/* ring phys base high (phys>>32); vendor posts it unconditionally — omitting it lets the engine source from a stale base */
+#define VFF_LEN			0x24	/* ring size in bytes */
+#define VFF_THRE		0x28	/* interrupt threshold */
+#define VFF_WPT			0x2C	/* write ptr: [15:0]=offset, BIT(16)=wrap */
+#define VFF_RPT			0x30	/* read ptr: same encoding */
+#define VFF_INT_BUF		0x38	/* RX: bytes staged in engine internal FIFO (mask 0x1F) */
+#define VFF_VALID		0x3C	/* unsent bytes in DRAM ring = WPT-RPT. TX: 16-bit, compare raw; the 0x1F mask is RX-only */
+#define VFF_SIZE		0x40	/* FREE space in the ring (NOT valid bytes) */
+#define VFF_DBG			0x50	/* engine debug/status */
+
+#define VFF_EN_BIT		BIT(0)
+#define VFF_RST_BIT		BIT(0)
+#define VFF_STOP_BIT		BIT(0)
+#define VFF_FLUSH_BIT		BIT(0)
+/* Interrupts disabled on both engines: the engines still DMA (FIFO<->ring)
+ * autonomously; TX is fire-and-forget after the VFF_WPT kick, and RX is polled
+ * in mtk_btif_recv() by reading the hw-advanced VFF_WPT. This deliberately
+ * avoids any completion IRQ — a level-triggered RX_THRE_INT (or a mis-acked
+ * RX_INT) storms the CPU into a soft-lockup, which hung the device repeatedly.
+ * Polling is sufficient for the low-rate WMT control channel. */
+#define VFF_INT_EN_TX		0
+#define VFF_INT_EN_RX		0
+#define VFF_WPT_WRAP		BIT(16)
+
+#define BTIF_VFF_SIZE		(8 * 1024)	/* per ring; power of two */
+#define BTIF_VFF_MASK		(BTIF_VFF_SIZE - 1)
+
+struct mtk_btif {
+	struct device		*dev;
+
+	/* Register windows from DT slot 0/1/2 (vendor naming). */
+	void __iomem		*base;		/* btif core regs @ 0x1100c000 */
+	void __iomem		*tx_dma;	/* AP DMA TX engine @ 0x11000b80 */
+	void __iomem		*rx_dma;	/* AP DMA RX engine @ 0x11000c00 */
+	resource_size_t		base_phys;	/* for log readability */
+
+	/* Vendor's two clocks. clk_prepare is done here; clk_enable happens
+	 * inside the (not-yet-ported) hal_btif_clk_ctrl during TX/RX so the
+	 * gate isn't kept on when idle. */
+	struct clk		*clk_btifc;	/* CLK_INFRA_BTIF (bit 31 of INFRA0) */
+	struct clk		*clk_apdmac;	/* CLK_INFRA_AP_DMA (bit 18 of INFRA1) */
+
+	/* IRQ numbers from DT slot 0/1/2 (vendor naming). */
+	int			irq_btif;
+	int			irq_tx_dma;
+	int			irq_rx_dma;
+
+	/* RX path: the rx-dma IRQ drains the APDMA RX ring into this kfifo;
+	 * mtk_btif_recv() dequeues from it and waits on rx_wait. */
+	spinlock_t		rx_lock;
+	struct kfifo		rx_fifo;
+	wait_queue_head_t	rx_wait;	/* woken when rx_fifo gains data */
+	u64			rx_byte_count;	/* lifetime total */
+	u32			irq_count_rx;	/* lifetime rx-dma IRQs */
+	u32			irq_count_tx;	/* lifetime tx-dma IRQs */
+
+	/* APDMA vFIFO rings in DMA-coherent DRAM. The conn MCU only services
+	 * these rings; rx_rpt/tx_wpt are sw shadows of the VFF pointers
+	 * (offset in [15:0] | wrap bit). */
+	void			*tx_ring;
+	dma_addr_t		tx_ring_dma;
+	u32			tx_wpt;
+	spinlock_t		tx_lock;
+	u64			tx_byte_count;	/* lifetime total enqueued */
+	void			*rx_ring;
+	dma_addr_t		rx_ring_dma;
+	u32			rx_rpt;
+};
+
+/* --- HAL register accessors (vendor BTIF_SET_BIT / BTIF_CLR_BIT) ---------- */
+
+static inline void mtk_btif_set_bit(struct mtk_btif *b, u32 off, u32 mask)
+{
+	writel(readl(b->base + off) | mask, b->base + off);
+}
+
+static inline void mtk_btif_clr_bit(struct mtk_btif *b, u32 off, u32 mask)
+{
+	writel(readl(b->base + off) & ~mask, b->base + off);
+}
+
+/* Vendor hal_btif_rx_ier_ctrl / hal_btif_tx_ier_ctrl. */
+static void mtk_btif_rx_ier(struct mtk_btif *b, bool en)
+{
+	if (en)
+		mtk_btif_set_bit(b, BTIF_REG_IER, BTIF_IER_RXFEN);
+	else
+		mtk_btif_clr_bit(b, BTIF_REG_IER, BTIF_IER_RXFEN);
+}
+
+static void mtk_btif_tx_ier(struct mtk_btif *b, bool en)
+{
+	if (en)
+		mtk_btif_set_bit(b, BTIF_REG_IER, BTIF_IER_TXEEN);
+	else
+		mtk_btif_clr_bit(b, BTIF_REG_IER, BTIF_IER_TXEEN);
+}
+
+/* Vendor hal_btif_tx/rx_mode_ctrl — PIO when false, DMA when true. */
+static void mtk_btif_tx_dma_mode(struct mtk_btif *b, bool dma)
+{
+	if (dma)
+		mtk_btif_set_bit(b, BTIF_REG_DMA_EN, BTIF_DMA_EN_TX);
+	else
+		mtk_btif_clr_bit(b, BTIF_REG_DMA_EN, BTIF_DMA_EN_TX);
+}
+
+static void mtk_btif_rx_dma_mode(struct mtk_btif *b, bool dma)
+{
+	if (dma)
+		mtk_btif_set_bit(b, BTIF_REG_DMA_EN, BTIF_DMA_EN_RX);
+	else
+		mtk_btif_clr_bit(b, BTIF_REG_DMA_EN, BTIF_DMA_EN_RX);
+}
+
+/* Vendor hal_btif_loopback_ctrl. */
+static void mtk_btif_loopback(struct mtk_btif *b, bool en)
+{
+	if (en)
+		mtk_btif_set_bit(b, BTIF_REG_TRI_LVL, BTIF_TRI_LOOP_EN);
+	else
+		mtk_btif_clr_bit(b, BTIF_REG_TRI_LVL, BTIF_TRI_LOOP_EN);
+}
+
+/* Vendor btif_new_handshake_ctrl. */
+static void mtk_btif_handshake(struct mtk_btif *b, bool en)
+{
+	if (en)
+		mtk_btif_set_bit(b, BTIF_REG_HANDSHAKE, BTIF_HANDSHAKE_EN);
+	else
+		mtk_btif_clr_bit(b, BTIF_REG_HANDSHAKE, BTIF_HANDSHAKE_EN);
+}
+
+/* Hardware reset of the two FIFOs — the vendor pattern is set-then-clear
+ * each CLR bit (pulse). Vendor hal_btif_hw_init lines 521-528.
+ */
+static void mtk_btif_fifo_reset(struct mtk_btif *b)
+{
+	mtk_btif_set_bit(b, BTIF_REG_FIFOCTRL, BTIF_FIFOCTRL_CLR_RX);
+	mtk_btif_clr_bit(b, BTIF_REG_FIFOCTRL, BTIF_FIFOCTRL_CLR_RX);
+	mtk_btif_set_bit(b, BTIF_REG_FIFOCTRL, BTIF_FIFOCTRL_CLR_TX);
+	mtk_btif_clr_bit(b, BTIF_REG_FIFOCTRL, BTIF_FIFOCTRL_CLR_TX);
+}
+
+/* Program one APDMA vFIFO engine. Port of stock hal_btif_dma_hw_init: warm
+ * reset, point at the coherent DRAM ring, set length/threshold, clear the
+ * pointers, arm the completion interrupt, run. */
+static void mtk_btif_vff_init(void __iomem *vff, dma_addr_t ring, u32 len,
+			      u32 int_en, u32 thre)
+{
+	int i;
+
+	writel(VFF_STOP_BIT, vff + VFF_STOP);
+	writel(VFF_RST_BIT,  vff + VFF_RST);		/* warm reset */
+	for (i = 0; i < 100 && (readl(vff + VFF_EN) & VFF_EN_BIT); i++)
+		udelay(1);
+	writel((u32)ring,              vff + VFF_ADDR);
+	writel((u32)((u64)ring >> 32), vff + VFF_ADDR_H);	/* high half: vendor posts both; without it the engine can source from a stale physical base (ring drains WPT==RPT but the wire stays silent) */
+	writel(len,       vff + VFF_LEN);
+	writel(thre,      vff + VFF_THRE);
+	writel(0,         vff + VFF_WPT);
+	writel(0,         vff + VFF_RPT);
+	writel(int_en,    vff + VFF_INT_EN);
+	writel(0,         vff + VFF_STOP);
+	writel(VFF_EN_BIT, vff + VFF_EN);		/* run */
+}
+
+/* External TX entry point: enqueue @len bytes into the APDMA TX vFIFO ring and
+ * kick the engine by advancing VFF_WPT (port of stock hal_dma_send_data). The
+ * conn MCU reads its input from this ring; the legacy THR path is dead.
+ * Returns bytes accepted (0 if the ring is full), or negative errno. */
+int mtk_btif_send(struct mtk_btif *b, const u8 *buf, unsigned int len)
+{
+	unsigned long flags;
+	u32 off, wrap, room, left;
+
+	if (!b || !buf || !len)
+		return -EINVAL;
+	if (len > BTIF_VFF_SIZE)
+		return -EINVAL;
+
+	if (tx_pio) {
+		unsigned int i, t;
+
+		/* PIO TX (HW-verified working; APDMA TX delivers nothing to the conn).
+		 * Put TX in PIO mode, then clock each byte out once the holding reg is
+		 * empty (LSR.THRE).  The BTIF shift-register feeds the conn BTIF0 RX. */
+		spin_lock_irqsave(&b->tx_lock, flags);
+		mtk_btif_clr_bit(b, BTIF_REG_DMA_EN, BTIF_DMA_EN_TX);
+		for (i = 0; i < len; i++) {
+			for (t = 0; t < 100000; t++) {
+				if (readl(b->base + BTIF_REG_LSR) & BTIF_LSR_THRE)
+					break;
+				cpu_relax();
+			}
+			writel(buf[i], b->base + BTIF_REG_THR);
+		}
+		b->tx_byte_count += len;
+		spin_unlock_irqrestore(&b->tx_lock, flags);
+		return (int)len;
+	}
+
+	spin_lock_irqsave(&b->tx_lock, flags);
+	left = readl(b->tx_dma + VFF_SIZE);		/* free space in TX ring */
+	if (left < len) {
+		spin_unlock_irqrestore(&b->tx_lock, flags);
+		return 0;
+	}
+	/* Read the HARDWARE write pointer as the base, NOT a sw shadow: AUTORST
+	 * (BTIF_DMA_EN_AUTORST) zeroes WPT/RPT after each completed transfer, so a
+	 * persistent shadow desyncs after the first frame.  Vendor hal_dma_send_data
+	 * reads VFF_WPT live (btif_dma_plat.c:881): off = WPT[15:0], wrap = WPT[16]. */
+	off  = readl(b->tx_dma + VFF_WPT);
+	wrap = off & VFF_WPT_WRAP;
+	off &= BTIF_VFF_MASK;
+	room = BTIF_VFF_SIZE - off;
+	if (len <= room) {
+		memcpy(b->tx_ring + off, buf, len);
+	} else {					/* split across the ring wrap */
+		memcpy(b->tx_ring + off, buf, room);
+		memcpy(b->tx_ring, buf + room, len - room);
+	}
+	off += len;
+	if (off >= BTIF_VFF_SIZE) {
+		off -= BTIF_VFF_SIZE;
+		wrap ^= VFF_WPT_WRAP;
+	}
+	b->tx_wpt = wrap | off;
+	wmb();						/* payload immutable before the WPT advance */
+	/* Mirror vendor hal_dma_send_data exactly: ENABLE the engine (AUTORST stops
+	 * it after each transfer), then post the WPT with a readback to latch it.
+	 * Do NOT flush a full frame — the engine bursts it; an immediate unconditional
+	 * flush issued *before* the burst purges the pending transaction (ring drains
+	 * WPT==RPT but nothing crosses the wire — the actual bug).  Only the sub-burst
+	 * tail (0 < valid < 8) needs a flush; the vendor does this in its TX-DMA IRQ
+	 * handler, but we run IRQ-less, so poll VFF_VALID and flush only the tail. */
+	/* Re-assert the BTIF-side TX DMA mode (connects the vFIFO output to the BTIF TX
+	 * shifter); idempotent, and undoes a prior tx_pio=1 send that cleared it. */
+	mtk_btif_set_bit(b, BTIF_REG_DMA_EN, BTIF_DMA_EN_TX);
+	writel(VFF_EN_BIT, b->tx_dma + VFF_EN);		/* vendor DMA_CTRL_ENABLE */
+	writel(b->tx_wpt, b->tx_dma + VFF_WPT);
+	(void)readl(b->tx_dma + VFF_WPT);		/* sync: force the WPT post */
+	/* The engine bursts in 8-byte units, leaving any trailing <8 bytes in the ring;
+	 * with no TX-DMA IRQ to flush them (vendor does it in hal_tx_dma_irq_handler) a
+	 * frame whose length isn't a burst multiple would reach the conn truncated.
+	 * Burst-multiple frames have no tail -> fire-and-forget (the engine drains under
+	 * AUTORST; the caller's free-space check paces the next send).  Else wait
+	 * (bounded, wall-clock via udelay) for the bursts to drain to the sub-burst
+	 * tail, then flush exactly that tail. */
+	if (len & 0x7u) {
+		u32 valid;
+		int p, q;
+
+		for (p = 0; p < 3000; p++) {		/* bounded ~30ms */
+			valid = readl(b->tx_dma + VFF_VALID);
+			if (valid == 0)
+				break;			/* drained, no residual tail */
+			if (valid < 8) {		/* sub-burst tail: force it onto the wire */
+				writel(VFF_FLUSH_BIT, b->tx_dma + VFF_FLUSH);
+				for (q = 0; q < 1000 &&
+				     (readl(b->tx_dma + VFF_FLUSH) & VFF_FLUSH_BIT); q++)
+					udelay(1);
+				break;
+			}
+			udelay(10);
+		}
+	}
+	b->tx_byte_count += len;
+	spin_unlock_irqrestore(&b->tx_lock, flags);
+
+	return (int)len;
+}
+EXPORT_SYMBOL_GPL(mtk_btif_send);
+
+/* Pulse the AP→consys wake-up line low for one 32kHz tick (~30us), then
+ * back high. Used by WMT before sending a command if the MCU may have
+ * entered low-power state.
+ *
+ * Vendor reference: hal_btif_raise_wak_sig (btif_plat.c:1131).
+ * Vendor uses ~128us for safety margin over 1/32kHz; we follow that.
+ */
+int mtk_btif_raise_wak(struct mtk_btif *b)
+{
+	if (!b)
+		return -EINVAL;
+
+	/* Drive low — clear BTIF_WAK[0]. */
+	mtk_btif_clr_bit(b, BTIF_REG_WAK, BTIF_WAK_BIT);
+	usleep_range(128, 160);
+	/* Drive high — set BTIF_WAK[0]. */
+	mtk_btif_set_bit(b, BTIF_REG_WAK, BTIF_WAK_BIT);
+
+	dev_dbg(b->dev, "WAK pulse fired\n");
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mtk_btif_raise_wak);
+
+/* Block until the consys MCU sends bytes (or @timeout_ms elapses), then drain
+ * up to @len bytes from the RX FIFO. Returns the byte count (0 on timeout).
+ * STP frames may dribble in over several IRQs, so callers that need a whole
+ * frame should loop and accumulate. Consumer side of the vendor BTIF RX thread.
+ */
+int mtk_btif_recv(struct mtk_btif *b, u8 *buf, unsigned int len,
+		  unsigned int timeout_ms)
+{
+	unsigned long flags, deadline;
+	u32 wpt, ro, wrap, room, valid, got;
+
+	if (!b || !buf || !len)
+		return -EINVAL;
+
+	deadline = jiffies + msecs_to_jiffies(timeout_ms) + 1;
+	do {
+		spin_lock_irqsave(&b->rx_lock, flags);
+		/* Received bytes = (hw-advanced WPT) - (our RPT), modulo ring. */
+		wpt  = readl(b->rx_dma + VFF_WPT);
+		ro   = b->rx_rpt & BTIF_VFF_MASK;
+		wrap = b->rx_rpt & VFF_WPT_WRAP;
+		if ((wpt & VFF_WPT_WRAP) == wrap)
+			valid = (wpt & BTIF_VFF_MASK) - ro;
+		else
+			valid = BTIF_VFF_SIZE - ro + (wpt & BTIF_VFF_MASK);
+		if (valid && valid <= BTIF_VFF_SIZE) {
+			got  = min(valid, len);
+			rmb();			/* see DMA-written data */
+			room = BTIF_VFF_SIZE - ro;
+			if (got <= room) {
+				memcpy(buf, b->rx_ring + ro, got);
+			} else {
+				memcpy(buf, b->rx_ring + ro, room);
+				memcpy(buf + room, b->rx_ring, got - room);
+			}
+			ro += got;
+			if (ro >= BTIF_VFF_SIZE) {
+				ro -= BTIF_VFF_SIZE;
+				wrap ^= VFF_WPT_WRAP;
+			}
+			b->rx_rpt = wrap | ro;
+			writel(b->rx_rpt, b->rx_dma + VFF_RPT);
+			b->rx_byte_count += got;
+			spin_unlock_irqrestore(&b->rx_lock, flags);
+			return (int)got;
+		}
+		spin_unlock_irqrestore(&b->rx_lock, flags);
+		usleep_range(1000, 2000);
+	} while (time_before(jiffies, deadline));
+
+	return 0;				/* timed out, nothing received */
+}
+EXPORT_SYMBOL_GPL(mtk_btif_recv);
+
+/* Resolve a BTIF handle from a DT phandle node (consumer side). Returns NULL
+ * if @np is not a BTIF device or its driver has not bound yet — the caller
+ * should treat NULL as -EPROBE_DEFER. The device refcount taken by the lookup
+ * is dropped before returning; the instance stays alive via the symbol-level
+ * module dependency the caller's use of this exported API creates. */
+struct mtk_btif *mtk_btif_get(struct device_node *np)
+{
+	struct platform_device *pdev;
+	struct mtk_btif *b;
+
+	if (!np)
+		return NULL;
+
+	pdev = of_find_device_by_node(np);
+	if (!pdev)
+		return NULL;
+
+	b = platform_get_drvdata(pdev);
+	put_device(&pdev->dev);
+
+	return b;			/* NULL if not yet probed */
+}
+EXPORT_SYMBOL_GPL(mtk_btif_get);
+
+/* Diagnostic: dump BTIF line status + both vFIFO engines (free space, WPT/RPT).
+ * After a send, tx free should return to the ring size and tx WPT==RPT once the
+ * engine has clocked the bytes out; LSR.TEMT(0x40)|THRE(0x20) confirm the BTIF
+ * shift register drained physically. A non-zero rx WPT means the MCU replied. */
+void mtk_btif_dump(struct mtk_btif *b, const char *tag)
+{
+	if (!b)
+		return;
+	dev_info(b->dev,
+		 "dump[%s]: LSR=0x%02x DMA_EN=0x%x sw[tx_wpt=0x%x rx_rpt=0x%x] | tx-vff EN=%u free=0x%x WPT=0x%x RPT=0x%x | rx-vff EN=%u free=0x%x WPT=0x%x RPT=0x%x\n",
+		 tag, readl(b->base + BTIF_REG_LSR), readl(b->base + BTIF_REG_DMA_EN),
+		 b->tx_wpt, b->rx_rpt,
+		 readl(b->tx_dma + VFF_EN), readl(b->tx_dma + VFF_SIZE),
+		 readl(b->tx_dma + VFF_WPT), readl(b->tx_dma + VFF_RPT),
+		 readl(b->rx_dma + VFF_EN), readl(b->rx_dma + VFF_SIZE),
+		 readl(b->rx_dma + VFF_WPT), readl(b->rx_dma + VFF_RPT));
+	/* RX-arrival diagnostic: INT_BUF(0x38)=bytes staged in the engine's internal
+	 * FIFO (arrived from the line but not yet in DRAM ring), VALID(0x3C)=bytes in
+	 * the ring (=WPT-RPT), INT_FLAG(0x00), DBG(0x50). If INT_BUF/VALID stay 0 with
+	 * INT_EN=0 -> ZERO conn-line bytes ever arrived (conn-side gate); if INT_BUF>0
+	 * -> bytes arrived but were not flushed to the ring (host flush gate). */
+	dev_info(b->dev,
+		 "dump[%s] rx-arrival: INT_BUF(0x38)=0x%x VALID(0x3C)=0x%x INT_FLAG(0x00)=0x%x DBG(0x50)=0x%x rx_byte_cnt=%llu irq_rx=%u\n",
+		 tag, readl(b->rx_dma + VFF_INT_BUF), readl(b->rx_dma + VFF_VALID),
+		 readl(b->rx_dma + VFF_INT_FLAG), readl(b->rx_dma + VFF_DBG),
+		 (unsigned long long)b->rx_byte_count, b->irq_count_rx);
+}
+EXPORT_SYMBOL_GPL(mtk_btif_dump);
+
+/* APDMA RX completion (SPI 154) — the conn MCU's replies arrive here. Drain the
+ * bytes the engine wrote into the RX ring into rx_fifo, release them by
+ * advancing VFF_RPT, and wake mtk_btif_recv(). Port of hal_rx_dma_irq_handler. */
+static irqreturn_t mtk_btif_rx_dma_irq(int irq, void *data)
+{
+	struct mtk_btif *b = data;
+	unsigned long flags;
+	u32 wpt, ro, room, valid;
+
+	writel(readl(b->rx_dma + VFF_INT_FLAG), b->rx_dma + VFF_INT_FLAG); /* W1C */
+	b->irq_count_rx++;
+
+	spin_lock_irqsave(&b->rx_lock, flags);
+	/* Bytes the engine has written = (hw WPT) - (our RPT), modulo the ring.
+	 * (VFF_SIZE @0x40 is FREE space, not valid — must not be used here.)
+	 * Stock hal_rx_dma_irq_handler likewise compares WPT(0x2c) vs RPT(0x30). */
+	wpt = readl(b->rx_dma + VFF_WPT);
+	ro  = b->rx_rpt & BTIF_VFF_MASK;
+	if ((wpt & VFF_WPT_WRAP) == (b->rx_rpt & VFF_WPT_WRAP))
+		valid = (wpt & BTIF_VFF_MASK) - ro;
+	else
+		valid = BTIF_VFF_SIZE - ro + (wpt & BTIF_VFF_MASK);
+	if (!valid || valid > BTIF_VFF_SIZE) {
+		spin_unlock_irqrestore(&b->rx_lock, flags);
+		return IRQ_HANDLED;
+	}
+	rmb();						/* see DMA-written data */
+	room = BTIF_VFF_SIZE - ro;
+	if (valid <= room) {
+		kfifo_in(&b->rx_fifo, b->rx_ring + ro, valid);
+	} else {
+		kfifo_in(&b->rx_fifo, b->rx_ring + ro, room);
+		kfifo_in(&b->rx_fifo, b->rx_ring, valid - room);
+	}
+	b->rx_rpt = wpt;				/* consumed up to the HW WPT */
+	writel(b->rx_rpt, b->rx_dma + VFF_RPT);		/* release consumed bytes */
+	b->rx_byte_count += valid;
+	spin_unlock_irqrestore(&b->rx_lock, flags);
+
+	wake_up_interruptible(&b->rx_wait);
+	return IRQ_HANDLED;
+}
+
+/* APDMA TX completion (SPI 155) — just acknowledge; the ring drain is HW-driven. */
+static irqreturn_t mtk_btif_tx_dma_irq(int irq, void *data)
+{
+	struct mtk_btif *b = data;
+
+	writel(readl(b->tx_dma + VFF_INT_FLAG), b->tx_dma + VFF_INT_FLAG); /* W1C */
+	b->irq_count_tx++;
+	return IRQ_HANDLED;
+}
+
+/* Port of vendor hal_btif_hw_init() + the APDMA vFIFO bring-up. Sets normal LCR,
+ * new-handshake, flushes the FIFOs, then enables DMA-mode framing and programs
+ * the TX/RX vFIFO engines. The conn MCU only services the DMA rings.
+ *
+ * Caller must have enabled the btifc + apdmac clocks and allocated the rings
+ * (b->tx_ring_dma / b->rx_ring_dma) first.
+ */
+static int mtk_btif_hw_init(struct mtk_btif *b)
+{
+	u32 tri;
+
+	/* Set fake LCR to normal mode (no break, no parity). */
+	writel(BTIF_FAKELCR_NORMAL_MODE, b->base + BTIF_REG_FAKELCR);
+
+	/* Enable new-handshake (vendor default for this IP). */
+	mtk_btif_handshake(b, true);
+
+	/* Flush both FIFOs. */
+	mtk_btif_fifo_reset(b);
+
+	/* TRI_LVL: stock packs RX_THRE in [3:0], TX_THRE in [6:4]; loopback bit7
+	 * cleared. (In DMA mode the core-FIFO thresholds barely matter — the vFIFO
+	 * VFF_THRE governs — but match stock's nibble layout.) */
+	tri = BTIF_TRI_LVL_RX(BTIF_RX_FIFO_THRE) |
+	      BTIF_TRI_LVL_TX(BTIF_TX_FIFO_THRE);
+	writel(tri, b->base + BTIF_REG_TRI_LVL);
+	mtk_btif_loopback(b, false);
+
+	/* begonia BTIF is DMA-only: enable BTIF-side RX+TX DMA framing (the conn
+	 * MCU keys off these bits), keep AUTORST. */
+	mtk_btif_set_bit(b, BTIF_REG_DMA_EN,
+			 BTIF_DMA_EN_RX | BTIF_DMA_EN_TX | BTIF_DMA_EN_AUTORST);
+
+	/* No core PIO interrupt in DMA mode — RX is delivered by the rx-dma IRQ
+	 * (stock frees the BTIF-port IRQ entirely once DMA RX is configured). */
+	mtk_btif_tx_ier(b, false);
+	mtk_btif_rx_ier(b, false);
+
+	/* Bring up the APDMA vFIFO engines against the coherent rings. RX is
+	 * delivered by the rx-timeout (RX_INT), so the threshold is just a
+	 * high-watermark, not the small-frame trigger. */
+	b->tx_wpt = 0;
+	b->rx_rpt = 0;
+	mtk_btif_vff_init(b->tx_dma, b->tx_ring_dma, BTIF_VFF_SIZE,
+			  VFF_INT_EN_TX, BTIF_VFF_SIZE / 2);
+	mtk_btif_vff_init(b->rx_dma, b->rx_ring_dma, BTIF_VFF_SIZE,
+			  VFF_INT_EN_RX, BTIF_VFF_SIZE / 2);
+
+	dev_info(b->dev,
+		 "hw_init: DMA mode; DMA_EN=0x%08x TRI_LVL=0x%08x HANDSHAKE=0x%08x; tx-vff EN=0x%x free=0x%x rx-vff EN=0x%x free=0x%x\n",
+		 readl(b->base + BTIF_REG_DMA_EN),
+		 readl(b->base + BTIF_REG_TRI_LVL),
+		 readl(b->base + BTIF_REG_HANDSHAKE),
+		 readl(b->tx_dma + VFF_EN), readl(b->tx_dma + VFF_SIZE),
+		 readl(b->rx_dma + VFF_EN), readl(b->rx_dma + VFF_SIZE));
+	return 0;
+}
+
+/* DMA-path loopback self-test: with TRI_LVL loopback enabled, bytes the TX
+ * vFIFO engine pushes into the BTIF TX FIFO loop back into the RX FIFO and are
+ * delivered by the RX vFIFO engine + rx-dma IRQ. A clean round-trip proves the
+ * whole APDMA TX+RX path (rings, WPT/RPT, rx-dma IRQ, kfifo, recv) end to end —
+ * independent of the conn MCU. */
+static void mtk_btif_selftest(struct mtk_btif *b)
+{
+	static const u8 tx[] = { 0xa5, 0x5a, 0x01, 0x02, 0x03, 0x04, 0xde, 0xad };
+	u8 rx[16] = { 0 };
+	int sent, n;
+
+	dev_info(b->dev, "selftest: enabling DMA loopback\n");
+	mtk_btif_loopback(b, true);
+	sent = mtk_btif_send(b, tx, sizeof(tx));
+	n = mtk_btif_recv(b, rx, sizeof(rx), 200);
+	dev_info(b->dev,
+		 "selftest: sent=%d recv=%d bytes=%*ph rx-irqs=%u => %s\n",
+		 sent, n, n > 0 ? n : 0, rx, b->irq_count_rx,
+		 (n == (int)sizeof(tx) && !memcmp(rx, tx, sizeof(tx))) ?
+			"PASS (DMA TX+RX path works)" : "FAIL (DMA path broken)");
+	mtk_btif_loopback(b, false);
+}
+
+static int mtk_btif_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct resource *r;
+	struct mtk_btif *b;
+	int ret;
+
+	b = devm_kzalloc(dev, sizeof(*b), GFP_KERNEL);
+	if (!b)
+		return -ENOMEM;
+	b->dev = dev;
+	platform_set_drvdata(pdev, b);
+
+	dev_info(dev, "probe\n");
+
+	/* --- map the three register windows (vendor _btif_set_default_setting
+	 * uses of_iomap(node, 0); we use named-or-indexed platform resources
+	 * which gives us proper devm management and address logging). */
+	r = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!r)
+		return dev_err_probe(dev, -EINVAL, "missing reg[0] (btif base)\n");
+	b->base = devm_ioremap_resource(dev, r);
+	if (IS_ERR(b->base))
+		return dev_err_probe(dev, PTR_ERR(b->base),
+				     "ioremap btif base\n");
+	b->base_phys = r->start;
+	dev_info(dev, "btif    base   @ %pa (%llu bytes)\n",
+		 &r->start, (unsigned long long)resource_size(r));
+
+	r = platform_get_resource(pdev, IORESOURCE_MEM, 1);
+	if (!r)
+		return dev_err_probe(dev, -EINVAL, "missing reg[1] (tx-dma base)\n");
+	b->tx_dma = devm_ioremap_resource(dev, r);
+	if (IS_ERR(b->tx_dma))
+		return dev_err_probe(dev, PTR_ERR(b->tx_dma),
+				     "ioremap tx-dma\n");
+	dev_info(dev, "tx-dma  base   @ %pa (%llu bytes)\n",
+		 &r->start, (unsigned long long)resource_size(r));
+
+	r = platform_get_resource(pdev, IORESOURCE_MEM, 2);
+	if (!r)
+		return dev_err_probe(dev, -EINVAL, "missing reg[2] (rx-dma base)\n");
+	b->rx_dma = devm_ioremap_resource(dev, r);
+	if (IS_ERR(b->rx_dma))
+		return dev_err_probe(dev, PTR_ERR(b->rx_dma),
+				     "ioremap rx-dma\n");
+	dev_info(dev, "rx-dma  base   @ %pa (%llu bytes)\n",
+		 &r->start, (unsigned long long)resource_size(r));
+
+	/* --- clocks (vendor hal_btif_clk_get_and_prepare). Just clk_prepare
+	 * here; clk_enable belongs to the TX/RX HAL (not yet ported). */
+	b->clk_btifc = devm_clk_get(dev, "btifc");
+	if (IS_ERR(b->clk_btifc))
+		return dev_err_probe(dev, PTR_ERR(b->clk_btifc),
+				     "clk btifc\n");
+	b->clk_apdmac = devm_clk_get(dev, "apdmac");
+	if (IS_ERR(b->clk_apdmac))
+		return dev_err_probe(dev, PTR_ERR(b->clk_apdmac),
+				     "clk apdmac\n");
+
+	/* prepare + enable both clocks. Vendor splits prepare (from probe)
+	 * and enable (lazy on first open) — we enable in probe so the block
+	 * is immediately accessible and hw_init below can write registers.
+	 * If/when we add power management, lazy-enable can be reintroduced. */
+	ret = clk_prepare_enable(b->clk_btifc);
+	if (ret)
+		return dev_err_probe(dev, ret, "clk_prepare_enable(btifc)\n");
+	ret = clk_prepare_enable(b->clk_apdmac);
+	if (ret) {
+		clk_disable_unprepare(b->clk_btifc);
+		return dev_err_probe(dev, ret, "clk_prepare_enable(apdmac)\n");
+	}
+	dev_info(dev, "clocks enabled: btifc + apdmac\n");
+
+	/* --- IRQs (vendor irq_of_parse_and_map(node, 0..2)). request_irq is
+	 * deferred — the actual handlers (btif_irq_handler, btif_tx_dma_irq,
+	 * btif_rx_dma_irq) aren't ported yet, so we only resolve the numbers
+	 * for log + future use. */
+	b->irq_btif = platform_get_irq(pdev, 0);
+	if (b->irq_btif < 0) {
+		ret = b->irq_btif;
+		goto err_unprepare;
+	}
+	b->irq_tx_dma = platform_get_irq(pdev, 1);
+	if (b->irq_tx_dma < 0) {
+		ret = b->irq_tx_dma;
+		goto err_unprepare;
+	}
+	b->irq_rx_dma = platform_get_irq(pdev, 2);
+	if (b->irq_rx_dma < 0) {
+		ret = b->irq_rx_dma;
+		goto err_unprepare;
+	}
+	dev_info(dev, "IRQs: btif=%d tx-dma=%d rx-dma=%d\n",
+		 b->irq_btif, b->irq_tx_dma, b->irq_rx_dma);
+
+	/* RX kfifo (the rx-dma IRQ fills it) + locks + waitqueue. */
+	spin_lock_init(&b->rx_lock);
+	spin_lock_init(&b->tx_lock);
+	init_waitqueue_head(&b->rx_wait);
+	ret = kfifo_alloc(&b->rx_fifo, MTK_BTIF_RX_KFIFO_SIZE, GFP_KERNEL);
+	if (ret) {
+		dev_err(dev, "kfifo_alloc(rx) failed: %d\n", ret);
+		goto err_clks;
+	}
+
+	/* APDMA vFIFO rings in DMA-coherent DRAM (port of _btif_vfifo_init). The
+	 * engine's VFF_ADDR is 32-bit, so the rings must live in the low 4 GB. */
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(32));
+	if (ret) {
+		dev_err(dev, "dma_set_mask_and_coherent(32): %d\n", ret);
+		goto err_kfifo;
+	}
+	b->tx_ring = dma_alloc_coherent(dev, BTIF_VFF_SIZE, &b->tx_ring_dma,
+					GFP_KERNEL);
+	b->rx_ring = dma_alloc_coherent(dev, BTIF_VFF_SIZE, &b->rx_ring_dma,
+					GFP_KERNEL);
+	if (!b->tx_ring || !b->rx_ring) {
+		ret = -ENOMEM;
+		goto err_rings;
+	}
+	dev_info(dev, "vFIFO rings: tx=%pad rx=%pad (%u bytes each)\n",
+		 &b->tx_ring_dma, &b->rx_ring_dma, BTIF_VFF_SIZE);
+
+	/* hw_init programs the vFIFO engines against the rings, so they must
+	 * exist first. */
+	ret = mtk_btif_hw_init(b);
+	if (ret < 0)
+		goto err_rings;
+
+	/* The conn-MCU link is the two APDMA IRQs: rx-dma (SPI 154) delivers the
+	 * MCU's replies, tx-dma (SPI 155) acks TX completion. The legacy BTIF-port
+	 * IRQ is not used in DMA mode (stock frees it). */
+	ret = devm_request_irq(dev, b->irq_rx_dma, mtk_btif_rx_dma_irq, 0,
+			       DRV_NAME "-rx", b);
+	if (ret) {
+		dev_err(dev, "request rx-dma irq %d: %d\n", b->irq_rx_dma, ret);
+		goto err_rings;
+	}
+	ret = devm_request_irq(dev, b->irq_tx_dma, mtk_btif_tx_dma_irq, 0,
+			       DRV_NAME "-tx", b);
+	if (ret) {
+		dev_err(dev, "request tx-dma irq %d: %d\n", b->irq_tx_dma, ret);
+		goto err_rings;
+	}
+
+	dev_info(dev,
+		 "BTIF probe complete: APDMA vFIFO TX+RX (rx-dma irq %d, tx-dma irq %d) + blocking RX (mtk_btif_recv) + WAK.\n",
+		 b->irq_rx_dma, b->irq_tx_dma);
+
+	if (selftest)
+		mtk_btif_selftest(b);
+	return 0;
+
+err_unprepare:
+	clk_disable_unprepare(b->clk_apdmac);
+	clk_disable_unprepare(b->clk_btifc);
+	return dev_err_probe(dev, ret, "platform_get_irq\n");
+err_rings:
+	if (b->tx_ring)
+		dma_free_coherent(dev, BTIF_VFF_SIZE, b->tx_ring, b->tx_ring_dma);
+	if (b->rx_ring)
+		dma_free_coherent(dev, BTIF_VFF_SIZE, b->rx_ring, b->rx_ring_dma);
+err_kfifo:
+	kfifo_free(&b->rx_fifo);
+err_clks:
+	clk_disable_unprepare(b->clk_apdmac);
+	clk_disable_unprepare(b->clk_btifc);
+	return ret;
+}
+
+static void mtk_btif_remove(struct platform_device *pdev)
+{
+	struct mtk_btif *b = platform_get_drvdata(pdev);
+
+	if (!b)
+		return;
+	/* IRQs are devm-managed; stop + mask the DMA engines first so no late
+	 * interrupt fires against a half-torn-down handler or a freed ring. */
+	writel(VFF_STOP_BIT, b->tx_dma + VFF_STOP);
+	writel(0, b->tx_dma + VFF_EN);
+	writel(VFF_STOP_BIT, b->rx_dma + VFF_STOP);
+	writel(0, b->rx_dma + VFF_EN);
+	mtk_btif_tx_dma_mode(b, false);
+	mtk_btif_rx_dma_mode(b, false);
+
+	if (b->tx_ring)
+		dma_free_coherent(b->dev, BTIF_VFF_SIZE, b->tx_ring, b->tx_ring_dma);
+	if (b->rx_ring)
+		dma_free_coherent(b->dev, BTIF_VFF_SIZE, b->rx_ring, b->rx_ring_dma);
+	kfifo_free(&b->rx_fifo);
+	clk_disable_unprepare(b->clk_apdmac);
+	clk_disable_unprepare(b->clk_btifc);
+	dev_info(b->dev,
+		 "removed (lifetime: %u rx-irq, %u tx-irq, %llu RX bytes, %llu TX bytes)\n",
+		 b->irq_count_rx, b->irq_count_tx, b->rx_byte_count, b->tx_byte_count);
+}
+
+static const struct of_device_id mtk_btif_of_match[] = {
+	{ .compatible = "mediatek,btif", },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mtk_btif_of_match);
+
+static struct platform_driver mtk_btif_driver = {
+	.probe	= mtk_btif_probe,
+	.remove	= mtk_btif_remove,
+	.driver	= {
+		.name		= DRV_NAME,
+		.of_match_table	= mtk_btif_of_match,
+	},
+};
+module_platform_driver(mtk_btif_driver);
+
+MODULE_AUTHOR("Michal Andrzejczak <mit.mis@gmail.com>");
+MODULE_DESCRIPTION("MediaTek BTIF bus driver (PIO transport: send/recv/wak; DMA TODO)");
+MODULE_LICENSE("GPL v2");
