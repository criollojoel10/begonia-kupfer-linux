+/* ----- WMT control channel: arm the WFSYS via the conn MCU ------------------
+ *
+ * Once the conn_infra MCU is at idle (COM_REG0 == 0x1D1E), the WiFi subsystem
+ * (WFSYS) is powered NOT by an AP register write but by a WMT "FUNCTION_CTRL"
+ * command sent to the MCU over STP/BTIF; the MCU then arms the WFSYS rgu and
+ * brings up its VER_ID internally.  Verified against the stock wmt_drv.ko:
+ * mtk_wcn_wmt_func_on -> wmt_func_wifi_ctrl -> wmt_core_func_ctrl_cmd ->
+ * mtk_wcn_stp_send_data; the host never writes the WFSYS/rgu CRs (the foreign
+ * soc3_0 WFSYS_ON poke our wmac side imported is a dead end).
+ *
+ * STP frame (BTIF "mandatory" mode, 4-byte header): 0x80, (type << 4) |
+ * (len >> 8), len & 0xff, 0x00, payload[len], crc16(payload) little-endian.
+ * type = WMT channel = 4; CRC is CRC-16/ARC (poly 0xA001, init 0) == the kernel
+ * crc16().  WMT FUNCTION_CTRL payload (6 bytes): eType=0x01 (CMD), opcode=0x06
+ * (FUNCTION_CTRL), u2SduLen=0x0002 (LE), SDU = { func_type, on }.  For WiFi-on
+ * that is 01 06 02 00 03 01; the MCU replies with a WMT EVENT whose status byte
+ * is 0 on success.
+ */
+#define WMT_STP_CHANNEL		0x04	/* STP type field for the WMT channel */
+#define WMT_STP_HDR_SYNC	0x80
+#define WMT_PKT_TYPE_CMD	0x01
+#define WMT_OPCODE_FUNC_CTRL	0x06
+#define WMTDRV_TYPE_WIFI	0x03
+#define DEFAULT_PATCH_FRAG_SIZE	1000u	/* vendor wmt_ic_soc.c PDA fragment size */
+
+/* BGFSYS driver-own (FW-own clear) handshake in CONN_HOST_CSR_TOP (0x18060000).
+ * The combo MCU that services the BTIF/WMT channel sleeps under FW-own; the
+ * driver must take ownership before the MCU will read/reply to BTIF traffic.
+ * Without this, a TX drains into the BTIF FIFO but the MCU never answers (0 RX).
+ * Vendor btmtk_cif_fw_own_clr (btmtk_btif_main.c:289): write CLR_FW_OWN, poll
+ * OWNER_STATE_SYNC == 0, then W1C the IRQ-own-clear bit. */
+#define BGF_LPCTL_OFFSET	0x030		/* host_csr + 0x30 */
+#define BGF_IRQ_STAT_OFFSET	0x034		/* host_csr + 0x34 */
+#define BGF_HOST_CLR_FW_OWN	BIT(1)		/* write to LPCTL to take driver-own */
+#define BGF_OWNER_STATE_SYNC	BIT(2)		/* LPCTL: 1 = FW owns, 0 = driver owns */
+#define BGF_IRQ_FW_OWN_CLR	BIT(0)		/* W1C in IRQ_STAT */
+
+/* conn-MCU post-boot companion registers. In the stock consys_hw_reset_bit_set
+ * (boot-log verified), alongside COM_REG0 @ 0x18002600 reaching 0x1D1E, two more
+ * registers reach their post-boot values over the ~26ms the MCU boots:
+ *   0x1800216C (CONN_MCU_CONFG + 0x16C) -> 0x10241400
+ *   0x18007104 (CONN_HIF_ON   + 0x104) -> 0x0000F29E
+ * The MCU's STP/BTIF responder only goes live once it is fully booted. We do not
+ * yet know if these are MCU-populated status or values the host must write
+ * (the boot-log 0->value pattern suggests status); we log the pre-values to
+ * find out, and idempotently write the stock values if they differ (harmless if
+ * status, a fix if they are config the host must set). */
+#define CONN_MCU_BOOT_STAT_OFFSET	0x16C		/* conn_mcu + 0x16C = 0x1800216C */
+#define CONN_MCU_BOOT_STAT_VAL		0x10241400u
+#define CONN_HIF_BOOT_STAT_OFFSET	0x104		/* conn_hif_on + 0x104 = 0x18007104 */
+#define CONN_HIF_BOOT_STAT_VAL		0x0000F29Eu
+
+/* Take BGFSYS driver-ownership so the combo MCU wakes and services BTIF.
+ * Returns 0 once OWNER_STATE_SYNC reads driver-owned. */
+static int mtk_conninfra_bgf_fw_own_clr(struct mtk_conninfra *c)
+{
+	u32 v;
+	int i;
+
+	v = readl(c->host_csr + BGF_LPCTL_OFFSET);
+	if (!(v & BGF_OWNER_STATE_SYNC)) {
+		dev_info(c->dev, "BGFSYS already driver-owned: LPCTL[0x18060030]=0x%08x\n",
+			 v);
+		return 0;
+	}
+	for (i = 0; i < 20; i++) {
+		writel(BGF_HOST_CLR_FW_OWN, c->host_csr + BGF_LPCTL_OFFSET);
+		usleep_range(500, 700);
+		v = readl(c->host_csr + BGF_LPCTL_OFFSET);
+		if (!(v & BGF_OWNER_STATE_SYNC))
+			break;
+	}
+	if (v & BGF_OWNER_STATE_SYNC) {
+		dev_warn(c->dev,
+			 "BGFSYS FW-own clear timed out: LPCTL[0x18060030]=0x%08x\n", v);
+		return -ETIMEDOUT;
+	}
+	/* Ack/clear the FW-own IRQ (write-1-to-clear). */
+	writel(BGF_IRQ_FW_OWN_CLR, c->host_csr + BGF_IRQ_STAT_OFFSET);
+	dev_info(c->dev, "BGFSYS driver-own taken after %d poll(s): LPCTL[0x18060030]=0x%08x\n",
+		 i + 1, v);
+	return 0;
+}
+
+/* Log and idempotently set the conn-MCU post-boot companion registers that
+ * stock reaches alongside COM_REG0 == 0x1D1E. The pre-read tells us whether our
+ * MCU booted as fully as stock (status) or stalled (0); writing the stock value
+ * when it differs is a harmless completion attempt if the MCU's STP responder
+ * needs them. Run after COM_REG0 idle, before the first WMT command. */
+static void mtk_conninfra_wmt_link_prep(struct mtk_conninfra *c)
+{
+	u32 mcu = readl(c->conn_mcu + CONN_MCU_BOOT_STAT_OFFSET);
+	u32 pc_min = 0xffffffff, pc_max = 0, pc = 0, hit_f29e = 0;
+	int i;
+
+	/* These are READ-ONLY MCU-populated status (vendor consys_hw_reset_bit_set
+	 * only PR_DBG-reads them): 0x1800216c = boot status, 0x18007104 =
+	 * CONSYS_CPUPCR = the conn-MCU's live CPU program counter.  Do NOT write
+	 * them (prior code wrote 0xf29e to the PC reg — a no-op at best). */
+	dev_info(c->dev,
+		 "conn-MCU boot status: 0x1800216c=0x%08x (want 0x10241400) 0x18007104(PC)=0x%08x (stock idle PC 0xf29e)\n",
+		 mcu, readl(c->conn_hif_on + CONN_HIF_BOOT_STAT_OFFSET));
+
+	/* ⭐ r93 — FINE PC HISTOGRAM (0x100-byte buckets over 0x0-0x2200) to localize
+	 * the exact phase-1 loop.  r92 showed the MCU dwells in 0x0-0x2100 + the log
+	 * path (0x140c/0x1970/0xb988) and NEVER reaches phase-2 init (efuse 0x7bxx,
+	 * DMA-init 0x3968 @0x3b86, servicing 0xf000+) — efuse REFUTED (0 samples).
+	 * The phase-1 code at ~0x18xx is an RX-command parser (checks header 0x6f 0xfc
+	 * at 0x1844) that log-spams; finer buckets pin which 256B window is hottest.
+	 * Also measure the log rate (EMI counter 0xf001f13c = carveout+0x1f13c). */
+	{
+		u32 fine[0x22] = {0}, midf[0x34] = {0}, serv = 0, mid = 0, n = 5000;
+		u32 lc0 = 0, lc1 = 0;
+		void __iomem *emi = NULL;
+		struct device_node *np2 = of_parse_phandle(c->dev->of_node, "memory-region", 0);
+		struct reserved_mem *rm2 = np2 ? of_reserved_mem_lookup(np2) : NULL;
+		char line[1400];
+		int k, off = 0;
+
+		if (np2)
+			of_node_put(np2);
+		if (rm2)
+			emi = ioremap_wc(rm2->base, rm2->size);
+		if (emi)
+			lc0 = readl(emi + 0x1f13c);
+
+		for (i = 0; i < (int)n; i++) {
+			pc = readl(c->conn_hif_on + CONN_HIF_BOOT_STAT_OFFSET) & 0xffff;
+			if (pc < pc_min)
+				pc_min = pc;
+			if (pc > pc_max)
+				pc_max = pc;
+			if (pc >= 0xf000)
+				serv++;
+			else if (pc < 0x2200)
+				fine[pc >> 8]++;
+			else {
+				u32 b = (pc - 0x2200) >> 10;	/* 0x400 buckets, 0x2200-0xf200 */
+
+				mid++;
+				if (b < 0x34)
+					midf[b]++;
+			}
+			udelay(20);
+		}
+		(void)hit_f29e;
+		if (emi) {
+			lc1 = readl(emi + 0x1f13c);
+			iounmap(emi);
+		}
+		for (k = 0; k < 0x22; k++)
+			if (fine[k])
+				off += scnprintf(line + off, sizeof(line) - off,
+						 "%02xxx=%u ", k, fine[k]);
+		off += scnprintf(line + off, sizeof(line) - off, "|| mid0x400[ ");
+		for (k = 0; k < 0x34; k++)
+			if (midf[k])
+				off += scnprintf(line + off, sizeof(line) - off,
+						 "%04x=%u ", 0x2200 + (k << 10), midf[k]);
+		off += scnprintf(line + off, sizeof(line) - off, "] ");
+		dev_info(c->dev,
+			 "conn-MCU FINE PC hist (%u samples): %s| mid(0x2200-0xf000)=%u SERVICING=%u | min=0x%04x max=0x%04x | logcounter 0x1f13c: %u->%u (delta=%u)\n",
+			 n, line, mid, serv, pc_min, pc_max, lc0, lc1, lc1 - lc0);
+	}
+
+	/* r99 — RAW PC TRACE: 96 back-to-back CONSYS_CPUPCR reads (no udelay) to catch
+	 * the fast main-code cycle the 20us histogram smears together with the tick
+	 * ISR + the 0xb6dc formatter.  Reveals the actual execution path / spin PC
+	 * between timer-tick excursions — the real gate the histogram obscures. */
+	{
+		u16 tr[96];
+		char tl[700];
+		int k, o = 0;
+
+		for (k = 0; k < 96; k++)
+			tr[k] = readl(c->conn_hif_on + 0x104) & 0xffff;
+		for (k = 0; k < 96; k++)
+			o += scnprintf(tl + o, sizeof(tl) - o, "%04x ", tr[k]);
+		dev_info(c->dev, "conn-MCU RAW PC trace (96 back-to-back, no delay): %s\n", tl);
+	}
+}
+
+/* Wrap a WMT payload in an STP (BTIF full-set) frame.  Returns the frame length.
+ * begonia's STP runs in btif_fullset mode (g_stp_mode bit2), where the 4-byte
+ * header is [0x80|(seq<<3), (type<<4)|len_hi, len_lo, hdr_checksum] and the
+ * MCU silently drops any frame whose hdr_checksum (byte0+byte1+byte2 & 0xff) is
+ * wrong.  ⭐ The two STP modes differ in BOTH byte3 AND the trailer (verified vs
+ * vendor stp_core.c:1141 stp_send_data_no_ps):
+ *   MANDATORY (btif_mand): byte0=0x80 (no seq), byte3=0x00, trailer = 0x00 0x00
+ *                          (LITERAL zeros, NOT a CRC).
+ *   FULLSET  (btif_full):  byte0=0x80|seq<<3|ack, byte3=(b0+b1+b2)&0xff (checksum),
+ *                          trailer = crc16(payload) LE.
+ * The conn-MCU ROM at idle (COM_REG0=0x1D1E) runs its PDA loader / STP responder
+ * in MANDATORY mode; it switches to FULLSET only AFTER patch-dwn + WMT_RESET
+ * (mt6785 pda_dl_patch_flag=1).  Our old code ALWAYS appended crc16 — so even the
+ * "mand" path (byte3=0) sent a wrong (crc) trailer and the ROM dropped every
+ * frame -> 0 RX.  So begonia bring-up starts in MANDATORY (stp_fullset=false) and
+ * flips to fullset after WMT_RESET. */
+static unsigned int conn_stp_frame(u8 *frame, const u8 *payload, u8 len)
+{
+	frame[0] = WMT_STP_HDR_SYNC;			/* 0x80 (seq=0) */
+	frame[1] = (WMT_STP_CHANNEL << 4) | ((len >> 8) & 0x0f);
+	frame[2] = len & 0xff;
+	memcpy(frame + 4, payload, len);
+	if (stp_fullset) {
+		u16 crc = crc16(0, payload, len);
+
+		frame[3] = (frame[0] + frame[1] + frame[2]) & 0xff;	/* checksum */
+		frame[4 + len] = crc & 0xff;				/* crc16 LE */
+		frame[5 + len] = (crc >> 8) & 0xff;
+	} else {
+		frame[3] = 0x00;			/* mandatory: byte3=0 */
+		frame[4 + len] = 0x00;			/* trailer = literal 00 00 */
+		frame[5 + len] = 0x00;
+	}
+	return 6 + len;
+}
+
+/* STP inband-reset: a raw (non-sequenced) 22-byte control frame that tells the
+ * running conn-MCU STP task to flush its RX/TX sequence counters to 0, so it
+ * accepts our fresh seq=0 frames. The MCU validates a 3-bit STP sequence on every
+ * data frame and SILENTLY DROPS seq-mismatched frames (no ack, no upcall) — which
+ * is why even WMT_QUERY_STP got zero reply. Magic from mtk_wcn_stp_inband_reset
+ * (wmt_drv.ko 0x18760): "COOL CODE" C0 01 C0 DE + signature + crc16 over the
+ * first 8 bytes, total 22 bytes, sent straight to BTIF (no STP wrap). */
+static void mtk_conninfra_stp_inband_reset(struct mtk_conninfra *c)
+{
+	u8 rst[22] = {
+		0xc0, 0x01, 0xc0, 0xde, 0x3e, 0xd1, 0xa7, 0xef,	/* magic (crc'd) */
+		0x7f, 0x7f, 0x7f, 0x7f, 0x7f, 0x7f, 0x7f, 0x7f,	/* padding */
+		0x80, 0x50, 0x08, 0xd8, 0x00, 0x00,		/* sig + crc16 slot */
+	};
+	u16 crc = crc16(0, rst, 8);
+
+	rst[20] = crc & 0xff;
+	rst[21] = (crc >> 8) & 0xff;
+	dev_info(c->dev, "STP inband-reset: %*ph\n", (int)sizeof(rst), rst);
+	mtk_btif_raise_wak(c->btif);
+	mtk_btif_send(c->btif, rst, sizeof(rst));
+	msleep(20);				/* let the MCU re-zero its seq state */
+}
+
+/* r113 diag_rx capture: read the conn-side reception state right after a WMT TX, to
+ * locate where the host frame dies.  CPUPCR burst => did the conn-MCU CPU move into
+ * the ISR (0xf0002600-0xf0002800) / receiver (0xf0008a00-0xf0008c00 or ROM fn0xe14x)
+ * / STP-dispatch (0x6a00-0x6d00) / receive-task 0x21b8 — or stay in the idle band?
+ * conn BTIF0 0x180A2000 => did bytes arrive (RBR/LSR DR) and is the RX channel on?
+ * conn DMA 0x180A1000 => is the RX DMA ring programmed (else DMA-delivered bytes have
+ * nowhere to land)? */
+static void mtk_conninfra_diag_rx(struct mtk_conninfra *c, const char *label)
+{
+	void __iomem *bt = ioremap(0x180A2000u, 0x1000);
+	void __iomem *dm = ioremap(0x180A1000u, 0x1000);
+	u32 isr = 0, recv = 0, disp = 0, task = 0, emi = 0, pcmax = 0;
+	int i;
+
+	for (i = 0; i < 4000; i++) {
+		u32 pc = readl(c->conn_hif_on + 0x104);
+
+		if (pc > pcmax)
+			pcmax = pc;
+		if ((pc & 0xf0000000u) == 0xf0000000u)
+			emi++;
+		if (pc >= 0xf0002600u && pc <= 0xf0002800u)
+			isr++;
+		if ((pc >= 0xf0008a00u && pc <= 0xf0008c00u) ||
+		    (pc >= 0x0000e130u && pc <= 0x0000e160u))
+			recv++;
+		if (pc >= 0x00006a00u && pc <= 0x00006d00u)
+			disp++;
+		if (pc >= 0x000021b0u && pc <= 0x00002290u)
+			task++;
+	}
+	dev_info(c->dev,
+		 "diag_rx[%s] CPUPCR 4000-sample: ISR=%u RECV=%u STPdisp=%u task21b8=%u EMI=%u maxPC=0x%08x\n",
+		 label, isr, recv, disp, task, emi, pcmax);
+	if (bt) {
+		dev_info(c->dev,
+			 "diag_rx[%s] conn BTIF0[0x180A2000]: RBR+00=0x%08x LSR+14=0x%08x +50=0x%08x +54=0x%08x +64=0x%08x +68=0x%08x +6c=0x%08x +e4=0x%08x\n",
+			 label, readl(bt + 0x00), readl(bt + 0x14), readl(bt + 0x50),
+			 readl(bt + 0x54), readl(bt + 0x64), readl(bt + 0x68),
+			 readl(bt + 0x6c), readl(bt + 0xe4));
+		iounmap(bt);
+	}
+	if (dm) {
+		dev_info(c->dev,
+			 "diag_rx[%s] conn DMA[0x180A1000]: +00=0x%08x RX[+100=0x%08x +104=0x%08x +108=0x%08x +10c=0x%08x +110=0x%08x] TX[+200=0x%08x +210=0x%08x]\n",
+			 label, readl(dm + 0x00), readl(dm + 0x100), readl(dm + 0x104),
+			 readl(dm + 0x108), readl(dm + 0x10c), readl(dm + 0x110),
+			 readl(dm + 0x200), readl(dm + 0x210));
+		iounmap(dm);
+	}
+	/* r116: AP-TX side in the SAME handler call (atomic w/ the conn read above) —
+	 * did THIS frame's bytes enter the tx-DMA ring (WPT advance) + leave the core
+	 * (LSR THRE/TEMT), while the conn ingress (+e4/ring) stays 0? */
+	{
+		void __iomem *vff = ioremap(0x11000b80u, 0x80);
+		void __iomem *core = ioremap(0x1100c000u, 0x100);
+
+		if (vff && core)
+			dev_info(c->dev,
+				 "diag_rx[%s] AP-TX: VFF EN=0x%08x WPT=0x%08x RPT=0x%08x VALID=0x%08x | core LSR=0x%08x DMA_EN=0x%08x\n",
+				 label, readl(vff + 0x08), readl(vff + 0x2c),
+				 readl(vff + 0x30), readl(vff + 0x3c),
+				 readl(core + 0x14), readl(core + 0x4c));
+		if (vff)
+			iounmap(vff);
+		if (core)
+			iounmap(core);
+	}
+}
+
+/* Send one WMT command (raw SDU payload) over STP/BTIF and collect the event
+ * into @evt (up to @cap bytes). Returns the event length (>0), 0/negative on
+ * timeout/error. */
+static int conn_wmt_cmd(struct mtk_conninfra *c, const u8 *payload, u8 plen,
+			u8 *evt, unsigned int cap, const char *label)
+{
+	u8 frame[4 + 24 + 2];
+	u8 drain[64];
+	unsigned int flen, total, elen;
+	int n, i, retry;
+
+	if (plen > 24)
+		return -EINVAL;
+	flen = conn_stp_frame(frame, payload, plen);
+
+	/* Resilient TX, mirroring stock mtk_wcn_consys_stp_btif_tx (which logs
+	 * "recovered, retry_left(8)").  The conn-MCU silently drops an STP frame whose
+	 * leading bytes are truncated by the BTIF wake / clock-domain crossing, so we
+	 * treat the link as COLD on every attempt: raise WAK + ~500us settle before
+	 * each TX so the MCU's event loop is awake to service the FIFO, and drain any
+	 * stale RX between attempts. */
+	for (retry = 0; retry < 8; retry++) {
+		mtk_btif_raise_wak(c->btif);
+		udelay(500);
+		dev_info(c->dev, "WMT[%s] TX try%d %*ph\n",
+			 label, retry, (int)flen, frame);
+		n = mtk_btif_send(c->btif, frame, flen);
+		if (n < 0)
+			return n;
+		if (diag_rx)	/* r116: every retry → per-frame WPT advance visible */
+			mtk_conninfra_diag_rx(c, label);
+
+		total = 0;
+		for (i = 0; i < 10 && total < cap; i++) {
+			n = mtk_btif_recv(c->btif, evt + total, cap - total, 50);
+			if (n < 0)
+				break;
+			total += n;
+			if (total >= 4 && evt[0] == WMT_STP_HDR_SYNC) {
+				elen = ((evt[1] & 0x0f) << 8) | evt[2];
+				if (total >= 6 + elen)
+					break;
+			}
+		}
+		if (total >= 4 && evt[0] == WMT_STP_HDR_SYNC) {
+			dev_info(c->dev, "WMT[%s] RX try%d %*ph\n",
+				 label, retry, (int)total, evt);
+			return (int)total;
+		}
+		dev_info(c->dev, "WMT[%s] try%d: no STP event (%u bytes) — re-waking\n",
+			 label, retry, total);
+		while (mtk_btif_recv(c->btif, drain, sizeof(drain), 5) > 0)
+			;
+	}
+	dev_warn(c->dev, "WMT[%s] no event after 8 tries (timeout)\n", label);
+	return -ETIMEDOUT;
+}
+
+/* Raw (un-framed) BTIF send, retrying while the 8KB TX vFIFO is full.
+ * mtk_btif_send() returns 0 (not an error) when the ring has no room, so a
+ * 22KB PDA stream sent in 1000-byte frags would be silently dropped after ~8
+ * frags without this.  The PDA body is raw bytes (vendor wmt_core_tx with
+ * bRawFlag=TRUE -> mtk_wcn_stp_send_data_raw -> straight to BTIF, no STP frame). */
+static int conn_btif_send_raw(struct mtk_conninfra *c, const u8 *buf, u32 len)
+{
+	int n, tries;
+
+	/* ~10000 * 300us = ~3s cap; the engine drains a 1000-byte frag in well
+	 * under a ms, so this only spins when genuinely backpressured. */
+	for (tries = 0; tries < 10000; tries++) {
+		n = mtk_btif_send(c->btif, buf, len);
+		if (n == (int)len)
+			return 0;
+		if (n < 0)
+			return n;
+		/* n == 0: TX vFIFO full — let the engine drain, then retry. */
+		usleep_range(200, 400);
+	}
+	return -ETIMEDOUT;
+}
+
+/* Boot the conn-MCU firmware: stream the conn-MCU ROM patch (soc1_0_patch_mcu)
+ * to its PDA loader over STP/BTIF, then WMT_RESET to make the MCU branch into and
+ * EXECUTE it.  THIS is the gate.  After conn_infra power the MCU only reaches ROM
+ * idle (COM_REG0 == 0x1D1E); in that state it services WMT opcode 0x01 (PDA_CFG)
+ * but NOT opcode 0x04 (QUERY_STP) or 0x06 (FUNCTION_CTRL), which need the running
+ * firmware — which is exactly why our earlier bare query_stp/func_ctrl got zero
+ * reply.  Running the firmware is what powers the WFSYS island and boots the WiFi
+ * N9, so the wmac driver-own (FW_OWN @ CONN_HIF_ON_LPCTL 0x18007000) can clear.
+ * Ported from vendor mtk_wcn_soc_pda_patch_dwn (wmt_ic_soc.c:3079) + init_table_3
+ * WMT_RESET (wmt_ic_soc.c:801).  begonia wmt_ic_ops_soc.options=0 => exactly one
+ * patch, 28-byte WMT_PATCH header strip, no 2-byte checksum, no get_a_die. */
+static int mtk_conninfra_pda_patch_dwn(struct mtk_conninfra *c)
+{
+	static const u8 cfg_evt[5] = { 0x02, 0x01, 0x01, 0x00, 0x00 };
+	static const u8 rst_cmd[5] = { 0x01, 0x07, 0x01, 0x00, 0x04 };
+	static const u8 rst_evt[5] = { 0x02, 0x07, 0x01, 0x00, 0x00 };
+	u8 cfg_cmd[21] = {
+		0x01, 0x01, 0x11, 0x00, 0x00,	/* WMT CMD, PDA_CFG op, len=0x0011 */
+		0, 0, 0, 0,			/* [5..8]  PDA target address (LE) */
+		0, 0, 0, 0,			/* [9..12] download size (LE) */
+		0, 0, 0, 0,			/* [13..16] scramble key = 0 */
+		0x2f, 0x02, 0x02, 0x00,		/* [17..20] config */
+	};
+	const struct firmware *fw;
+	const u8 *body, *h;
+	u32 addr, body_sz, nfrag, off, i;
+	u8 pda_hdr[12];
+	u8 evt[40];
+	int n, ret;
+
+	ret = request_firmware(&fw, CONN_MCU_FW_PATCH_MCU, c->dev);
+	if (ret) {
+		dev_err(c->dev, "PDA: request_firmware(%s) failed: %d\n",
+			CONN_MCU_FW_PATCH_MCU, ret);
+		return ret;
+	}
+	if (fw->size <= WMT_PATCH_HDR_LEN) {
+		dev_err(c->dev, "PDA: patch too small (%zu)\n", fw->size);
+		release_firmware(fw);
+		return -EINVAL;
+	}
+
+	/* addressByte = u4PatchAddr at WMT_PATCH header offset 0x18 (LE); body
+	 * follows the 28-byte header (no checksum because options=0). */
+	h = fw->data;
+	addr = h[0x18] | (h[0x19] << 8) | (h[0x1a] << 16) | (h[0x1b] << 24);
+	body = fw->data + WMT_PATCH_HDR_LEN;
+	body_sz = fw->size - WMT_PATCH_HDR_LEN;
+
+	cfg_cmd[5]  = addr & 0xff;
+	cfg_cmd[6]  = (addr >> 8) & 0xff;
+	cfg_cmd[7]  = (addr >> 16) & 0xff;
+	cfg_cmd[8]  = (addr >> 24) & 0xff;
+	cfg_cmd[9]  = body_sz & 0xff;
+	cfg_cmd[10] = (body_sz >> 8) & 0xff;
+	cfg_cmd[11] = (body_sz >> 16) & 0xff;
+	cfg_cmd[12] = (body_sz >> 24) & 0xff;
+
+	nfrag = (body_sz + DEFAULT_PATCH_FRAG_SIZE - 1) / DEFAULT_PATCH_FRAG_SIZE;
+	dev_info(c->dev,
+		 "PDA: %s addr=0x%08x body=0x%x frags=%u — booting conn-MCU fw\n",
+		 CONN_MCU_FW_PATCH_MCU, addr, body_sz, nfrag);
+
+	/* r115 BTIF0 RX-arm: read the conn BTIF0 front-end at THIS exact idle point
+	 * (rigorous same-point baseline vs stock's idle snapshot), and if btif0_arm,
+	 * write it to stock's idle config (0x04=1, 0x0c=3, 0x4c=1) so the conn receiver
+	 * is enabled before the first WMT byte.  conn BTIF0 0x180A2000 is AP-writable
+	 * via the connac bus2chip window (chip 0x80030000). */
+	{
+		void __iomem *bt = ioremap(0x180A2000u, 0x1000);
+
+		if (bt) {
+			dev_info(c->dev,
+				 "BTIF0_BASELINE @idle: 04=%08x 08=%08x 0c=%08x 14=%08x 4c=%08x\n",
+				 readl(bt + 0x04), readl(bt + 0x08), readl(bt + 0x0c),
+				 readl(bt + 0x14), readl(bt + 0x4c));
+			if (btif0_arm) {
+				writel(0x1u, bt + 0x04);
+				writel(0x3u, bt + 0x0c);
+				writel(0x1u, bt + 0x4c);
+				dev_info(c->dev,
+					 "BTIF0_ARM set -> 04=%08x 0c=%08x 4c=%08x (stock idle config)\n",
+					 readl(bt + 0x04), readl(bt + 0x0c), readl(bt + 0x4c));
+			}
+			iounmap(bt);
+		}
+	}
+
+	/* r114 DIAGNOSTIC (oracle .research/oracle-tx-trace.txt): stock's FIRST
+	 * post-idle BTIF transaction is wmt_core_hw_check() — a chip-ID READ of
+	 * GEN_HCR (0x80000008, mask 0x0000FFFF), NOT the PDA.  Mainline detects the
+	 * chip via AP-MMIO and so makes the PDA its first-ever BTIF round-trip,
+	 * which dies n=-110.  Replicate stock's read to learn whether the conn-MCU
+	 * BTIF receiver answers ANY frame at idle.  Brick-safe (a register read).
+	 * Bytes match trace frame#1 exactly (wmt_core.c WMT_SET_REG_CMD layout). */
+	{
+		static const u8 hwck[20] = {
+			0x01, 0x08, 0x10, 0x00,	/* WMT CMD, opcode 0x08 reg-access, len 16 */
+			0x02, 0x01, 0x00, 0x01,	/* op=read(2), type=reg(1), 1 register */
+			0x08, 0x00, 0x00, 0x80,	/* addr = GEN_HCR = 0x80000008 (LE) */
+			0x00, 0x00, 0x00, 0x00,	/* value (ignored on read) */
+			0xff, 0xff, 0x00, 0x00,	/* mask = GEN_HCR_MASK = 0x0000FFFF */
+		};
+		int hn = conn_wmt_cmd(c, hwck, sizeof(hwck), evt, sizeof(evt),
+				      "hwcheck");
+
+		if (hn >= 18 && evt[4] == 0x02 && evt[5] == 0x08)
+			dev_info(c->dev,
+				 "HWCHECK: RD_EVT ok (n=%d) chipid=0x%02x%02x — conn BTIF RX/TX LIVE at idle\n",
+				 hn, evt[17], evt[16]);
+		else
+			dev_err(c->dev,
+				"HWCHECK: no/bad RD_EVT (n=%d) — conn BTIF receiver NOT answering at idle\n",
+				hn);
+	}
+
+	/* Step 1: PDA config CMD (STP-framed, opcode 0x01) -> await CFG_EVT.
+	 * This reply is the DECISIVE go/no-go: it proves the conn-MCU ROM is alive
+	 * at 0x1D1E AND the BTIF RX path delivers upstream STP frames. */
+	n = conn_wmt_cmd(c, cfg_cmd, sizeof(cfg_cmd), evt, sizeof(evt), "pda_cfg");
+	if (n < 9 || memcmp(evt + 4, cfg_evt, sizeof(cfg_evt)) != 0) {
+		dev_err(c->dev,
+			"PDA: CFG_EVT bad/none (n=%d) — conn-MCU ROM not answering PDA over BTIF\n",
+			n);
+		ret = -EIO;
+		goto out;
+	}
+	dev_info(c->dev, "PDA: CFG_EVT OK — conn-MCU ROM ALIVE, streaming patch\n");
+
+	/* Step 2: 12-byte PDA header (raw): LE (body_sz + 12), rest zero. */
+	memset(pda_hdr, 0, sizeof(pda_hdr));
+	pda_hdr[0] = (body_sz + 12) & 0xff;
+	pda_hdr[1] = ((body_sz + 12) >> 8) & 0xff;
+	pda_hdr[2] = ((body_sz + 12) >> 16) & 0xff;
+	pda_hdr[3] = ((body_sz + 12) >> 24) & 0xff;
+	ret = conn_btif_send_raw(c, pda_hdr, sizeof(pda_hdr));
+	if (ret) {
+		dev_err(c->dev, "PDA: pda_hdr send failed: %d\n", ret);
+		goto out;
+	}
+
+	/* Step 3: stream the body raw in 1000-byte fragments (fire-and-forget). */
+	for (i = 0, off = 0; i < nfrag; i++, off += DEFAULT_PATCH_FRAG_SIZE) {
+		u32 flen = min_t(u32, DEFAULT_PATCH_FRAG_SIZE, body_sz - off);
+
+		ret = conn_btif_send_raw(c, body + off, flen);
+		if (ret) {
+			dev_err(c->dev, "PDA: frag %u/%u send failed: %d\n",
+				i, nfrag, ret);
+			goto out;
+		}
+	}
+	dev_info(c->dev, "PDA: streamed %u frags (0x%x bytes) OK\n", nfrag, body_sz);
+
+	/* Step 4: WMT_RESET (STP-framed) -> await RESET_EVT.  Makes the conn-MCU
+	 * branch into the downloaded firmware and run it -> WFSYS/N9 powered. */
+	n = conn_wmt_cmd(c, rst_cmd, sizeof(rst_cmd), evt, sizeof(evt), "wmt_reset");
+	if (n < 9 || memcmp(evt + 4, rst_evt, sizeof(rst_evt)) != 0) {
+		dev_warn(c->dev,
+			 "PDA: WMT_RESET_EVT bad/none (n=%d) — fw may not be running\n", n);
+		ret = -EIO;
+		goto out;
+	}
+	dev_info(c->dev, "PDA: WMT_RESET OK — conn-MCU now EXECUTING firmware\n");
+	/* The running firmware speaks FULLSET STP (seq/ack/crc); switch framing so
+	 * the post-RESET query_stp/set_stp/func_ctrl are accepted. */
+	stp_fullset = true;
+	ret = 0;
+out:
+	release_firmware(fw);
+	return ret;
+}
+
+/* Boot the conn-MCU firmware (PDA patch-dwn + WMT_RESET), then run the WMT/STP
+ * session and turn the WiFi function on.  CORRECTED ROOT CAUSE: our earlier
+ * tests sent query_stp/func_ctrl while the conn-MCU was still in ROM idle
+ * (COM_REG0=0x1D1E), where it services ONLY the PDA loader (opcode 0x01) — WMT
+ * ops (query_stp 0x04, func_ctrl 0x06) have no ROM handler and are silently
+ * dropped (TX drained, rx vFIFO empty).  The firmware that handles WMT ops — and
+ * that powers WFSYS + boots the WiFi N9 — only runs after the PDA patch download
+ * and WMT_RESET (vendor mtk_wcn_soc_sw_init, .pda_dl_patch_flag=1: the
+ * _wmt_soc_mode_ctrl query_stp/set_stp/full-mode handshake at wmt_ic_soc.c:1340
+ * runs AFTER patch_dwn, not before).  So we now do the PDA boot FIRST, then the
+ * session, then FUNCTION_CTRL. */
+static int mtk_conninfra_wmt_func_ctrl(struct mtk_conninfra *c, u8 func, bool on)
+{
+	static const u8 query_stp[] = { 0x01, 0x04, 0x01, 0x00, 0x04 };
+	static const u8 set_stp[]   = { 0x01, 0x04, 0x05, 0x00, 0x03,
+					0xdb, 0x0e, 0x68, 0x01 };
+	u8 func_ctrl[6] = { WMT_PKT_TYPE_CMD, WMT_OPCODE_FUNC_CTRL,
+			    0x02, 0x00, func, on ? 1 : 0 };
+	u8 evt[40];
+	unsigned int elen;
+	int n, ret_pda;
+
+	/* Take BGFSYS driver-ownership so the combo MCU is awake to service BTIF. */
+	mtk_conninfra_bgf_fw_own_clr(c);
+	mtk_btif_dump(c->btif, "pre-init");
+
+	/* r113b: poke the full stock CIRQ mask BEFORE any frame.  The conn is at idle
+	 * here (COM_REG0=0x1D1E) and has already set its own mask to 0x8000B100; we
+	 * overwrite to the stock superset 0x8087B380 so the 6 extra IRQ sources (incl.
+	 * the DMA-RX-done that wakes the receiver) are unmasked when the first PDA
+	 * frame arrives. */
+	if (cirq_unmask) {
+		void __iomem *cq = ioremap(0x180A5000u, 0x1000);
+
+		if (cq) {
+			u32 pre = readl(cq + 0xb0);
+
+			writel(0x8087B380u, cq + 0xb0);
+			dev_info(c->dev,
+				 "cirq_unmask: 0x180A50B0 0x%08x -> 0x%08x (stock superset; +bits 7,9,16,17,18,23)\n",
+				 pre, readl(cq + 0xb0));
+			iounmap(cq);
+		} else {
+			dev_warn(c->dev, "cirq_unmask: ioremap(0x180A5000) failed\n");
+		}
+	}
+
+	/* r113 conn_rx_pio: route conn BTIF0 RX to PIO so arriving bytes hit RBR (DR)
+	 * and the PIO RX IRQ can fire (the DMA-completion IRQ never wakes the receiver). */
+	if (conn_rx_pio) {
+		void __iomem *bt = ioremap(0x180A2000u, 0x1000);
+
+		if (bt) {
+			u32 de = readl(bt + 0x4c);
+			u32 ie = readl(bt + 0x04);
+
+			writel(de & ~0x1u, bt + 0x4c);	/* clear RX-DMA enable -> PIO RX */
+			writel(ie | 0x1u, bt + 0x04);	/* set ERBFI (RX-data-avail IRQ) */
+			dev_info(c->dev,
+				 "conn_rx_pio: conn BTIF0 dmaen 0x%08x->0x%08x ier 0x%08x->0x%08x\n",
+				 de, readl(bt + 0x4c), ie, readl(bt + 0x04));
+			iounmap(bt);
+		} else {
+			dev_warn(c->dev, "conn_rx_pio: ioremap(0x180A2000) failed\n");
+		}
+	}
+
+	/* Step 0: STP inband-reset so the MCU re-zeros its sequence state and will
+	 * accept our seq=0 frames (without this it drops everything silently). */
+	mtk_conninfra_stp_inband_reset(c);
+	mtk_btif_dump(c->btif, "after-reset");
+
+	/* THE GATE: boot the conn-MCU firmware before any WMT op.  The ROM-idle MCU
+	 * (COM_REG0=0x1D1E) only services PDA opcode 0x01; query_stp(0x04)/
+	 * func_ctrl(0x06) are silently dropped until the firmware runs.  This streams
+	 * the ROM patch over PDA + WMT_RESET, after which the firmware powers WFSYS,
+	 * boots the WiFi N9, and the WMT ops below + the wmac driver-own succeed. */
+	ret_pda = mtk_conninfra_pda_patch_dwn(c);
+	if (ret_pda) {
+		dev_warn(c->dev,
+			 "PDA patch-dwn failed (%d) — WFSYS will stay dark; continuing for diagnostics\n",
+			 ret_pda);
+	} else {
+		msleep(50);				/* let the conn-MCU boot its fw */
+		/* The WMT_RESET re-inits the MCU's STP state; re-zero our seq so the
+		 * session commands below are accepted. */
+		mtk_conninfra_stp_inband_reset(c);
+		mtk_btif_dump(c->btif, "after-wmt-reset");
+	}
+
+	/* Step 1: WMT_QUERY_STP — first command of a fresh BTIF-full session. */
+	n = conn_wmt_cmd(c, query_stp, sizeof(query_stp), evt, sizeof(evt),
+			 "query_stp");
+	mtk_btif_dump(c->btif, "after-query");
+	if (n <= 0) {
+		dev_warn(c->dev, "WMT session: query_stp got NO reply — STP session not open; trying func_ctrl anyway for diagnostics\n");
+	} else {
+		dev_info(c->dev, "WMT session: query_stp REPLIED (%d) — STP ALIVE\n", n);
+		/* Step 2: WMT_SET_STP, then settle, then re-query (full mode). */
+		conn_wmt_cmd(c, set_stp, sizeof(set_stp), evt, sizeof(evt), "set_stp");
+		msleep(10);
+		conn_wmt_cmd(c, query_stp, sizeof(query_stp), evt, sizeof(evt),
+			     "query_stp2");
+	}
+
+	/* Step 7: FUNCTION_CTRL, now that the session is established. */
+	n = conn_wmt_cmd(c, func_ctrl, sizeof(func_ctrl), evt, sizeof(evt),
+			 "func_ctrl");
+	mtk_btif_dump(c->btif, "after-func");
+	if (n <= 0)
+		return -ETIMEDOUT;
+
+	elen = ((evt[1] & 0x0f) << 8) | evt[2];
+	if (n >= 6 && elen >= 1 && 4 + elen <= (unsigned)n && evt[4 + elen - 1] == 0) {
+		dev_info(c->dev, "WMT func_ctrl(func=%u,on=%d): MCU acked status 0\n",
+			 func, on);
+		return 0;
+	}
+	dev_warn(c->dev, "WMT func_ctrl: event received but status != 0 / malformed\n");
+	return -EIO;
+}
+
+/* Acquire a *real* A-die supply.  We use _get_optional (not _get) precisely so
+ * a supply missing from DT returns -ENODEV instead of a dummy regulator that
+ * silently no-ops on enable() — a dummy left the begonia A-die unpowered and
+ * the WFSYS rgu un-armed for many iterations.  Any error here is fatal. */
+static int mtk_conninfra_get_supply(struct mtk_conninfra *c, const char *id,
+				    struct regulator **out)
+{
+	struct regulator *reg = devm_regulator_get_optional(c->dev, id);
+
+	if (IS_ERR(reg))
+		return dev_err_probe(c->dev, PTR_ERR(reg),
+				     "regulator %s not wired in DT (A-die would be unpowered)\n",
+				     id);
+	*out = reg;
+	return 0;
+}
+
+static int mtk_conninfra_enable_one(struct mtk_conninfra *c,
+				    struct regulator *reg, const char *id, int uv)
+{
+	int rc = regulator_set_voltage(reg, uv, uv);
+
+	if (rc)
+		return dev_err_probe(c->dev, rc, "set %s voltage\n", id);
+	rc = regulator_enable(reg);
+	if (rc)
+		return dev_err_probe(c->dev, rc, "enable %s\n", id);
+	return 0;
+}
+
+/* Set the LDO's SW operator-enable bit *before* regulator_enable, matching the
+ * vendor pmic_ldo_xxx_lp(SW, 1, 1, SW_OFF) call that precedes each enable. */
+static void mtk_conninfra_ldo_sw_op_en(struct mtk_conninfra *c, u16 op_en_reg)
+{
+	if (c->pmic)
+		regmap_update_bits(c->pmic, op_en_reg,
+				   MT6359_LDO_SW_OP_EN, MT6359_LDO_SW_OP_EN);
+}
+
+/* After regulator_enable, tie the A-die LDO to SRCLKEN0 hardware low-power
+ * control — the vendor pmic_ldo_xxx_lp(SRCLKEN0, 1, 1, HW_LP/HW_OFF) sequence:
+ * clear the SW LP request, set OP_MODE for SRCLKEN0, enable the SRCLKEN0
+ * operator, and set its config (HW_LP=1 for VCN18, HW_OFF=0 for VCN33_2). The
+ * SW operator (set above) + regulator_enable keep the rail on; this just lets
+ * it follow SRCLKEN0 in hardware. Reads back + logs so we can confirm on
+ * hardware that the PMIC writes stick. */
+static void mtk_conninfra_ldo_hw_mode(struct mtk_conninfra *c, const char *name,
+				      u16 con0, u16 op_en, u16 op_cfg, bool hw_lp)
+{
+	u32 c0 = 0, oe = 0, oc = 0;
+
+	if (!c->pmic)
+		return;
+	regmap_update_bits(c->pmic, con0, MT6359_LDO_LP, 0);
+	regmap_update_bits(c->pmic, con0, MT6359_LDO_OP_MODE_SRCLKEN0,
+			   MT6359_LDO_OP_MODE_SRCLKEN0);
+	regmap_update_bits(c->pmic, op_en, MT6359_LDO_HW0_OP, MT6359_LDO_HW0_OP);
+	regmap_update_bits(c->pmic, op_cfg, MT6359_LDO_HW0_OP,
+			   hw_lp ? MT6359_LDO_HW0_OP : 0);
+
+	regmap_read(c->pmic, con0, &c0);
+	regmap_read(c->pmic, op_en, &oe);
+	regmap_read(c->pmic, op_cfg, &oc);
+	dev_info(c->dev,
+		 "%s SRCLKEN0 %s: CON0[0x%x]=0x%04x OP_EN[0x%x]=0x%04x OP_CFG[0x%x]=0x%04x\n",
+		 name, hw_lp ? "HW_LP" : "HW_OFF", con0, c0, op_en, oe, op_cfg, oc);
+}
+
+static int mtk_conninfra_enable_supplies(struct mtk_conninfra *c)
+{
+	int rc;
+
+	rc = mtk_conninfra_get_supply(c, "vcn18", &c->vcn18);
+	if (rc)
+		return rc;
+	rc = mtk_conninfra_get_supply(c, "vcn33_1_wifi", &c->vcn33_1_wifi);
+	if (rc)
+		return rc;
+	rc = mtk_conninfra_get_supply(c, "vcn33_2_wifi", &c->vcn33_2_wifi);
+	if (rc)
+		return rc;
+
+	/* vendor consys_hw_vcn18_ctrl: SW_OP_EN, enable VCN18 (1.8V), then tie to
+	 * SRCLKEN0 HW_LP. Then VCN33_1 (3.3V) — left in SW mode (no LP cfg). */
+	mtk_conninfra_ldo_sw_op_en(c, VCN18_LDO_OP_EN);
+	rc = mtk_conninfra_enable_one(c, c->vcn18, "vcn18", VCN18_MICROVOLT);
+	if (rc)
+		return rc;
+	mtk_conninfra_ldo_hw_mode(c, "vcn18", VCN18_LDO_CON0, VCN18_LDO_OP_EN,
+				  VCN18_LDO_OP_CFG, true /* HW_LP */);
+
+	rc = mtk_conninfra_enable_one(c, c->vcn33_1_wifi, "vcn33_1_wifi",
+				      VCN33_1_WIFI_MICROVOLT);
+	if (rc)
+		goto err_vcn18;
+	/* vendor consys_hw_vcn28_ctrl: SW_OP_EN, enable VCN33_2 (2.8V), then tie to
+	 * SRCLKEN0 HW_OFF. (begonia runtime co_clock_type==1, but the net VCN33_2
+	 * state is identical to the co_clock_type==0 path.) */
+	mtk_conninfra_ldo_sw_op_en(c, VCN33_2_LDO_OP_EN);
+	rc = mtk_conninfra_enable_one(c, c->vcn33_2_wifi, "vcn33_2_wifi",
+				      VCN33_2_WIFI_MICROVOLT);
+	if (rc)
+		goto err_vcn33_1;
+	mtk_conninfra_ldo_hw_mode(c, "vcn33_2", VCN33_2_LDO_CON0, VCN33_2_LDO_OP_EN,
+				  VCN33_2_LDO_OP_CFG, false /* HW_OFF */);
+
+	dev_info(c->dev,
+		 "A-die supplies: vcn18=%duV vcn33_1_wifi=%duV vcn33_2_wifi=%duV enabled\n",
+		 VCN18_MICROVOLT, VCN33_1_WIFI_MICROVOLT, VCN33_2_WIFI_MICROVOLT);
+	return 0;
+
+err_vcn33_1:
+	regulator_disable(c->vcn33_1_wifi);
+err_vcn18:
+	regulator_disable(c->vcn18);
+	return rc;
+}
+
+static void mtk_conninfra_disable_supplies(struct mtk_conninfra *c)
+{
+	if (c->vcn33_2_wifi)
+		regulator_disable(c->vcn33_2_wifi);
+	if (c->vcn33_1_wifi)
+		regulator_disable(c->vcn33_1_wifi);
+	if (c->vcn18)
+		regulator_disable(c->vcn18);
+}
+
+static void mtk_conninfra_pinmux(struct mtk_conninfra *c)
+{
+	u32 v, before;
+
+	before = readl(c->pinctrl + PINMUX_01_OFFSET);
+	v = (before & PINMUX_01_MASK) | PINMUX_01_VALUE;
+	writel(v, c->pinctrl + PINMUX_01_OFFSET);
+	dev_info(c->dev, "pinmux pinctrl[0x%03x] 0x%08x -> 0x%08x\n",
+		 PINMUX_01_OFFSET, before, readl(c->pinctrl + PINMUX_01_OFFSET));
+
+	before = readl(c->pinctrl + PINMUX_02_OFFSET);
+	v = (before & PINMUX_02_MASK) | PINMUX_02_VALUE;
+	writel(v, c->pinctrl + PINMUX_02_OFFSET);
+	dev_info(c->dev, "pinmux pinctrl[0x%03x] 0x%08x -> 0x%08x\n",
+		 PINMUX_02_OFFSET, before, readl(c->pinctrl + PINMUX_02_OFFSET));
+
+	before = readl(c->iocfg_lm + IOCFG_LM_00_OFFSET);
+	v = (before & IOCFG_LM_00_MASK) | IOCFG_LM_00_VALUE;
+	writel(v, c->iocfg_lm + IOCFG_LM_00_OFFSET);
+	dev_info(c->dev, "pinmux iocfg_lm[0x%03x] 0x%08x -> 0x%08x\n",
+		 IOCFG_LM_00_OFFSET, before,
+		 readl(c->iocfg_lm + IOCFG_LM_00_OFFSET));
+
+	/* vendor udelay(150) after pinmux switch */
+	usleep_range(150, 200);
+}
+
+static void mtk_conninfra_set_con_pwr_on(struct mtk_conninfra *c)
+{
+	void __iomem *reg = c->infracfg_ao + INFRACFG_AO_CON_PWR_ON_OFFSET;
+	u32 before = readl(reg);
+	u32 after  = before | INFRACFG_AO_CON_PWR_ON_BIT;
+
+	writel(after, reg);
+	dev_info(c->dev, "CON_PWR_ON: infracfg_ao[0x%03x] 0x%08x -> 0x%08x\n",
+		 INFRACFG_AO_CON_PWR_ON_OFFSET, before, readl(reg));
+}
+
+/* Port of vendor consys_hw_reset_bit_set(enable).
+ *
+ *   assert=true:  set BIT(12) + write 0x88 key in top byte at ap_rgu+0x18.
+ *                 Asserts the consys CPU SW reset. Must be called BEFORE
+ *                 the CONN power-domain is brought up so the MCU is in
+ *                 reset when power is applied.
+ *   assert=false: clear BIT(12) + write 0x88 key. Releases the MCU.
+ *
+ * Vendor source: mt6785.c consys_hw_reset_bit_set + mt6785.h
+ *   CONSYS_CPU_SW_RST_OFFSET=0x18, CONSYS_CPU_SW_RST_BIT=BIT(12),
+ *   CONSYS_CPU_SW_RST_CTRL_KEY=(0x88 << 24).
+ *
+ * The 0x88 key in the top byte is mandatory — every write to this register
+ * must include it or the hardware silently drops the write.
+ */
+static void mtk_conninfra_cpu_sw_reset(struct mtk_conninfra *c, bool assert)
+{
+	void __iomem *reg = c->ap_rgu + AP_RGU_CONSYS_CPU_SW_RST_OFFSET;
+	u32 cur = readl(reg);
+	u32 next;
+
+	/* Force the top-byte key to exactly 0x88. OR-ing 0x88<<24 onto the
+	 * existing value would leave any pre-set bits in 24..31 in place,
+	 * which would not form the required key and the write would silently
+	 * be dropped by the hardware. Mask the top byte to 0 first. */
+	next = (cur & 0x00ffffffu) | AP_RGU_CONSYS_SW_RST_KEY;
+	if (assert)
+		next |= AP_RGU_CONSYS_CPU_SW_RST_BIT;
+	else
+		next &= ~AP_RGU_CONSYS_CPU_SW_RST_BIT;
+
+	writel(next, reg);
+	dev_info(c->dev, "consys CPU SW reset %s: ap_rgu[0x%02x] 0x%08x -> 0x%08x\n",
+		 assert ? "ASSERT" : "RELEASE",
+		 AP_RGU_CONSYS_CPU_SW_RST_OFFSET, cur, readl(reg));
+}
+
+/* Release the AP->conn_infra INFRA TOPAXI bus-protection (infracfg@0x10001000).
+ * THE fix for "all 0x18xxxxxx reads return 0": the SPM CONN MTCMOS is powered
+ * but the AP-side bus to consys is isolated until these protect bits clear.
+ * scpsys is supposed to do this on power-on, but the CONN domain has no
+ * upstream DT consumer -> genpd re-disables it as "unused" -> protection
+ * re-asserts; and its bp_cfg uses WR_IGN (no STA poll) so a failed clear is
+ * silent. We clear + poll STA ourselves. write-1-to-CLR; do NOT RMW. */
+static int mtk_conninfra_release_ap2conn_busprot(struct mtk_conninfra *c)
+{
+	u32 v = 0;
+	int i;
+
+	writel(CONN_TOPAXI_PROT_0_MASK, c->infracfg + INFRA_TOPAXI_PROTECTEN_CLR);
+	for (i = 0; i < 20; i++) {
+		v = readl(c->infracfg + INFRA_TOPAXI_PROTECTEN_STA1);
+		if (!(v & CONN_TOPAXI_PROT_0_MASK))
+			break;
+		usleep_range(1000, 2000);
+	}
+	if (v & CONN_TOPAXI_PROT_0_MASK) {
+		dev_err(c->dev,
+			"TOPAXI_PROTECTEN STA1[0x10001228]=0x%08x bits 0x%lx stuck\n",
+			v, (unsigned long)CONN_TOPAXI_PROT_0_MASK);
+		return -ETIMEDOUT;
+	}
+
+	writel(CONN_TOPAXI_PROT_1_MASK, c->infracfg + INFRA_TOPAXI_PROTECTEN_1_CLR);
+	for (i = 0; i < 20; i++) {
+		v = readl(c->infracfg + INFRA_TOPAXI_PROTECTEN_1_STA1);
+		if (!(v & CONN_TOPAXI_PROT_1_MASK))
+			break;
+		usleep_range(1000, 2000);
+	}
+	if (v & CONN_TOPAXI_PROT_1_MASK) {
+		dev_err(c->dev,
+			"TOPAXI_PROTECTEN_1 STA1[0x10001258]=0x%08x bit10 stuck\n", v);
+		return -ETIMEDOUT;
+	}
+
+	dev_info(c->dev,
+		 "AP->conn TOPAXI bus-protect released (STA1[0x228]&0x46000=0, STA1_1[0x258]&0x400=0)\n");
+	return 0;
+}
+
+/* Vendor gen4m wf_pwr_on_consys_mcu (soc3_0.c:2007-2054): wake the
+ * conn_infra-off island and release AP2CONN sleep-protection so the
+ * conn_infra-off register bus responds. Without this, the genpd CONN domain
+ * + CON_PWR_ON power consys but its register windows (0x180b1xxx VER_ID,
+ * 0x18001000 CONN_HW_VER) read clean 0x0. */
+static int mtk_conninfra_wake_conn_infra_off(struct mtk_conninfra *c)
+{
+	u32 v, hwver = 0;
+	int i;
+
+	/* Wakeup conn_infra-off: 0x180601A4[0] = 1. */
+	v = readl(c->host_csr + CONN_INFRA_WAKEUP_WF_OFFSET);
+	writel(v | BIT(0), c->host_csr + CONN_INFRA_WAKEUP_WF_OFFSET);
+	dev_info(c->dev, "conn_infra wakeup: host_csr[0x1a4] 0x%08x -> 0x%08x\n",
+		 v, readl(c->host_csr + CONN_INFRA_WAKEUP_WF_OFFSET));
+
+	/* Assert + HOLD the AP2CONN wakeup (INFRACFG_AO+0xf00 bit9, cleared-to-
+	 * assert) so conn_infra-off stays awake for the (later, async) WiFi-N9
+	 * driver-own at 0x18007000 — the vendor force_trigger pulses it; we hold
+	 * it so FW_OWN can actually clear and the N9 services fw-download cmds. */
+	v = readl(c->infracfg + CONSYS_AP2CONN_OSC_EN_OFFSET);
+	writel(v & ~CONSYS_AP2CONN_WAKEUP_BIT,
+	       c->infracfg + CONSYS_AP2CONN_OSC_EN_OFFSET);
+	dev_info(c->dev, "AP2CONN wake: infracfg[0xf00] 0x%08x -> 0x%08x (held)\n",
+		 v, readl(c->infracfg + CONSYS_AP2CONN_OSC_EN_OFFSET));
+
+	/* Poll AP2CONN sleep-protect ACK clear: 0x18060184[5] == 0. */
+	for (i = 0; i < 20; i++) {
+		v = readl(c->host_csr + CONN_ON2OFF_SLP_PROT_ACK_OFFSET);
+		if (!(v & CONN_ON2OFF_SLP_PROT_ACK_BIT))
+			break;
+		usleep_range(1000, 2000);
+	}
+	if (v & CONN_ON2OFF_SLP_PROT_ACK_BIT) {
+		dev_err(c->dev,
+			"AP2CONN slp-prot ACK stuck: host_csr[0x184]=0x%08x (bit5 set)\n",
+			v);
+		return -ETIMEDOUT;
+	}
+
+	/* Poll CONN_HW_VER 0x18001000 == 0x20010000 — proves conn_infra-off bus alive. */
+	for (i = 0; i < 20; i++) {
+		hwver = readl(c->conn_infra_cfg + CONN_HW_VER_OFFSET);
+		if (hwver == CONN_HW_VER_EXPECTED)
+			break;
+		usleep_range(1000, 2000);
+	}
+	dev_info(c->dev,
+		 "conn_infra-off woke: slp_ack[0x18060184]=0x%08x  CONN_HW_VER[0x18001000]=0x%08x (want 0x20010000)\n",
+		 v, hwver);
+	return 0;
+}
+
+static int mtk_conninfra_check_ver_id(struct mtk_conninfra *c)
+{
+	u32 ver = 0, conf = 0;
+	int i;
+
+	/* Vendor polling_consys_chipid retries up to 10x at msleep(20) (~200ms)
+	 * AFTER the full power/reset choreography settles. Our old 10x1ms (~10ms)
+	 * loop was too tight: from a true cold start the consys-internal 0x180b1xxx
+	 * window does not return a stable IP-version word until the CONNSYS clock
+	 * tree spins up. Give it up to ~1s. */
+	for (i = 0; i < 50; i++) {
+		ver = readl(c->conn_top_misc_off + VER_ID_OFFSET);
+		conf = readl(c->conn_top_misc_off + CONF_ID_OFFSET);
+		if (ver == CONSYS_IP_VER_ID_EXPECTED)
+			break;
+		msleep(20);
+	}
+
+	dev_info(c->dev,
+		 "VER_ID[0x180b1010]=0x%08x  CONF_ID[0x180b1014]=0x%08x (after %d poll%s)\n",
+		 ver, conf, i + 1, i ? "s" : "");
+
+	if (ver == CONSYS_IP_VER_ID_EXPECTED) {
+		dev_info(c->dev, "bring-up done: consys VER_ID = 0x%08x\n", ver);
+		return 0;
+	}
+	dev_err(c->dev,
+		"bring-up failed: VER_ID=0x%08x (expected 0x%08x) — consys did not power on\n",
+		ver, CONSYS_IP_VER_ID_EXPECTED);
+	return -ENODEV;
+}
+
+/* conn_infra POS (Platform Operation Sequence). Ported from the begonia-family
+ * mt6781_pos_gen.c ops, in the order mtk_wcn_consys_hw_reg_ctrl(on=1) invokes
+ * them. Per the vendor caller these run AFTER VER_ID but BEFORE the conn CPU
+ * reset release — the caller does it WHILE the reset is asserted. Several CRs
+ * (EMI entry, some AFE) are reset-protected and only latch in that state, which
+ * is why running them late (post reset-release, in the wmac probe) left them 0. */
+static void mtk_conninfra_pos_setup(struct mtk_conninfra *c)
+{
+	u32 v, clkchk;
+
+	/* DIAGNOSTIC: conn_infra HW bus-clock liveness (vendor consys_check_reg_readable,
+	 * gen4m mt6785.c:1357): write CLOCK_CHECK_VALUE to mcu_conn_hif_on @ 0x18007000,
+	 * udelay(1000) settle, read back; bit16=HCLK, bit17=OSCCLK both set => conn_infra
+	 * HW bus clock alive. Vendor uses the 1ms settle (we omitted it before) + this is
+	 * a self-test. Poll a few times: if HCLK/OSCCLK never come up despite full CONN
+	 * power, it's strong evidence the conn MCU needs firmware to raise its own clocks. */
+	{
+		int k;
+		for (k = 0; k < 5; k++) {
+			writel(CONN_HIF_ON_CLOCK_CHECK_VALUE,
+			       c->conn_hif_on + CONN_HIF_ON_CLOCK_CHECK_OFFSET);
+			udelay(1000);
+			clkchk = readl(c->conn_hif_on + CONN_HIF_ON_CLOCK_CHECK_OFFSET);
+			if ((clkchk & CONN_HIF_ON_HCLK) && (clkchk & CONN_HIF_ON_OSCCLK))
+				break;
+		}
+		dev_info(c->dev,
+			 "clock-liveness: conn_hif_on[0x18007000]=0x%08x HCLK(b16)=%d OSCCLK(b17)=%d (after %d try, both=1 => alive)\n",
+			 clkchk, !!(clkchk & CONN_HIF_ON_HCLK), !!(clkchk & CONN_HIF_ON_OSCCLK), k + 1);
+	}
+
+	/* AFE WBG calibration + subsys_pll_initial REMOVED (r74).  Verified against
+	 * the stock begonia wmt_drv.ko (MIUI V12.5.1.0): begonia runs NO AFE WBG cal
+	 * in its conn_infra bring-up (consys_afe_reg_setting is a no-op stub).  The
+	 * mt6877-derived calibration that lived here was chip-wrong guesswork and a
+	 * known conn_infra wedge-risk.  Stock reaches conn-MCU idle (COM_REG0
+	 * 0x18002600 == 0x1D1E) from analog/clock/PLL preconditions only, no AFE cal.
+	 */
+
+	/* B2 (wf wcvhqa405): consys_emi_entry_address is UNREGISTERED on mt6785 — stock
+	 * does NOT write the BT/WF EMI-entry pointers, and the mt6781 values we wrote
+	 * (0xF0170000/0xF02A0000) don't even match where we place the images
+	 * (bt@0xf0080000 / wifi@0xf0140000): wrong pointers the MCU could follow into
+	 * garbage.  Removed for stock parity. */
+
+	/* consys_set_xo_osc_ctrl (rc-mode-off path): disable conn_top rc
+	 * osc_ctrl_top, set XO initial/bg stable time, unmask srcclkena_ack. */
+	v = readl(c->mcu_misc_on + CONN_ON_RC_OSC_CTL_0_OFFSET);
+	writel(v & ~(1u << 7), c->mcu_misc_on + CONN_ON_RC_OSC_CTL_0_OFFSET);
+	v = readl(c->mcu_misc_on + CONN_ON_OSC_CTL_2_OFFSET);
+	writel((v & ~0xFF00u) | 0x0600u, c->mcu_misc_on + CONN_ON_OSC_CTL_2_OFFSET);
+	v = readl(c->mcu_misc_on + CONN_ON_OSC_CTL_OFFSET);
+	writel((v & ~0xFFFFu) | 0x0708u, c->mcu_misc_on + CONN_ON_OSC_CTL_OFFSET);
+	v = readl(c->mcu_misc_on + CONN_ON_OSC_CTL_2_OFFSET);
+	writel(v & ~(1u << 0), c->mcu_misc_on + CONN_ON_OSC_CTL_2_OFFSET);
+
+	/* conn_infra-ON clkgen/PLL enables (r74) — verified in stock wmt_drv.ko
+	 * polling_consys_chipid (.text 0x4264 / 0x42c4), the two ON-island writes our
+	 * port was MISSING.  CONN_HW_VER @ 0x18001000 reads 0 (ON island dead) while
+	 * VER_ID @ 0x180b1010 (OFF island) reads fine — the conn MCU runs in the ON
+	 * island, so these are prime candidates for advancing COM_REG0 0x4fd0->0x1D1E.
+	 *   [0x180c1600] |= 0x800000        (CONN_TOP_MISC_ON clkgen REQUEST)
+	 *   [0x180b3034]  = (v&0xFFE7FFFF)|0x80000  (WPLL bit19) */
+	v = readl(c->mcu_misc_on + 0x600);
+	writel(v | 0x800000u, c->mcu_misc_on + 0x600);
+	v = readl(c->conn_afe + 0x34);
+	writel((v & 0xFFE7FFFFu) | 0x80000u, c->conn_afe + 0x34);
+	/* r75 — stock polling_consys_chipid also runs this UNCONDITIONALLY next to
+	 * the two above (RE-confirmed); our port had omitted it. */
+	/* A3 (wf wcvhqa405) — REAL CONN2EMI slpprot release: stock writes
+	 * mcu_conn_hif_pdma_base + 0x160 = 0x18004160 |= BIT(4) (mt6785.c:917-921).
+	 * We had mis-targeted mcu_misc_on+0x160 = 0x180c1160 (wrong physical reg),
+	 * leaving the real conn<->EMI sleep protection unreleased — a plausible block
+	 * on the conn-MCU's EMI access.  Map 0x18004000 inline + set the real bit. */
+	{
+		void __iomem *pdma = ioremap(0x18004000u, 0x1000);
+
+		if (pdma) {
+			u32 sp;
+
+			writel(readl(pdma + 0x160) | BIT(4), pdma + 0x160);
+			wmb();
+			sp = readl(pdma + 0x160);
+			iounmap(pdma);
+			dev_info(c->dev, "CONN2EMI slpprot 0x18004160 |= BIT(4) (A3): now 0x%08x\n", sp);
+		}
+	}
+	dev_info(c->dev,
+		 "conn_infra-ON enables: TOP_MISC_ON[0x180c1600]=0x%08x WPLL[0x180b3034]=0x%08x\n",
+		 readl(c->mcu_misc_on + 0x600), readl(c->conn_afe + 0x34));
+
+	/* B2 (wf wcvhqa405): consys_bus_timeout_config is UNREGISTERED on mt6785 — stock
+	 * does NOT write 0x18002440 (and our 0x90000002 != stock-default 0x86500080).
+	 * Removed for stock parity. */
+
+	/* consys_set_mcu_mem_pdn_delay: SLEEPB<->ISOINTB timing (rgu_on + 0x284). */
+	v = readl(c->conn_rgu_on + CONN_RGU_MCUSYS_DLY_CHAIN_OFFSET);
+	writel((v & ~0xF0000u) | 0x40000u,
+	       c->conn_rgu_on + CONN_RGU_MCUSYS_DLY_CHAIN_OFFSET);
+
+	dev_info(c->dev,
+		 "POS setup (reset asserted): AFE[0x180b3030]=0x%08x EMI_WF[0x18002508]=0x%08x OSC_CTL[0x180c1200]=0x%08x DLY[0x180c0284]=0x%08x BUSHANG[0x18002440]=0x%08x\n",
+		 readl(c->conn_afe + CONN_AFE_RG_WBG_PLL_04_OFFSET),
+		 readl(c->conn_mcu + CONN_MCU_WF_EMI_ENTRY_OFFSET),
+		 readl(c->mcu_misc_on + CONN_ON_OSC_CTL_OFFSET),
+		 readl(c->conn_rgu_on + CONN_RGU_MCUSYS_DLY_CHAIN_OFFSET),
+		 readl(c->conn_mcu + CONN_MCU_BUSHANGCR_OFFSET));
+}
+
+/* Force the conn XO clock buffer (mt6359 EXTBUF2 / XO_WCN) on, via the PMIC
+ * regmap. Mirrors vendor clk_buf_ctrl_internal(CLK_BUF_CONN, FORCE_ON): on
+ * DCXO_CW00, clear EXTBUF2_MODE (-> SW/force mode) then set EXTBUF2_EN_M (enable).
+ * THE leading-hypothesis fix for the WFSYS rgu not arming: WFSYS needs this 26MHz
+ * RF clock and mainline never enables it. No-op (warn) if the PMIC regmap is
+ * absent so the rest of bring-up still runs. */
+static void mtk_conninfra_enable_xo_wcn(struct mtk_conninfra *c)
+{
+	unsigned int v = 0;
+	int ret;
+
+	if (!c->pmic) {
+		dev_warn(c->dev, "no PMIC regmap; cannot enable XO_WCN (conn 26MHz buffer)\n");
+		return;
+	}
+	regmap_read(c->pmic, MT6359_DCXO_CW00, &v);
+	dev_info(c->dev, "XO_WCN pre: DCXO_CW00[0x788]=0x%08x (MODE[4:3]=%u EN_M[5]=%u)\n",
+		 v, (v & XO_EXTBUF2_MODE_MASK) >> 3, !!(v & XO_EXTBUF2_EN_M_MASK));
+	/* clear EXTBUF2_MODE (force/SW mode) */
+	ret = regmap_update_bits(c->pmic, MT6359_DCXO_CW00, XO_EXTBUF2_MODE_MASK, 0);
+	/* set EXTBUF2_EN_M (enable the buffer) */
+	ret |= regmap_update_bits(c->pmic, MT6359_DCXO_CW00,
+				  XO_EXTBUF2_EN_M_MASK, XO_EXTBUF2_EN_M_MASK);
+	regmap_read(c->pmic, MT6359_DCXO_CW00, &v);
+	dev_info(c->dev, "XO_WCN post: DCXO_CW00[0x788]=0x%08x (MODE[4:3]=%u EN_M[5]=%u) rc=%d\n",
+		 v, (v & XO_EXTBUF2_MODE_MASK) >> 3, !!(v & XO_EXTBUF2_EN_M_MASK), ret);
+}
+
+static int mtk_conninfra_probe(struct platform_device *pdev)
+{
+	struct mtk_conninfra *c;
+	struct device_node *pmic_np;
+	struct device_node *btif_np;
+	int ret;
+
+	c = devm_kzalloc(&pdev->dev, sizeof(*c), GFP_KERNEL);
+	if (!c) return -ENOMEM;
+	c->dev = &pdev->dev;
+	platform_set_drvdata(pdev, c);
+
+	dev_info(&pdev->dev, "probe (enable_bringup=%d)\n", enable_bringup);
+
+	if (!enable_bringup) {
+		dev_info(&pdev->dev,
+			 "bring-up gated off.  Set enable_bringup=1 via sysfs + unbind/bind to run it.\n");
+		/* Still instantiate DT children (e.g. wmac@18000000) so their
+		 * drivers can probe and defer if they actually need the MCU
+		 * powered. With bring-up gated off the children will probably
+		 * see EPROBE_DEFER / EIO on MMIO; that's the right shape for
+		 * userspace to opt into bring-up later. */
+		return devm_of_platform_populate(&pdev->dev);
+	}
+
+	/* Full bring-up sequence — only runs when enable_bringup=1.
+	 * Order matches the vendor flow: map registers, LDOs, pinmux, clock,
+	 * genpd power-on, CON_PWR_ON gate, VER_ID poll. (An earlier copy of
+	 * the clk_get + pm_runtime_enable + clk_prepare_enable block lived
+	 * here before this comment and ran BEFORE LDOs/pinmux, which (a) is
+	 * the wrong order, and (b) caused the second pm_runtime_enable below
+	 * to fire `Unbalanced pm_runtime_enable!` warnings. Removed.) */
+	/* Resolve the BTIF handle (WMT channel to the conn MCU) up front, before
+	 * any power state is set up, so a not-yet-probed BTIF can cleanly defer.
+	 * Prefer the DT phandle; fall back to the unique "mediatek,btif" node so
+	 * this works module-only without a dtb reflash. A missing BTIF just skips
+	 * the WMT WiFi function-on (diagnostic). */
+	btif_np = of_parse_phandle(pdev->dev.of_node, "mediatek,btif", 0);
+	if (!btif_np)
+		btif_np = of_find_compatible_node(NULL, NULL, "mediatek,btif");
+	if (btif_np) {
+		c->btif = mtk_btif_get(btif_np);
+		of_node_put(btif_np);
+		if (!c->btif)
+			return dev_err_probe(&pdev->dev, -EPROBE_DEFER,
+					     "BTIF not bound yet\n");
+	}
+
+	ret = mtk_conninfra_map_by_name(pdev, "spm", SPM_BASE_DEFAULT, SPM_WIN_SIZE, &c->spm);
+	if (ret) return ret;
+	ret = mtk_conninfra_map_by_name(pdev, "infracfg-ao", INFRACFG_AO_BASE_DEFAULT,
+				  INFRACFG_AO_WIN_SIZE, &c->infracfg_ao);
+	if (ret) return ret;
+	ret = mtk_conninfra_map_by_name(pdev, "conn-top-misc-off", CONN_TOP_MISC_OFF_BASE_DEFAULT,
+				  CONN_TOP_MISC_OFF_WIN_SIZE, &c->conn_top_misc_off);
+	if (ret) return ret;
+	ret = mtk_conninfra_map_by_name(pdev, "pinctrl", PINCTRL_BASE_DEFAULT,
+				  PINCTRL_WIN_SIZE, &c->pinctrl);
+	if (ret) return ret;
+	ret = mtk_conninfra_map_by_name(pdev, "iocfg-lm", IOCFG_LM_BASE_DEFAULT,
+				  IOCFG_LM_WIN_SIZE, &c->iocfg_lm);
+	if (ret) return ret;
+	ret = mtk_conninfra_map_by_name(pdev, "ap-rgu", AP_RGU_BASE_DEFAULT,
+				  AP_RGU_WIN_SIZE, &c->ap_rgu);
+	if (ret) return ret;
+	ret = mtk_conninfra_map_by_name(pdev, "host-csr", CONN_HOST_CSR_BASE_DEFAULT,
+				  CONN_HOST_CSR_WIN_SIZE, &c->host_csr);
+	if (ret) return ret;
+	ret = mtk_conninfra_map_by_name(pdev, "conn-infra-cfg", CONN_INFRA_CFG_BASE_DEFAULT,
+				  CONN_INFRA_CFG_WIN_SIZE, &c->conn_infra_cfg);
+	if (ret) return ret;
+	ret = mtk_conninfra_map_by_name(pdev, "infracfg", INFRACFG_BASE_DEFAULT,
+				  INFRACFG_WIN_SIZE, &c->infracfg);
+	if (ret) return ret;
+	/* POS windows — fixed phys (not in the consys node reg list). */
+	ret = mtk_conninfra_map_by_name(pdev, "conn-mcu", CONN_MCU_BASE_DEFAULT,
+				  CONN_MCU_WIN_SIZE, &c->conn_mcu);
+	if (ret) return ret;
+	ret = mtk_conninfra_map_by_name(pdev, "conn-afe", CONN_AFE_CTL_BASE_DEFAULT,
+				  CONN_AFE_CTL_WIN_SIZE, &c->conn_afe);
+	if (ret) return ret;
+	ret = mtk_conninfra_map_by_name(pdev, "mcu-misc-on", CONN_MCU_TOP_MISC_ON_BASE_DEFAULT,
+				  CONN_MCU_TOP_MISC_ON_WIN_SIZE, &c->mcu_misc_on);
+	if (ret) return ret;
+	ret = mtk_conninfra_map_by_name(pdev, "conn-rgu-on", CONN_RGU_ON_BASE_DEFAULT,
+				  CONN_RGU_ON_WIN_SIZE, &c->conn_rgu_on);
+	if (ret) return ret;
+	ret = mtk_conninfra_map_by_name(pdev, "conn-hif-on", CONN_HIF_ON_BASE_DEFAULT,
+				  CONN_HIF_ON_WIN_SIZE, &c->conn_hif_on);
+	if (ret) return ret;
+	ret = mtk_conninfra_map_by_name(pdev, "conn-afe2", CONN_AFE2_BASE_DEFAULT,
+				  CONN_AFE2_WIN_SIZE, &c->conn_afe2);
+	if (ret) return ret;
+
+	/* Vendor: consys_clk_get_from_dts pulls "ccif" (CLK_INFRA_CCIF4_AP) and
+	 * "conn" (clk_scp_conn_main). On mainline, the "conn" gate is what
+	 * MT6785_POWER_DOMAIN_CONN models in mt6785-pm-domains.h — same SPM
+	 * register (0x320), same sta_mask (BIT(1)), same bus-protection bits.
+	 * So we get the CCIF clock here, and use pm_runtime_resume_and_get
+	 * below as the equivalent of vendor's clk_prepare_enable(clk_scp_conn_main).
+	 */
+	c->clk_ccif = devm_clk_get(c->dev, "ccif");
+	if (IS_ERR(c->clk_ccif))
+		return dev_err_probe(c->dev, PTR_ERR(c->clk_ccif),
+				     "clk ccif\n");
+
+	/* mt6359 PMIC regmap for the conn XO_WCN clock-buffer enable. The mt6359
+	 * regmap actually belongs to its PARENT pwrap device (mt6397-core does
+	 * dev_get_regmap(pdev->dev.parent) — the pwrap's devm_regmap). So find the
+	 * pwrap node by compatible, resolve its platform_device, and pull its regmap.
+	 * This works WITHOUT a dtb reflash (modprobe-only). Warn+continue if absent. */
+	pmic_np = of_find_compatible_node(NULL, NULL, "mediatek,mt6785-pwrap");
+	if (!pmic_np)
+		pmic_np = of_find_node_by_name(NULL, "pwrap");
+	if (pmic_np) {
+		struct platform_device *pwrap_pdev = of_find_device_by_node(pmic_np);
+
+		if (pwrap_pdev) {
+			c->pmic = dev_get_regmap(&pwrap_pdev->dev, NULL);
+			put_device(&pwrap_pdev->dev);
+		}
+		of_node_put(pmic_np);
+	}
+	if (c->pmic)
+		dev_info(c->dev, "pwrap/mt6359 regmap acquired for XO_WCN\n");
+	else
+		dev_warn(c->dev, "no pwrap regmap; cannot enable XO_WCN\n");
+
+	/* Vendor bring-up sequence (mt6785.c mtk_wcn_consys_hw_reg_ctrl on=1):
+	 *   1. consys_hw_vcn18_ctrl(ENABLE)         — VCN18 (+SRCLKEN0 HW_LP) +
+	 *                                             VCN33_1 LDOs
+	 *   2. consys_set_if_pinmux(ENABLE)         — D-die <-> A-die pinmux
+	 *   3. udelay(150)
+	 *   4. vcn28_hw_mode_ctrl + hw_vcn28_ctrl   — VCN33_2 +SRCLKEN0 HW_OFF
+	 *       (runs whether co_clock_type is 0 or 1; net VCN33_2 state is the
+	 *       same — now replicated in mtk_conninfra_enable_supplies). efuse
+	 *       paldo is a no-op on this SoC — skipped.
+	 *   5. consys_hw_reset_bit_set(ENABLE)      — assert consys CPU SW reset
+	 *   6. consys_hw_spm_clk_gating_enable()    — EMPTY on mt6785 (skipped)
+	 *   7. consys_hw_power_ctrl(ENABLE):
+	 *        clk_prepare_enable(ccif) + clk_prepare_enable(conn) + CON_PWR_ON
+	 *        (clk_scp_conn_main maps to genpd power-domain in mainline)
+	 *   8. udelay(10)
+	 *   9. consys_ahb_clock_ctrl(ENABLE)        — EMPTY on mt6785 (skipped)
+	 *  10. polling_consys_chipid                — retry-poll VER_ID
+	 *  ... middle steps (acr/afe/emi/wifi setting) deferred to M2 ...
+	 *  11. consys_hw_reset_bit_set(DISABLE)     — release consys CPU
+	 *  12. msleep(20)
+	 */
+	/* Stock op #1 (consys_reset_emi_coredump): zero the conn-MCU EMI coredump
+	 * carveout regions before anything else, as the stock wmt_drv does first. */
+	mtk_conninfra_reset_emi_coredump(c);
+
+	ret = mtk_conninfra_enable_supplies(c);
+	if (ret)
+		return ret;
+
+	/* Enable the conn XO clock buffer (mt6359 EXTBUF2 / XO_WCN) — the 26MHz RF
+	 * clock the WFSYS needs. Done right after the LDOs, before pinmux/power, so
+	 * the buffer is up by the time WFSYS power-on runs. (Mainline omits this;
+	 * leading hypothesis for the WFSYS rgu not arming.) */
+	mtk_conninfra_enable_xo_wcn(c);
+
+	mtk_conninfra_pinmux(c);  /* includes the udelay(150) at the end */
+
+	/* Step 5: assert consys CPU SW reset BEFORE power-on so the MCU is
+	 * held in reset when power is applied — matches vendor flow exactly.
+	 * Skipping this in r57-r59 was the most likely reason VER_ID stayed
+	 * at 0 even after CON_PWR_ON wrote BIT(0) successfully: with the MCU
+	 * free-running through the power-up transient, hardware state ended
+	 * up undefined and the static VER_ID register reads as 0.
+	 */
+	mtk_conninfra_cpu_sw_reset(c, true);
+
+	ret = clk_prepare_enable(c->clk_ccif);
+	if (ret) {
+		dev_err(c->dev, "clk_prepare_enable(ccif) failed: %d\n", ret);
+		mtk_conninfra_cpu_sw_reset(c, false);
+		mtk_conninfra_disable_supplies(c);
+		return ret;
+	}
+
+	/* ⭐ FILL THE GAP (wf wksxyh7tt + live-confirmed): the clk core's clk_disable_unused
+	 * gates CLK_INFRA_PMIC_CONN (infra0 bit3) + CLK_INFRA_SCP (bit4) at boot — neither is
+	 * CLK_IS_CRITICAL and no in-tree driver claims them — yet stock's clk_scp_conn_main
+	 * keeps the conn PMIC/SCP clocks ON.  The conn bus clock (HCLK/OSCCLK @0x18007000) is
+	 * alive so the MCU reaches 0x1d1e, but the PMIC/A-die + SCP clocks the servicing path
+	 * needs are dark.  mainline has no consumer for these, so we ungate them directly via
+	 * the infra0 CG clr reg (mtk_cg_enable == write BIT to clr_ofs 0x84; sta 0x90 bit=0 =>
+	 * ungated).  Live-confirmed: 0x10001090 0x1befff5c -> 0x1befff44 after this write. */
+	{
+		u32 sta = readl(c->infracfg + 0x90);
+
+		if (sta & (BIT(3) | BIT(4))) {
+			writel(BIT(3) | BIT(4), c->infracfg + 0x84);
+			readl(c->infracfg + 0x84);
+			dev_info(c->dev,
+				 "ungate CLK_INFRA_PMIC_CONN+SCP: infra0 STA 0x%08x -> 0x%08x (gap-fill)\n",
+				 sta, readl(c->infracfg + 0x90));
+		}
+	}
+
+	/* Step 7 (conn part): genpd power-on of MT6785_POWER_DOMAIN_CONN.
+	 * Mainline's mt6785-pm-domains.c implements the same SPM dance vendor's
+	 * spm_mtcmos_ctrl_conn does — PWR_ON, PWR_ON_2ND, PWR_STATUS poll,
+	 * clear CLK_DIS, clear PWR_ISO, set PWR_RST_B, release bus-protection
+	 * (TOPAXI BIT(14)/(13|18), TOPAXI_1 BIT(10)).
+	 *
+	 * No fallback: if genpd doesn't bring the domain up, the manual SPM
+	 * dance below would still leave bus-protection asserted (we don't have
+	 * the infracfg syscon mapped here — pm-domains owns it), so MMIO
+	 * accesses to the consys block would silently return 0. Bail out
+	 * instead, with cleanup that mirrors what we set up so far.
+	 */
+	pm_runtime_enable(c->dev);
+	ret = pm_runtime_resume_and_get(c->dev);
+	if (ret < 0) {
+		dev_err(c->dev, "pm_runtime_resume_and_get failed: %d\n", ret);
+		mtk_conninfra_cpu_sw_reset(c, false);
+		pm_runtime_disable(c->dev);
+		clk_disable_unprepare(c->clk_ccif);
+		mtk_conninfra_disable_supplies(c);
+		return ret;
+	}
+	dev_info(c->dev, "pm_runtime resume_and_get OK (genpd ran SPM dance)\n");
+
+	/* r104 — FORCE CODE RE-FETCH via CONN genpd power-cycle.  The CONN domain
+	 * arrives ALREADY-POWERED from the bootloader (CONN_PWR_CON=0x0d at probe), so
+	 * cpu_sw_reset alone never makes the conn-MCU re-fetch its CODE from EMI — r103
+	 * proved EMI code-patches are inert (the MCU runs a cached/pre-loaded copy).
+	 * The CPU is already held in reset here (cpu_sw_reset(true) @ ~2292).
+	 * pm_runtime_put_sync drops the genpd refcount to 0 -> genpd runs the SCPSYS
+	 * power-OFF dance (bus-protect, ISO, MTCMOS off) which removes power from the
+	 * conn-MCU core -> ICACHE/ITCM cleared.  resume_and_get re-powers it; the rest
+	 * of bring-up (power dance, emi_load+PATCH, single reset-release) then boots the
+	 * conn-MCU FRESH from our patched EMI.  Gated behind force_recycle; the readback
+	 * tells us if genpd actually dropped power (PWR_CON ON=0) vs kept it on. */
+	if (force_recycle) {
+		u32 pc, st;
+
+		dev_info(c->dev, "force_recycle: CONN genpd power-DOWN (put_sync) to clear conn-MCU ICACHE/ITCM...\n");
+		pm_runtime_put_sync(c->dev);
+		pc = readl(c->spm + CONN_PWR_CON_OFFSET);
+		st = readl(c->spm + SPM_PWR_STATUS_OFFSET);
+		dev_info(c->dev,
+			 "force_recycle: after put_sync CONN_PWR_CON[0x320]=0x%08x STA[0x160]=0x%08x (ON=%d CONN_STA=%d; want ON=0 STA=0 = really powered off)\n",
+			 pc, st, !!(pc & PWR_ON), !!(st & CONN_PWR_STA_MASK));
+		usleep_range(3000, 4000);
+		ret = pm_runtime_resume_and_get(c->dev);
+		if (ret < 0) {
+			dev_err(c->dev, "force_recycle: re-resume_and_get failed: %d\n", ret);
+			mtk_conninfra_cpu_sw_reset(c, false);
+			pm_runtime_disable(c->dev);
+			clk_disable_unprepare(c->clk_ccif);
+			mtk_conninfra_disable_supplies(c);
+			return ret;
+		}
+		pc = readl(c->spm + CONN_PWR_CON_OFFSET);
+		dev_info(c->dev,
+			 "force_recycle: CONN genpd power-UP done CONN_PWR_CON[0x320]=0x%08x (conn-MCU re-fetches patched EMI on reset-release)\n",
+			 pc);
+	}
+
+	/* Diagnostic (read-only): confirm the SPM CONN power domain actually
+	 * left reset/isolation. genpd/scpsys is *supposed* to set PWR_RST_B,
+	 * clear PWR_ISO and report CONN in PWR_STATUS. If VER_ID still reads 0
+	 * with RST_B=1/ISO=0/STA=1, the failure is downstream of domain power
+	 * (clock/CCIF handshake); if RST_B=0 or STA=0, genpd didn't really power
+	 * consys and that alone explains VER_ID=0. scpsys CONN ctl_offs=0x320,
+	 * sta_mask=BIT(1) (matches mainline mt6785 pm-domains). */
+	{
+		u32 pwr_con = readl(c->spm + 0x320);	/* CONN_PWR_CON */
+		u32 pwr_sta = readl(c->spm + 0x160);	/* PWR_STATUS */
+
+		dev_info(c->dev,
+			 "SPM CONN_PWR_CON[0x320]=0x%08x RST_B=%d ISO=%d ON=%d ON_2ND=%d CLK_DIS=%d; PWR_STATUS[0x160]=0x%08x CONN_STA=%d\n",
+			 pwr_con, !!(pwr_con & BIT(0)), !!(pwr_con & BIT(1)),
+			 !!(pwr_con & BIT(2)), !!(pwr_con & BIT(3)),
+			 !!(pwr_con & BIT(4)), pwr_sta, !!(pwr_sta & BIT(1)));
+	}
+
+	/* READ-ONLY probe (no writes): is the SPM power machine already seeded?
+	 * Stock consys_hw_power_ctrl seeds PWRON_CONFG_EN (0x10006000 = 0x0b160001)
+	 * before the CONN power dance; the synthesis says that seed is the one step
+	 * we omit. Read it (+ the topckgen bus-protect STA) to learn whether the
+	 * preloader/scpsys already set it before we decide to write it. infracfg @
+	 * 0x10001000 is mapped as c->infracfg; STA1=0x228 (AXI_RX bit14, AHB bit13,
+	 * GALS bit18), STA1_1=0x258 (AHB_RX bit10). spm@0x10006000 = c->spm + 0x0. */
+	dev_info(c->dev,
+		 "SPM probe: PWRON_CONFG_EN[0x10006000]=0x%08x; TOPAXI STA1[0x10001228]=0x%08x STA1_1[0x10001258]=0x%08x\n",
+		 readl(c->spm + 0x0),
+		 readl(c->infracfg + INFRA_TOPAXI_PROTECTEN_STA1),
+		 readl(c->infracfg + INFRA_TOPAXI_PROTECTEN_1_STA1));
+
+	/* Vendor consys_hw_power_ctrl(ENABLE) — the AUTHORITATIVE working CONN
+	 * power-on from begonia's stock WMT kernel (xm_mt6785.c:619-678), which
+	 * reaches HCLK/OSCCLK + COM_REG0=0x1d1e with NO firmware. genpd/scpsys
+	 * powers the domain (VER_ID proves it) but omits the connsys-specific seed +
+	 * bus-clock-enable steps. Full stock sequence on spm@0x10006000, all polls
+	 * BOUNDED (stock uses infinite while — we cap to avoid the hard-hang risk):
+	 *   1. PWRON_CONFG_EN 0x10006000 = (v & 0xFFFF) | 0x0b160001  [seed SPM]
+	 *   2. PWR_ON (bit2),  poll PWR_STATUS 0x160 bit1
+	 *   3. PWR_ON_2ND (bit3), poll PWR_STATUS_2ND 0x164 bit1
+	 *   4. CLEAR conn_clk_dis (bit4)  [AP-to-CONNSYS bus clock ON], udelay(1)
+	 *   5. CLEAR ISO (bit1)
+	 *   6. SET RST_B (bit0)
+	 * VERIFIED 2026-06-01: writing PWRON_CONFG_EN does NOT hang the SoC (the
+	 * prior "it hangs" claim was a wrong inference — the phone had been put into
+	 * BROM manually). BUT it is also NOT the missing piece: 0x10006000 reads
+	 * 0x00000001 BEFORE our write (bit0 enable already set by the preloader;
+	 * 0x0b16 is a write-only key that doesn't read back), so this write is a
+	 * genuine no-op. Kept for fidelity to the stock sequence; harmless. The conn
+	 * bus clock (HCLK/OSCCLK @ 0x18007000) stays 0 even with the CONN domain
+	 * fully powered (CONN_PWR_CON=0x0d, STATUS bit1=1) — so the gate is elsewhere
+	 * (a topckgen/CCF conn clock mux, or firmware). RMW, bounded polls. */
+	{
+		u32 v, seed;
+		int i;
+
+		seed = readl(c->spm + SPM_PWRON_CONFG_EN_OFFSET);
+		writel((seed & 0x0000FFFFu) | SPM_PWRON_CONFG_EN_VALUE,
+		       c->spm + SPM_PWRON_CONFG_EN_OFFSET);
+		dev_info(c->dev, "PWRON_CONFG_EN[0x10006000] 0x%08x -> 0x%08x (seed 0x0b160001)\n",
+			 seed, readl(c->spm + SPM_PWRON_CONFG_EN_OFFSET));
+
+		v = readl(c->spm + CONN_PWR_CON_OFFSET);
+		writel(v | PWR_ON, c->spm + CONN_PWR_CON_OFFSET);
+		for (i = 0; i < 50; i++) {
+			if (readl(c->spm + SPM_PWR_STATUS_OFFSET) & CONN_PWR_STA_MASK)
+				break;
+			udelay(10);
+		}
+		v = readl(c->spm + CONN_PWR_CON_OFFSET);
+		writel(v | PWR_ON_2ND, c->spm + CONN_PWR_CON_OFFSET);
+		for (i = 0; i < 50; i++) {
+			if (readl(c->spm + SPM_PWR_STATUS_2ND_OFFSET) & CONN_PWR_STA_MASK)
+				break;
+			udelay(10);
+		}
+		/* THE candidate fix: turn on the AP-to-CONNSYS bus clock. */
+		v = readl(c->spm + CONN_PWR_CON_OFFSET);
+		writel(v & ~PWR_CLK_DIS, c->spm + CONN_PWR_CON_OFFSET);
+		udelay(1);
+		v = readl(c->spm + CONN_PWR_CON_OFFSET);
+		writel(v & ~PWR_ISO, c->spm + CONN_PWR_CON_OFFSET);
+		v = readl(c->spm + CONN_PWR_CON_OFFSET);
+		writel(v | PWR_RST_B, c->spm + CONN_PWR_CON_OFFSET);
+		usleep_range(1000, 1500);
+		v = readl(c->spm + CONN_PWR_CON_OFFSET);
+		dev_info(c->dev,
+			 "manual CONN_PWR_CON[0x320]=0x%08x (CLK_DIS=%d ISO=%d ON=%d RST_B=%d) STA[0x160]=0x%08x STA_2ND[0x164]=0x%08x\n",
+			 v, !!(v & PWR_CLK_DIS), !!(v & PWR_ISO), !!(v & PWR_ON),
+			 !!(v & PWR_RST_B), readl(c->spm + SPM_PWR_STATUS_OFFSET),
+			 readl(c->spm + SPM_PWR_STATUS_2ND_OFFSET));
+	}
+
+	/* Step 7 (CON_PWR_ON part) — vendor writes BIT(0) to pericfg+0x438. */
+	mtk_conninfra_set_con_pwr_on(c);
+	usleep_range(10, 20);                /* Step 8 */
+	/* Step 9 (consys_ahb_clock_ctrl) is empty on mt6785 — skip. */
+
+	/* Open the AP->conn_infra bus: clear the INFRA TOPAXI protection that
+	 * scpsys leaves asserted (CONN domain has no upstream consumer, gets
+	 * re-disabled). Until this, every 0x18xxxxxx read returns 0 / writes are
+	 * lost — so this MUST precede the conn_infra-off wakeup and all conn
+	 * reads below. */
+	ret = mtk_conninfra_release_ap2conn_busprot(c);
+	if (ret) {
+		mtk_conninfra_cpu_sw_reset(c, false);
+		pm_runtime_put(c->dev);
+		pm_runtime_disable(c->dev);
+		clk_disable_unprepare(c->clk_ccif);
+		mtk_conninfra_disable_supplies(c);
+		return ret;
+	}
+
+	/* THE fix for VER_ID=0: wake conn_infra-off + release AP2CONN
+	 * sleep-protection (vendor wf_pwr_on_consys_mcu). genpd CONN ON +
+	 * CON_PWR_ON power consys but leave its register bus asleep; this
+	 * ungates it so VER_ID@0x180b1010 (and CONN_HW_VER@0x18001000) read. */
+	ret = mtk_conninfra_wake_conn_infra_off(c);
+	if (ret) {
+		mtk_conninfra_cpu_sw_reset(c, false);
+		pm_runtime_put(c->dev);
+		pm_runtime_disable(c->dev);
+		clk_disable_unprepare(c->clk_ccif);
+		mtk_conninfra_disable_supplies(c);
+		return ret;
+	}
+
+	/* FIX for VER_ID=0: release the consys CPU SW reset BEFORE polling
+	 * VER_ID. Diagnostics proved the SPM CONN domain is fully powered
+	 * (RST_B=1 ISO=0 PWR_STATUS CONN=1) and CON_PWR_ON sticks, yet
+	 * VER_ID@0x180b1010 read 0x0 — because we polled it with the conn MCU
+	 * still held in reset. The vendor consys_hw_reset_bit_set(FALSE)
+	 * de-asserts the CPU reset and only THEN does the conn_infra bus come
+	 * up (vendor waits for mcu_base+0x600==0x1D1E); CONN_TOP_MISC_OFF.VER_ID
+	 * is not valid until the MCU is out of reset. Order now matches vendor:
+	 * power -> release reset -> settle -> read VER_ID. */
+	/* NOTE (wf wcvhqa405): stock releases the conn CPU ONCE, after EMI is fully
+	 * loaded (single consys_hw_reset_bit_set(false)).  We no longer release here;
+	 * VER_ID is read with the CPU asserted (conn_infra-off island, readable after
+	 * the busprot-clear + conn_infra-off wake done above). */
+
+	/* Step 10: poll VER_ID — retries internally (~1s) while conn_infra
+	 * spins up after the reset release. */
+	ret = mtk_conninfra_check_ver_id(c);
+	if (ret)
+		dev_warn(c->dev,
+			 "VER_ID read 0/fail with conn CPU asserted (%d); continuing to single reset release\n",
+			 ret);
+
+	/* POS in the vendor reset-state order. VER_ID above needed the reset
+	 * released (conn_infra-off bus comes up). Vendor mtk_wcn_consys_hw_reg_ctrl
+	 * then runs the POS ops WHILE the conn CPU is held in reset, and only after
+	 * that releases the reset for the MCU's real boot. So: re-assert reset ->
+	 * POS setup (the reset-protected CRs latch here) -> release. Log COM_REG0
+	 * before/after release to observe the conn MCU state (0x1d1e == idle); do
+	 * NOT gate on it (begonia's hand-written flow has no idle poll — that exists
+	 * only in the mt6781 auto-gen variant). */
+	/* CPU stays ASSERTED through VER_ID + POS + emi_load; single release follows. */
+	mtk_conninfra_pos_setup(c);
+	/* r75 — THE conn-MCU run gate: place its RAM firmware in EMI (+ WF->EMI
+	 * remap) while the CPU is held in reset, so the MCU has code to execute the
+	 * instant we release it.  Empty EMI = MCU stuck at loader-wait 0x4fd0. */
+	mtk_conninfra_emi_load(c);
+	mtk_conninfra_cpu_sw_reset(c, false);
+
+	/* Gate on conn-MCU idle, the AUTHORITATIVE begonia success signal (verified
+	 * in stock wmt_drv.ko .text 0x38c0-0x3940: after releasing the conn CPU
+	 * reset, poll COM_REG0 @ 0x18002600 == 0x1D1E, max 10 reads, 20ms apart).
+	 * This — not the foreign-soc3_0 WFSYS_ON/rgu poke our mt76 side imported —
+	 * is how begonia confirms conn_infra is up; WFSYS power follows from it.
+	 * Diagnostic for now (non-fatal): we want to see whether the r74 changes
+	 * advance COM_REG0 from the stuck 0x4fd0 toward 0x1D1E. */
+	{
+		u32 com_reg0 = 0;
+		int t;
+
+		for (t = 0; t < 10; t++) {
+			msleep(20);
+			com_reg0 = readl(c->conn_mcu + CONN_MCU_COM_REG0_OFFSET);
+			if (com_reg0 == CONN_MCU_COM_REG0_IDLE)
+				break;
+		}
+		dev_info(c->dev,
+			 "conn MCU COM_REG0[0x18002600] = 0x%08x after %d poll(s) (0x1D1E == idle%s)\n",
+			 com_reg0, t + 1,
+			 com_reg0 == CONN_MCU_COM_REG0_IDLE ? " — REACHED!" : ", still not idle");
+
+		/* With the conn MCU at idle, arm the WFSYS by asking the MCU to turn
+		 * the WiFi function on over the WMT/BTIF channel (the MCU powers the
+		 * WFSYS itself — there is no AP-side WFSYS power register). Diagnostic
+		 * / non-fatal: if it works, the wmac child will then read a live WFSYS
+		 * VER_ID 0x184B0010 / rgu 0x180602CC. Needs the BTIF driver bound. */
+		if (com_reg0 == CONN_MCU_COM_REG0_IDLE && c->btif) {
+			mtk_conninfra_wmt_link_prep(c);
+			mtk_conninfra_wmt_func_ctrl(c, WMTDRV_TYPE_WIFI, true);
+		} else if (com_reg0 == CONN_MCU_COM_REG0_IDLE)
+			dev_warn(c->dev,
+				 "conn MCU idle but no BTIF handle — skipping WMT WiFi function-on\n");
+		/* GROUND TRUTH: dump conn-MCU EMI coredump + status regs. Called
+		 * UNCONDITIONALLY (r111) so the DUMP-ROM readback prints even when a
+		 * patch breaks the boot (COM != 0x1d1e). */
+		mtk_conninfra_dump_coredump(c);
+	}
+
+	platform_set_drvdata(pdev, c);
+
+	/* Instantiate DT children (wmac@18000000) as platform devices so
+	 * their drivers (mt7915e's mt6785-wmac) can bind. devm_-managed
+	 * so the children are unbound automatically on remove. */
+	ret = devm_of_platform_populate(&pdev->dev);
+	if (ret) {
+		/* probe failure => .remove is NOT called, so unwind the power/
+		 * clk/supplies we brought up (reverse order), else the consys
+		 * domain + VCN regulators + CCIF clk + pm_runtime leak and the
+		 * next probe hits unbalanced-use warnings. */
+		dev_err(&pdev->dev, "of_platform_populate failed: %d\n", ret);
+		pm_runtime_put(c->dev);
+		pm_runtime_disable(c->dev);
+		clk_disable_unprepare(c->clk_ccif);
+		mtk_conninfra_disable_supplies(c);
+		return ret;
+	}
+	return 0;
+}
+
+static void mtk_conninfra_remove(struct platform_device *pdev)
+{
+	struct mtk_conninfra *c = platform_get_drvdata(pdev);
+
+	if (!c) {
+		dev_info(&pdev->dev, DRV_NAME ": remove (probe was no-op)\n");
+		return;
+	}
+	/* Only unwind state we actually set up — c->clk_ccif is only valid
+	 * if enable_bringup was true at probe time. */
+	if (c->clk_ccif && !IS_ERR(c->clk_ccif)) {
+		pm_runtime_put(&pdev->dev);
+		pm_runtime_disable(&pdev->dev);
+		clk_disable_unprepare(c->clk_ccif);
+		mtk_conninfra_disable_supplies(c);
+	}
+	dev_info(&pdev->dev, DRV_NAME ": removed\n");
+}
+
+static const struct of_device_id mtk_conninfra_of_match[] = {
+	/* Binds the consys@18002000 DT node's resources + power-domain + clocks. */
+	{ .compatible = "mediatek,mt6785-consys" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mtk_conninfra_of_match);
+
+static struct platform_driver mtk_conninfra_driver = {
+	.probe	= mtk_conninfra_probe,
+	.remove	= mtk_conninfra_remove,
+	.driver	= {
+		.name		= DRV_NAME,
+		.of_match_table	= mtk_conninfra_of_match,
+	},
+};
+module_platform_driver(mtk_conninfra_driver);
+
+MODULE_AUTHOR("Michal Andrzejczak <mit.mis@gmail.com>");
+MODULE_DESCRIPTION("MediaTek MT6785 ConnInfra power subsystem driver");
+MODULE_LICENSE("GPL");
diff --git a/include/linux/soc/mediatek/mtk-btif.h b/include/linux/soc/mediatek/mtk-btif.h
new file mode 100755
index 000000000..3007dba3f
--- /dev/null
+++ b/include/linux/soc/mediatek/mtk-btif.h
@@ -0,0 +1,103 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * MediaTek BTIF bus driver — public API for in-kernel consumers.
+ *
+ * BTIF is the UART-like FIFO link between the AP and the connectivity (consys)
+ * MCU on MediaTek combo SoCs. It carries the WMT (Wireless MultiTransport)
+ * control channel used to turn the WiFi/BT/GPS sub-functions on and off. The
+ * conninfra driver consumes this API to send WMT commands to the consys MCU
+ * once it has been brought to idle.
+ *
+ * The handle is obtained from a DT phandle to the BTIF node; struct mtk_btif
+ * is opaque to consumers.
+ */
+#ifndef __LINUX_SOC_MEDIATEK_MTK_BTIF_H
+#define __LINUX_SOC_MEDIATEK_MTK_BTIF_H
+
+#include <linux/types.h>
+
+struct device_node;
+struct mtk_btif;
+
+#if IS_ENABLED(CONFIG_MTK_BTIF)
+
+/**
+ * mtk_btif_get() - resolve a BTIF handle from a DT phandle node.
+ * @np: the BTIF device_node (e.g. from of_parse_phandle(consumer, "mediatek,btif", 0)).
+ *
+ * Return: the bound BTIF instance, or NULL if @np is not a BTIF device or its
+ * driver has not probed yet (the caller should treat NULL as -EPROBE_DEFER).
+ */
+struct mtk_btif *mtk_btif_get(struct device_node *np);
+
+/**
+ * mtk_btif_send() - queue bytes for transmission to the consys MCU.
+ * @b:   BTIF handle from mtk_btif_get().
+ * @buf: bytes to send (already framed by the caller).
+ * @len: number of bytes.
+ *
+ * Return: number of bytes accepted into the TX FIFO, or negative errno.
+ */
+int mtk_btif_send(struct mtk_btif *b, const u8 *buf, unsigned int len);
+
+/**
+ * mtk_btif_recv() - block for bytes received from the consys MCU.
+ * @b:          BTIF handle.
+ * @buf:        destination buffer.
+ * @len:        maximum bytes to copy.
+ * @timeout_ms: how long to wait for the first byte(s).
+ *
+ * Drains whatever has arrived in the RX FIFO (up to @len) once data is
+ * available. May return fewer bytes than a full frame; callers that need a
+ * whole frame should loop and accumulate.
+ *
+ * Return: number of bytes copied (0 on timeout), or negative errno.
+ */
+int mtk_btif_recv(struct mtk_btif *b, u8 *buf, unsigned int len,
+		  unsigned int timeout_ms);
+
+/**
+ * mtk_btif_raise_wak() - pulse the AP->consys wake-up line.
+ * @b: BTIF handle.
+ *
+ * Signals the consys MCU that a packet is pending, in case it had entered a
+ * low-power state. Return: 0 on success, negative errno otherwise.
+ */
+int mtk_btif_raise_wak(struct mtk_btif *b);
+
+/**
+ * mtk_btif_dump() - log BTIF + APDMA vFIFO state for diagnostics.
+ * @b:   BTIF handle.
+ * @tag: short label for the log line.
+ */
+void mtk_btif_dump(struct mtk_btif *b, const char *tag);
+
+#else
+
+static inline struct mtk_btif *mtk_btif_get(struct device_node *np)
+{
+	return NULL;
+}
+
+static inline int mtk_btif_send(struct mtk_btif *b, const u8 *buf,
+				unsigned int len)
+{
+	return -ENODEV;
+}
+
+static inline int mtk_btif_recv(struct mtk_btif *b, u8 *buf, unsigned int len,
+				unsigned int timeout_ms)
+{
+	return -ENODEV;
+}
+
+static inline int mtk_btif_raise_wak(struct mtk_btif *b)
+{
+	return -ENODEV;
+}
+
+static inline void mtk_btif_dump(struct mtk_btif *b, const char *tag) { }
+
+#endif /* CONFIG_MTK_BTIF */
+
+#endif /* __LINUX_SOC_MEDIATEK_MTK_BTIF_H */
