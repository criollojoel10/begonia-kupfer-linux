+#ifdef CONFIG_MT7615_MT6785_WMAC
+static int mt6785_load_firmware(struct mt7615_dev *dev)
+{
+	int ret;
+
+	/* N9 already running? (warm re-probe) */
+	if (mt76_get_field(dev, MT_CONN_ON_MISC, MT_TOP_MISC2_FW_N9_RDY))
+		return -EIO;
+
+	mt76_set(dev, MT_WPDMA_GLO_CFG, MT_WPDMA_GLO_CFG_BYPASS_TX_SCH);
+
+	dev_info(dev->mt76.dev,
+		 "begonia fw-dl pre: INT_SRC=0x%08x INT_MASK=0x%08x GLO_CFG=0x%08x\n",
+		 mt76_rr(dev, MT_INT_SOURCE_CSR), mt76_rr(dev, MT_INT_MASK_CSR),
+		 mt76_rr(dev, MT_WPDMA_GLO_CFG));
+
+	/* begonia does NOT download the N9 patch from the wlan driver — stock
+	 * logs \"MCU patch is not downloaded by wlan driver, read patch info\";
+	 * the conn-MCU/WMT side owns the patch. Go straight to the N9 RAM.
+	 * soc1_0 RAM: V3 multi-region (mt76_connac2_fw_trailer, n_region=5);
+	 * mt7663_load_n9 parses exactly this via mt76_connac_mcu_init_download. */
+	ret = mt7663_load_n9(dev, MT6785_FIRMWARE_N9);
+	if (ret) {
+		dev_info(dev->mt76.dev,
+			 "begonia fw-dl n9 FAIL ret=%d: INT_SRC=0x%08x INT_MASK=0x%08x MCU_INT=0x%08x\n",
+			 ret, mt76_rr(dev, MT_INT_SOURCE_CSR),
+			 mt76_rr(dev, MT_INT_MASK_CSR),
+			 mt76_rr(dev, MT_MCU2HOST_INT_STATUS));
+		goto out;
+	}
+
+	if (!mt76_poll_msec(dev, MT_CONN_ON_MISC, MT_TOP_MISC2_FW_N9_RDY,
+			    MT_TOP_MISC2_FW_N9_RDY, 1500)) {
+		dev_err(dev->mt76.dev, "begonia: timeout waiting FW_N9_RDY\n");
+		ret = -EIO;
+		goto out;
+	}
+
+	dev->fw_ver = MT7615_FIRMWARE_V3;
+	dev->mcu_ops = &uni_update_ops;
+	dev_info(dev->mt76.dev, "begonia soc1_0 firmware init done\n");
+out:
+	mt76_clear(dev, MT_WPDMA_GLO_CFG, MT_WPDMA_GLO_CFG_BYPASS_TX_SCH);
+	return ret;
+}
