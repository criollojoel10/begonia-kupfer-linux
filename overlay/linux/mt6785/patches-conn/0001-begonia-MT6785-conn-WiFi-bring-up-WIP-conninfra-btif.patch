+static int mtk_conninfra_map_by_name(struct platform_device *pdev,
+			       const char *name,
+			       unsigned long fallback_phys, size_t fallback_size,
+			       void __iomem **out)
+{
+	struct resource *r = platform_get_resource_byname(pdev, IORESOURCE_MEM, name);
+	void __iomem *p;
+
+	if (r) {
+		p = devm_ioremap(&pdev->dev, r->start, resource_size(r));
+		if (!p)
+			return dev_err_probe(&pdev->dev, -ENOMEM,
+					     "ioremap reg(%s)\n", name);
+		dev_info(&pdev->dev, "%s mapped @ %pa (%llu bytes)\n",
+			 name, &r->start, (unsigned long long)resource_size(r));
+	} else {
+		/* Fallback: ioremap by absolute physical address.  Used for
+		 * pinctrl/iocfg_lm which aren't part of the consys node's reg
+		 * list — they are separate top-level SoC blocks. */
+		p = devm_ioremap(&pdev->dev, fallback_phys, fallback_size);
+		if (!p)
+			return dev_err_probe(&pdev->dev, -ENOMEM,
+					     "ioremap fallback %s\n", name);
+		dev_info(&pdev->dev, "%s mapped from fixed phys 0x%08lx (%zu bytes)\n",
+			 name, fallback_phys, fallback_size);
+	}
+	*out = p;
+	return 0;
+}
