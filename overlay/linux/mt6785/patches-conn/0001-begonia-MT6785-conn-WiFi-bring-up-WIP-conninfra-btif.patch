+/* consys_reset_emi_coredump (stock wmt_drv.ko slot+0x138, .text 0x58fc) — the
+ * FIRST op in the stock conn power-on, and one our port was missing.  It zeroes
+ * the conn-MCU EMI coredump regions before the MCU boots: conn-window
+ * 0xF0068000..0xF0068400 (0x400) and 0xF0070400..0xF0078400 (0x8000).  The conn
+ * MCU's 0xF0000000 EMI window maps to our consys_reserved carveout's phys base
+ * (soc_mt6785 programs that remap), so these are carveout base+0x68000 and
+ * base+0x70400.  Stale garbage in the coredump area can leave the conn MCU in
+ * loader-wait (COM_REG0 stuck 0x4fd0).  Best-effort: warn+continue on failure.
+ * Safe: consys_reserved is a dedicated 4 MB no-map carveout, offsets well within. */
+static void mtk_conninfra_reset_emi_coredump(struct mtk_conninfra *c)
+{
+	struct device_node *np;
+	struct reserved_mem *rmem;
+	void __iomem *emi;
+
+	np = of_parse_phandle(c->dev->of_node, "memory-region", 0);
+	if (!np) {
+		dev_warn(c->dev, "EMI coredump reset: no memory-region phandle\n");
+		return;
+	}
+	rmem = of_reserved_mem_lookup(np);
+	of_node_put(np);
+	if (!rmem) {
+		dev_warn(c->dev, "EMI coredump reset: reserved_mem lookup failed\n");
+		return;
+	}
+	/* map [base+0x68000, base+0x78400) = 0x10400 bytes, covering both regions */
+	emi = ioremap_wc(rmem->base + 0x68000, 0x10400);
+	if (!emi) {
+		dev_warn(c->dev, "EMI coredump reset: ioremap_wc failed\n");
+		return;
+	}
+	memset_io(emi, 0, 0x400);		/* 0xF0068000..0xF0068400 */
+	memset_io(emi + 0x8400, 0, 0x8000);	/* 0xF0070400..0xF0078400 */
+	iounmap(emi);
+	dev_info(c->dev,
+		 "EMI coredump reset: zeroed carveout %pa +0x68000(0x400) +0x70400(0x8000)\n",
+		 &rmem->base);
+}
+
+/* ----- conn-MCU firmware load into EMI (r75) --------------------------------
+ * THE conn-MCU run gate (RE-confirmed from stock vmlinux + wmt_drv.ko): the conn
+ * MCU boots its RAM firmware from the EMI carveout.  If EMI is empty when the
+ * conn-CPU reset is released, the MCU executes nothing and sits in loader-wait
+ * (COM_REG0 0x18002600 stuck 0x4fd0).  Stock wmt_drv places the image BEFORE the
+ * reset release (polling_consys_chipid -> mtk_wcn_soc_rom_patch_dwn /
+ * wlanDownloadEMISection).  Our wmac-side prestage (soc_mt6785.c) placed the SAME
+ * blobs but TOO LATE — after this driver already released the reset — so the MCU
+ * had already wedged.  We replicate the stock placement here, in the reset-held
+ * POS window, right before the release.  Blobs carry a 48-byte ROM_EMI_HEADER
+ * whose patch_addr gives the conn-MCU EMI address (0xf0xxxxxx); we memcpy_toio to
+ * carveout + (patch_addr & 0xFFFFFF), the MCU's 0xf0000000 window mapping. */
+#define CONN_MCU_FW_RAM_MCU	"mediatek/soc1_0_ram_mcu_2a_1_hdr.bin"
+#define CONN_MCU_FW_RAM_WIFI	"mediatek/soc1_0_ram_wifi_2a_1_hdr.bin"
+#define CONN_MCU_FW_RAM_BT	"mediatek/soc1_0_ram_bt_2a_1_hdr.bin"
+/* The conn-MCU ROM PATCH (distinct from the EMI ram_* images above): a small
+ * ~22KB WMT_PATCH blob streamed to the MCU's PDA loader over STP/BTIF, then run
+ * via WMT_RESET.  This is what makes the (ROM-idle) MCU EXECUTE firmware, which
+ * powers WFSYS + boots the WiFi N9.  Header = 28-byte WMT_PATCH (time[16] +
+ * plat[4] + u2HwVer + u2SwVer + u4PatchAddr@0x18); body follows (no checksum,
+ * vendor wmt_ic_ops_soc.options=0).  patch_addr@0x18 = PDA target (0x0001c011). */
+#define CONN_MCU_FW_PATCH_MCU	"mediatek/soc1_0_patch_mcu_2a_1_hdr.bin"
+#define WMT_PATCH_HDR_LEN	28u	/* sizeof(WMT_PATCH); body starts after it */
+/* EmiOffset = patch_addr & 0x00FF0000.  The low 16 bits of the header patch_addr
+ * are a flag/type, NOT part of the EMI offset — VERIFIED against the WORKING stock
+ * MIUI wmt_drv log (docs/wifi-begonia/dmesg-STOCK-MIUI-wmt-working.txt):
+ *   ram_mcu  patch_addr 0xf0000011 -> EmiOffset 0x0
+ *   ram_wifi patch_addr 0xf0140011 -> EmiOffset 0x140000
+ *   ram_bt                         -> EmiOffset 0x80000
+ * Our earlier &0xFFFFFF mask put ram_mcu at carveout+0x11 (17 bytes off), so the
+ * conn MCU fetched garbage and never left loader-wait (COM_REG0 0x4fd0). */
+#define CONN_EMI_OFFSET_MASK	0x00FF0000u
+#define CONN_EMI_REMAP_OFFSET	0x0380u	/* INFRACFG_AO[0x380][19:0] = carveout>>16 */
+#define CONN_EMI_PERI_REMAP_OFF	0x0388u	/* [19:0] = peri base >> 16 */
+#define CONN_EMI_PERI_VAL	0x10003000u
+/* Stock consys_emi_set_remapping_reg programs a THIRD remap our driver omitted:
+ * the MD (modem-shared) window at TOPCKGEN+0x39C = mdPhy>>16. Stock boot dmesg
+ * shows MD_MAPPING(0x8c00); 0x8c000000 is a reserved region on pmOS (/proc/iomem
+ * 8c000000-8cd7ffff). If the conn-MCU fw touches its MD window during boot and
+ * this is unmapped (0), the access bus-errors -> the fw branches to idle instead
+ * of the 0xf000+ servicing dispatcher stock reaches. (CONSYS_EMI_AP_MD_OFFSET.) */
+#define CONN_EMI_MD_REMAP_OFF	0x039Cu	/* [19:0] = md shared-mem base >> 16 */
+#define CONN_EMI_MD_VAL		0x8c000000u
+#define CONN_EMI_REMAP_MASK	0x000FFFFFu
+
+struct conn_rom_emi_header {
+	u8	date_time[16];
+	u8	plat[4];
+	__le16	hw_ver;
+	__le16	sw_ver;
+	__le32	patch_addr;
+	__le32	patch_type;
+	__le32	crc[4];
+} __packed;
+static_assert(sizeof(struct conn_rom_emi_header) == 48);
+
+/* Place one conn RAM image into the EMI carveout at carveout + (patch_addr &
+ * 0x00FF0000), body after the 48-byte ROM_EMI_HEADER — matching stock
+ * mtk_wcn_soc_rom_patch_dwn (wmt_drv.ko .text 0x34b44) and the working MIUI log. */
+static int mtk_conninfra_emi_place(struct mtk_conninfra *c, phys_addr_t base,
+				   size_t sz, const char *name)
+{
+	const struct firmware *fw;
+	const struct conn_rom_emi_header *hdr;
+	void __iomem *p;
+	u32 off, len;
+	int ret;
+
+	ret = request_firmware(&fw, name, c->dev);
+	if (ret) {
+		dev_err(c->dev, "EMI fw %s missing: %d\n", name, ret);
+		return ret;
+	}
+	if (fw->size <= sizeof(*hdr)) {
+		release_firmware(fw);
+		return -EINVAL;
+	}
+	hdr = (const void *)fw->data;
+	off = le32_to_cpu(hdr->patch_addr) & CONN_EMI_OFFSET_MASK;
+	len = fw->size - sizeof(*hdr);
+	if ((u64)off + len > sz) {
+		dev_err(c->dev, "EMI %s [0x%x+0x%x] exceeds carveout 0x%zx\n",
+			name, off, len, sz);
+		release_firmware(fw);
+		return -EINVAL;
+	}
+	p = ioremap_wc(base, sz);
+	if (!p) {
+		release_firmware(fw);
+		return -ENOMEM;
+	}
+	memcpy_toio(p + off, fw->data + sizeof(*hdr), len);
+	wmb();
+	iounmap(p);
+	dev_info(c->dev, "EMI place %s patch_addr=0x%08x -> carveout+0x%x len 0x%x\n",
+		 name, le32_to_cpu(hdr->patch_addr), off, len);
+	release_firmware(fw);
+	return 0;
+}
+
+/* Set the WF->EMI remap + place the conn-MCU ROM patch so the MCU has code to
+ * run when its reset is released.  Must run while the conn CPU is held in reset. */
+static void mtk_conninfra_emi_load(struct mtk_conninfra *c)
+{
+	struct device_node *np;
+	struct reserved_mem *rmem;
+	u32 r;
+
+	np = of_parse_phandle(c->dev->of_node, "memory-region", 0);
+	if (!np) {
+		dev_warn(c->dev, "EMI load: no memory-region phandle\n");
+		return;
+	}
+	rmem = of_reserved_mem_lookup(np);
+	of_node_put(np);
+	if (!rmem) {
+		dev_warn(c->dev, "EMI load: reserved_mem lookup failed\n");
+		return;
+	}
+
+	/* WF->EMI remap: point the conn MCU's 0xf0000000 window at our carveout
+	 * (INFRACFG_AO[0x380][19:0] = base>>16) + peri window. */
+	r = readl(c->infracfg + CONN_EMI_REMAP_OFFSET);
+	r = (r & ~CONN_EMI_REMAP_MASK) |
+	    (u32)((rmem->base >> 16) & CONN_EMI_REMAP_MASK);
+	writel(r, c->infracfg + CONN_EMI_REMAP_OFFSET);
+	r = readl(c->infracfg + CONN_EMI_PERI_REMAP_OFF);
+	r = (r & ~CONN_EMI_REMAP_MASK) |
+	    ((CONN_EMI_PERI_VAL >> 16) & CONN_EMI_REMAP_MASK);
+	writel(r, c->infracfg + CONN_EMI_PERI_REMAP_OFF);
+	/* MD (modem-shared) window remap — stock sets this third mapping; we omitted it. */
+	r = readl(c->infracfg + CONN_EMI_MD_REMAP_OFF);
+	r = (r & ~CONN_EMI_REMAP_MASK) |
+	    ((CONN_EMI_MD_VAL >> 16) & CONN_EMI_REMAP_MASK);
+	writel(r, c->infracfg + CONN_EMI_MD_REMAP_OFF);
+	dev_info(c->dev, "WF->EMI remap [0x380]=0x%08x [0x388]=0x%08x [0x39c]=0x%08x carveout %pa\n",
+		 readl(c->infracfg + CONN_EMI_REMAP_OFFSET),
+		 readl(c->infracfg + CONN_EMI_PERI_REMAP_OFF),
+		 readl(c->infracfg + CONN_EMI_MD_REMAP_OFF), &rmem->base);
+
+	/* ⭐ Stock (mtk_wmt_probe) zeroes the ENTIRE connsys EMI carveout ("Clearing
+	 * Connsys EMI 4194304 bytes") BEFORE placing the RAM images — a clean slate.
+	 * The conn-MCU's .data/.bss/scratch/log-ring regions live in EMI OUTSIDE the
+	 * loaded ram_mcu image (only 0x1dfe8 B); stale DRAM there can derail its early
+	 * init before it reaches the 0xf000+ servicing loop.  We previously zeroed only
+	 * the coredump regions.  Match stock: full-carveout clear, THEN place images.
+	 * (Empirical: .miui-capture stock boot dmesg reaches PC 0xf2a6 right after this.) */
+	{
+		void __iomem *pz = ioremap_wc(rmem->base, rmem->size);
+
+		if (pz) {
+			memset_io(pz, 0, rmem->size);
+			wmb();
+			iounmap(pz);
+			dev_info(c->dev, "EMI: cleared FULL carveout %pa size 0x%zx (match stock)\n",
+				 &rmem->base, (size_t)rmem->size);
+		}
+	}
+
+	/* ⭐ A2 (wf wcvhqa405) — stock consys_emi_mpu_set_region_protection: EMI MPU
+	 * region 27 over the conn carveout (FORBIDDEN except domains 14/16), via the MTK
+	 * EMIMPU secure SMC (mainline lacks emi_mpu_set_protection; the raw EMI-MPU regs
+	 * are secure-only).  MTK_SIP_KERNEL_EMIMPU_SET (AARCH64) = 0xC2000262.
+	 * arm_smccc_smc takes a0..a7 then &res (four trailing zeros after the apc word). */
+	{
+		struct arm_smccc_res res;
+		u32 start  = (u32)((rmem->base >> 16) | (27u << 24));
+		u32 end_hi = (u32)(((rmem->base + rmem->size - 1) >> 16) | (1u << 24));
+		u32 end_lo = (u32)(((rmem->base + rmem->size - 1) >> 16) | (0u << 24));
+
+		arm_smccc_smc(0xC2000262u, start, end_hi, 0x00b6db6du, 0, 0, 0, 0, &res);
+		arm_smccc_smc(0xC2000262u, start, end_lo, 0x80b6da28u, 0, 0, 0, 0, &res);
+		if ((long)res.a0 < 0)
+			dev_warn(c->dev, "EMI-MPU SMC unimplemented by ATF (res.a0=0x%lx) — continuing\n",
+				 res.a0);
+		else
+			dev_info(c->dev, "EMI-MPU region27 set via SMC: res.a0=0x%lx\n", res.a0);
+	}
+
+	/* Place the conn RAM firmware at the stock EmiOffsets (verified against the
+	 * working MIUI log): ram_mcu @ carveout+0x0, ram_wifi @ +0x140000,
+	 * ram_bt @ +0x80000.  ram_mcu @ +0x0 is the conn-MCU's own image — the MCU
+	 * boots it on reset release and advances COM_REG0 0x4fd0 -> 0x1D1E. */
+	/* r105 skip_emi (ROM-vs-EMIfw decisive test): the full-carveout clear above
+	 * already ran, so skipping placement leaves EMI all-ZERO (no ram fw). If the
+	 * conn-MCU still reaches COM_REG0=0x1d1e with ZERO firmware present, it is
+	 * provably executing its in-silicon ROM (not our EMI image) — confirms 2026-06-06b
+	 * before any stock-flash roundtrip. */
+	if (skip_emi) {
+		dev_info(c->dev, "skip_emi: NOT placing ram_mcu/wifi/bt — EMI left ZEROED (ROM-vs-EMIfw test)\n");
+	} else {
+		mtk_conninfra_emi_place(c, rmem->base, rmem->size, CONN_MCU_FW_RAM_MCU);
+		mtk_conninfra_emi_place(c, rmem->base, rmem->size, CONN_MCU_FW_RAM_WIFI);
