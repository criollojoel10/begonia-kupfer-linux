+ * dual-sourced: mt6785-pm-domains.h CONN bp_cfg + vendor mt6785.h. */
+#define INFRACFG_BASE_DEFAULT		0x10001000UL	/* real infracfg syscon */
+#define INFRACFG_WIN_SIZE		0x1000
+#define INFRA_TOPAXI_PROTECTEN_STA1	0x228
+#define INFRA_TOPAXI_PROTECTEN_CLR	0x2a4		/* write-1-to-clear-protection */
+#define INFRA_TOPAXI_PROTECTEN_1_STA1	0x258
+#define INFRA_TOPAXI_PROTECTEN_1_CLR	0x2ac
+#define CONN_TOPAXI_PROT_0_MASK		(BIT(13) | BIT(14) | BIT(18)) /* AP2CONN_AHB | CONN2INFRA_AHB | CONN2INFRA_AXI_GALS_MST */
+#define CONN_TOPAXI_PROT_1_MASK		BIT(10)			      /* AP2CONN AHB Rx */
+
+/* ----- conn_infra POS (Platform Operation Sequence) windows --------------
+ * The begonia-family (mt6781/mt6789 conn_infra gen, VER_ID 0x10020600) POS
+ * configuration. Vendor caller mtk_wcn_consys_hw_reg_ctrl(on=1) runs these
+ * AFTER VER_ID but WHILE the conn CPU is still held in reset, THEN releases the
+ * reset (reset_bit_set ENABLE ... afe/emi/xo/bus_timeout ... reset_bit_set
+ * DISABLE). Several of these CRs are reset-protected and only latch while the
+ * MCU is in reset. Bases match begonia's consys DT node; values from
+ * mt6781_pos_gen.c (the auto-generated POS for begonia's sibling SoC). */
+#define CONN_MCU_BASE_DEFAULT		0x18002000UL	/* CONN_MCU_CONFIG */
+#define CONN_MCU_WIN_SIZE		0x1000
+#define CONN_MCU_BT_EMI_ENTRY_OFFSET	0x504		/* = 0xf0170000 */
+#define CONN_MCU_WF_EMI_ENTRY_OFFSET	0x508		/* = 0xf02a0000 */
+#define CONN_MCU_BUSHANGCR_OFFSET	0x440		/* = 0x90000002 */
+#define CONN_MCU_COM_REG0_OFFSET	0x600		/* MCU state (idle == 0x1d1e) */
+#define CONN_MCU_COM_REG0_IDLE		0x00001D1Eu	/* conn-MCU idle/ready (stock gate) */
+
+#define CONN_AFE_CTL_BASE_DEFAULT	0x180B3000UL	/* begonia-family AFE */
+#define CONN_AFE_CTL_WIN_SIZE		0x200
+#define CONN_AFE_RG_WBG_PLL_04_OFFSET	0x30		/* = 0x00040088 */
+#define CONN_AFE_RG_WBG_GL5_02_OFFSET	0x104		/* = 0xa8808800 */
+
+/* mt6877 conninfra-core AFE base (the open sibling of begonia's closed core). The
+ * authoritative afe_wbg_cal + subsys_pll_initial operate here. Register map from
+ * .research/conninfra-mt6877/mt6877_pos.c (connsys_afe_wbg_cal/subsys_pll_initial). */
+#define CONN_AFE2_BASE_DEFAULT		0x18003000UL
+#define CONN_AFE2_WIN_SIZE		0x200
+#define AFE2_RG_DIG_EN_01		0x00	/* RC[0], TXCAL WF/BT [21:19] */
+#define AFE2_RG_DIG_EN_02		0x04	/* PLL routing: WF[1:0],MCU_BGF[3:2],BT[7:6],MCU_WF[17:16] */
+#define AFE2_RG_DIG_EN_03		0x08	/* BPLL_UP[21], WPLL_UP[20] */
+#define AFE2_RG_DIG_TOP_01		0x0c	/* CLKGEN WPLL+BPLL REQUEST [18:15] */
+#define AFE2_RG_PLL_STB_TIME		0xf4	/* = 0x03140521 mask 0x7FFF7FFF */
+#define AFE2_RG_WBG_BT0_TX_03		0x58	/* VCM [25:22] */
+#define AFE2_RG_WBG_WF0_TX_03		0x78
+#define AFE2_RG_WBG_WF1_TX_03		0x94
+/* conn_infra D-die cfg (mt6877 connsys_d_die_cfg): conn2ap EMI path range +
+ * SYSRAM/co-ext mem HW-control. All in the conn_infra-OFF window (already mapped
+ * via the 16MB wmac window from the wmac side, but conninfra needs its own). */
+#define CONN_BUS_CR_EMI_START_OFFSET	0xE360	/* CONN_BUS_CR base 0x1800E000 + .. */
+/* WPLL setting ("WPLL issue@LT", vendor mt6785.c:955 / mt6785.h:136): conn AFE
+ * 0x180b3034 = (v & 0xFFE7FFFF) | 0x00080000 (set bit19). The conn WiFi PLL —
+ * candidate for bringing up the conn_infra hif/MCU clock (HCLK/OSCCLK @ 0x18007000). */
+#define CONN_AFE_WPLL_SETTING_OFFSET	0x34		/* 0x180b3034 */
+#define CONN_AFE_WPLL_SETTING_MASK	0xFFE7FFFFu
+#define CONN_AFE_WPLL_SETTING_VALUE	0x00080000u
+#define CONN_AFE_RG_DIG_EN_03_OFFSET	0x08		/* bus clock: BPLL[21]/WPLL[20] */
+#define CONN_AFE_BPLL_EN		BIT(21)
+#define CONN_AFE_WPLL_EN		BIT(20)
+
+/* conn_infra clock-liveness check (vendor consys_check_reg_readable, gen4m
+ * mt6785.c:1311 — write CONSYS_CLOCK_CHECK_VALUE to mcu_conn_hif_on_base, read
+ * back; bit16=HCLK, bit17=OSCCLK must both be set if the conn_infra HW bus clock
+ * to the MCU/hif domain is alive). The base is CONN_HIF_ON @ 0x18007000 (begonia
+ * consys DTS reg index 4), NOT 0x18060000 (that's CONN_HOST_CSR_TOP). */
+#define CONN_HIF_ON_BASE_DEFAULT	0x18007000UL
+#define CONN_HIF_ON_WIN_SIZE		0x1000
+#define CONN_HIF_ON_CLOCK_CHECK_OFFSET	0x0		/* 0x18007000 */
+#define CONN_HIF_ON_CLOCK_CHECK_VALUE	0x00030000u
+#define CONN_HIF_ON_HCLK		BIT(16)
+#define CONN_HIF_ON_OSCCLK		BIT(17)
+
+#define CONN_MCU_TOP_MISC_ON_BASE_DEFAULT 0x180C1000UL	/* CONN_TOP_MISC_ON */
+#define CONN_MCU_TOP_MISC_ON_WIN_SIZE	0x1000
+#define CONN_ON_OSC_CTL_OFFSET		0x200		/* XO initial stable */
+#define CONN_ON_OSC_CTL_2_OFFSET	0x204		/* XO bg stable + ack */
+#define CONN_ON_RC_OSC_CTL_0_OFFSET	0x240		/* rc osc_ctrl_top */
+
+#define CONN_RGU_ON_BASE_DEFAULT	0x180C0000UL	/* CONN_RGU_ON */
+#define CONN_RGU_ON_WIN_SIZE		0x300
+#define CONN_RGU_MCUSYS_DLY_CHAIN_OFFSET 0x284		/* mcu mem pdn delay */
