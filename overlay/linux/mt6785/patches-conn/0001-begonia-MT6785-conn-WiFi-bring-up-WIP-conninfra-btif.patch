diff --git a/arch/arm64/boot/dts/mediatek/mt6785-xiaomi-begonia-common.dtsi b/arch/arm64/boot/dts/mediatek/mt6785-xiaomi-begonia-common.dtsi
index 9b9bf94f3..b4fe73ab3 100644
--- a/arch/arm64/boot/dts/mediatek/mt6785-xiaomi-begonia-common.dtsi
+++ b/arch/arm64/boot/dts/mediatek/mt6785-xiaomi-begonia-common.dtsi
@@ -731,3 +731,19 @@ &xhci {
 	vusb33-supply = <&mt6359_vusb_ldo_reg>;
 	status = "okay";
 };
+
+&{/reserved-memory} {
+	/* CONNSYS EMI carveout — 4 MB, 16 MB-aligned. AP-side physical DRAM
+	 * the conn MCU + WFSYS reach through their 0xf0000000 EMI window once
+	 * the conninfra driver programs the remap: INFRACFG_AO(0x10001000)+0x380
+	 * = (this base >> 16). Blobs land at carveout + (patch_addr & 0x00FF0000):
+	 * ram_mcu +0x0, ram_wifi +0x140000, ram_bt +0x80000 (conninfra
+	 * mtk_conninfra_emi_load). This is the single shared conn EMI carveout. */
+	consys_reserved: consys@0 {
+		compatible = "mediatek,mt6785-consys-reserved";
+		no-map;
+		size = <0 0x400000>;
+		alignment = <0 0x1000000>;
+		alloc-ranges = <0 0x40000000 0 0x80000000>;
+	};
+};
diff --git a/arch/arm64/boot/dts/mediatek/mt6785.dtsi b/arch/arm64/boot/dts/mediatek/mt6785.dtsi
index 2d92417c9..a244539c0 100644
--- a/arch/arm64/boot/dts/mediatek/mt6785.dtsi
+++ b/arch/arm64/boot/dts/mediatek/mt6785.dtsi
@@ -828,7 +828,7 @@ timer {
 			     <GIC_PPI 10 IRQ_TYPE_LEVEL_LOW 0>;
 	};
 
-	soc {
+	soc: soc {
 		#address-cells = <2>;
 		#size-cells = <2>;
 		compatible = "simple-bus";
@@ -1991,3 +1991,86 @@ larb6: larb@1a001000 {
 		};
 	};
 };
+
+&soc {
+	consys: consys@18002000 {
+		compatible = "mediatek,mt6785-consys";
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+		reg = <0 0x18002000 0 0x1000>,	/* MCU CONFIG */
+		      <0 0x10003000 0 0x1000>,	/* INFRA_AO_PERICFG (vendor consys reg index 11); conninfra uses +0x438 here for CON_PWR_ON. Vendor's actual INFRACFG_AO is reg index 2 = 0x10001000 (TOPAXI bus-protect + EMI remap @ +0x380), hardcoded in both drivers */
+		      <0 0x10006000 0 0x1000>,	/* SPM */
+		      <0 0x10007000 0 0x0100>,	/* AP_RGU */
+		      <0 0x18007000 0 0x1000>,	/* CONN_HIF_ON */
+		      <0 0x180b1000 0 0x1000>,	/* CONN_TOP_MISC_OFF */
+		      <0 0x180a3000 0 0x1000>,	/* CONN_MCU_CFG_ON */
+		      <0 0x180a5000 0 0x0800>,	/* CONN_MCU_CIRQ */
+		      <0 0x180c1000 0 0x1000>,	/* CONN_TOP_MISC_ON */
+		      <0 0x18004000 0 0x1000>,	/* CONN_HIF_PDMA */
+		      <0 0x10000000 0 0x1000>,	/* TOPCKGEN (clocks; bus-protect is actually at INFRACFG 0x10001000, mapped via fixed-phys in the driver) */
+		      <0 0x180b3000 0 0x0100>;	/* WPLL */
+		reg-names = "mcu-cfg", "infracfg-ao", "spm", "ap-rgu",
+			    "conn-hif-on", "conn-top-misc-off",
+			    "conn-mcu-cfg-on", "conn-mcu-cirq",
+			    "conn-top-misc-on", "conn-hif-pdma",
+			    "topckgen", "wpll";
+		clocks = <&infracfg CLK_INFRA_CCIF4_AP>;
+		clock-names = "ccif";
+		power-domains = <&spm MT6785_POWER_DOMAIN_CONN>;
+		memory-region = <&consys_reserved>;
+		/* mt6359 PMIC regmap — conninfra driver forces XO_WCN (EXTBUF2,
+		 * the conn 26MHz clock buffer) on via DCXO_CW00. begonia is
+		 * non-co-clock so the vendor runtime relies on the preloader
+		 * leaving it HW-on; mainline has no mt6359 clk-buf driver. */
+		mediatek,pmic = <&pmic>;
+		/* BTIF (WMT control channel to the conn MCU). The conninfra driver
+		 * sends the WMT FUNCTION_CTRL command that arms the WFSYS over this. */
+		mediatek,btif = <&btif>;
+		/* A-die analog rails (begonia WiFi has a SEPARATE A-die). Vendor
+		 * WMT consys_hw_on powers these mt6359 LDOs before WFSYS bring-up:
+		 * VCN18 1.8V + VCN33_1 3.3V (consys_hw_vcn18_ctrl) and VCN33_2 2.8V
+		 * (consys_hw_vcn28_ctrl, non-co-clock path). Without them the A-die
+		 * has no RF/PLL clock and the WFSYS rgu (0x180602cc[2]) never arms. */
+		vcn18-supply = <&mt6359_vcn18_ldo_reg>;
+		vcn33_1_wifi-supply = <&mt6359_vcn33_1_wifi_ldo_reg>;
+		vcn33_2_wifi-supply = <&mt6359_vcn33_2_wifi_ldo_reg>;
+		status = "okay";
+	};
+};
+
+#include <dt-bindings/clock/mediatek,mt6785-clk.h>
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+
+&soc {
+	btif: btif@1100c000 {
+		compatible = "mediatek,btif";
+		reg = <0 0x1100c000 0 0x1000>,	/* btif base */
+		      <0 0x11000b80 0 0x80>,	/* btif tx dma */
+		      <0 0x11000c00 0 0x80>;	/* btif rx dma */
+		interrupts = <GIC_SPI 138 IRQ_TYPE_LEVEL_LOW>,	/* btif */
+			     <GIC_SPI 155 IRQ_TYPE_LEVEL_LOW>,	/* tx dma */
+			     <GIC_SPI 154 IRQ_TYPE_LEVEL_LOW>;	/* rx dma */
+		clocks = <&infracfg CLK_INFRA_BTIF>,
+			 <&infracfg CLK_INFRA_AP_DMA>;
+		clock-names = "btifc", "apdmac";
+		status = "okay";
+	};
+};
+
+&consys {
+	wmac: wmac@18000000 {
+		compatible = "mediatek,mt6785-wmac";
+		/* Full conn_infra window (16 MB), matching mt7986-wmac: the mt798x
+		 * reg_map remaps offsets > 1 MB into this aperture. */
+		reg = <0 0x18000000 0 0x1000000>;
+		interrupts = <GIC_SPI 322 IRQ_TYPE_LEVEL_LOW>;
+		/* No memory-region: the conn-MCU/WFSYS firmware EMI carveout +
+		 * WF->EMI remap are owned by the parent consys node / conninfra
+		 * driver (consys_reserved). The wmac side reads firmware over the
+		 * mt76 FWDL ring (DMA), not the carveout. */
+		power-domains = <&spm MT6785_POWER_DOMAIN_CONN>;
+		status = "okay";
+	};
+};
diff --git a/drivers/misc/Kconfig b/drivers/misc/Kconfig
