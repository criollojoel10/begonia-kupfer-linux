diff --git a/drivers/soc/mediatek/mtk-conninfra-mt6785.c b/drivers/soc/mediatek/mtk-conninfra-mt6785.c
new file mode 100755
index 000000000..983800d0f
--- /dev/null
+++ b/drivers/soc/mediatek/mtk-conninfra-mt6785.c
@@ -0,0 +1,3301 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek MT6785 (Helio G90T) ConnInfra power subsystem driver.
+ *
+ * Owns the bring-up sequence for the connectivity subsystem (BT/WiFi/FM/GPS
+ * shared MCU): VCN18 + VCN33_1_WIFI LDOs, D-die <-> A-die pinmux, SPM
+ * CONN_PWR_CON dance via genpd, INFRACFG_AO CON_PWR_ON.  Bring-up passes
+ * when CONN_TOP_MISC_OFF.VER_ID @ 0x180b1010 reads 0x10020600.
+ *
+ * Source-cross-referenced from MiCode begonia-p-oss vendor kernel:
+ *   drivers/misc/mediatek/connectivity/common/common_main/platform/
+ *   mtk_wcn_consys_hw.c:587  mtk_wcn_consys_hw_reg_ctrl(on=1)
+ *   mt6785.c                 consys_hw_vcn18_ctrl / consys_pmic_get_from_dts
+ *                            consys_set_if_pinmux / consys_hw_power_ctrl
+ *   mt6785.h                 CONSYS_IF_PINMUX_* / CONSYS_REG_*
+ *
+ * Bind via DT compatible "mediatek,mt6785-consys".  CON_PWR_ON address is
+ * INFRA_AO_PERICFG @ 0x10003000 + 0x438 = 0x10003438.
+ */
+#include <linux/clk.h>
+#include <linux/crc16.h>
+#include <linux/delay.h>
+#include <linux/firmware.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/of_platform.h>
+#include <linux/of_reserved_mem.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+#include <linux/regmap.h>
+#include <linux/mfd/syscon.h>
+#include <linux/regulator/consumer.h>
+#include <linux/arm-smccc.h>
+
+#include <linux/soc/mediatek/mtk-btif.h>
+
+/* ----- mt6359 PMIC conn XO clock buffer (XO_EXTBUF2 / "XO_WCN") ------------
+ * The conn subsystem's 26MHz crystal clock comes from the mt6359 PMIC's
+ * EXTBUF2 buffer. Vendor clk_buf_ctrl_internal(CLK_BUF_CONN, FORCE_ON) force-on
+ * = on DCXO_CW00: clear XO_EXTBUF2_MODE (bits[4:3]), set XO_EXTBUF2_EN_M (bit5).
+ * begonia stock RUNTIME co_clock_type == 1 (stock dmesg "co clock type(1),turn
+ * on clk buf"): the gen4m callback consys_co_clock_type() is hardcoded 0
+ * (mt6785.c:448) but is OVERRIDDEN by the vendor WMT_SOC.cfg co_clock_flag=1
+ * (wmt_plat_alps.c:356, wmt_conf.c:144). In the type-1 branch the vendor
+ * clock_buffer_ctrl(ENABLE)->KERNEL_clk_buf_ctrl(CLK_BUF_CONN,true) OPENS
+ * XO_WCN; mainline has no mt6359 clk-buf driver, so we force it on here (this
+ * IS the type-1 behaviour). Regs from LineageOS begonia upmu_hw.h (base=0).
+ * NOTE: co-clock type is NOT the conn-MCU servicing-loop gate (it runs before
+ * COM_REG0=0x1D1E, which we reach); verified by 5-agent workflow 2026-06-03. */
+#define MT6359_DCXO_CW00		0x788
+#define XO_EXTBUF2_MODE_MASK		(0x3u << 3)	/* bits [4:3] */
+#define XO_EXTBUF2_EN_M_MASK		(0x1u << 5)	/* bit 5 */
+
+/* ----- mt6359 A-die LDO hardware low-power (SRCLKEN0) config --------------
+ * The vendor consys_hw_vcn18_ctrl / consys_hw_vcn28_ctrl (mt6785.c) do NOT
+ * just regulator_enable the conn A-die rails — they also tie each LDO to
+ * SRCLKEN0 so it tracks the SoC low-power state in hardware. Our driver did
+ * the regulator_enable but skipped this LP config; replicate it exactly via
+ * the mt6359 regmap. Addresses + bit positions are from LineageOS begonia
+ * upmu_hw.h (MT6359_PMIC_REG_BASE = 0); pmic_lp_api.c decodes the vendor call
+ * pmic_ldo_xxx_lp(user, op_mode, op_en, op_cfg) into these register writes:
+ *   user SRCLKEN0(0)/SW(15) -> bit index of OP_EN/OP_CFG;
+ *   op_mode -> CON0 bit (user+10);  LP -> CON0[1];  op_cfg HW_LP=1, HW_OFF=0.
+ * VCN18 uses HW_LP, VCN33_2 uses HW_OFF; VCN33_1 stays SW-mode (no LP cfg). */
+#define VCN18_LDO_CON0			0x1c2a	/* RG_LDO_VCN18:   LP[1], OP_MODE_SRCLKEN0[10] */
+#define VCN18_LDO_OP_EN			0x1c2e	/*   HW0_OP_EN[0], SW_OP_EN[15] */
+#define VCN18_LDO_OP_CFG		0x1c34	/*   HW0_OP_CFG[0] */
+#define VCN33_2_LDO_CON0		0x1c08	/* RG_LDO_VCN33_2: identical layout */
+#define VCN33_2_LDO_OP_EN		0x1c0c
+#define VCN33_2_LDO_OP_CFG		0x1c12
+#define MT6359_LDO_LP			BIT(1)	/* CON0[1]  SW low-power request */
+#define MT6359_LDO_OP_MODE_SRCLKEN0	BIT(10)	/* CON0[10] HW low-power mode for SRCLKEN0 */
+#define MT6359_LDO_HW0_OP		BIT(0)	/* OP_EN/OP_CFG[0] SRCLKEN0 operator */
+#define MT6359_LDO_SW_OP_EN		BIT(15)	/* OP_EN[15] SW operator enable */
+
+/* ----- SPM CONN power-domain control (vendor clk-mt6785-pg.c CONN block) - */
+#define SPM_BASE_DEFAULT		0x10006000UL
+#define SPM_WIN_SIZE			0x1000
+#define CONN_PWR_CON_OFFSET		0x320
+#define SPM_PWR_STATUS_OFFSET		0x160
+#define SPM_PWR_STATUS_2ND_OFFSET	0x164
+#define PWR_RST_B			BIT(0)
+#define PWR_ISO				BIT(1)
+#define PWR_ON				BIT(2)
+#define PWR_ON_2ND			BIT(3)
+#define PWR_CLK_DIS			BIT(4)
+#define CONN_PWR_STA_MASK		BIT(1)
+/* PWRON_CONFG_EN: the SPM power-machine seed begonia's stock consys_hw_power_ctrl
+ * writes (0x10006000 = 0x0b160001) before the CONN power dance. spm@0x10006000,
+ * so offset 0 from c->spm. */
+#define SPM_PWRON_CONFG_EN_OFFSET	0x0
+#define SPM_PWRON_CONFG_EN_VALUE	0x0b160001u
+
