+ * Andes NDS32 core) writes its exception/coredump register snapshot to the EMI
+ * coredump region — conn-view 0x70068000 (uncached) / 0xf0068000 (cached), both
+ * aliasing EMI offset 0x68000 = carveout+0x68000, which we zero at bring-up.
+ * NON-ZERO contents here = the MCU FAULTED during init and dumped its state
+ * (fault PC, cause, GP regs) — disassembly (NDS32) shows the dump routine at fw
+ * 0xba70 writing an index to 0x8002209c and the result from 0x80025048 here.
+ * All-zero = no fault written.  Also samples the CONN_TOP_MISC_ON regs the fw
+ * touches (chip 0x81021xxx -> phys 0x180C1xxx). */
+static void mtk_conninfra_dump_coredump(struct mtk_conninfra *c)
+{
+	struct device_node *np;
+	struct reserved_mem *rmem;
+	void __iomem *p;
+	bool any;
+	int i;
+
+	np = of_parse_phandle(c->dev->of_node, "memory-region", 0);
+	if (!np)
+		return;
+	rmem = of_reserved_mem_lookup(np);
+	of_node_put(np);
+	if (!rmem)
+		return;
+	p = ioremap_wc(rmem->base, rmem->size);
+	if (!p)
+		return;
+
+	/* r112 DUMP-SYSRAM readback (carveout-only, can't hang): the conn-MCU copied its
+	 * SYSRAM [0x02000000..0x02010000] to carveout+0x40000. SYSRAM addr 0x02000000+X is
+	 * at carveout+0x40000+X.  Show the 9-slot RTOS scheduler table (0x020014bc stride
+	 * 0x20 => carveout+0x414bc), per-slot [tcb +0x14]=state (<2=RUNNABLE) +0x16=prio,
+	 * + STATE/WINNER/MASK, + the EMI ROM->callback vtable (carveout+0x25c00, direct). */
+	if (force_dumprom || force_tramp) {
+		int i;
+
+		dev_info(c->dev,
+			 "SCHED globals: STATE[0x02005980]=%08x (8=no-task) WINNER[0x02005984]=%08x (0=idle, !=0=climb) MASK[0x02001444]=%08x (suppress; bit set=slot locked)\n",
+			 readl(p + 0x45980), readl(p + 0x45984), readl(p + 0x41444));
+		dev_info(c->dev, "=== RTOS scheduler 9-slot task table @SYSRAM 0x020014bc (tcb +0x14=state<2=RUNNABLE, +0x16=prio) ===\n");
+		for (i = 0; i < 9; i++) {
+			u32 base = 0x414bc + i * 0x20;
+			u32 tcb = readl(p + base);
+			u32 w14 = readl(p + base + 0x14);
+			u32 w0c = readl(p + base + 0x0c);
+
+			dev_info(c->dev,
+				 "  slot%d @0x%07x: tcb=%08x %s | [+0x14]=%08x state=%02x(%s) prio=%02x | [+0x0c]=%08x\n",
+				 i, 0x020014bc + i * 0x20, tcb, tcb ? "POPULATED" : "empty",
+				 w14, w14 & 0xff, (w14 & 0xff) < 2 ? "RUNNABLE" : "blocked",
+				 (w14 >> 16) & 0xff, w0c);
+		}
+		dev_info(c->dev, "=== EMI ROM->callback vtable @carveout+0x25c00 (boot-fnptr +0x0c, ISR-fnptr +0xb4) ===\n");
+		for (i = 0; i < 0x100; i += 16)
+			dev_info(c->dev, "  vtbl+%03x: %08x %08x %08x %08x\n", i,
+				 readl(p + 0x25c00 + i), readl(p + 0x25c00 + i + 4),
+				 readl(p + 0x25c00 + i + 8), readl(p + 0x25c00 + i + 12));
+	}
+
+	dev_info(c->dev, "=== conn-MCU EMI coredump @carveout+0x68000 (non-zero words = MCU faulted) ===\n");
+	any = false;
+	for (i = 0; i < 0x400; i += 16) {
+		u32 w0 = readl(p + 0x68000 + i),     w1 = readl(p + 0x68000 + i + 4);
+		u32 w2 = readl(p + 0x68000 + i + 8), w3 = readl(p + 0x68000 + i + 12);
+
+		if (w0 | w1 | w2 | w3) {
+			dev_info(c->dev, "  +0x%03x: %08x %08x %08x %08x\n", i, w0, w1, w2, w3);
+			any = true;
+		}
+	}
+	if (!any)
+		dev_info(c->dev, "  (all zero — no coredump written)\n");
+
+	dev_info(c->dev, "=== conn-MCU EMI coredump2 @carveout+0x70400 (non-zero) ===\n");
+	any = false;
+	for (i = 0; i < 0x800; i += 16) {
+		u32 w0 = readl(p + 0x70400 + i),     w1 = readl(p + 0x70400 + i + 4);
+		u32 w2 = readl(p + 0x70400 + i + 8), w3 = readl(p + 0x70400 + i + 12);
+
+		if (w0 | w1 | w2 | w3) {
+			dev_info(c->dev, "  +0x%03x: %08x %08x %08x %08x\n", i, w0, w1, w2, w3);
+			any = true;
+		}
+	}
+	if (!any)
+		dev_info(c->dev, "  (all zero)\n");
+
+	/* The serial/BTIF DMA init (fw fn 0x3968) reads its baud/ring config from
+	 * EMI 0xf001ee7c/ee84/ee98/ee9c (= carveout+0x1ee7c/...).  If these are 0,
+	 * the host never seeded them and the conn BTIF DMA channel is misconfigured. */
+	dev_info(c->dev,
+		 "EMI serial-cfg: +1ee7c=%08x +1ee84=%08x +1ee98=%08x +1ee9c=%08x | +1ee40=%08x +1ee54=%08x\n",
+		 readl(p + 0x1ee7c), readl(p + 0x1ee84), readl(p + 0x1ee98),
+		 readl(p + 0x1ee9c), readl(p + 0x1ee40), readl(p + 0x1ee54));
+
+	/* ⭐ r94 — SERVICING-LOOP GATE PROBE (from 6-agent workflow wf_6891a3c2).
+	 * The conn-MCU reaches 0x1d1e idle but dwells in its phase-1 superloop
+	 * (fn 0x26c4) and never enters the 0xf000+ servicing loop.  These EMI words
+	 * (conn-view 0xf001eXXX = rmem->base + 0x1eXXX via the WF->EMI remap) are the
+	 * fw's dispatch state — AP-readable here.  MOST DISCRIMINATING (run first):
+	 * the SERVICING fn-ptr TABLE — pointer-equality against a known constant,
+	 * which (unlike a value-poll) cannot be transient-misread like efuse/co-clock:
+	 *   +25cf8 must = 0xf000f118 (the 0xf118 cmd-dispatcher, registered fw D:043d4)
+	 *   +25cb4 must = 0xf00026c4 (the phase-1 loop, registered fw D:02072)
+	 * If wrong/0 -> the registration block (fn ~0x4004-0x44xx) NEVER RAN = a
+	 * table-build init fault (alt A1), structurally different from an input-wait,
+	 * and the PC histogram CANNOT see it (lumps 0x2200-0xf000).  The coredump
+	 * read below (+0x68000) rules out a silent NDS32 exception loop (alt A2). */
+	dev_info(c->dev,
+		 "conn-MCU SERVICING TABLE: +25cf8=%08x (want f000f118 dispatcher) +25cb4=%08x (want f00026c4 phase1-loop)\n",
+		 readl(p + 0x25cf8), readl(p + 0x25cb4));
+	dev_info(c->dev,
+		 "conn-MCU DISPATCH STATE: run+1f0e4=%08x (loop var @fw0x26f0; serviced!=dwell) phase+1f0e8=%08x (0x4=no-event,serviced 2/3) cmd+1ee64=%08x (inbound opcode; 0=none rx'd) stat+1ee68=%08x gateC+1f040=%08x (byte 1f041=cmd-0xb DMA gate)\n",
+		 readl(p + 0x1f0e4), readl(p + 0x1f0e8), readl(p + 0x1ee64),
+		 readl(p + 0x1ee68), readl(p + 0x1f040));
+	/* ⭐ r97 — FAULT-vs-STALL settle (workflow wf_5e721243 lens disagreement).
+	 * fw fn 0xb83c (the 33% PC dwell) is EITHER the NDS32 exception/coredump
+	 * handler (=> MCU faulted in early init) OR a trace/format leaf re-entered
+	 * benignly.  fn 0xb83c writes magic 0x0deadead to carveout+0x68158
+	 * UNCONDITIONALLY when it runs; the exception handler also stashes the NDS32
+	 * fault sysregs to EMI: fault-PC@0x1efc0, EVA(fault addr)@0x1efc4,
+	 * ITYPE(cause)@0x1efc8, ctx@0x1ef2c, fault-counters@0x1f03c.  Reading these
+	 * decides it: non-zero magic/EVA/counters => the fw is CRASHING (EVA names
+	 * the ungated reg/clock/power domain); all-zero => not faulting, the dwell
+	 * is benign trace and the stall is a command/phase gate. */
+	dev_info(c->dev,
+		 "conn-MCU FAULT PROBE: magic 0x68158=%08x (0x0deadead=>0xb83c RAN=FAULTED) | fault-PC 0x1efc0=%08x EVA 0x1efc4=%08x ITYPE 0x1efc8=%08x ctx 0x1ef2c=%08x | cnt 0x1f03c=%08x gate 0x1f030=%08x(byte1f033)\n",
+		 readl(p + 0x68158), readl(p + 0x1efc0), readl(p + 0x1efc4),
+		 readl(p + 0x1efc8), readl(p + 0x1ef2c), readl(p + 0x1f03c),
+		 readl(p + 0x1f030));
+	/* ⭐ r99 — CORRECT-BUILD (.disasm-v1256) climb-state probe (wf wi37zakb8/wktnrib9y,
+	 * byte-verified).  After fw-patch #1 (fn0x29a4 0x510-slot read -> 0x1107), pinpoint
+	 * WHERE the idle->servicing climb stalls.  ioremap_wc = uncached MCU ground truth
+	 * (unlike /dev/mem = stale AP cache / unaligned SIGBUS).  All offsets 4-aligned.
+	 *   mirror+1ff3c = fn0x32d0's cached 0x510 read (==0x1107 => dispatcher saw the spoof)
+	 *   arm+203e4    = fn0x2834 arm-flag (!=0 => arm-gate fired; state-precond satisfied)
+	 *   state+201b4  = fn0x289c state machine (climb target 3)
+	 *   step+20164   = superloop step ptr (==f000289c => init ran; 0 => stuck pre-superloop)
+	 *   patch+29d8   = our patch site, LE of BE bytes 11 07 d5 0d (==0dd50711 => patch live) */
+	dev_info(c->dev,
+		 "conn-MCU CLIMB PROBE: mirror+1ff3c=%08x (want 1107) arm+203e4=%08x (!=0=armed) state+201b4=%08x (->3) | step+20164=%08x (want f000289c) svc+201b0=%08x exit+20168=%08x | patch+29d8=%08x (want 0dd50711)\n",
+		 readl(p + 0x1ff3c), readl(p + 0x203e4), readl(p + 0x201b4),
+		 readl(p + 0x20164), readl(p + 0x201b0), readl(p + 0x20168),
+		 readl(p + 0x29d8));
+	/* r110 M-DISP-S0 readback + FULL-32-bit-PC rider (workflow wf_234c86f7).
+	 * [0x20110]=0x1d28 => fn0x12028 LIVE (alias correction vindicated); [0x20114]=s0
+	 * (the stuck dispatch selector).  The FULL CPUPCR (no &0xffff mask) resolves the
+	 * low-16 alias for free: stock idles full-PC 0x1e664; if OR has bits >=0x10000 the
+	 * live code is in the high region; COM_REG0 confirms still-idle. */
+	{
+		/* r110b — FULL-PC HISTOGRAM: the masked sampler hid that the real PC is
+		 * 0xf000XXXX (EMI fw) OR 0x0000XXXX (ROM).  Collect distinct FULL PCs + counts
+		 * to map the ROM/EMI interleave (which addrs are ROM vs EMI) and find the hot
+		 * dispatcher's true base.  Also count ROM(hi==0) vs EMI(hi==0xf000) samples. */
+		u32 ev[20] = {0}, ec[20] = {0};	/* EMI (0xf000xxxx) distinct = the ROM->EMI overlay calls */
+		u32 rom = 0, emi = 0, oth = 0;
+		int ne = 0, k, jj;
+		char hb[420];
+		int o = 0;
+
+		for (k = 0; k < 12000; k++) {
+			u32 pc = readl(c->conn_hif_on + 0x104);
+			u32 hi = pc & 0xffff0000u;
+
+			if (hi == 0) {
+				rom++;
+				continue;
+			} else if (hi == 0xf0000000u) {
+				emi++;
+			} else {
+				oth++;
+				continue;
+			}
+			/* collect distinct EMI PCs (the overlay functions the ROM calls) */
+			for (jj = 0; jj < ne; jj++)
+				if (ev[jj] == pc)
+					break;
+			if (jj == ne && ne < 20) {
+				ev[ne] = pc;
+				ec[ne] = 1;
+				ne++;
+			} else if (jj < ne) {
+				ec[jj]++;
+			}
+			udelay(15);
+		}
+		for (jj = 0; jj < ne; jj++)
+			o += scnprintf(hb + o, sizeof(hb) - o, "%05x:%u ", ev[jj] & 0xfffff, ec[jj]);
+		dev_info(c->dev,
+			 "FULL-PC HIST (12000): ROM=%u EMI=%u other=%u | EMI-overlay-call offsets[%d]: %s\n",
+			 rom, emi, oth, ne, hb);
+	}
+
+	/* r101 — DISPATCH-SLOT HISTOGRAM (on-device fw byte-verified v1256-layout:
+	 * fn0x2038 dispatcher writes the live fn-ptr to [0xf00201bc] each pass; fn0x205c
+	 * writes state=4 to [0xf00201b4]).  The MCU idles dispatcher->idle-handler->
+	 * telemetry and fn0x205c never fires (state stays 0).  Sample 0x201bc densely to
+	 * enumerate WHICH fn-ptrs the idle loop actually dispatches (0xf000205c would
+	 * mean the trigger fired), and watch state[0x201b4] for ANY transition away from
+	 * 0.  Read-only EMI sampling — harmless, always runs. */
+	{
+		u32 sv[12] = {0}, sc[12] = {0};
+		u32 st_min = 0xffffffffu, st_max = 0, dl_or = 0;
+		int ns = 0, k, j, o = 0;
+		char hb[320];
+
+		for (k = 0; k < 4000; k++) {
+			u32 d = readl(p + 0x201bc);
+			u32 s = readl(p + 0x201b4);
+
+			dl_or |= d;
+			if (s < st_min)
+				st_min = s;
+			if (s > st_max)
+				st_max = s;
+			for (j = 0; j < ns; j++)
+				if (sv[j] == d)
+					break;
+			if (j == ns && ns < 12) {
+				sv[ns] = d;
+				sc[ns] = 1;
+				ns++;
+			} else if (j < ns) {
+				sc[j]++;
+			}
+			udelay(20);
+		}
+		for (j = 0; j < ns; j++)
+			o += scnprintf(hb + o, sizeof(hb) - o, "%08x:%u ", sv[j], sc[j]);
+		dev_info(c->dev,
+			 "r101 DISPATCH-SLOT[0x201bc] %d distinct fn-ptrs / 4000: %s| OR=%08x state[0x201b4] min=%08x max=%08x\n",
+			 ns, hb, dl_or, st_min, st_max);
+	}
+	{
+		int n, o = 0;
+		bool tbl = false;
+		char hl[256];
+
+		for (n = 0; n <= 0x58; n += 4) {
+			u32 v = readl(p + 0x1f084 + n);
+
+			if (v) {
+				tbl = true;
+				o += scnprintf(hl + o, sizeof(hl) - o, "+%02x=%08x ", 0x84 + n, v);
+			}
+		}
+		dev_info(c->dev, "conn-MCU handler-table 0x1f084..: %s\n",
+			 tbl ? hl : "(all zero — fn0x205c per-state init did NOT run)");
+	}
+
+	/* ⭐ r102 — CORRECTED SEED.  r101 proved the dispatch slot [0x201bc] is 0/4000
+	 * (null-dispatch loop) and state[0x201b4]=0 — fn 0x205c never ran.  The PRIOR
+	 * r95 SEED wrote to 0x1f084 / 0x1f0e8 which (now byte-verified) is the EMI LOG
+	 * RING ("timesync : ", "lost trace count"), NOT the dispatch state — that is why
+	 * it failed.  The REAL targets, byte-extracted from the on-device v1256-layout fw
+	 * fn 0x205c (0x205c-0x21f4):
+	 *   step/handler table  -> [0xf0020150 + i*4]  (23 fn-ptrs, contiguous)
+	 *   servicing table     -> [0xf0025cb4] = 0xf00026c4   (already early-init built)
+	 *   svc var             -> [0xf00201b0] = 0
+	 *   STATE               -> [0xf00201b4] = 4            (written LAST = the gate)
+	 * The main loop dispatches by state; state=4 makes it call the phase-1 superloop
+	 * fn 0x26c4, which POLLS [0xf0020164] (step) and jral5's it — no interrupt needed,
+	 * so even though we cannot replicate fn 0x205c's final mtsr 0x1b8 (a conn-MCU CPU
+	 * sysreg), the polled path can still pick the seed up.  Volatile EMI (reboot
+	 * recovers); gated behind seed_dispatch. */
+	if (seed_dispatch) {
+		static const u32 disp_tbl[] = {
+			0xf00021f8, 0xf0001d8c, 0xf00026b8, 0xf000237c, 0xf0002348,
+			0xf000289c, 0xf0002834, 0xf0001e08, 0xf0001e5c, 0xf0001ea8,
+			0xf0002704, 0xf0001ef4, 0xf0001f50, 0xf0002204, 0xf000246c,
+			0xf000265c, 0xf00027ec, 0xf00027a4, 0xf0001f9c, 0xf0001fd4,
+			0xf0002004, 0xf0002038, 0xf000240c,
+		};
+		u32 pcmin = 0xffff, pcmax = 0, serv = 0, st, sp;
+		int k;
+
+		dev_info(c->dev, "⭐ r102 SEED: writing fn0x205c table->0x20150[%zu] + svc 0x201b0=0 + STATE 0x201b4=4 (CORRECTED offsets)\n",
+			 ARRAY_SIZE(disp_tbl));
+		for (k = 0; k < (int)ARRAY_SIZE(disp_tbl); k++)
+			writel(disp_tbl[k], p + 0x20150 + k * 4);
+		writel(0xf00026c4, p + 0x25cb4);	/* servicing table (ensure) */
+		writel(0, p + 0x201b0);			/* svc var = 0 */
+		wmb();
+		writel(4, p + 0x201b4);			/* STATE = 4, written LAST = the gate */
+		wmb();
+
+		/* give the main loop time + sample its PC to see if it advances */
+		for (k = 0; k < 400; k++) {
+			u32 pc = readl(c->conn_hif_on + 0x104) & 0xffff;	/* CONSYS_CPUPCR (macro defined later) */
+
+			if (pc < pcmin)
+				pcmin = pc;
+			if (pc > pcmax)
+				pcmax = pc;
+			if (pc >= 0xf000)
+				serv++;
+			udelay(50);
+		}
+		st = readl(p + 0x201b4);
+		sp = readl(p + 0x20164);
+		dev_info(c->dev,
+			 "⭐ r102 SEED RESULT: state+201b4=%08x(seeded 4; 0=>fw zeroed) step+20164=%08x(seeded f000289c) | PC after seed: min=0x%04x max=0x%04x SERVICING(>=f000)=%u/400 | COM_REG0=%08x\n",
+			 st, sp, pcmin, pcmax, serv, readl(c->conn_mcu + 0x600));
+		dev_info(c->dev,
+			 "⭐ r102 SEED table-still-set? +20150=%08x +20164=%08x +201b4=%08x svc+201b0=%08x (0 => fw overwrote our seed)\n",
+			 readl(p + 0x20150), readl(p + 0x20164),
+			 readl(p + 0x201b4), readl(p + 0x201b0));
+	}
+
+	/* ⭐ r96 — COMMAND-MAILBOX read + kick (workflow wf_889a362f).  fw fn 0x205c
+	 * is the handler for command 0x1101; the phase-1 router fn 0x32d0 polls
+	 * chip 0x80000510 = conn_mcu+0x510 = 0x18002510 and dispatches fn 0x205c IFF
+	 * it reads 0x1101.  Read it (+ the dispatcher lock-flag 0x1f01c, want 0) — and
+	 * if kick_1101, POST 0x1101 to make the MCU run fn 0x205c itself, then observe
+	 * whether the table/phase build (fn 0x205c ran) + the PC advances to 0xf000+. */
+	dev_info(c->dev,
+		 "conn-MCU CMD-MAILBOX: 0x18002510=%08x (router polls; ==0x1101 fires fn0x205c) 514=%08x 518=%08x | lock 0x1f01c=%08x (want 0) group 0x1ee64=%08x\n",
+		 readl(c->conn_mcu + 0x510), readl(c->conn_mcu + 0x514),
+		 readl(c->conn_mcu + 0x518), readl(p + 0x1f01c), readl(p + 0x1ee64));
+
+	/* ⭐ r97 — AP-WRITE-RECEIVABILITY PROBE (workflow wf_5e721243 recommendation).
+	 * The r96 kick (post 0x1101) never moved phase.  Two competing reasons: (a)
+	 * wrong opcode (should be 0x1107/0x1108), or (b) the 0x510/514/518 trio is an
+	 * MCU-INTERNAL scratch the fw rewrites every superloop (fn 0x29fc/0x2c78), so
+	 * an AP write is INERT (conn-write/AP-read).  Decide it: write a sentinel to
+	 * each slot, then sample it 200x — if the sentinel PERSISTS the AP can drive
+	 * the trio (poke path viable, pin the real opcode next); if it's clobbered to
+	 * 0/MCU-value the register path is dead and we must use framed STP/BTIF. */
+	/* ⭐ r98 — BOOTSTRAP OPCODE POST.  r97 proved the mailbox trio is AP-writable
+	 * (sentinels held 200/200) and the MCU is NOT faulting.  The fw router fn0x32d0
+	 * reads slot idx=1 = conn_mcu+0x510 into GROUP 0xf001ee64 (disasm 0x32da-0x32e2),
+	 * classifies it (0x2d18 covers 0x1101-0x1200) and dispatches; the 0x1107/0x1108
+	 * handler at fw 0x2834 sets phase=4 (swi 0x4,[0xf001f0e8]) which runs fn0x205c +
+	 * arms the 0xf000f118 dispatcher.  r96 used 0x1101 (routes to a NULL handler at
+	 * [0xf001ee60] — never seeded).  Post the CORRECT opcodes 0x1107 then 0x1108 to
+	 * 0x510 (args 0x514/0x518=0) and watch GROUP / phase / handler-table / PC. */
+	if (kick_1101) {
+		static const u32 ops[2] = { 0x1107u, 0x1108u };
+		int o, k;
+
+		dev_info(c->dev,
+			 "⭐ r98 OPCODE POST: 0x1107 then 0x1108 -> mailbox 0x18002510 (GROUP 0x1ee64 -> phase=4)\n");
+		for (o = 0; o < 2; o++) {
+			u32 pcmin = 0xffff, pcmax = 0, serv = 0, mb, grp, ph;
+
+			writel(0u, c->conn_mcu + 0x514);
+			writel(0u, c->conn_mcu + 0x518);
+			wmb();
+			writel(ops[o], c->conn_mcu + 0x510);
+			wmb();
+			for (k = 0; k < 400; k++) {
+				u32 pc = readl(c->conn_hif_on + 0x104) & 0xffff;
+
+				if (pc < pcmin)
+					pcmin = pc;
+				if (pc > pcmax)
+					pcmax = pc;
+				if (pc >= 0xf000)
+					serv++;
+				udelay(50);
+			}
+			mb = readl(c->conn_mcu + 0x510);
+			grp = readl(p + 0x1ee64);
+			ph = readl(p + 0x1f0e8);
+			dev_info(c->dev,
+				 "⭐ r98 OPCODE 0x%04x: mailbox=%08x(0=consumed) GROUP 0x1ee64=%08x phase 0x1f0e8=%08x(want 4) tbl0 0x1f084=%08x run 0x1f0e4=%08x | PC min=0x%04x max=0x%04x SERVICING=%u/400\n",
+				 ops[o], mb, grp, ph, readl(p + 0x1f084),
+				 readl(p + 0x1f0e4), pcmin, pcmax, serv);
+		}
+	}
+
+	dev_info(c->dev, "=== EMI conn-MCU working region 0x1f000-0x1f100 (non-zero) ===\n");
+	any = false;
+	for (i = 0; i < 0x100; i += 16) {
+		u32 w0 = readl(p + 0x1f000 + i),     w1 = readl(p + 0x1f000 + i + 4);
+		u32 w2 = readl(p + 0x1f000 + i + 8), w3 = readl(p + 0x1f000 + i + 12);
+
+		if (w0 | w1 | w2 | w3)
+			dev_info(c->dev, "  +1f%03x: %08x %08x %08x %08x\n", i, w0, w1, w2, w3);
+	}
+	iounmap(p);
+
+	dev_info(c->dev,
+		 "CONN_TOP_MISC[0x180C1xxx]: 310=%08x 340=%08x 400=%08x 408=%08x 428=%08x 600=%08x\n",
+		 readl(c->mcu_misc_on + 0x310), readl(c->mcu_misc_on + 0x340),
+		 readl(c->mcu_misc_on + 0x400), readl(c->mcu_misc_on + 0x408),
+		 readl(c->mcu_misc_on + 0x428), readl(c->mcu_misc_on + 0x600));
+
+	/* ⭐ GROUND TRUTH on the conn-side transport: the conn-MCU's BTIF0 receiver
+	 * (NDS32 chip 0x80030000) and its conn->AP DMA engine (chip 0x80010000) are
+	 * AP-visible via the connac bus2chip window: chip 0x80030000 -> bus 0xA2000
+	 * -> phys 0x180A2000; chip 0x80010000 -> bus 0xA1000 -> phys 0x180A1000.
+	 * If BTIF0 ctrl(0x04)/DMA_EN(0x4c) are 0, the conn never enabled BTIF0 (i.e.
+	 * transport-mode != BTIF, fn ~0x5e98 gated off by gp[-0x318ec]!=4). If the
+	 * DMA port(0x200) ring(0x208/0x20c) is unset, the conn->AP TX-DMA isn't armed. */
+	{
+		void __iomem *bt = ioremap(0x180A2000u, 0x1000);
+		void __iomem *dm = ioremap(0x180A1000u, 0x1000);
+
+		if (bt) {
+			dev_info(c->dev,
+				 "conn BTIF0[0x180A2000] (chip 0x80030000): ctl04=%08x ier08=%08x fifo0c=%08x lsr14=%08x dmaen4c=%08x x60=%08x e4=%08x\n",
+				 readl(bt + 0x04), readl(bt + 0x08), readl(bt + 0x0c),
+				 readl(bt + 0x14), readl(bt + 0x4c), readl(bt + 0x60), readl(bt + 0xe4));
+			iounmap(bt);
+		}
+		if (dm) {
+			int j;
+
+			dev_info(c->dev,
+				 "conn DMA[0x180A1000] (chip 0x80010000): p200=%08x 204=%08x 208=%08x 20c=%08x 210=%08x 214=%08x 218=%08x 22c=%08x | 2c=%08x 30=%08x 34=%08x\n",
+				 readl(dm + 0x200), readl(dm + 0x204), readl(dm + 0x208),
+				 readl(dm + 0x20c), readl(dm + 0x210), readl(dm + 0x214),
+				 readl(dm + 0x218), readl(dm + 0x22c),
+				 readl(dm + 0x2c), readl(dm + 0x30), readl(dm + 0x34));
+			/* full scan of the DMA engine — find every non-zero channel reg
+			 * (which channel carries BTIF0 + whether its ring/ptrs are set). */
+			dev_info(c->dev, "=== conn DMA full scan 0x180A1000+0x000-0x300 (non-zero) ===\n");
+			for (j = 0; j < 0x300; j += 16) {
+				u32 w0 = readl(dm + j),     w1 = readl(dm + j + 4);
+				u32 w2 = readl(dm + j + 8), w3 = readl(dm + j + 12);
+
+				if (w0 | w1 | w2 | w3)
+					dev_info(c->dev, "  +0x%03x: %08x %08x %08x %08x\n", j, w0, w1, w2, w3);
+			}
+			iounmap(dm);
+		}
+	}
+
+	/* ⭐ r92 — INIT POLL-LOOP TARGETS (from NDS32 disasm of soc1_0_ram_mcu).
+	 * The conn-MCU init contains hardware poll-loops that must satisfy before it
+	 * proceeds to the BTIF-servicing loop + conn->AP DMA-channel init (fn 0x3968).
+	 * If one never satisfies, init aborts/retries forever -> never services BTIF
+	 * -> zero conn->AP replies (the wall).  These conn-chip addrs are AP-visible
+	 * via the connac bus2chip window; read them at conn-idle to see WHICH poll is
+	 * unsatisfied:
+	 *   - CONN_MCU_PDA  chip 0x81090008 -> phys 0x180A9008: fw 0x60da does an
+	 *     *UNBOUNDED* wait for bit0==1 then sets bit31 (no timeout = hard hang if 0).
+	 *   - MCU_CFG       chip 0x80000424 -> phys 0x18002424: fw 0xc5fe requests via
+	 *     0x80000440 bit16 then polls 0x80000424 bit20==1 (sub-system access ack).
+	 *   - GPSSYS        chip 0x80073020 -> phys 0x18063020: fw 0x91xx poll.
+	 *   - EFUSE         chip 0x81070000 (= MT_EFUSE_ADDR_BASE): fw 0x7bce/0x7c8e
+	 *     timeout-poll bits[1:0]/bit1 ready.  NOT in bus2chip (conn-internal) so
+	 *     not directly readable here; inferred via the others + DMA-chan state. */
+	{
+		void __iomem *pda = ioremap(0x180A9000u, 0x1000);
+		void __iomem *gps = ioremap(0x18063000u, 0x1000);
+
+		if (pda) {
+			int j;
+
+			dev_info(c->dev,
+				 "conn PDA[0x180A9000] (chip 0x81090000): 008=%08x(bit0=ready@fw0x60da) 00c=%08x 000=%08x 004=%08x\n",
+				 readl(pda + 0x008), readl(pda + 0x00c),
+				 readl(pda + 0x000), readl(pda + 0x004));
+			dev_info(c->dev, "=== conn PDA full scan 0x180A9000+0x000-0x100 (non-zero) ===\n");
+			for (j = 0; j < 0x100; j += 16) {
+				u32 w0 = readl(pda + j),     w1 = readl(pda + j + 4);
+				u32 w2 = readl(pda + j + 8), w3 = readl(pda + j + 12);
+
+				if (w0 | w1 | w2 | w3)
+					dev_info(c->dev, "  +0x%03x: %08x %08x %08x %08x\n", j, w0, w1, w2, w3);
+			}
+			iounmap(pda);
+		}
+		/* MCU_CFG block is already mapped as c->conn_mcu (phys 0x18002000). */
+		dev_info(c->dev,
+			 "MCU_CFG[0x18002000] (chip 0x80000000): 424=%08x(bit20=ack@fw0xc5fe) 428=%08x 440=%08x 600=%08x(COM_REG0)\n",
+			 readl(c->conn_mcu + 0x424), readl(c->conn_mcu + 0x428),
+			 readl(c->conn_mcu + 0x440), readl(c->conn_mcu + 0x600));
+		if (gps) {
+			dev_info(c->dev,
+				 "conn GPSSYS[0x18063000] (chip 0x80070000): 020=%08x 000=%08x 004=%08x\n",
+				 readl(gps + 0x020), readl(gps + 0x000), readl(gps + 0x004));
+			iounmap(gps);
+		}
+	}
+}
