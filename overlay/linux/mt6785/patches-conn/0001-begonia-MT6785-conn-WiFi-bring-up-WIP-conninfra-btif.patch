diff --git a/drivers/net/wireless/mediatek/mt76/mt7615/soc_mt6785.c b/drivers/net/wireless/mediatek/mt76/mt7615/soc_mt6785.c
new file mode 100755
index 000000000..69dcdfd71
--- /dev/null
+++ b/drivers/net/wireless/mediatek/mt76/mt7615/soc_mt6785.c
@@ -0,0 +1,93 @@
+// SPDX-License-Identifier: ISC
+/*
+ * Xiaomi Redmi Note 8 Pro (begonia, MediaTek MT6785) soc1_0 WMAC platform
+ * driver on the mt7615 (connac1.0) chassis.
+ *
+ * begonia's integrated WiFi is a connac1.0 MAC (soc1_0 firmware, A-die 0x6631)
+ * reached over the AXI bus through the 0x18000000 conn_infra aperture — the
+ * same shape as MT7622 (mt7615/soc.c), whose wmac is also at 0x18000000. It is
+ * NOT a connac2 part, so it rides the mt7615 driver (mt7663-class register map,
+ * V1 patch + V3 N9 firmware), not mt7915.
+ *
+ * The wmac is a DT child of consys@18002000. conn_infra (the parent) is brought
+ * up by the separate mtk-conninfra-mt6785 driver; until that parent is bound the
+ * 0x18000000 window is held in reset, so probe defers.
+ *
+ * mt7615_mmio_probe() allocates the device, requests the irq, AND runs
+ * mt7615_register_device (which downloads firmware into the consys window the
+ * parent owns) internally — so the device_link to the parent is established
+ * BEFORE the probe call, not after.
+ */
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+
+#include "mt7615.h"
+
+#define MT6785_CHIP_ID		0x6785
+#define MT6785_WMAC_WINDOW	0x01000000u	/* full 16 MB conn_infra aperture */
+
+static int mt6785_wmac_probe(struct platform_device *pdev)
+{
+	struct device *parent = pdev->dev.parent;
+	struct resource *res;
+	void __iomem *mem_base;
+	int irq, ret;
+
+	/* Defer until the conninfra parent binds, else 0x18000000 is in reset. */
+	if (!parent || !device_is_bound(parent))
+		return -EPROBE_DEFER;
+
+	irq = platform_get_irq(pdev, 0);
+	if (irq < 0)
+		return irq;
+
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!res)
+		return dev_err_probe(&pdev->dev, -EINVAL, "no wmac reg resource\n");
+
+	/* Non-exclusive map — coexists with the conninfra parent's subblock
+	 * devm_ioremap maps inside the same window. */
+	mem_base = devm_ioremap(&pdev->dev, res->start, MT6785_WMAC_WINDOW);
+	if (!mem_base)
+		return dev_err_probe(&pdev->dev, -ENOMEM, "ioremap wmac window\n");
+
+	/* Pin the parent BEFORE mt7615_register_device (inside mt7615_mmio_probe)
+	 * starts the firmware download into the consys window. */
+	if (!device_link_add(&pdev->dev, parent,
+			     DL_FLAG_AUTOREMOVE_CONSUMER | DL_FLAG_PM_RUNTIME))
+		return dev_err_probe(&pdev->dev, -ENODEV,
+				     "failed to link to conninfra parent\n");
+
+	/* Canonical mt7615 mmio probe: begonia reg_map + forced synthetic chip
+	 * id (skips the unreliable MT_HW_CHIPID/MT_HW_REV read on this SoC). */
+	ret = mt7615_mmio_probe(&pdev->dev, mem_base, irq,
+				mt7615_mt6785_reg_map, MT6785_CHIP_ID);
+	if (ret)
+		return ret;
+
+	return 0;
+}
+
+static void mt6785_wmac_remove(struct platform_device *pdev)
+{
+	struct mt7615_dev *dev = platform_get_drvdata(pdev);
+
+	mt7615_unregister_device(dev);
+}
+
+static const struct of_device_id mt6785_wmac_of_match[] = {
+	{ .compatible = "mediatek,mt6785-wmac" },
+	{},
+};
+MODULE_DEVICE_TABLE(of, mt6785_wmac_of_match);
+
+struct platform_driver mt6785_wmac_driver = {
+	.driver = {
+		.name = "mt6785-wmac",
+		.of_match_table = mt6785_wmac_of_match,
+	},
+	.probe = mt6785_wmac_probe,
+	.remove = mt6785_wmac_remove,
+};
