-{
-	ULONG len = count;
-	PINT8 pBuf = NULL;
-	PINT8 pToken = NULL;
-	PINT8 pDelimiter = " \t";
-	INT32 x = 0;
-	INT8 buf[128] = { 0 };
-	LONG res = 0;
-
-	if (len >= osal_sizeof(buf)) {
-		STPSDIO_PR_ERR("input handling fail!\n");
-		len = osal_sizeof(buf) - 1;
-		return -1;
-	}
-
-	if (copy_from_user(buf, buffer, len)) {
-		STPSDIO_PR_ERR("copy_from_user error.\n");
-		return -EFAULT;
-	}
-
-	buf[len] = '\0';
-	pBuf = buf;
-	pToken = osal_strsep(&pBuf, pDelimiter);
-	if (pToken != NULL) {
-		osal_strtol(pToken, 16, &res);
-		x = (INT32)res;
-	} else {
-		x = 0;
-	}
-
-	if (x == 0) {
-		STPSDIO_PR_DBG("stp_sdio_own_ctrl(OWN_CLR)\n\r");
