-	flag = sdio_get_host_pm_caps(func);
-#if HIF_SDIO_SUPPORT_WAKEUP
-	if (!(flag & MMC_PM_KEEP_POWER) || !(flag & MMC_PM_WAKE_SDIO_IRQ)) {
