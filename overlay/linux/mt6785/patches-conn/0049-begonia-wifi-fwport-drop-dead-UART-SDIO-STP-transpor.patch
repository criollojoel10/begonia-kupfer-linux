-static _osal_inline_ INT32 stp_sdio_do_own_set(MTK_WCN_STP_SDIO_HIF_INFO *p_info)
-{
-	UINT32 value = 0;
-	UINT32 iRet = 0;
-
-	/* [COHEC_00006052] SW work-around solution:
-	 * using CMD52 write instead of CMD53 write for CCIR, CHLPCR, CSDIOCSR
