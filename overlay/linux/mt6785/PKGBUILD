pkgver() {
    cd "${_srcname}"
    make kernelversion | cut -d "-" -f 1
}

prepare() {
    cd "$srcdir/${_srcname}"

    # Fuel gauge GM30 (PMIC MT6359), importado del kernel downstream de Xiaomi.
    # El orden importa: 0102 añade `config BATTERY_MT6359` al Kconfig de
    # power/supply, y olddefconfig (abajo) tiene que ver ese símbolo para que
    # CONFIG_BATTERY_MT6359=y de extra_config sobreviva. Por eso los parches
    # van ANTES de generar el .config.
    #
    # El glob es 01[0-9][0-9]-*.patch a proposito: son exactamente los 10, en
    # orden lexico (0101..0110), que es el orden en que hay que aplicarlos. Si
    # faltara alguno, el glob se quedaria literal y patch fallaria en vez de
    # saltarselo. Y se cuentan, para que un parche que aplicara a medias no
    # pase por bueno: patch -Np1 devuelve !=0 ante un hunk fallido y makepkg
    # para igual, pero el recuento deja el numero en el log.
    local p n=0
    for p in "$srcdir"/01[0-9][0-9]-*.patch; do
        echo "==> $(basename "$p")"
        patch -Np1 --no-backup-if-mismatch -i "$p"
        n=$((n + 1))
    done
    [ "$n" -eq 10 ] || {
        echo "==> ERROR: se esperaban 10 parches de bateria y se aplicaron $n" >&2
        return 1
    }
    echo "==> $n parches de bateria aplicados"

    cp "$srcdir/config-postmarketos-mediatek-mt6785.aarch64" .config
    cat "$srcdir/extra_config" >>.config

    # Los otros dos modulos de la pila de bateria se suben aqui de =m a =y, y
    # no en extra_config, porque extra_config se CONCATENA al .config y esos dos
    # simbolos ya existen en el config de pmaports (=m): concatenarlos dejaria
    # lineas duplicadas. Este fichero solo declara simbolos nuevos.
    #
    # De =m a =y a proposito. Los tres modulos de la pila se referencian por DT
    # y su orden de probe no esta garantizado entre modulos:
    #   rtc-mt6397     -> registra el nvmem "mtk_rtc_nvmem"; de ahi salen los dos
    #                     nvmem-cells del gauge (fg_init = inicializacion del
    #                     contador coulomb, fg_soc = state-of-charge). Sin el,
    #                     el gauge se queda esperando.
    #   mt6359-auxadc  -> es el proveedor IIO de los 4 canales que pide el gauge
    #                     (BAT_TEMP, BATADC, VBIF, VBAT). Su primer
    #                     devm_iio_channel_get() es el unico punto DURO del
    #                     driver: si falla, -EPROBE_DEFER para siempre.
    # Con los tres built-in el orden lo fija el DT, no el sincronismo de modprobe.
    # Efecto secundario buscado: esos .ko desaparecen del paquete.
    #
    # scripts/config es la herramienta que trae el kernel para esto. Si alguno de
    # los tres hubiera desaparecido del Kconfig (por ejemplo, si el parche 0102
    # no llegara a aplicarse) este comando falla y el build para aqui, en vez de
    # compilar en silencio un kernel sin fuel gauge.
    sh scripts/config --file .config \
        -e BATTERY_MT6359 \
        -e RTC_DRV_MT6397 \
        -e MEDIATEK_MT6359_AUXADC

    make olddefconfig

    # don't run depmod on "make install". We'll do this ourselves in packaging
    sed -i "2iexit 0" scripts/depmod.sh
}

build() {
    cd ${_srcname}
    unset LDFLAGS

    # --- ccache ---------------------------------------------------------------
    # Esto no es una optimizacion: el ccache no ha funcionado NUNCA y por eso
    # `make Image.gz modules` se come 22m49s en cada build. Hay tres bugs
    # apilados, los tres fuera de este repositorio:
    #
    # 1) kupferbootstrap escribe el makepkg.conf con
    #       BUILDENV=(!distcc color !ccache !check !sign)
    #    (generator.py:94), asi que makepkg no envuelve CC/CXX con ccache. Se
    #    escribe en chroot/abstract.py:397 y el kernel se compila con
    #    --config /etc/makepkg_cross_aarch64.conf, que es ese fichero.
    #
    # 2) El compilador real es de CROSS: generator.py:194 exporta
    #       CROSS_COMPILE="{hostspec}-"  /  CC="{hostspec}-gcc ..."
    #    y el Makefile del kernel usa CC = $(CROSS_COMPILE)gcc. El unico enganche
    #    que deja kupferbootstrap es prependar /usr/lib/ccache al PATH
    #    (packages/build.py:722), y ahi solo hay shims de gcc/g++/cc/c++/cpp/ld/
    #    gcov a secas, ninguno de cross. En el log del build no aparece ni una
    #    vez "ccache aarch64-unknown-linux-gnu-gcc" (el hostspec real lo delata
    # el propio log): los ~30k objetos del target nunca
    #    entraron en la cache. Solo pasaban por ella los HOSTCC de a secas.
    #
    # 3) ccache 4.x escribe donde nadie monta. chroot/build.py:183 hace bind de
    #    /ccache/<arch> sobre $HOME/.ccache, pero src/ccache/config.cpp
    #    default_cache_dir() devuelve en Linux  $HOME/.cache/ccache  (no
    #    ~/.ccache). Sin CCACHE_DIR ni XDG_CACHE_HOME, ccache escribia en
    #    /home/kupfer/.cache/ccache, que no esta bind-montado y muere con el
    #    chroot. El log lo delata: el mount -o bind se hace bien y aun asi la
    #    cache sale vacia.
    #
    # Sintoma medido: todas las entradas ccache-* del repo pesan 273 B, que es
    # un marcador de directorio vacio.
    #
    # El arreglo de (1) no es posible desde aqui (habria que parchear
    # kupferbootstrap). El de (2) y el de (3) caben aqui:
    #
    # Para (2) se invoca ccache en su forma NORMAL, con argv[0] == ccache y el
    # compilador de cross como argumento, y se sobreescribe CC en la linea de
    # comandos, que pisa el CC = $(CROSS_COMPILE)gcc del Makefile. Se ha
    # descartado a proposito la otra via, un shim aarch64-unknown-linux-gnu-gcc ->
    # /usr/bin/ccache en un directorio prependido al PATH: funciona, pero obliga
    # a confiar en que ccache no se encuentra a si mismo al resolver el
    # compilador real, y eso no se ha podido verificar. Con esta forma no hay
    # ninguna auto-referencia posible, y no hay que tocar el PATH ni crear
    # shims. ${CROSS_COMPILE} YA LLEVA la raya final, asi que se concatena
    # directo: kupferbootstrap lo exporta como "aarch64-unknown-linux-gnu-" y el
    # compilador es "${CROSS_COMPILE}gcc", CON guion. Quitar la raya con
    # ${CROSS_COMPILE%-} y pegarle "gcc" sin volver a ponerla daba
    # "aarch64-unknown-linux-gnugcc", que no existe: revento el run 36360020474 a
    # los 11m26s con "ccache: error: Could not find compiler ... in PATH" y
    # "scripts/Kconfig.include:45: Sorry, this C compiler is not supported". Ese
    # era el unico fallo, y lo produjo un string mal escrito aqui.
    # El hostspec NO se escribe a mano porque el log no lo imprime.
    # HOSTCC idem, para los binarios de host (fixdep, conf, sortextable). Se
    # deja LD/AR/NM/OBJCOPY/STRIP como estan: ccache no puede envolverlos.
    export CCACHE_DIR="${CCACHE_DIR:-$HOME/.ccache}"
    mkdir -p "$CCACHE_DIR"
    command -v ccache >/dev/null || {
        echo "==> ERROR: ccache no esta instalado en el chroot" >&2
        return 1
    }
    # El compilador de cross se comprueba ANTES de arrancar el make. Sin esto un
    # nombre mal escrito se descubre 11 minutos despues, en syncconfig, con el
    # motivo enterrado en el log; con esto falla al instante y legible.
    command -v "${CROSS_COMPILE}gcc" >/dev/null || {
        echo "==> ERROR: no existe el compilador de cross ${CROSS_COMPILE}gcc" >&2
        echo "==> CROSS_COMPILE vale '$CROSS_COMPILE'" >&2
        return 1
    }
    local _cc="ccache ${CROSS_COMPILE}gcc"
    echo "==> CCACHE_DIR=$CCACHE_DIR  CC=$_cc  HOSTCC=ccache gcc"
    # shellcheck disable=SC2086
    make ${MAKEFLAGS} CC="$_cc" HOSTCC="ccache gcc" Image.gz modules
    # Para que el log diga cuantos hits hubo de verdad, y no haya que deducirlo
    # del tamano de la cache.
    ccache -s || true
    # shellcheck disable=SC2086
    make ${MAKEFLAGS} CC="$_cc" HOSTCC="ccache gcc" DTC_FLAGS="-@" dtbs
}

_package() {
    pkgdesc="The Linux Kernel and modules - ${_desc}"
    depends=(coreutils kmod mkinitcpio)
    optdepends=("crda: to set the correct wireless channels of your country")
    backup=(etc/mkinitcpio.d/linux.preset)
    install=linux.install

    cd ${_srcname}

    KARCH=arm64

    # get kernel version
    _kernver="$(make kernelrelease)"
    _basekernel=${_kernver%%-*}
    _basekernel=${_basekernel%.*}

    mkdir -p "${pkgdir}"/{boot,usr/lib/modules}
    make INSTALL_MOD_PATH="${pkgdir}/usr" modules_install
    mkdir -p "${pkgdir}/boot/dtbs/mediatek"
    cp arch/arm64/boot/dts/mediatek/mt6785-xiaomi-begonia.dtb \
        "${pkgdir}/boot/dtbs/mediatek"
    cp arch/$KARCH/boot/Image.gz "${pkgdir}/boot"

    # make room for external modules
    local _extramodules="extramodules-${_basekernel}${_kernelname}"
    ln -s "../${_extramodules}" "${pkgdir}/usr/lib/modules/${_kernver}/extramodules"

    # add real version for building modules and running depmod from hook
    echo "${_kernver}" |
        install -Dm644 /dev/stdin "${pkgdir}/usr/lib/modules/${_extramodules}/version"

    # remove build and source links
    [ -e "${pkgdir}/usr/lib/modules/${_kernver}/source" ] && rm "${pkgdir}/usr/lib/modules/${_kernver}/source"
    [ -e "${pkgdir}/usr/lib/modules/${_kernver}/build" ] && rm "${pkgdir}/usr/lib/modules/${_kernver}/build"

    # now we call depmod...
    depmod -b "${pkgdir}/usr" -F System.map "${_kernver}"

    # sed expression for following substitutions
    local _subst="
    s|%PKGBASE%|${pkgbase}|g
    s|%KERNVER%|${_kernver}|g
    s|%EXTRAMODULES%|${_extramodules}|g
  "

    # install mkinitcpio preset file
    sed "${_subst}" ../linux.preset |
        install -Dm644 /dev/stdin "${pkgdir}/etc/mkinitcpio.d/linux.preset"

    # install pacman hooks
    sed "${_subst}" ../60-linux.hook |
        install -Dm644 /dev/stdin "${pkgdir}/usr/share/libalpm/hooks/60-${pkgbase}.hook"
    sed "${_subst}" ../90-linux.hook |
        install -Dm644 /dev/stdin "${pkgdir}/usr/share/libalpm/hooks/90-${pkgbase}.hook"
}

_package-headers() {
    pkgdesc="Header files and scripts for building modules for linux kernel - ${_desc}"
    provides=("linux-headers=${pkgver}")
    conflicts=(linux-headers linux-aarch64-headers)

    cd ${_srcname}
    local _builddir="${pkgdir}/usr/lib/modules/${_kernver}/build"

    install -Dt "${_builddir}" -m644 Makefile .config Module.symvers
    install -Dt "${_builddir}/kernel" -m644 kernel/Makefile

    mkdir "${_builddir}/.tmp_versions"

    cp -t "${_builddir}" -a include scripts

    install -Dt "${_builddir}/arch/${KARCH}" -m644 arch/${KARCH}/Makefile
    install -Dt "${_builddir}/arch/${KARCH}/kernel" -m644 arch/${KARCH}/kernel/asm-offsets.s

    cp -t "${_builddir}/arch/${KARCH}" -a arch/${KARCH}/include
    mkdir -p "${_builddir}/arch/arm"
    cp -t "${_builddir}/arch/arm" -a arch/arm/include

    # copy in Kconfig files
    find . -name Kconfig\* -exec install -Dm644 {} "${_builddir}/{}" \;

    # remove unneeded architectures
    local _arch
    for _arch in "${_builddir}"/arch/*/; do
        [[ ${_arch} == */${KARCH}/ || ${_arch} == */arm/ ]] && continue
        rm -r "${_arch}"
    done

    # remove files already in linux-docs package
    rm -r "${_builddir}/Documentation"

    # remove now broken symlinks
    find -L "${_builddir}" -type l -printf "Removing %P\n" -delete

    # Fix permissions
    chmod -R u=rwX,go=rX "${_builddir}"
}

pkgname=("${pkgbase}" "${pkgbase}-headers")
for _p in "${pkgname[@]}"; do
    eval "package_${_p}() {
    _package${_p#${pkgbase}}
  }"
done