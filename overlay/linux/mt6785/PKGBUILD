_mode=cross
_kernelname=mt6785
pkgbase="linux-$_kernelname"
_desc="MediaTek MT6785 (begonia) kernel"
pkgver=7.1
pkgrel=2
_arches=specific
arch=(aarch64)
license=(GPL2)
url=https://gitlab.postmarketos.org/mt6785-mainline/linux
# Toolchain LLVM como en el MR !8852 de pmaports (Draft de Dinolek): el kernel
# 7.1 de mt6785 se construye con clang/lld y el config de pmaports activa
# CONFIG_DEBUG_INFO_BTF=y, que necesita pahole (con el fix 000-meow-btf.patch).
makedepends=(
    xmlto
    docbook-xsl
    kmod
    inetutils
    bc
    dtc
    cpio
    python
    clang
    lld
    llvm
    pahole
    python3
    libelf
    perl
    openssl
)
options=(!strip)

# Tag del tronco (Dinolek). El port conn/WiFi NO está aquí: llega como serie de
# parches ya rebasada sobre este tag (ver _conn_* más abajo).
_tag="7.1-r0"
_srcname="linux-$_tag"

# Commit de pmaports con el config de 7.1: es el head del MR !8852
# (Dinolek/pmaports, rama begonia). Si el MR avanza, actualizar este sha.
_pmos_sha=ae9d32b76335a995f5187be50d8cfffa30e555cb

source=(
    "$_srcname.tar.gz::$url/-/archive/$_tag/$_srcname.tar.gz"
    "config-postmarketos-mediatek-mt6785.aarch64::https://gitlab.postmarketos.org/Dinolek/pmaports/-/raw/$_pmos_sha/device/testing/linux-postmarketos-mediatek-mt6785/config-postmarketos-mediatek-mt6785.aarch64"
    extra_config
    linux.preset
    60-linux.hook
    90-linux.hook
    000-meow-btf.patch
    010-dts-conn-7.1.patch
    zz-conn-7.1-api.patch
    #PATCHES#
)
# Los dos primeros son remotos: su sha se imprime en el log del workflow
# (ruta 7.1-r0 y commit de pmaports quedan fijados, así que son reproducibles).
sha256sums=(
    SKIP
    SKIP
    SKIP
    SKIP
    SKIP
    SKIP
    SKIP
    SKIP
    SKIP
    #SUMS#
)

pkgver() {
    cd "${_srcname}"
    make kernelversion | cut -d "-" -f 1
}

prepare() {
    cd "$srcdir/${_srcname}"

    # 1) Parches, en orden alfabético:
    #    000-meow-btf.patch      fix de BTF del MR !8852 (para pahole)
    #    010-dts-conn-7.1.patch  el DT del port adaptado al layout partido de 7.1
    #                            (el rebase lo descarta a propósito)
    #    conn-NNNN-*.patch       serie conn/WiFi rebasada que genera el CI
    # Los dos primeros viven en este repo; la serie conn-* llega como artifact.
    local _p
    for _p in "$srcdir"/*.patch; do
        [ -e "$_p" ] || continue
        msg2 "aplicando $(basename "$_p")"
        patch -p1 -N --no-backup-if-mismatch <"$_p"
    done

    # 2) Config: la de pmaports (7.1) + nuestros overrides en extra_config.
    #
    # OJO: esta pasada de Kconfig TIENE que usar el MISMO entorno que build()
    # (LLVM=1). Hay simbolos arm64 cuya visibilidad depende del compilador,
    # por ejemplo COMPAT_VDSO:
    #     depends on (CC_IS_CLANG && LD_IS_LLD) || "$(CROSS_COMPILE_COMPAT)" != ""
    # Al cambiar de gcc a clang/lld pasan de invisibles a visibles. En el run
    # 39086842278 prepare() evaluo el config SIN LLVM=1 (y Kconfig borro
    # CONFIG_COMPAT_VDSO y CONFIG_THUMB2_COMPAT_VDSO del .config); despues el
    # syncconfig implicito de build(), ya con LLVM=1, los vio otra vez como
    # simbolos nuevos: imprimio "* Restart config... *" y se puso a PREGUNTAR.
    # Como el job corre bajo un PTY (script -qec) cuyo stdin nunca da EOF, conf
    # se quedo bloqueado leyendo y el job murio por timeout sin compilar nada.
    # Reproducido en local; con el entorno alineado la segunda pasada es
    # silenciosa (0 "Restart config").
    #
    # El </dev/null es un cinturon extra: si algun dia Kconfig decide preguntar,
    # toma los valores por defecto en vez de colgarse hasta el timeout.
    cp "$srcdir/config-postmarketos-mediatek-mt6785.aarch64" .config
    cat "$srcdir/extra_config" >>.config
    make LLVM=1 olddefconfig </dev/null

    # 3) Dejamos el arbol sincronizado (auto.conf + headers generados) y a la
    #    vez comprobamos que Kconfig CONVERGE: si vuelve a pedir respuestas es
    #    que el config no es coherente con este entorno, y preferimos fallar en
    #    un minuto que quedarnos horas colgados.
    _syncout=$(make LLVM=1 syncconfig </dev/null 2>&1)
    if printf '%s' "$_syncout" | grep -q "Restart config"; then
        printf '%s\n' "$_syncout" | tail -20
        echo "ERROR: Kconfig no converge con LLVM=1 (config incoherente con el entorno de build)" >&2
        exit 1
    fi
    [ -f include/config/auto.conf ] || { echo "ERROR: falta include/config/auto.conf tras syncconfig" >&2; exit 1; }

    # don't run depmod on "make install". We'll do this ourselves in packaging
    sed -i "2iexit 0" scripts/depmod.sh
}

build() {
    cd ${_srcname}
    unset LDFLAGS
    # LLVM=1 como en el APKBUILD de pmaports para 7.1.
    make ${MAKEFLAGS} LLVM=1 Image.gz modules </dev/null
    make ${MAKEFLAGS} LLVM=1 DTC_FLAGS="-@" dtbs </dev/null
}

_package() {
    pkgdesc="The Linux Kernel and modules - ${_desc}"
    depends=(coreutils kmod mkinitcpio)
    optdepends=("crda: to set the correct wireless channels of your country")
    backup=(etc/mkinitcpio.d/linux.preset)
    install=linux.install

    cd ${_srcname}

    KARCH=arm64

    _kernver="$(make kernelrelease)"
    _basekernel=${_kernver%%-*}
    _basekernel=${_basekernel%.*}

    mkdir -p "${pkgdir}"/{boot,usr/lib/modules}
    make INSTALL_MOD_PATH="${pkgdir}/usr" modules_install
    mkdir -p "${pkgdir}/boot/dtbs/mediatek"
    # 7.1 partio el DTS de begonia por panel: ya no existe el monolito
    # mt6785-xiaomi-begonia.dtb, sino mt6785-xiaomi-begonia-{csot,tianma}.dtb.
    # Se instalan todos los de begonia y se falla si no hay ninguno, para que el
    # empaquetado no pueda pasar en falso (run 39131222270 murio aqui).
    local _dtb _dtb_n=0
    for _dtb in arch/arm64/boot/dts/mediatek/mt6785-xiaomi-begonia*.dtb; do
        [ -e "$_dtb" ] || continue
        cp "$_dtb" "${pkgdir}/boot/dtbs/mediatek/" && _dtb_n=$((_dtb_n + 1))
    done
    if [ "$_dtb_n" -eq 0 ]; then
        error "no se genero ningun DTB de begonia (se esperaba -csot y/o -tianma)"
        return 1
    fi

    # Alias retrocompatible para poder actualizar desde el propio equipo (sin PC):
    # device-mt6785-xiaomi-begonia deja en /etc/kupfer/deviceinfo
    #   deviceinfo_dtb="mediatek/mt6785-xiaomi-begonia"
    # y el actualizador de arranque (hook 91-android-bootimg-updater ->
    # update-bootimg) construye la imagen con
    #   --dtb "/boot/dtbs/$deviceinfo_dtb.dtb"
    # En 7.1 ese DTB monolítico ya no existe porque el DTS se partió por panel,
    # así que sin este alias el hook fallaría al actualizar el kernel. El panel de
    # begonia es CSOT, así que el alias apunta a esa variante.
    if [ -e "${pkgdir}/boot/dtbs/mediatek/mt6785-xiaomi-begonia-csot.dtb" ]; then
        cp -f "${pkgdir}/boot/dtbs/mediatek/mt6785-xiaomi-begonia-csot.dtb" \
              "${pkgdir}/boot/dtbs/mediatek/mt6785-xiaomi-begonia.dtb"
    fi
    cp arch/$KARCH/boot/Image.gz "${pkgdir}/boot"

    local _extramodules="extramodules-${_basekernel}${_kernelname}"
    ln -s "../${_extramodules}" "${pkgdir}/usr/lib/modules/${_kernver}/extramodules"

    echo "${_kernver}" |
        install -Dm644 /dev/stdin "${pkgdir}/usr/lib/modules/${_extramodules}/version"

    [ -e "${pkgdir}/usr/lib/modules/${_kernver}/source" ] && rm "${pkgdir}/usr/lib/modules/${_kernver}/source"
    [ -e "${pkgdir}/usr/lib/modules/${_kernver}/build" ] && rm "${pkgdir}/usr/lib/modules/${_kernver}/build"

    depmod -b "${pkgdir}/usr" -F System.map "${_kernver}"

    local _subst="
    s|%PKGBASE%|${pkgbase}|g
    s|%KERNVER%|${_kernver}|g
    s|%EXTRAMODULES%|${_extramodules}|g
  "

    sed "${_subst}" ../linux.preset |
        install -Dm644 /dev/stdin "${pkgdir}/etc/mkinitcpio.d/linux.preset"

    sed "${_subst}" ../60-linux.hook |
        install -Dm644 /dev/stdin "${pkgdir}/usr/share/libalpm/hooks/60-${pkgbase}.hook"
    sed "${_subst}" ../90-linux.hook |
        install -Dm644 /dev/stdin "${pkgdir}/usr/share/libalpm/hooks/90-${pkgbase}.hook"
}

_package-headers() {
    pkgdesc="Header files and scripts for building modules for linux kernel - ${_desc}"
    provides=("linux-headers=${pkgver}")
    conflicts=(linux-headers linux-aarch64-headers)

    cd ${_srcname}
    local _builddir="${pkgdir}/usr/lib/modules/${_kernver}/build"

    install -Dt "${_builddir}" -m644 Makefile .config Module.symvers
    install -Dt "${_builddir}/kernel" -m644 kernel/Makefile

    mkdir "${_builddir}/.tmp_versions"

    cp -t "${_builddir}" -a include scripts

    install -Dt "${_builddir}/arch/${KARCH}" -m644 arch/${KARCH}/Makefile
    install -Dt "${_builddir}/arch/${KARCH}/kernel" -m644 arch/${KARCH}/kernel/asm-offsets.s

    cp -t "${_builddir}/arch/${KARCH}" -a arch/${KARCH}/include
    mkdir -p "${_builddir}/arch/arm"
    cp -t "${_builddir}/arch/arm" -a arch/arm/include

    find . -name Kconfig\* -exec install -Dm644 {} "${_builddir}/{}" \;

    local _arch
    for _arch in "${_builddir}"/arch/*/; do
        [[ ${_arch} == */${KARCH}/ || ${_arch} == */arm/ ]] && continue
        rm -r "${_arch}"
    done

    rm -r "${_builddir}/Documentation"

    find -L "${_builddir}" -type l -printf "Removing %P\n" -delete

    chmod -R u=rwX,go=rX "${_builddir}"
}

pkgname=("${pkgbase}" "${pkgbase}-headers")
for _p in "${pkgname[@]}"; do
    eval "package_${_p}() {
    _package${_p#${pkgbase}}
  }"
done
