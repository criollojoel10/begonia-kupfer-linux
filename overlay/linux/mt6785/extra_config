# Stack WiFi/BT interno MediaTek (begonia-conn-wifi, rama del kernel de Dinolek).
#
# Modulos que produce:
#   wmt_drv.ko          (connectivity/common)  -> /dev/wmtWifi
#   wlan_gen4m.ko       (connectivity/wlan/gen4m)
#   mtk-vendor-btif.ko  (btif, platform_driver "mediatek,btif")
#
# wlan_gen4m.ko llama a wireless_send_event(), que cfg80211 solo exporta con
# CONFIG_CFG80211_WEXT. OJO: el simbolo de kconfig es CFG80211_WEXT, no
# WEXT_CORE. WEXT_CORE es un simbolo OCULTO (def_bool y depends on CFG80211_WEXT
# || WIRELESS_EXT), asi que ponerlo a mano no sirve de nada: olddefconfig lo
# borra y modpost aborta con
#   ERROR: modpost: "wireless_send_event" [.../wlan_gen4m.ko] undefined!
# Esto es exactamente lo que se arreglo en el lado postmarketOS (commit 0a7763a).
CONFIG_CFG80211_WEXT=y
CONFIG_MTK_WMT_FWPORT=m
CONFIG_MTK_WMT_DRV=m
CONFIG_MTK_WLAN_GEN4M=m
CONFIG_MTK_WMT_FWPORT_BTIF=m
# El driver BTIF viejo (MTK_BTIF) se deja fuera a proposito: los dos declaran
# platform_driver con el mismo compatible ("mediatek,btif") y el DT avisa de
# "no dual-define for mediatek,btif node".
# CONFIG_MTK_BTIF is not set
#
# Limitacion conocida: mtk-vendor-btif.ko NO registra un HCI (no hay
# hci_register_dev en drivers/misc/mediatek/btif/), solo transporta trafico de
# control WMT al conn-MCU. El Bluetooth de verdad necesita el userspace vendor
# mtk_bt_stack, que no esta en el port, asi que BT por BTIF no es viable.

# USB Ethernet dongles (hub begins to device)
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_AX8817X=m
CONFIG_USB_NET_AX88179_178A=m
# USB_RTL8150 produce el modulo rtl8150.ko (no r8150.ko: el fuente es rtl8150.c).
CONFIG_USB_RTL8150=m
CONFIG_USB_RTL8152=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_CDC_EEM=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_USB_NET_DM9601=m
CONFIG_USB_NET_SMSC95XX=m
CONFIG_USB_NET_SR9700=m
CONFIG_USB_NET_SR9800=m

# USB WiFi dongles
# OJO con las mayusculas: kconfig distingue mayusculas de minusculas y descarta
# en silencio los simbolos que no existen cuando se hace `make olddefconfig`.
# El simbolo correcto es MT76_CORE (no existe CONFIG_MT76), y los drivers se
# llaman MT76x0U / MT76x2U con la x en minuscula.
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTL8XXXU=m
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT76_CORE=m
CONFIG_MT76_USB=m
CONFIG_MT76x0U=m
CONFIG_MT76x2U=m
CONFIG_MT7921U=m
# Dongles AC de 20-30 EUR (MT8812AU/MT8821AU/MT8822BU) via rtw88.
# RTW88 es el menuconfig padre (tristate, depends on MAC80211) y los drivers de
# la familia viven dentro de `if RTW88`: sin el padre activado, olddefconfig
# descarta los cinco simbolos siguientes en silencio y no sale ningun
# rtw88_*.ko. Es el mismo fallo que en el lado postmarketOS (run 36277664585).
CONFIG_RTW88=m
# El hook 'systemd' de mkinitcpio (install/systemd) hace map add_module 'crypto-lzo'
# 'crypto-lz4'. El config base de pmaports trae CONFIG_CRYPTO_LZO=y pero deja
# CRYPTO_LZ4 apagado, y si el initramfs llega a construirse con el
# /etc/mkinitcpio.conf DE STOCK (no con el de Kupfer) eso es un ERROR que aborta
# package(). Con el modulo presente el hook no protesta.
CONFIG_CRYPTO_LZ4=m
CONFIG_RTW88_CORE=m
CONFIG_RTW88_USB=m
CONFIG_RTW88_8812AU=m
CONFIG_RTW88_8821AU=m
CONFIG_RTW88_8822BU=m
# Modem 3G/4G USB (el nombre del modulo es sierra_net).
CONFIG_USB_SIERRA_NET=m

# Bluetooth USB (Realtek RTL8821C / CSR / MT8812A)
# BT se queda en =m: BT_HCIBTUSB=m hace `select BT`, y un select con valor m
# baja el simbolo a m aunque se pida =y. Se escribe =m para que el config diga
# la verdad. BT_BREDR y BT_LE son BOOL (no admiten =m: kconfig los pone a y).
# RFCOMM y BNEP los usan los perfiles utiles (-envio de ficheros, tethering).
CONFIG_BT=m
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=m
CONFIG_BT_BNEP=m
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIUART=m

# USB serial
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_PL2303=m
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_SERIAL_CP210X=m

# required by the exec of stage2 scripts / initramfs
CONFIG_CMDLINE_FORCE=n
CONFIG_USB_DWC2=y
CONFIG_USB_ETH=n
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
# Sin compresion de modulos, a proposito. El config de pmaports trae
# CONFIG_MODULE_COMPRESS_ZSTD=y, y entonces `make modules_install` invoca el
# binario zstd; si falta en el entorno de build el kernel no se empaqueta:
#   /bin/sh: line 0: zstd: not found
#   make[2]: *** [scripts/Makefile.modinst:162: .../sha512-ce.ko.zst] Error 127
# (es exactamente lo que mato el build de postmarketOS, y alli se arreglo
# anadiendo zstd a makedepends; aqui se decide no comprimir, que es lo que
# hace el propio kernel de Arch y lo que ya funciono en begonia con pmOS).
# Ventaja adicional: el initramfs no tiene que descomprimir .ko.zst al arrancar.
# Si alguna vez se quiere volver a comprimir, hay que anadir zstd a makedepends.
# CONFIG_MODULE_COMPRESS is not set
# CONFIG_MODULE_COMPRESS_GZIP is not set
# CONFIG_MODULE_COMPRESS_XZ is not set
# CONFIG_MODULE_COMPRESS_ZSTD is not set
# CONFIG_MODULE_COMPRESS_ALL is not set
CONFIG_BLK_DEV_DM_BUILTIN=y
CONFIG_BLK_DEV_DM=y

# ---------------------------------------------------------------------------
# Tailscale: netfilter connmark/mark (workaround rp_filter en mangle).
#
# Sintoma sin esto: `tailscaled` health check falla con
#   enabling connmark rules: ... Warning: Extension connmark revision 0 not
#   supported, missing kernel module? / iptables: unknown option "--nfmask"
# y el tunel WireGuard queda fragil (handshake que no completa, peer "online"
# sin datos). Tailscale inserta en mangle/PREROUTING:
#   -m conntrack --ctstate ESTABLISHED,RELATED -m connmark ! --mark 0x0/0xff0000
#   -j CONNMARK --restore-mark --nfmask 0xff0000 --ctmask 0xff0000
# y en mangle/OUTPUT:
#   -m conntrack --ctstate NEW -m mark ! --mark 0x0/0xff0000
#   -j CONNMARK --save-mark --nfmask 0xff0000 --ctmask 0xff0000
#
# El simbolo que CONSTRUYE xt_connmark.ko es CONFIG_NETFILTER_XT_CONNMARK
# (net/netfilter/Makefile: obj-$(CONFIG_NETFILTER_XT_CONNMARK) += xt_connmark.o).
# TARGET/MATCH_CONNMARK solo lo seleccionan (compat); se ponen igual para que el
# config sea explicito.
#
# Fijado a =m (no =y): con NF_CONNTRACK=m el capping tristate degrada =y a =m
# en silencio (mismo fallo que ya sufrieron CFG80211_WEXT y RTW88 aqui). =m basta:
# x_tables hace request_module("xt_connmark") y lo autocarga.
CONFIG_NETFILTER_XT_CONNMARK=m
CONFIG_NETFILTER_XT_TARGET_CONNMARK=m
CONFIG_NETFILTER_XT_MATCH_CONNMARK=m
CONFIG_NETFILTER_XT_TARGET_MARK=m


# ---------------------------------------------------------------------------
# Diagnostico de arranque (2026-10-20): el 7.2.11 arranca (logo) pero no monta
# la raiz: sin journal, sin RNDIS y sin WiFi => se cuelga en el initramfs. No
# hay UART accesible en begonia, asi que se manda la consola a ramoops: el
# kernel escribe ahi aunque no haya display, y tras un cuelgue el siguiente
# arranque puede leerla con `cat /sys/fs/pstore/console-ramoops-0`.
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_DEFAULT_KMSG_BYTES=2097152
