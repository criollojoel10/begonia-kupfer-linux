+		PMIC_AUXADC_BAT_TEMP_VOLT_MIN_ADDR,
+		PMIC_AUXADC_BAT_TEMP_VOLT_MIN_MASK
+		<< PMIC_AUXADC_BAT_TEMP_VOLT_MIN_SHIFT,
+		tmp_int_lt << PMIC_AUXADC_BAT_TEMP_VOLT_MIN_SHIFT);
