+		regmap_update_bits(gauge->regmap,
+			PMIC_AUXADC_BAT_TEMP_EN_ADDR,
+			PMIC_AUXADC_BAT_TEMP_EN_MASK
+			<< PMIC_AUXADC_BAT_TEMP_EN_SHIFT,
