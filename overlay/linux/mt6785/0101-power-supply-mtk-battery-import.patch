+{
+	int ret = (_reg * 4096) / (VOLTAGE_FULL_RANGES * R_VAL_TEMP_3);
+
+	bm_debug(gauge->gm, "[%s] %d => %d\n", __func__, _reg, ret);
+	return ret;
+}
