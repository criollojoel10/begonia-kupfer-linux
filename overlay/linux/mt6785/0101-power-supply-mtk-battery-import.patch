+void fg_convert_prop_tolower(char *s)
+{
+	int loop = 0;
+
+	while (*s && loop <= MAX_PROP_NAME_LEN) {
+		if (*s == '_')
+			*s = '-';
+		else
+			*s = tolower(*s);
+		loop++;
+		s++;
+	}
+}
