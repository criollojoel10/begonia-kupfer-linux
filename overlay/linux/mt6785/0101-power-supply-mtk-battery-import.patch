+			PMIC_AUXADC_LBAT2_EN_ADDR,
+			PMIC_AUXADC_LBAT2_EN_MASK << PMIC_AUXADC_LBAT2_EN_SHIFT,
+			0 << PMIC_AUXADC_LBAT2_EN_SHIFT);
