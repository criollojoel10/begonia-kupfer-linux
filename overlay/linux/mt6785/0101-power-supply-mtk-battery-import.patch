+int nafg_en_set(struct mtk_gauge *gauge,
+	struct mtk_gauge_sysfs_field_info *attr, int val)
+{
+	static int cnt;
+
+	bm_debug(gauge->gm, "%s %d %d\n", __func__,
+		cnt, val);
+	if (val != 0)
+		cnt++;
+	else
+		cnt--;
+
+	if (val != 0) {
+		val = 1;
+		enable_gauge_irq(gauge, NAFG_IRQ);
