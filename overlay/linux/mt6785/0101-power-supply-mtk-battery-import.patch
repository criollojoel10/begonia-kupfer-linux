+void fg_ocv_query_soc(struct mtk_battery *gm, int ocv)
+{
+	if (ocv > 50000 || ocv <= 0)
+		return;
+
+	gm->algo_req_ocv = ocv;
+	wakeup_fg_algo_cmd(gm,
+		FG_INTR_KERNEL_CMD, FG_KERNEL_CMD_REQ_ALGO_DATA,
+		ocv);
+
+	bm_trace(gm, "[%s] ocv:%d\n",
+		__func__, ocv);
+}
