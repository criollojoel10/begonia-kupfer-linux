--- a/drivers/misc/mediatek/connectivity/compat/include/mtk-conn-gpio.h
+++ b/drivers/misc/mediatek/connectivity/compat/include/mtk-conn-gpio.h
@@ -0,0 +1,49 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Puente device_node -> numero de GPIO para el port conn/WiFi vendor en 7.1.
+ *
+ * El kernel 7.1 elimino include/linux/of_gpio.h y con el las helpers legacy
+ * of_get_named_gpio()/of_get_gpio(). El codigo vendor sigue trabajando con
+ * numeros de GPIO (gpio_request/gpio_direction_output/...), API que sigue viva
+ * en include/linux/gpio.h, asi que lo unico que hay que reconstruir es el
+ * puente con la API nueva de fwnode + desc_to_gpio().
+ *
+ * El descriptor se libera inmediatamente: el codigo vendor vuelve a pedir el
+ * GPIO por numero mas tarde, y si lo dejasemos reclamado (claimed) ese
+ * gpio_request() posterior fallaria con -EBUSY.
+ */
+#ifndef _MTK_CONN_GPIO_COMPAT_H_
+#define _MTK_CONN_GPIO_COMPAT_H_
+
+#include <linux/device.h>
+#include <linux/err.h>
+#include <linux/gpio/consumer.h>
+#include <linux/of.h>
+
+static inline int mtk_conn_of_get_named_gpio(struct device_node *np,
+					     const char *propname, int index)
+{
+	struct gpio_desc *desc;
+	int gpio;
+
+	if (!np)
+		return -ENODEV;
+
+	desc = fwnode_gpiod_get_index(of_fwnode_handle(np), propname, index,
+				      GPIOD_ASIS, "mtk-conn");
+	if (IS_ERR(desc))
+		return PTR_ERR(desc);
+
+	gpio = desc_to_gpio(desc);
+	gpiod_put(desc);
+
+	return gpio;
+}
+
+/* El codigo vendor llamaba of_get_named_gpio(): se conserva el nombre para no
+ * tener que tocar los sitios de llamada, solo la cabecera que se incluye.
+ */
+#define of_get_named_gpio(np, prop, idx) \
+	mtk_conn_of_get_named_gpio(np, prop, idx)
+
+#endif /* _MTK_CONN_GPIO_COMPAT_H_ */
